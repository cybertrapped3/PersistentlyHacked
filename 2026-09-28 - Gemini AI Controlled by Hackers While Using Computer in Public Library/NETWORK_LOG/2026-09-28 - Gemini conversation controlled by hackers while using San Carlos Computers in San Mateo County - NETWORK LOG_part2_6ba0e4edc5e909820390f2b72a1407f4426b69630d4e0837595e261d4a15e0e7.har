--border-color);\\\\n  border-radius: var(--border-radius-pill);\\\\n  padding: 6px var(--spacing-m);\\\\n  font-size: 0.82rem;\\\\n  font-weight: 500;\\\\n  color: var(--text-primary);\\\\n  cursor: pointer;\\\\n  transition: background-color 0.15s ease, border-color 0.15s ease;\\\\n}\\\\n\\\\nreply-chip:hover, [data-type\\\\u003d\\\\\"reply-chip\\\\\"]:hover {\\\\n  background-color: var(--bg-card);\\\\n  border-color: var(--accent-color);\\\\n}\\\\n\\\\nreply-choices {\\\\n  display: flex;\\\\n  flex-direction: column;\\\\n  gap: var(--spacing-s);\\\\n  margin: var(--spacing-m) 0;\\\\n}\\\\n\\\\nreply-option {\\\\n  display: flex;\\\\n  align-items: center;\\\\n  background-color: var(--bg-card);\\\\n  border: 1px solid var(--border-color);\\\\n  border-radius: var(--border-radius-m);\\\\n  padding: var(--spacing-m);\\\\n  font-size: 0.85rem;\\\\n  font-weight: 500;\\\\n  color: var(--text-primary);\\\\n  cursor: pointer;\\\\n  transition: border-color 0.15s ease, background-color 0.15s ease;\\\\n}\\\\n\\\\nreply-option:hover, reply-option.selected {\\\\n  border-color: var(--accent-color);\\\\n  background-color: var(--accent-secondary);\\\\n}\\\\n\\\\n\\\\n\"]'))));\n_.Ic(_.lm(rpi||(rpi=(0,_.pm)(\"[null,null,null,null,null,\\\"/**\\\\n * @fileoverview Client hydration runtime for the Rich Pages GenHTML iframe\\\\n * render mode (go/rich-pages-design). Defines the Web Components the model\\\\n * emits so the browser upgrades them inside the sandboxed iframe:\\\\n *   interactive-map, gmp-map, gmp-advanced-marker (static inline-SVG maps),\\\\n *   bar-chart, line-chart (inline SVG), spec-bar, chat-bubble, text-editor.\\\\n *\\\\n * Vendored (curated extract) from the Structura SI static/app.js\\\\n * (//depot/google3/experimental/users/vnatchu/chatbot/static/app.js). Excludes\\\\n * gen-image (needs a server round-trip; tracked separately) and all SI app\\\\n * scaffolding.\\\\n *\\\\n * This bundle has NO external library dependencies: charts render as inline\\\\n * SVG, and the map elements degrade to the SI's static inline-SVG fallback\\\\n * (the one edit vs the SI: renderLeafletMap() falls back to renderSvgMap() when\\\\n * leaflet is absent). Interactive leaflet tile maps require network egress the\\\\n * sandbox blocks and are a follow-up (P2).\\\\n */\\\\nclass InteractiveMap extends HTMLElement {\\\\n  /** @suppress {checkTypes} */\\\\n  connectedCallback() {\\\\n    this.style.display \\\\u003d 'block';\\\\n    this.style.height \\\\u003d '300px';\\\\n    this.style.width \\\\u003d '100%';\\\\n    this.style.margin \\\\u003d '12px 0';\\\\n    this.style.borderRadius \\\\u003d '8px';\\\\n    this.style.border \\\\u003d '1px solid var(--border-color)';\\\\n\\\\n    // If we are currently streaming, render a static placeholder\\\\n    if (this.closest('.streaming')) {\\\\n      this.innerHTML \\\\u003d `\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"widget-streaming-placeholder\\\\\\\" style\\\\u003d\\\\\\\"height: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--bg-secondary); color: var(--text-secondary); font-size: 0.8rem; font-style: italic; border-radius: 8px;\\\\\\\"\\\\u003e\\\\n          \\ud83d\\uddfa\\ufe0f Map loading (waiting for stream)...\\\\n        \\\\u003c/div\\\\u003e\\\\n      `;\\\\n      return;\\\\n    }\\\\n\\\\n    this.compile();\\\\n  }\\\\n\\\\n  /** @suppress {checkTypes} */\\\\n  compile() {\\\\n    // Idempotency guard \\u2014 never render twice\\\\n    if (this.classList.contains('map-ready')) return;\\\\n\\\\n    // Validate that required data attributes are present and parseable\\\\n    const centerStr \\\\u003d this.getAttribute('data-center');\\\\n    if (!centerStr) return;\\\\n    let center;\\\\n    try {\\\\n      center \\\\u003d JSON.parse(centerStr);\\\\n    } catch (e) {\\\\n      return;  // data-center not fully streamed yet\\\\n    }\\\\n\\\\n    this.classList.add('map-ready');\\\\n\\\\n    // Fade in smoothly\\\\n    this.style.opacity \\\\u003d '0';\\\\n    this.style.transition \\\\u003d 'opacity 0.35s ease';\\\\n    requestAnimationFrame(() \\\\u003d\\\\u003e {\\\\n      this.style.opacity \\\\u003d '1';\\\\n    });\\\\n\\\\n    this.innerHTML \\\\u003d '';\\\\n    /** @type {?} */ const L \\\\u003d window['L'];\\\\n    const mapDiv \\\\u003d document.createElement('div');\\\\n    mapDiv.style.width \\\\u003d '100%';\\\\n    mapDiv.style.height \\\\u003d '100%';\\\\n    this.appendChild(mapDiv);\\\\n\\\\n    const zoom \\\\u003d parseInt(this.getAttribute('data-zoom') || '', 10) || 13;\\\\n\\\\n    const map \\\\u003d L.map(mapDiv).setView(center, zoom);\\\\n    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\\\\n      attribution: '\\u00a9 OpenStreetMap'\\\\n    }).addTo(map);\\\\n\\\\n    // Leaflet can't autodetect icon paths when loaded inline; set explicitly\\\\n    delete L.Icon.Default.prototype._getIconUrl;\\\\n    L.Icon.Default.mergeOptions({\\\\n      iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',\\\\n      iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',\\\\n      shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',\\\\n    });\\\\n\\\\n    const markersStr \\\\u003d this.getAttribute('data-markers');\\\\n    if (markersStr) {\\\\n      try {\\\\n        const markers \\\\u003d JSON.parse(markersStr);\\\\n        markers.forEach(m \\\\u003d\\\\u003e {\\\\n          L.marker([m.lat, m.lng])\\\\n              .addTo(map)\\\\n              .bindPopup(m.label || m.title || '');\\\\n        });\\\\n      } catch (e) {\\\\n        console.error('Error parsing markers:', e);\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\\nif (!customElements.get('interactive-map')) {\\\\n  customElements.define('interactive-map', InteractiveMap);\\\\n}\\\\n\\\\nfunction shouldHealFirstTag(html) {\\\\n  const trimmed \\\\u003d html.trim();\\\\n  if (!trimmed) return false;\\\\n\\\\n  const validTags \\\\u003d [\\\\n    'p', 'div', 'span', 'aside', 'section', 'article', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',\\\\n    'ul', 'ol', 'li', 'table', 'tr', 'td', 'th', 'blockquote', 'pre', 'code', 'b', 'i',\\\\n    'strong', 'em', 'mark', 'a',\\\\n    'reply-choices', 'suggested-replies', 'accordion', 'tabs', 'tab-container', 'tab-headers', 'tab-panel',\\\\n    'grid', 'card', 'timeline', 'stepper', 'stat-grid', 'comparison-grid', 'comparison-table', 'chart', 'gmp-map',\\\\n    'pro-tip', 'alert-box', 'recipe', 'suggest-replies', 'reply-chip', 'chat-bubble', 'text-editor'\\\\n  ];\\\\n\\\\n  const tagRegex \\\\u003d new RegExp(\\\\n      '^(' + validTags.join('|') + ')(?:\\\\\\\\\\\\\\\\s+[a-zA-Z0-9\\\\\\\\\\\\\\\\-]+(?:\\\\u003d(?:\\\\\\\"[^\\\\\\\"]*\\\\\\\"|\\\\\\\\'[^\\\\\\\\']*\\\\\\\\'|[^\\\\u003e\\\\\\\\\\\\\\\\s]+))?)*\\\\\\\\\\\\\\\\s*\\\\u003e', 'i');\\\\n  return tagRegex.test(trimmed);\\\\n}\\\\n\\\\nfunction isElementParsed(el) {\\\\n  if (!el.closest('.streaming')) return true;\\\\n  if (el.nextSibling) return true;\\\\n  let parent \\\\u003d el.parentNode;\\\\n  while (parent \\\\u0026\\\\u0026 parent !\\\\u003d\\\\u003d document.body) {\\\\n    if (parent.nextSibling) return true;\\\\n    parent \\\\u003d parent.parentNode;\\\\n  }\\\\n  return false;\\\\n}\\\\n\\\\nconst isWrs \\\\u003d\\\\n    (window.location.hostname \\\\u003d\\\\u003d\\\\u003d 'local' || window.location.host \\\\u003d\\\\u003d\\\\u003d 'local');\\\\n\\\\nconst hasGmapsScript \\\\u003d\\\\n    !!document.querySelector('script[src*\\\\u003d\\\\\\\"maps.googleapis.com\\\\\\\"]') ||\\\\n    !!document.querySelector('script[src*\\\\u003d\\\\\\\"maps.google.com\\\\\\\"]');\\\\n\\\\nif (!hasGmapsScript) {\\\\n  class GmpMap extends HTMLElement {\\\\n    constructor() {\\\\n      super();\\\\n      this.mapInstance \\\\u003d null;\\\\n      this.leafletMarkers \\\\u003d [];\\\\n      this.mutationObserver \\\\u003d null;\\\\n    }\\\\n\\\\n    connectedCallback() {\\\\n      this.style.display \\\\u003d 'block';\\\\n      this.style.height \\\\u003d this.style.height || '300px';\\\\n      this.style.width \\\\u003d '100%';\\\\n      this.style.margin \\\\u003d '12px 0';\\\\n      this.style.borderRadius \\\\u003d '8px';\\\\n      this.style.border \\\\u003d '1px solid var(--border-color)';\\\\n      this.style.position \\\\u003d 'relative';\\\\n\\\\n      // If we are currently streaming, render a static placeholder.\\\\n      if (this.closest('.streaming')) {\\\\n        if (!this.querySelector('.widget-streaming-placeholder')) {\\\\n          this.innerHTML \\\\u003d `\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"widget-streaming-placeholder\\\\\\\" style\\\\u003d\\\\\\\"height: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--bg-secondary); color: var(--text-secondary); font-size: 0.8rem; font-style: italic; border-radius: 8px;\\\\\\\"\\\\u003e\\\\n              \\ud83d\\uddfa\\ufe0f Map loading (waiting for stream)...\\\\n            \\\\u003c/div\\\\u003e\\\\n          `;\\\\n        }\\\\n      }\\\\n\\\\n      this.compile();\\\\n\\\\n      // Listen for future children mutations (dynamic marker updates)\\\\n      if (!this.mutationObserver) {\\\\n        this.mutationObserver \\\\u003d new MutationObserver(() \\\\u003d\\\\u003e {\\\\n          this.compile();\\\\n        });\\\\n        this.mutationObserver.observe(this, {\\\\n          childList: true,\\\\n          subtree: true,\\\\n          attributes: true,\\\\n          attributeFilter: ['position', 'title', 'center', 'zoom']\\\\n        });\\\\n      }\\\\n    }\\\\n\\\\n    compile() {\\\\n      if (this.classList.contains('map-ready')) return;\\\\n      if (!isElementParsed(this)) return;\\\\n      const placeholder \\\\u003d this.querySelector('.widget-streaming-placeholder');\\\\n      if (placeholder) {\\\\n        placeholder.remove();\\\\n      }\\\\n      this.classList.add('map-ready');\\\\n      this.initMap();\\\\n    }\\\\n\\\\n    disconnectedCallback() {\\\\n      if (this.mutationObserver) {\\\\n        this.mutationObserver.disconnect();\\\\n        this.mutationObserver \\\\u003d null;\\\\n      }\\\\n      if (this.mapInstance) {\\\\n        this.mapInstance.remove();\\\\n        this.mapInstance \\\\u003d null;\\\\n      }\\\\n    }\\\\n\\\\n    /** @suppress {checkTypes} */\\\\n    async initMap() {\\\\n      console.log(\\\\n          '[MAP_DEBUG] initMap() called. center:', this.getAttribute('center'),\\\\n          'zoom:', this.getAttribute('zoom'));\\\\n      const centerAttr \\\\u003d this.getAttribute('center');\\\\n      if (!centerAttr) return;\\\\n      const parts \\\\u003d centerAttr.split(',');\\\\n      if (parts.length \\\\u003c 2) return;\\\\n      const centerLat \\\\u003d parseFloat(parts[0]);\\\\n      const centerLng \\\\u003d parseFloat(parts[1]);\\\\n      if (isNaN(centerLat) || isNaN(centerLng)) return;\\\\n\\\\n      const zoom \\\\u003d parseInt(this.getAttribute('zoom') || '', 10) || 13;\\\\n\\\\n      // Get current markers from the DOM\\\\n      const markerElements \\\\u003d this.querySelectorAll('gmp-advanced-marker');\\\\n      console.log(\\\\n          '[MAP_DEBUG] Found gmp-advanced-marker elements in DOM count:',\\\\n          markerElements.length);\\\\n      const markersData \\\\u003d [];\\\\n      markerElements.forEach(markerEl \\\\u003d\\\\u003e {\\\\n        const positionAttr \\\\u003d markerEl.getAttribute('position');\\\\n        if (!positionAttr) return;\\\\n        const mParts \\\\u003d positionAttr.split(',');\\\\n        if (mParts.length \\\\u003c 2) return;\\\\n        const lat \\\\u003d parseFloat(mParts[0]);\\\\n        const lng \\\\u003d parseFloat(mParts[1]);\\\\n        if (!isNaN(lat) \\\\u0026\\\\u0026 !isNaN(lng)) {\\\\n          markersData.push({\\\\n            lat: lat,\\\\n            lng: lng,\\\\n            title: markerEl.getAttribute('title') || ''\\\\n          });\\\\n        }\\\\n      });\\\\n\\\\n      if (markersData.length \\\\u003d\\\\u003d\\\\u003d 0) {\\\\n        markersData.push(\\\\n            {lat: centerLat, lng: centerLng, title: 'Center Location'});\\\\n      }\\\\n\\\\n      // Get or create the inner map container\\\\n      let mapContainer \\\\u003d this.querySelector('.map-container-inner');\\\\n      if (!mapContainer) {\\\\n        mapContainer \\\\u003d document.createElement('div');\\\\n        mapContainer.className \\\\u003d 'map-container-inner';\\\\n        mapContainer.style.width \\\\u003d '100%';\\\\n        mapContainer.style.height \\\\u003d '100%';\\\\n        mapContainer.style.position \\\\u003d 'absolute';\\\\n        mapContainer.style.top \\\\u003d '0';\\\\n        mapContainer.style.left \\\\u003d '0';\\\\n        mapContainer.style.zIndex \\\\u003d '1';\\\\n        this.insertBefore(mapContainer, this.firstChild);\\\\n      }\\\\n\\\\n      // Fast async connectivity check to the map tile server (1.5s timeout).\\\\n      // Cache the result on window so subsequent maps on the same page skip\\\\n      // the probe and avoid repeated 1.5s delays.\\\\n      let online \\\\u003d false;\\\\n      if (window._mapTileConnectivity !\\\\u003d\\\\u003d undefined) {\\\\n        online \\\\u003d window._mapTileConnectivity;\\\\n      } else {\\\\n        try {\\\\n          const controller \\\\u003d new AbortController();\\\\n          const timeoutId \\\\u003d setTimeout(() \\\\u003d\\\\u003e controller.abort(), 1500);\\\\n          await fetch(\\\\n              'https://mt1.google.com/vt/lyrs\\\\u003dm\\\\u0026x\\\\u003d0\\\\u0026y\\\\u003d0\\\\u0026z\\\\u003d0',\\\\n              {mode: 'no-cors', cache: 'no-store', signal: controller.signal});\\\\n          clearTimeout(timeoutId);\\\\n          online \\\\u003d true;\\\\n        } catch (e) {\\\\n          console.log(\\\\n              '[MAP_DEBUG] Tile server unreachable (offline/sandboxed), choosing static SVG map layout:',\\\\n              e.message);\\\\n        }\\\\n        window._mapTileConnectivity \\\\u003d online;\\\\n      }\\\\n\\\\n      if (!online) {\\\\n        this.renderSvgMap(mapContainer, markersData);\\\\n      } else {\\\\n        this.renderLeafletMap(\\\\n            mapContainer, markersData, centerLat, centerLng, zoom);\\\\n      }\\\\n    }\\\\n\\\\n    /** @suppress {checkTypes} */\\\\n    renderSvgMap(mapContainer, markersData) {\\\\n      mapContainer.innerHTML \\\\u003d '';\\\\n      let minLat \\\\u003d Infinity, maxLat \\\\u003d -Infinity;\\\\n      let minLng \\\\u003d Infinity, maxLng \\\\u003d -Infinity;\\\\n      markersData.forEach(m \\\\u003d\\\\u003e {\\\\n        if (m.lat \\\\u003c minLat) minLat \\\\u003d m.lat;\\\\n        if (m.lat \\\\u003e maxLat) maxLat \\\\u003d m.lat;\\\\n        if (m.lng \\\\u003c minLng) minLng \\\\u003d m.lng;\\\\n        if (m.lng \\\\u003e maxLng) maxLng \\\\u003d m.lng;\\\\n      });\\\\n\\\\n      if (maxLat - minLat \\\\u003c 0.005) {\\\\n        minLat -\\\\u003d 0.005;\\\\n        maxLat +\\\\u003d 0.005;\\\\n      }\\\\n      if (maxLng - minLng \\\\u003c 0.01) {\\\\n        minLng -\\\\u003d 0.01;\\\\n        maxLng +\\\\u003d 0.01;\\\\n      }\\\\n\\\\n      const latRange \\\\u003d maxLat - minLat;\\\\n      const lngRange \\\\u003d maxLng - minLng;\\\\n\\\\n      const svg \\\\u003d document.createElementNS('http://www.w3.org/2000/svg', 'svg');\\\\n      svg.setAttribute('viewBox', '0 0 600 300');\\\\n      svg.style.width \\\\u003d '100%';\\\\n      svg.style.height \\\\u003d '100%';\\\\n      svg.style.backgroundColor \\\\u003d '#f4f3f0';\\\\n      svg.style.display \\\\u003d 'block';\\\\n\\\\n      const river \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'path');\\\\n      river.setAttribute('d', 'M -50,150 C 150,50 350,250 650,150');\\\\n      river.setAttribute('fill', 'none');\\\\n      river.setAttribute('stroke', '#cad2d3');\\\\n      river.setAttribute('stroke-width', '40');\\\\n      svg.appendChild(river);\\\\n\\\\n      const park1 \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'rect');\\\\n      park1.setAttribute('x', '80');\\\\n      park1.setAttribute('y', '30');\\\\n      park1.setAttribute('width', '120');\\\\n      park1.setAttribute('height', '80');\\\\n      park1.setAttribute('rx', '8');\\\\n      park1.setAttribute('fill', '#e1e8db');\\\\n      svg.appendChild(park1);\\\\n\\\\n      const park2 \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'rect');\\\\n      park2.setAttribute('x', '420');\\\\n      park2.setAttribute('y', '180');\\\\n      park2.setAttribute('width', '100');\\\\n      park2.setAttribute('height', '90');\\\\n      park2.setAttribute('rx', '8');\\\\n      park2.setAttribute('fill', '#e1e8db');\\\\n      svg.appendChild(park2);\\\\n\\\\n      const streetPaths \\\\u003d [\\\\n        'M 0,50 L 600,50', 'M 0,120 L 600,120', 'M 0,220 L 600,220',\\\\n        'M 100,0 L 100,300', 'M 250,0 L 250,300', 'M 400,0 L 400,300',\\\\n        'M 520,0 L 520,300', 'M 0,0 L 300,300', 'M 300,0 L 600,300'\\\\n      ];\\\\n      streetPaths.forEach(pathData \\\\u003d\\\\u003e {\\\\n        const line \\\\u003d\\\\n            document.createElementNS('http://www.w3.org/2000/svg', 'path');\\\\n        line.setAttribute('d', pathData);\\\\n        line.setAttribute('fill', 'none');\\\\n        line.setAttribute('stroke', '#ffffff');\\\\n        line.setAttribute('stroke-width', '6');\\\\n        svg.appendChild(line);\\\\n      });\\\\n\\\\n      const compassGroup \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'g');\\\\n      compassGroup.setAttribute('transform', 'translate(560, 40)');\\\\n\\\\n      const compassBg \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'circle');\\\\n      compassBg.setAttribute('r', '20');\\\\n      compassBg.setAttribute('fill', '#ffffff');\\\\n      compassBg.setAttribute('stroke', '#cad2d3');\\\\n      compassBg.setAttribute('stroke-width', '2');\\\\n      compassGroup.appendChild(compassBg);\\\\n\\\\n      const compassNeedle \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'path');\\\\n      compassNeedle.setAttribute('d', 'M 0,-14 L 6,0 L 0,14 L -6,0 Z');\\\\n      compassNeedle.setAttribute('fill', '#ea4335');\\\\n      compassGroup.appendChild(compassNeedle);\\\\n\\\\n      const compassNeedleN \\\\u003d\\\\n          document.createElementNS('http://www.w3.org/2000/svg', 'path');\\\\n      compassNeedleN.setAttribute('d', 'M 0,-14 L 6,0 L 0,0 L -6,0 Z');\\\\n      compassNeedleN.setAttribute('fill', '#4285f4');\\\\n      compassGroup.appendChild(compassNeedleN);\\\\n      svg.appendChild(compassGroup);\\\\n\\\\n      const marginX \\\\u003d 80;\\\\n      const marginY \\\\u003d 60;\\\\n      const usableW \\\\u003d 600 - 2 * marginX;\\\\n      const usableH \\\\u003d 300 - 2 * marginY;\\\\n\\\\n      markersData.forEach(m \\\\u003d\\\\u003e {\\\\n        const pctX \\\\u003d (m.lng - minLng) / lngRange;\\\\n        const pctY \\\\u003d 1 - (m.lat - minLat) / latRange;\\\\n\\\\n        const x \\\\u003d marginX + pctX * usableW;\\\\n        const y \\\\u003d marginY + pctY * usableH;\\\\n\\\\n        const pinGroup \\\\u003d\\\\n            document.createElementNS('http://www.w3.org/2000/svg', 'g');\\\\n        pinGroup.setAttribute('transform', `translate(${x}, ${y})`);\\\\n\\\\n        const pin \\\\u003d\\\\n            document.createElementNS('http://www.w3.org/2000/svg', 'path');\\\\n        pin.setAttribute(\\\\n            'd', 'M 0,0 C -12,-12 -12,-30 0,-30 C 12,-30 12,-12 0,0 Z');\\\\n        pin.setAttribute('fill', '#ea4335');\\\\n        pin.setAttribute('stroke', '#ffffff');\\\\n        pin.setAttribute('stroke-width', '1.5');\\\\n        pinGroup.appendChild(pin);\\\\n\\\\n        const dot \\\\u003d\\\\n            document.createElementNS('http://www.w3.org/2000/svg', 'circle');\\\\n        dot.setAttribute('cy', '-20');\\\\n        dot.setAttribute('r', '4');\\\\n        dot.setAttribute('fill', '#ffffff');\\\\n        pinGroup.appendChild(dot);\\\\n\\\\n        if (m.title) {\\\\n          const labelGroup \\\\u003d\\\\n              document.createElementNS('http://www.w3.org/2000/svg', 'g');\\\\n          labelGroup.setAttribute('transform', 'translate(14, -28)');\\\\n\\\\n          const rect \\\\u003d\\\\n              document.createElementNS('http://www.w3.org/2000/svg', 'rect');\\\\n          rect.setAttribute('height', '18');\\\\n          rect.setAttribute('rx', '4');\\\\n          rect.setAttribute('fill', '#ffffff');\\\\n          rect.setAttribute('stroke', '#cad2d3');\\\\n          rect.setAttribute('stroke-width', '1');\\\\n\\\\n          const text \\\\u003d\\\\n              document.createElementNS('http://www.w3.org/2000/svg', 'text');\\\\n          text.setAttribute('x', '6');\\\\n          text.setAttribute('y', '13');\\\\n          text.setAttribute('font-size', '9');\\\\n          text.setAttribute('font-family', 'sans-serif');\\\\n          text.setAttribute('font-weight', 'bold');\\\\n          text.setAttribute('fill', '#3c4043');\\\\n          text.textContent \\\\u003d m.title;\\\\n\\\\n          labelGroup.appendChild(rect);\\\\n          labelGroup.appendChild(text);\\\\n          pinGroup.appendChild(labelGroup);\\\\n\\\\n          const approxWidth \\\\u003d m.title.length * 6 + 12;\\\\n          rect.setAttribute('width', approxWidth.toString());\\\\n        }\\\\n\\\\n        svg.appendChild(pinGroup);\\\\n      });\\\\n\\\\n      mapContainer.appendChild(svg);\\\\n    }\\\\n\\\\n    /** @suppress {checkTypes} */\\\\n    renderLeafletMap(mapContainer, markersData, centerLat, centerLng, zoom) {\\\\n      // Live Browser: Leaflet interactive rendering\\\\n      /** @type {?} */ const L \\\\u003d window['L'];\\\\n      if (!L) {\\\\n        // Rich Pages iframe (P1): the leaflet runtime is intentionally not\\\\n        // shipped (interactive tiles need network egress the sandbox blocks;\\\\n        // tracked as a follow-up). Degrade to the static inline-SVG map instead\\\\n        // of erroring. This is the only edit vs the vendored SI app.js.\\\\n        this.renderSvgMap(mapContainer, markersData);\\\\n        return;\\\\n      }\\\\n\\\\n      console.log(\\\\n          '[MAP_DEBUG] Live Leaflet map rendering. mapInstance exists:',\\\\n          !!this.mapInstance);\\\\n      if (!this.mapInstance) {\\\\n        this.mapInstance \\\\u003d\\\\n            L.map(mapContainer).setView([centerLat, centerLng], zoom);\\\\n        L.tileLayer('https://mt1.google.com/vt/lyrs\\\\u003dm\\\\u0026x\\\\u003d{x}\\\\u0026y\\\\u003d{y}\\\\u0026z\\\\u003d{z}', {\\\\n           attribution: '\\u00a9 Google Maps'\\\\n         }).addTo(this.mapInstance);\\\\n      } else {\\\\n        this.mapInstance.setView([centerLat, centerLng], zoom);\\\\n      }\\\\n\\\\n      // Clear existing markers from the Leaflet instance\\\\n      this.leafletMarkers.forEach(marker \\\\u003d\\\\u003e {\\\\n        this.mapInstance.removeLayer(marker);\\\\n      });\\\\n      this.leafletMarkers \\\\u003d [];\\\\n\\\\n      // Custom Google Maps Red Pin SVG marker icon\\\\n      const pinSvg \\\\u003d `\\\\n        \\\\u003csvg xmlns\\\\u003d\\\\\\\"http://www.w3.org/2000/svg\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 30\\\\\\\" width\\\\u003d\\\\\\\"24\\\\\\\" height\\\\u003d\\\\\\\"30\\\\\\\"\\\\u003e\\\\n          \\\\u003cpath d\\\\u003d\\\\\\\"M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z\\\\\\\" fill\\\\u003d\\\\\\\"#ea4335\\\\\\\" stroke\\\\u003d\\\\\\\"#ffffff\\\\\\\" stroke-width\\\\u003d\\\\\\\"1.5\\\\\\\"/\\\\u003e\\\\n        \\\\u003c/svg\\\\u003e\\\\n      `;\\\\n      const customIcon \\\\u003d L.divIcon({\\\\n        html: pinSvg,\\\\n        iconSize: [24, 30],\\\\n        iconAnchor: [12, 30],\\\\n        popupAnchor: [0, -30],\\\\n        className: ''\\\\n      });\\\\n\\\\n      // Add new markers\\\\n      markersData.forEach(m \\\\u003d\\\\u003e {\\\\n        console.log('[MAP_DEBUG] Adding Leaflet marker to map instance:', m);\\\\n        const marker \\\\u003d L.marker([m.lat, m.lng], {icon: customIcon})\\\\n                           .addTo(this.mapInstance)\\\\n                           .bindPopup(`\\\\u003cstrong\\\\u003e${m.title}\\\\u003c/strong\\\\u003e`);\\\\n        this.leafletMarkers.push(marker);\\\\n      });\\\\n      console.log(\\\\n          '[MAP_DEBUG] Leaflet markers added count:',\\\\n          this.leafletMarkers.length);\\\\n    }\\\\n  }\\\\n\\\\n  class GmpAdvancedMarker extends HTMLElement {\\\\n    connectedCallback() {\\\\n      this.style.display \\\\u003d 'none';\\\\n    }\\\\n  }\\\\n\\\\n  if (!customElements.get('gmp-map')) {\\\\n    customElements.define('gmp-map', GmpMap);\\\\n  }\\\\n  if (!customElements.get('gmp-advanced-marker')) {\\\\n    customElements.define('gmp-advanced-marker', GmpAdvancedMarker);\\\\n  }\\\\n}\\\\n\\\\nclass SimpleChart extends HTMLElement {\\\\n  /** @suppress {checkTypes} */\\\\n  connectedCallback() {\\\\n    this.style.display \\\\u003d 'block';\\\\n    this.style.margin \\\\u003d '16px 0';\\\\n    this.style.padding \\\\u003d '12px';\\\\n    this.style.background \\\\u003d 'var(--bg-primary)';\\\\n    this.style.border \\\\u003d '1px solid var(--border-color)';\\\\n    this.style.borderRadius \\\\u003d '8px';\\\\n    this.style.height \\\\u003d '260px';\\\\n\\\\n    // If we are currently streaming, render a static placeholder.\\\\n    // The renderLoop will call compile() once data attributes are complete.\\\\n    if (this.closest('.streaming')) {\\\\n      this.innerHTML \\\\u003d `\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"widget-streaming-placeholder\\\\\\\" style\\\\u003d\\\\\\\"height: 100%; display: flex; align-items: center; justify-content: center; background-color: var(--bg-secondary); color: var(--text-secondary); font-size: 0.8rem; font-style: italic; border-radius: 6px;\\\\\\\"\\\\u003e\\\\n          \\ud83d\\udcca Chart loading...\\\\n        \\\\u003c/div\\\\u003e\\\\n      `;\\\\n      return;\\\\n    }\\\\n\\\\n    this.compile();\\\\n  }\\\\n\\\\n  /** @suppress {checkTypes} */\\\\n  compile() {\\\\n    // Idempotency guard \\u2014 never render twice\\\\n    if (this.classList.contains('chart-ready')) return;\\\\n\\\\n    // Validate that data attributes are present and contain parseable JSON.\\\\n    let labels, values;\\\\n    try {\\\\n      labels \\\\u003d JSON.parse(this.getAttribute('data-labels') || '[]');\\\\n      values \\\\u003d JSON.parse(this.getAttribute('data-values') || '[]');\\\\n      if (!labels.length \\\\u0026\\\\u0026 !values.length) return;\\\\n    } catch (e) {\\\\n      return;  // data attributes not fully streamed yet\\\\n    }\\\\n\\\\n    // Mark as ready\\\\n    this.classList.add('chart-ready');\\\\n    this.innerHTML \\\\u003d '';\\\\n\\\\n    const type \\\\u003d this.tagName.toLowerCase().replace('-chart', '');\\\\n    const label \\\\u003d this.getAttribute('data-label') || 'Data';\\\\n\\\\n    // Resolve CSS variable colors\\\\n    const cs \\\\u003d getComputedStyle(document.documentElement);\\\\n    const accent \\\\u003d cs.getPropertyValue('--accent-color').trim() || '#3b82f6';\\\\n    const textColor \\\\u003d\\\\n        cs.getPropertyValue('--text-secondary').trim() || '#888';\\\\n    const borderColor \\\\u003d\\\\n        cs.getPropertyValue('--border-color').trim() || '#e0e0e0';\\\\n\\\\n    // Chart layout\\\\n    const W \\\\u003d this.getBoundingClientRect().width || 500;\\\\n    const H \\\\u003d 260;\\\\n    const pad \\\\u003d {top: 24, right: 16, bottom: 36, left: 48};\\\\n    const cw \\\\u003d W - pad.left - pad.right;\\\\n    const ch \\\\u003d H - pad.top - pad.bottom;\\\\n\\\\n    // Handle negative values by computing min and max\\\\n    const minVal \\\\u003d Math.min(...values, 0);\\\\n    const 