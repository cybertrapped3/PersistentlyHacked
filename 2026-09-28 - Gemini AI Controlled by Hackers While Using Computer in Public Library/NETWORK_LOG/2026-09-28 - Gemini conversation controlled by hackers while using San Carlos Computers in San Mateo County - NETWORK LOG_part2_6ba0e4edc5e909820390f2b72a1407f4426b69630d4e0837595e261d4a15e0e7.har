.075 4.925C18.575 4.40833 17.8917 4.11667 17.025 4.05C16.775 4.05 16.5083 4.04167 16.225 4.025C15.9917 4.025 15.725 4.025 15.425 4.025C15.125 4.00833 14.8167 4 14.5 4H9.5C9.18333 4 8.875 4.00833 8.575 4.025C8.275 4.025 8.00833 4.025 7.775 4.025C7.49167 4.04167 7.225 4.05 6.975 4.05C6.10833 4.11667 5.41667 4.40833 4.9 4.925C4.4 5.425 4.11667 6.10833 4.05 6.975C4.05 7.24167 4.05 7.525 4.05 7.825C4.03333 8.075 4.01667 8.35 4 8.65C4 8.93333 4 9.21667 4 9.5Z\\\" fill=\\\"currentColor\\\"/>\\n                            </g>\\n                            <defs>\\n                                <clipPath id=\\\"clip0_259_2972\\\">\\n                                    <rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"white\\\"/>\\n                                </clipPath>\\n                            </defs>\\n                        </svg>\\n                    </button>\\n                    <button id=\\\"lightbox-share-button\\\" class=\\\"lightbox-share-button--hidden\\\" title=\\\"Share\\\">\\n                        <svg width=\\\"24\\\" height=\\\"24\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n                            <g clip-path=\\\"url(#clip0_259_2978)\\\">\\n                                <path d=\\\"M9.075 21.5C7.80833 21.5 6.725 21.05 5.825 20.15C4.925 19.25 4.475 18.1583 4.475 16.875V12.975C4.475 11.6917 4.925 10.6 5.825 9.7C6.725 8.78333 7.80833 8.325 9.075 8.325C9.29167 8.325 9.46667 8.4 9.6 8.55C9.75 8.7 9.825 8.875 9.825 9.075C9.825 9.29167 9.75 9.475 9.6 9.625C9.46667 9.75833 9.29167 9.825 9.075 9.825C8.225 9.825 7.49167 10.1333 6.875 10.75C6.275 11.3667 5.975 12.1083 5.975 12.975V16.875C5.975 17.7583 6.275 18.5 6.875 19.1C7.49167 19.7 8.225 20 9.075 20H14.875C15.7417 20 16.475 19.7 17.075 19.1C17.675 18.5 17.975 17.7583 17.975 16.875V12.975C17.975 12.1083 17.675 11.3667 17.075 10.75C16.475 10.1333 15.7417 9.825 14.875 9.825C14.6583 9.825 14.475 9.75833 14.325 9.625C14.1917 9.475 14.125 9.29167 14.125 9.075C14.125 8.875 14.1917 8.7 14.325 8.55C14.475 8.4 14.6583 8.325 14.875 8.325C16.1583 8.325 17.2417 8.78333 18.125 9.7C19.025 10.6 19.475 11.6917 19.475 12.975V16.875C19.475 18.1583 19.025 19.25 18.125 20.15C17.2417 21.05 16.1583 21.5 14.875 21.5H9.075ZM12 15.675C11.7833 15.675 11.6 15.6 11.45 15.45C11.3167 15.3 11.25 15.125 11.25 14.925V5.05L10.525 5.775C10.375 5.925 10.1917 6 9.975 6C9.775 6 9.6 5.925 9.45 5.775C9.31667 5.625 9.25 5.45 9.25 5.25C9.25 5.05 9.31667 4.875 9.45 4.725L11.45 2.725C11.5333 2.64167 11.6167 2.58333 11.7 2.55C11.7833 2.51667 11.875 2.5 11.975 2.5C12.075 2.5 12.1667 2.51667 12.25 2.55C12.35 2.58333 12.4417 2.64167 12.525 2.725L14.525 4.725C14.6583 4.875 14.725 5.05 14.725 5.25C14.725 5.45 14.6583 5.625 14.525 5.775C14.375 5.925 14.1917 6 13.975 6C13.775 6 13.6 5.925 13.45 5.775L12.75 5.075V14.925C12.75 15.125 12.675 15.3 12.525 15.45C12.375 15.6 12.2 15.675 12 15.675Z\\\" fill=\\\"currentColor\\\"/>\\n                            </g>\\n                            <defs>\\n                                <clipPath id=\\\"clip0_259_2978\\\">\\n                                    <rect width=\\\"24\\\" height=\\\"24\\\" fill=\\\"white\\\"/>\\n                                </clipPath>\\n                            </defs>\\n                        </svg>\\n                    </button>\\n                </div>\\n                <div id=\\\"viewer-bg-halos\\\" class=\\\"lumi-viewer-bg-halos\\\"></div>\\n                <div id=\\\"labels-container\\\">\\n                    <svg id=\\\"labels-svg\\\"></svg>\\n                    <div id=\\\"conversation-anchors-container\\\"></div>\\n                </div>\\n                \\x3c!-- Initial Load Magic Spinner (No Text) --\\x3e\\n                <div id=\\\"progressive-loading-pill\\\" class=\\\"progressive-loading-pill hidden\\\">\\n                    <span class=\\\"progressive-loading-spinner\\\"></span>\\n                </div>\\n            </div>\\n        </div>\\n        <div id=\\\"text-panel\\\"></div>\\n\\n        \\x3c!-- Mini Map --\\x3e\\n        <div id=\\\"mini-map-container\\\" title=\\\"Click to zoom out\\\">\\n            <img id=\\\"mini-map-bg\\\" src=\\\"\\\" alt=\\\"Mini Map\\\">\\n            <div id=\\\"mini-map-dots\\\"></div>\\n            <div id=\\\"mini-map-viewport\\\"></div>\\n        </div>\\n\\n        \\x3c!-- Step inside button (inline mode only) --\\x3e\\n        <button id=\\\"inline-virtual-tour-button\\\" style=\\\"display: none;\\\">\\n            <span class=\\\"tour-label\\\">Step inside</span>\\n        </button>\\n\\n        \\x3c!-- Onboarding Tooltip --\\x3e\\n        <div id=\\\"onboarding-tooltip\\\" style=\\\"display: none;\\\">\\n            <div class=\\\"tooltip-arrow\\\"></div>\\n            <div class=\\\"tooltip-content\\\">\\n                <div class=\\\"tooltip-title\\\">Select Hotspots to learn more</div>\\n                <div class=\\\"tooltip-description\\\">Choose any callouts or hotspots in the scene to zoom into the details</div>\\n            </div>\\n        </div>\\n\\n    </div>\\n\\n\\n\\n    \\x3c!-- Floating Loading Indicator --\\x3e\\n    <div id=\\\"lightbox-loading-indicator\\\" class=\\\"visible\\\">\\n        <span class=\\\"google-symbols spinner-icon\\\">progress_activity</span>\\n    </div>\\n\\n    \\x3c!-- Hidden container to hold canvases for mask detection --\\x3e\\n    <div id=\\\"mask-canvas-container\\\"></div>\\n\\n    <script>\\n        (() => {\\n\\\"use strict\\\";\\nwindow.DEEP_ZOOM_SHELL_ENV = 'prod';\\nwindow.DEEP_ZOOM_SHELL_VERSION = '1.0.0';\\nif (window.__DEEP_ZOOM_INITIALIZED__) {\\n  console.log('JS already initialized, skipping execution.');\\n  return;\\n}\\nwindow.__DEEP_ZOOM_INITIALIZED__ = true;\\n\\n/**\\n * @fileoverview Configuration placeholders, global runtime state, DOM references,\\n * safe-area clearance calculators, and transition timer tracking.\\n */\\n\\n// =========================================\\n// placeholder for the node data\\n// =========================================\\nconst nodesData = {};\\nlet rootId = '';\\nwindow.nodesData = nodesData;\\nwindow.rootId = rootId;\\nlet staticAudio = null;\\nif (typeof staticAudio === 'undefined') {\\n  staticAudio = null;\\n}\\nlet staticTimeline = (typeof null !== 'undefined') ?\\n    null :\\n    null;\\nconst staticConversationAnchors =\\n    (typeof null !== 'undefined') ?\\n    null :\\n    null;\\nlet sessionConversationAnchors = [];\\nlet activeConversationId = null;\\nlet conversationAnchorsContainer = null;\\n\\n// =========================================\\n// Production-Safe Logger Wrapper\\n// =========================================\\nconst enableDebugLogging = 'false' === 'true';\\nconst Logger = {\\n  log(...args) {\\n    if (enableDebugLogging) {\\n      console.log(...args);\\n    }\\n  },\\n  info(...args) {\\n    if (enableDebugLogging) {\\n      console.info(...args);\\n    }\\n  },\\n  warn(...args) {\\n    console.warn(...args);\\n  },\\n  error(...args) {\\n    console.error(...args);\\n  }\\n};\\n\\n// =========================================\\n// JavaScript interaction logic\\n// =========================================\\n/**\\n * Resolves the starting node ID from window globals or URL search params.\\n * @return {string}\\n */\\nfunction resolveStartingNodeId() {\\n  try {\\n    if (typeof window !== 'undefined') {\\n      if (window.__INITIAL_NODE_ID__) {\\n        return window.__INITIAL_NODE_ID__;\\n      }\\n      const urlParams = new URLSearchParams(window.location.search);\\n      const paramNodeId = urlParams.get('node_id') || urlParams.get('nodeId');\\n      if (paramNodeId) {\\n        return paramNodeId;\\n      }\\n      if (window.parent && window.parent !== window) {\\n        try {\\n          const parentParams = new URLSearchParams(window.parent.location.search);\\n          const parentNodeId = parentParams.get('node_id') || parentParams.get('nodeId');\\n          if (parentNodeId) {\\n            return parentNodeId;\\n          }\\n        } catch (e) {}\\n      }\\n    }\\n  } catch (e) {}\\n  return typeof rootId !== 'undefined' ? rootId : '0';\\n}\\nlet currentNodeId = resolveStartingNodeId();\\nlet isImmersiveMode = false;\\nlet isLightboxTransitioning = false;\\nlet activeTempImage = null;\\nlet pendingZoomChildId = null;\\nlet pendingLayerZoomChildId = null;\\nlet isProgressiveLoadingActive = false;\\nlet isTextPanelMinimized = false;\\nlet userCollapsedTextPanel = false;\\nlet customWidgetTitle =\\n    (typeof window !== 'undefined' && window.__CUSTOM_WIDGET_TITLE__) || '';\\n\\nconst CHEVRON_DOWN_SVG =\\n    '<svg width=\\\"24\\\" height=\\\"24\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"currentColor\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z\\\"/></svg>';\\nconst CHEVRON_UP_SVG =\\n    '<svg width=\\\"24\\\" height=\\\"24\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"currentColor\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6 1.41 1.41z\\\"/></svg>';\\nconst CLOSE_ICON_SVG =\\n    '<svg width=\\\"26\\\" height=\\\"26\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><line x1=\\\"18\\\" y1=\\\"6\\\" x2=\\\"6\\\" y2=\\\"18\\\"></line><line x1=\\\"6\\\" y1=\\\"6\\\" x2=\\\"18\\\" y2=\\\"18\\\"></line></svg>';\\nconst ARROW_BACK_SVG =\\n    '<svg width=\\\"24\\\" height=\\\"24\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"currentColor\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path d=\\\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z\\\"/></svg>';\\n\\nlet activePreloadedImages = [];\\nlet isMobileApp = false;\\nlet mobileTopSafeArea = 0;\\nlet mobileBottomSafeArea = 0;\\nlet hasDismissedOnboardingTooltip = false;\\nlet shouldPanToOnboarding = false;\\nlet nudgeTimeoutId = null;\\nlet nudgeReturnTimeoutId = null;\\nlet hasNudgedOrInteracted = false;\\nlet onboardingTooltipInitialX = null;\\nlet pinnedChildId = null;\\nlet suppressMouseLeave = false;\\nlet isAnimating = false;\\nlet activeTransitionTimeoutIds = [];\\nlet hoveringChildId = null;\\nlet labelDragListenerController = null;\\nlet currentImmersiveX = 0;\\nlet currentImmersiveY = 0;\\nlet currentImmersiveScale = 1;\\nlet recalculateLabelsTimerId = null;\\nlet tourPayload = null;\\nconst audioBlobCache = new Map();\\nlet resizeTimeout;\\nlet dragMoved = false;\\n\\n/**\\n * Computes the total top clearance (safe area + navigation toolbar + buffer)\\n * in screen pixels to prevent labels from colliding with top navigation buttons.\\n * @return {number} Top clearance in screen pixels.\\n */\\nfunction getTopNavClearancePx() {\\n  const isLandscape = window.innerWidth > window.innerHeight;\\n  const isWeb = !isMobileApp;\\n\\n  // Ignore top safe area for landscape and web during label computation\\n  if (isLandscape || isWeb) {\\n    return 10;\\n  }\\n\\n  const toolbar = document.getElementById('lightbox-toolbar');\\n  if (toolbar && toolbar.offsetParent !== null) {\\n    const toolbarRect = toolbar.getBoundingClientRect();\\n    const cRect = mainContainer ? mainContainer.getBoundingClientRect() : {top: 0};\\n    const toolbarBottomInContainer = toolbarRect.bottom - cRect.top;\\n    if (toolbarBottomInContainer > 0) {\\n      return toolbarBottomInContainer + 16; // 16px buffer below bottom edge of toolbar buttons\\n    }\\n  }\\n\\n  let safeArea = mobileTopSafeArea;\\n  if (!safeArea) {\\n    const cssSafeArea = parseInt(\\n        getComputedStyle(document.documentElement)\\n            .getPropertyValue('--mobile-top-safe-area'),\\n        10);\\n    if (!isNaN(cssSafeArea) && cssSafeArea > 0) {\\n      safeArea = cssSafeArea;\\n    }\\n  }\\n  const effectiveSafeArea = safeArea || (isMobileViewport() ? 50 : 20);\\n  const navBarHeight = 52;\\n  const buffer = 16;\\n  return effectiveSafeArea + navBarHeight + buffer;\\n}\\n\\n/**\\n * Computes the total bottom clearance (safe area + bottom sheet title/chevron +\\n * buffer) in screen pixels to prevent labels from colliding with bottom UI\\n * controls.\\n * @return {number} Bottom clearance in screen pixels from viewport bottom.\\n */\\nfunction getBottomClearancePx() {\\n  const isLandscape = window.innerWidth > window.innerHeight;\\n  const isMobile = isMobileViewport() || isMobileApp;\\n\\n  // On landscape, UI is arranged horizontally / at corners with minimal bottom\\n  // interference\\n  if (isLandscape) {\\n    let safeArea = mobileBottomSafeArea;\\n    if (!safeArea) {\\n      const cssSafeArea = parseInt(\\n          getComputedStyle(document.documentElement)\\n              .getPropertyValue('--mobile-bottom-safe-area'),\\n          10);\\n      if (!isNaN(cssSafeArea) && cssSafeArea > 0) {\\n        safeArea = cssSafeArea;\\n      }\\n    }\\n    return Math.max(16, (safeArea || 0) + 12);\\n  }\\n\\n  // On desktop / non-mobile:\\n  if (!isMobile) {\\n    const tourOverlay = document.getElementById('tour-overlay');\\n    if (tourOverlay && tourOverlay.offsetParent !== null &&\\n        getComputedStyle(tourOverlay).display !== 'none') {\\n      const cRect = mainContainer ? mainContainer.getBoundingClientRect() :\\n                                    {bottom: window.innerHeight};\\n      const tRect = tourOverlay.getBoundingClientRect();\\n      const clearance = cRect.bottom - tRect.top;\\n      if (clearance > 0) return clearance + 20;\\n    }\\n    return 30;  // Clean margin for desktop canvas bottom\\n  }\\n\\n  // On mobile portrait:\\n  const cRect = mainContainer ? mainContainer.getBoundingClientRect() :\\n                                {bottom: window.innerHeight};\\n\\n  // 1. If tour overlay is active / visible\\n  const tourOverlay = document.getElementById('tour-overlay');\\n  if (tourOverlay && tourOverlay.offsetParent !== null &&\\n      getComputedStyle(tourOverlay).display !== 'none') {\\n    const tRect = tourOverlay.getBoundingClientRect();\\n    const clearance = cRect.bottom - tRect.top;\\n    if (clearance > 0) {\\n      return clearance + 24;\\n    }\\n  }\\n\\n  // Safe area calculation\\n  let safeArea = mobileBottomSafeArea;\\n  if (!safeArea) {\\n    const cssSafeArea = parseInt(\\n        getComputedStyle(document.documentElement)\\n            .getPropertyValue('--mobile-bottom-safe-area'),\\n        10);\\n    if (!isNaN(cssSafeArea) && cssSafeArea > 0) {\\n      safeArea = cssSafeArea;\\n    }\\n  }\\n  const effectiveSafeArea = safeArea || 20;\\n\\n  // 2. Check text-panel state\\n  const textPanel = document.getElementById('text-panel');\\n  if (textPanel && textPanel.offsetParent !== null &&\\n      !textPanel.classList.contains('hidden') &&\\n      getComputedStyle(textPanel).display !== 'none') {\\n    // If text panel is minimized / collapsed:\\n    if (textPanel.classList.contains('minimized') || isTextPanelMinimized) {\\n      const collapsedHeaderHeight = 54;\\n      const bottomOffset = 20;\\n      const buffer = 28;\\n      return effectiveSafeArea + bottomOffset + collapsedHeaderHeight + buffer;\\n    } else {\\n      // Text panel is EXPANDED: clear the whole panel\\n      const tpRect = textPanel.getBoundingClientRect();\\n      const clearance = cRect.bottom - tpRect.top;\\n      if (clearance > 0) {\\n        return clearance + 20;\\n      }\\n    }\\n  }\\n\\n  // 3. Fallback calculation for mobile portrait (assumes collapsed state)\\n  const collapsedHeaderHeight = 54;\\n  const bottomOffset = 20;\\n  const buffer = 28;\\n  return effectiveSafeArea + bottomOffset + collapsedHeaderHeight + buffer;\\n}\\n\\n/**\\n * Forces immediate release of an HTMLImageElement's decoded GPU texture.\\n * @param {?HTMLImageElement} img\\n */\\nfunction releaseImageElement(img) {\\n  if (!img || img === mainImage) return;\\n  img.onload = null;\\n  img.onerror = null;\\n  if (mainImage &&\\n      (img.src === mainImage.src || img.src === mainImage.currentSrc)) {\\n    return;\\n  }\\n  img.src = '';\\n}\\n\\n/**\\n * Evicts all preloaded HTMLImageElement instances and releases their GPU textures.\\n */\\nfunction evictPreloadedImages() {\\n  for (const img of activePreloadedImages) {\\n    releaseImageElement(img);\\n  }\\n  activePreloadedImages = [];\\n  if (regionHighlight && regionHighlight.style.opacity === '0') {\\n    regionHighlight.style.backgroundImage = 'none';\\n    regionHighlight.style.webkitMaskImage = 'none';\\n    regionHighlight.style.maskImage = 'none';\\n  }\\n}\\n\\n/**\\n * Rewrites FIFE image URLs (lh3.googleusercontent.com) to request a lightweight\\n * 320px thumbnail for the minimap instead of a 4K (=s0) texture.\\n * @param {string} src\\n * @return {string}\\n */\\nfunction getMinimapImageUrl(src) {\\n  if (!src || typeof src !== 'string') return '';\\n  if (src.includes('googleusercontent.com/')) {\\n    if (/=[swh]\\\\d+[^/]*$/.test(src)) {\\n      return src.replace(/=[swh]\\\\d+[^/]*$/, '=w320');\\n    }\\n    if (!src.includes('=')) {\\n      return src + '=w320';\\n    }\\n  }\\n  return src;\\n}\\n\\n/**\\n * Preloads an asset and pins it in memory to prevent garbage collection.\\n * @param {string} src\\n * @return {!Promise<?HTMLImageElement>}\\n */\\nconst preloadAsset = (src) => {\\n  return new Promise(resolve => {\\n    const img = new Image();\\n    img.onload = () => {\\n      activePreloadedImages.push(img); // Pin in memory\\n      resolve(img);\\n    };\\n    img.onerror = () => resolve(null);\\n    img.src = src;\\n  });\\n};\\n\\n{\\n  document.body.classList.add(\\n      'immersive-config-active',\\n      'label-visibility-in-immersive-lightbox-always',\\n      'text-below',\\n      'text-visible-in-lightbox');\\n  const inlineExploreBtn = document.getElementById('inline-explore-button');\\n  if (inlineExploreBtn) {\\n    const iconSpan = inlineExploreBtn.querySelector('.explore-icon');\\n    if (iconSpan) {\\n      iconSpan.textContent = 'expand_content';\\n    }\\n    inlineExploreBtn.classList.add('immersive-style');\\n  }\\n\\n  // Display the inline CTA button to encourage lightbox expansion\\n  const tourBtn = document.getElementById('inline-virtual-tour-button');\\n  if (tourBtn) {\\n    tourBtn.style.display = 'flex';\\n    tourBtn.addEventListener('click', (e) => {\\n      e.stopPropagation();\\n      if (typeof handleFirstClick === 'function') {\\n        handleFirstClick(e);\\n      }\\n    });\\n  }\\n}\\n\\n/**\\n * Registers and tracks a transition timeout.\\n * @param {!Function} callback\\n * @param {number} delay\\n * @return {number}\\n */\\nfunction setTrackedTimeout(callback, delay) {\\n  const id = setTimeout(() => {\\n    activeTransitionTimeoutIds = activeTransitionTimeoutIds.filter(t => t !== id);\\n    if (!isAnimating) return;\\n    callback();\\n  }, delay);\\n  activeTransitionTimeoutIds.push(id);\\n  return id;\\n}\\n\\n/**\\n * Clears all active transition timeouts and removes active temporary animation elements.\\n */\\nfunction clearActiveTransitions() {\\n  activeTransitionTimeoutIds.forEach(id => clearTimeout(id));\\n  activeTransitionTimeoutIds = [];\\n  if (activeTempImage) {\\n    releaseImageElement(activeTempImage);\\n    activeTempImage.remove();\\n    activeTempImage = null;\\n  }\\n  evictPreloadedImages();\\n  const oldOverlay = document.getElementById('video-transition-overlay');\\n  if (oldOverlay) oldOverlay.remove();\\n  const oldSkipBtn = document.getElementById('video-transition-skip-btn');\\n  if (oldSkipBtn) oldSkipBtn.remove();\\n}\\n\\n// Durations and curves\\nconst STANDARD_ZOOM_DURATION_MS = 500;\\nconst LATERAL_NAVIGATION_DURATION_MS = 400;\\nconst UI_FADE_MS = 200;\\nconst ASYNC_DELAY_MS = 50;\\nconst MASK_BLUR_RADIUS_PX = 48;\\nconst MAX_MASK_CANVAS_DIM = 256;\\nconst IMMERSIVE_ZOOM_BUFFER = 1.1;\\nconst BEZIER_SMOOTH = 'cubic-bezier(0.5, 0, 0.5, 1)';\\nconst BEZIER_SNAPPY = 'cubic-bezier(0.31, 0.94, 0.34, 1)';\\n\\n// Transitions\\nconst UI_ELEMENT_FADE_IN = `opacity ${UI_FADE_MS}ms ${BEZIER_SNAPPY}`;\\nconst TRANSITION_STANDARD_ZOOM = `transform ${STANDARD_ZOOM_DURATION_MS}ms ${BEZIER_SMOOTH}`;\\nconst TRANSITION_IMAGE_DEFAULT = `opacity 150ms ${BEZIER_SMOOTH}, ${TRANSITION_STANDARD_ZOOM}`;\\n\\nconst mainImage = document.getElementById('main-image');\\nconst maskContainer = document.getElementById('mask-canvas-container');\\nconst mainContainer = document.getElementById('main-image-container');\\nconst urlTooltip = document.getElementById('url-tooltip');\\nconst labelsContainer = document.getElementById('labels-container');\\nconst labelsSvg = document.getElementById('labels-svg');\\nconst textPanel = document.getElementById('text-panel');\\nif (textPanel && typeof ResizeObserver !== 'undefined') {\\n  const textPanelObserver = new ResizeObserver((entries) => {\\n    for (const entry of entries) {\\n      const height = entry.target.offsetHeight;\\n      document.documentElement.style.setProperty(\\n          '--text-panel-height', `${height}px`);\\n    }\\n  });\\n  textPanelObserver.observe(textPanel);\\n}\\nconst regionHighlight = document.getElementById('region-highlight');\\nconst lightboxZoomOutBtn = document.getElementById('lightbox-zoom-out-button');\\n\\nif (lightboxZoomOutBtn) {\\n  lightboxZoomOutBtn.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    dismissOnboardingTooltip();\\n    if (isAnimating) return;\\n    lightboxZoomOutBtn.classList.remove('lightbox-zoom-out-button--visible');\\n    const currentNode = nodesData[currentNodeId];\\n    if (currentNode && currentNode.parentId) {\\n      zoomToParent(currentNode.parentId, currentNodeId);\\n    } else {\\n      renderNode(rootId);\\n    }\\n  });\\n}\\n\\nconst miniMapContainer = document.getElementById('mini-map-container');\\nconst miniMapBg = document.getElementById('mini-map-bg');\\nconst miniMapViewport = document.getElementById('mini-map-viewport');\\n\\nif (miniMapBg) {\\n  miniMapBg.addEventListener('dragstart', (e) => {\\n    e.preventDefault();\\n  });\\n\\n  /** Updates the minimap layout once the image loads. */\\n  miniMapBg.onload = () => {\\n    updateMinimapLayout();\\n  };\\n}\\n\\n/**\\n * Sets up the minimap container size matching the loaded image aspect ratio.\\n */\\nconst updateMinimapLayout = () => {\\n  if (!miniMapBg || !miniMapContainer) return;\\n  const naturalWidth = miniMapBg.naturalWidth;\\n  const naturalHeight = miniMapBg.naturalHeight;\\n  if (naturalWidth && naturalHeight) {\\n    const AR = naturalWidth / naturalHeight;\\n    const computedStyle = window.getComputedStyle(miniMapContainer);\\n    const maxWidth =\\n        parseFloat(computedStyle.getPropertyValue('--minimap-max-width')) ||\\n        160;\\n    const maxHeight =\\n        parseFloat(computedStyle.getPropertyValue('--minimap-max-height')) ||\\n        90;\\n\\n    let width = maxWidth;\\n    let height = maxHeight;\\n\\n    if (AR > (maxWidth / maxHeight)) {\\n      width = maxWidth;\\n      height = maxWidth / AR;\\n    } else {\\n      height = maxHeight;\\n      width = maxHeight * AR;\\n    }\\n\\n    miniMapContainer.style.width = `${width}px`;\\n    miniMapContainer.style.height = `${height}px`;\\n    miniMapContainer.style.setProperty('--minimap-width', `${width}px`);\\n    miniMapContainer.style.setProperty('--minimap-height', `${height}px`);\\n\\n    renderMinimapDots(naturalWidth, naturalHeight);\\n    syncMinimapViewport();\\n  }\\n};\\n\\nlet isDragging = false;\\nlet isPinching = false;\\nlet pinchStartDistance = 0;\\nlet pinchStartScale = 1;\\nlet pinchStartMidpoint = {x: 0, y: 0};\\nlet dragUiHidden = false;\\nlet dragStartX = 0;\\nlet dragStartY = 0;\\nlet dX = 0;\\nlet dY = 0;\\n\\n// Find if the node has no child nodes with labels\\n/**\\n// Find adjacent siblings for the given node\\n/**\\n * Finds neighbors.\\n * @param {string} nodeId\\n * @return {!Object}\\n */\\n/** Hides UI. */\\n\\n\\n/**\\n * @fileoverview Client & Host PostMessage IPC Bridge (`client_ipc_bridge.js`).\\n * Centralizes all inbound `window.addEventListener('message')` handlers into a\\n * single deterministic message router (`handleHostMessage`) and manages\\n * outbound `window.parent.postMessage` / WebKit native bridge calls between the\\n * shell iframe and host clients (Gemini Web, Android WebView, iOS WKWebView,\\n * Dev Server):\\n *   - `isMobileApp` / `setIsMobileApp`\\n *   - `topSafeArea` / `bottomSafeArea` / `leftSafeArea` / `rightSafeArea`\\n *   - `initLightboxMode` / `initInlineMode` / `setWidgetTitle`\\n *   - `navigateToNode` / `selectNode`\\n *   - `lightboxInlineConversationVisibilityChange` /\\n * `lightboxShareVisibilityChange` / `lightboxBackButtonVisibilityChange` /\\n * `requestFeedback`\\n *   - Outbound `lightboxFullscreenRequest`, `lightboxMinimizeRequest`,\\n * `lightboxShareRequest`, `lightboxInlineConversationRequest`\\n */\\n\\nlet handleFirstClick = null;\\nlet isInlineModeRestricted =\\n    (typeof window !== 'undefined' && window.__IS_INLINE_MODE__ === true) ||\\n    false;\\nif (isInlineModeRestricted) {\\n  document.body.classList.add('inline-mode-restricted');\\n}\\nlet globalLabelDraggingActive = false;\\nlet labelDragTimeoutId = null;\\n\\n/**\\n * Handles the first click to activate lightbox.\\n * @param {!Event} e\\n */\\nhandleFirstClick = (e) => {\\n  if (globalLabelDraggingActive) {\\n    return;\\n  }\\n\\n  const isInteractiveTarget = e.target.closest('.label') ||\\n      e.target.closest('.anchor-dot') ||\\n      e.target.closest('.anchor-dot-group') ||\\n      e.target.closest('.label-line-hit-target') ||\\n      e.target.closest('.anchor-dot-hit-target');\\n\\n  const shouldPassThrough = isMobileApp || isInteractiveTarget;\\n\\n  if (!shouldPassThrough) {\\n    e.stopPropagation();\\n  }\\n\\n  if (window.parent) {\\n    window.parent.postMessage({ type: 'lightboxFullscreenRequest' }, '*');\\n  }\\n\\n  if (isInlineModeRestricted) {\\n    return;\\n  }\\n\\n  document.body.classList.add('lightbox-active', 'minimap-lightbox-active');\\n  document.removeEventListener('click', handleFirstClick, true);\\n  updateNavigationControls();\\n};\\n\\n// Create toolbar\\nif (!document.getElementById('lightbox-toolbar')) {\\n  const toolbar = document.createElement('div');\\n  toolbar.id = 'lightbox-toolbar';\\n\\n  // Left container (Back Arrow + Breadcrumbs)\\n  const toolbarLeft = document.createElement('div');\\n  toolbarLeft.className = 'toolbar-left';\\n\\n  const backArrow = document.createElement('div');\\n  backArrow.id = 'lightbox-back-arrow';\\n  backArrow.innerHTML = ARROW_BACK_SVG;\\n  backArrow.classList.add('lightbox-back-arrow--hidden');\\n  toolbarLeft.appendChild(backArrow);\\n\\n  const breadcrumbs = document.createElement('div');\\n  breadcrumbs.id = 'viewer-header-breadcrumbs';\\n  toolbarLeft.appendChild(breadcrumbs);\\n\\n  toolbar.appendChild(toolbarLeft);\\n\\n  // Right container (Feedback + Share + Collapse)\\n  const toolbarRight = document.createElement('div');\\n  toolbarRight.className = 'toolbar-right';\\n\\n  const feedbackShareGroup =\\n      document.getElementById('lightbox-feedback-share-group');\\n  if (feedbackShareGroup) {\\n    toolbarRight.appendChild(feedbackShareGroup);\\n  }\\n\\n  const collapseButton = document.createElement('button');\\n  collapseButton.id = 'lightbox-collapse-button';\\n  collapseButton.innerHTML = CLOSE_ICON_SVG;\\n  collapseButton.setAttribute('aria-label', 'Close');\\n  collapseButton.addEventListener('click', (e) => {\\n    e.preventDefault();\\n    e.stopPropagation();\\n    collapseLightbox();\\n  });\\n  toolbarRight.appendChild(collapseButton);\\n\\n  toolbar.appendChild(toolbarRight);\\n  document.body.appendChild(toolbar);\\n}\\n\\n/**\\n * Collapses the lightbox view.\\n */\\nconst collapseLightbox = () => {\\n  clearActiveTransitions();\\n  isAnimating = false;\\n  cancelNudge();\\n  if (typeof exitConversationInteractionMode === 'function') {\\n    exitConversationInteractionMode(/* opt_notifyParent= */ false);\\n  }\\n  if (window.parent) {\\n    window.parent.postMessage({ type: 'lightboxMinimizeRequest' }, '*');\\n  }\\n  // Delay the internal UI teardown so the iframe stays in fullscreen\\n  // dark mode while the parent dialog fades out. Without this delay,\\n  // the iframe instantly switches to inline mode (white background)\\n  // before the parent can react, causing a visible white flash.\\n  //\\n  // The 250ms value is intentionally coupled to the Angular dialog's\\n  // exitAnimationDuration (200ms) in deepzoom.ts, with 50ms headroom\\n  // for slower devices.\\n  setTimeout(() => {\\n    document.body.classList.remove('lightbox-active', 'immersive-active');\\n    isImmersiveMode = false;\\n    renderNode(rootId);\\n    document.addEventListener('click', handleFirstClick, true);\\n  }, 250);\\n};\\n\\nconst inlineConversationButton =\\n    document.getElementById('lightbox-inline-conversation-button');\\nconst shareButton = document.getElementById('lightbox-share-button');\\nconst feedbackButton = document.getElementById('lightbox-feedback-button');\\nconst backArrow = document.getElementById('lightbox-back-arrow');\\nconst collapseButton = document.getElementById('lightbox-collapse-button');\\n\\nif (inlineConversationButton) {\\n  inlineConversationButton.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    if (window.parent) {\\n      window.parent.postMessage(\\n          {type: 'lightboxInlineConversationRequest'}, '*');\\n    }\\n  });\\n}\\n\\nif (shareButton) {\\n  shareButton.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    if (window.parent) {\\n      window.parent.postMessage({type: 'lightboxShareRequest'}, '*');\\n    }\\n  });\\n}\\n\\nif (feedbackButton) {\\n  feedbackButton.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    if (typeof window.emitUserInteraction === 'function') {\\n      window.emitUserInteraction('FEEDBACK_OPEN');\\n    }\\n    if (typeof openFeedbackModal === 'function') {\\n      openFeedbackModal();\\n    }\\n  });\\n}\\n\\nif (backArrow) {\\n  backArrow.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    collapseLightbox();\\n  });\\n}\\n\\nif (collapseButton) {\\n  collapseButton.addEventListener('click', (e) => {\\n    e.stopPropagation();\\n    collapseLightbox();\\n  });\\n}\\n\\n// Global delegation fallback for close button\\ndocument.addEventListener('click', (e) => {\\n  if (e.target && (e.target.id === 'lightbox-collapse-button' || e.target.closest('#lightbox-collapse-button'))) {\\n    e.stopPropagation();\\n    collapseLightbox();\\n  }\\n});\\n\\n/**\\n * Unified message router for all inbound host PostMessage events.\\n * @param {!MessageEvent} event\\n */\\nfunction handleHostMessage(event) {\\n  if (!event.data || typeof event.data.type !== 'string') return;\\n  const data = event.data;\\n\\n  switch (data.type) {\\n    case 'isMobileApp':\\n    case 'setIsMobileApp': {\\n      const isMobileVal = data.value === true || data.isMobileApp === true;\\n      isMobileApp = isMobileVal;\\n      Logger.log('Set isMobileApp to:', isMobileApp);\\n      if (isMobileApp) {\\n        document.body.classList.add('is-mobile-app');\\n      } else {\\n        document.body.classList.remove('is-mobile-app');\\n      }\\n      renderLabels();\\n      break;\\n    }\\n\\n    case 'mobileTopSafeArea':\\n    case 'topSafeArea':\\n    case 'setTopSafeArea': {\\n      const rawVal = data.height !== undefined ?\\n          data.height :\\n          (data.value !== undefined ? data.value : data.topSafeArea);\\n      const value = parseInt(rawVal, 10);\\n      if (!isNaN(value)) {\\n        mobileTopSafeArea = value;\\n        document.documentElement.style.setProperty(\\n            '--mobile-top-safe-area', `${value}px`);\\n        Logger.log('Set --mobile-top-safe-area to:', value);\\n        renderLabels();\\n      }\\n      break;\\n    }\\n\\n    case 'mobileBottomSafeArea':\\n    case 'bottomSafeArea':\\n    case 'setBottomSafeArea': {\\n      const rawVal = data.height !== undefined ?\\n          data.height :\\n          (data.value !== undefined ? data.value : data.bottomSafeArea);\\n      const value = parseInt(rawVal, 10);\\n      if (!isNaN(value)) {\\n        mobileBottomSafeArea = value;\\n        document.documentElement.style.setProperty(\\n            '--mobile-bottom-safe-area', `${value}px`);\\n        Logger.log('Set --mobile-bottom-safe-area to:', value);\\n        renderLabels();\\n      }\\n      break;\\n    }\\n\\n    case 'mobileLeftSafeArea':\\n    case 'leftSafeArea':\\n    case 'setLeftSafeArea': {\\n      const rawVal = data.width !== undefined ?\\n          data.width :\\n          (data.value !== undefined ? data.value : data.leftSafeArea);\\n      const value = parseInt(rawVal, 10);\\n      if (!isNaN(value)) {\\n        document.documentElement.style.setProperty(\\n            '--mobile-left-safe-area', `${value}px`);\\n        Logger.log('Set --mobile-left-safe-area to:', value);\\n        renderLabels();\\n      }\\n      break;\\n    }\\n\\n    case 'mobileRightSafeArea':\\n    case 'rightSafeArea':\\n    case 'setRightSafeArea': {\\n      const rawVal = data.width !== undefined ?\\n          data.width :\\n          (data.value !== undefined ? data.value : data.rightSafeArea);\\n      const value = parseInt(rawVal, 10);\\n      if (!isNaN(value)) {\\n        document.documentElement.style.setProperty(\\n            '--mobile-right-safe-area', `${value}px`);\\n        Logger.log('Set --mobile-right-safe-area to:', value);\\n        renderLabels();\\n      }\\n      break;\\n    }\\n\\n    case 'initLightboxMode': {\\n      isInlineModeRestricted = false;\\n      document.body.classList.remove('inline-mode-restricted');\\n      document.body.classList.add('lightbox-active', 'minimap-lightbox-active');\\n      document.removeEventListener('click', handleFirstClick, true);\\n      if (typeof updateNavigationControls === 'function') {\\n        updateNavigationControls();\\n      }\\n\\n      const targetNodeId = data.node_id || data.nodeId;\\n      if (!isImmersiveMode) {\\n        if (targetNodeId && typeof nodesData !== 'undefined' && nodesData && nodesData[targetNodeId]) {\\n          currentNodeId = targetNodeId;\\n        }\\n        isImmersiveMode = true;\\n        userCollapsedTextPanel = false;\\n        isLightboxTransitioning = true;\\n        shouldPanToOnboarding = true;\\n\\n        if (nudgeTimeoutId) clearTimeout(nudgeTimeoutId);\\n        if (nudgeReturnTimeoutId) clearTimeout(nudgeReturnTimeoutId);\\n        nudgeTimeoutId = null;\\n        nudgeReturnTimeoutId = null;\\n        hasNudgedOrInteracted = false;\\n\\n        document.body.classList.add('immersive-active');\\n        const header = document.getElementById('immersive-header');\\n        if (header) {\\n          header.style.display = 'flex';\\n        }\\n\\n        // Hide labels/dots instantly during the transition to avoid jank\\n        if (labelsContainer) labelsContainer.classList.add('hidden-instant');\\n        if (labelsSvg) labelsSvg.classList.add('hidden-instant');\\n\\n        renderNode(currentNodeId);\\n\\n        // Disable transition temporarily so the initial pan snaps instantly\\n        const oldImageTransition = mainImage.style.transition;\\n        mainImage.style.transition = 'none';\\n        if (labelsContainer) labelsContainer.style.transition = 'none';\\n\\n        // Reposition viewport instantly to focus on onboarding dot\\n        resetImmersiveViewport();\\n\\n        // Force layout reflow to register the instant position change\\n        void mainImage.offsetWidth;\\n\\n        // Restore transition styles for subsequent movements\\n        mainImage.style.transition = oldImageTransition;\\n        if (labelsContainer) labelsContainer.style.transition = '';\\n\\n        // Force viewport reset and show dots after the image transition completes.\\n        let transitioned = false;\\n        const onTransitionEnd = (e) => {\\n          if (e && e.target !== mainImage) return;\\n          if (transitioned) return;\\n          transitioned = true;\\n          mainImage.removeEventListener('transitionend', onTransitionEnd);\\n          Logger.log('Image transition completed, initializing immersive layout');\\n\\n          isLightboxTransitioning = false;\\n          resetImmersiveViewport();\\n\\n          // Fade them back in smoothly\\n          if (labelsContainer) labelsContainer.classList.remove('hidden-instant');\\n          if (labelsSvg) labelsSvg.classList.remove('hidden-instant');\\n\\n          showOnboardingTooltip();\\n          startNudgeTimer();\\n\\n          executePendingZoom();\\n        };\\n\\n        mainImage.addEventListener('transitionend', onTransitionEnd);\\n        setTimeout(onTransitionEnd, 600); // Failsafe fallback\\n      } else {\\n        if (targetNodeId && typeof nodesData !== 'undefined' && nodesData && nodesData[targetNodeId]) {\\n          if (currentNodeId !== targetNodeId) {\\n            renderNode(targetNodeId);\\n          }\\n        } else if (!targetNodeId && typeof rootId !== 'undefined') {\\n          if (currentNodeId !== rootId) {\\n            renderNode(rootId);\\n          }\\n        }\\n        const node = (nodesData && nodesData[currentNodeId]) || (nodesData && nodesData[rootId]);\\n        if (node) updateTextPanel(node.text, currentNodeId);\\n      }\\n      break;\\n    }\\n\\n    case 'initInlineMode': {\\n      if (data.title) {\\n        customWidgetTitle = data.title;\\n        window.customWidgetTitle = customWidgetTitle;\\n      }\\n      isInlineModeRestricted = true;\\n      document.body.classList.add('inline-mode-restricted');\\n      document.body.classList.remove(\\n          'lightbox-active', 'immersive-active', 'minimap-lightbox-active');\\n      isImmersiveMode = false;\\n      if (miniMapContainer) {\\n        miniMapContainer.style.display = 'none';\\n      }\\n      const targetNodeId = data.node_id || data.nodeId;\\n      if (targetNodeId && typeof nodesData !== 'undefined' && nodesData && nodesData[targetNodeId]) {\\n        if (currentNodeId !== targetNodeId) {\\n          renderNode(targetNodeId);\\n        } else {\\n          updateTextPanel(nodesData[currentNodeId].text, currentNodeId);\\n        }\\n      } else if (!targetNodeId && typeof rootId !== 'undefined') {\\n        if (currentNodeId !== rootId) {\\n          renderNode(rootId);\\n        } else if (nodesData && nodesData[rootId]) {\\n          updateTextPanel(nodesData[rootId].text, rootId);\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'setWidgetTitle': {\\n      if (data.title) {\\n        customWidgetTitle = data.title;\\n        window.customWidgetTitle = customWidgetTitle;\\n        if (isInlineModeRestricted && typeof rootId !== 'undefined' &&\\n            String(currentNodeId) === String(rootId)) {\\n          const node = nodesData && nodesData[rootId];\\n          if (node) updateTextPanel(node.text, rootId);\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'navigateToNode':\\n    case 'selectNode': {\\n      const targetNodeId = data.node_id || data.nodeId;\\n      if (targetNodeId && typeof nodesData !== 'undefined' && nodesData && nodesData[targetNodeId]) {\\n        if (currentNodeId !== targetNodeId) {\\n          renderNode(targetNodeId);\\n        }\\n      } else if (!targetNodeId && typeof rootId !== 'undefined') {\\n        if (currentNodeId !== rootId) {\\n          renderNode(rootId);\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'lightboxInlineConversationVisibilityChange': {\\n      const inlineConvBtn =\\n          document.getElementById('lightbox-inline-conversation-button');\\n      if (inlineConvBtn) {\\n        if (data.action === 'hide') {\\n          inlineConvBtn.classList.add(\\n              'lightbox-inline-conversation-button--hidden');\\n        } else if (data.action === 'show') {\\n          inlineConvBtn.classList.remove(\\n              'lightbox-inline-conversation-button--hidden');\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'lightboxShareVisibilityChange': {\\n      const shareBtn = document.getElementById('lightbox-share-button');\\n      if (shareBtn) {\\n        if (data.action === 'hide') {\\n          shareBtn.classList.add('lightbox-share-button--hidden');\\n        } else if (data.action === 'show') {\\n          shareBtn.classList.remove('lightbox-share-button--hidden');\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'lightboxBackButtonVisibilityChange': {\\n      const backBtn = document.getElementById('lightbox-back-arrow');\\n      if (backBtn) {\\n        if (data.action === 'hide') {\\n          backBtn.classList.add('lightbox-back-arrow--hidden');\\n        } else if (data.action === 'show') {\\n          backBtn.classList.remove('lightbox-back-arrow--hidden');\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'requestFeedback': {\\n      const feedbackBtn = document.getElementById('lightbox-feedback-button');\\n      const shouldShow =\\n          data.action === 'show' || data.visible === true || data.enabled === true;\\n      if (feedbackBtn) {\\n        if (shouldShow) {\\n          feedbackBtn.classList.remove('lightbox-feedback-button--hidden');\\n          feedbackBtn.style.display = '';\\n        } else {\\n          feedbackBtn.classList.add('lightbox-feedback-button--hidden');\\n          feedbackBtn.style.display = 'none';\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'supplementaldataupdate': {\\n      loadDeepZoomData(data.detail || data.data || data);\\n      break;\\n    }\\n\\n    case 'getCanvasMetrics':\\n    case 'requestCanvasMetrics': {\\n      if (typeof emitCanvasMetrics === 'function') {\\n        emitCanvasMetrics();\\n      }\\n      break;\\n    }\\n\\n    case 'resetWorldState': {\\n      resetWorldState();\\n      break;\\n    }\\n\\n    case 'setProgressiveLoadingState': {\\n      const isLoading = Boolean(\\n          (data.detail && data.detail.isLoading !== undefined) ?\\n              data.detail.isLoading :\\n              data.loading);\\n      setProgressiveLoadingIndicator(isLoading);\\n      break;\\n    }\\n\\n    case 'addConversationAnchor': {\\n      const anchorData = data.anchor || data;\\n      if (typeof normalizeAnchor === 'function' &&\\n          typeof addOrUpdateConversationAnchor === 'function') {\\n        const normalized = normalizeAnchor(anchorData);\\n        if (normalized) {\\n          addOrUpdateConversationAnchor(normalized);\\n          if (typeof renderConversationAnchors === 'function') {\\n            renderConversationAnchors();\\n          }\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'removeConversationAnchor': {\\n      const convId = data.conversationId || data.conversation_id || data.id;\\n      if (convId && typeof removeConversationAnchor === 'function') {\\n        removeConversationAnchor(convId);\\n        if (typeof renderConversationAnchors === 'function') {\\n          renderConversationAnchors();\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'setConversationAnchors': {\\n      const rawAnchors = data.anchors || data.conversationAnchors;\\n      if (Array.isArray(rawAnchors) && typeof normalizeAnchor === 'function' &&\\n          typeof addOrUpdateConversationAnchor === 'function') {\\n        sessionConversationAnchors = [];\\n        rawAnchors.forEach(a => {\\n          const norm = normalizeAnchor(a);\\n          if (norm) addOrUpdateConversationAnchor(norm);\\n        });\\n        if (typeof renderConversationAnchors === 'function') {\\n          renderConversationAnchors();\\n        }\\n      }\\n      break;\\n    }\\n\\n    case 'closeInlineConversation': {\\n      if (typeof exitConversationInteractionMode === 'function') {\\n        exitConversationInteractionMode(/* opt_notifyParent= */ false);\\n      }\\n      break;\\n    }\\n\\n    case 'setInlineConversationActive': {\\n      const convId = data.conversationId || data.conversation_id;\\n      if (convId) {\\n        if (typeof getAnchorsForCurrentNode === 'function' &&\\n            typeof enterConversationInteractionMode === 'function') {\\n          const anchors = getAnchorsForCurrentNode();\\n          const targetAnchor =\\n              anchors.find(a => String(a.conversationId) === String(convId));\\n          if (targetAnchor) {\\n            enterConversationInteractionMode(\\n                targetAnchor, null, /* opt_notifyParent= */ false);\\n          }\\n        }\\n      } else if (typeof exitConversationInteractionMode === 'function') {\\n        exitConversationInteractionMode(/* opt_notifyParent= */ false);\\n      }\\n      break;\\n    }\\n    default:\\n      break;\\n  }\\n}\\n\\n/**\\n * Updates the visibility of the progressive loading pill indicator.\\n * @param {boolean} loading Whether data hydration is currently in progress.\\n */\\nfunction setProgressiveLoadingIndicator(loading) {\\n  isProgressiveLoadingActive = Boolean(loading);\\n  const pill = document.getElementById('progressive-loading-pill');\\n  if (!pill) return;\\n  if (loading) {\\n    pill.classList.remove('hidden');\\n  } else {\\n    pill.classList.add('hidden');\\n  }\\n}\\n\\n/**\\n * Smoothly updates the loading spinner state of existing label DOM elements\\n * in-place without recreating DOM nodes or restarting CSS animations.\\n */\\nfunction updateLabelReadyStatesInPlace() {\\n  if (!currentNodeId || !nodesData[currentNodeId]) return;\\n  const currentNode = nodesData[currentNodeId];\\n  (currentNode.childrenIds || []).forEach((childId) => {\\n    const childNode = nodesData[childId];\\n    if (!childNode) return;\\n    const isChildLayerReady = !childNode.childrenIds ||\\n        childNode.childrenIds.length === 0 ||\\n        childNode.childrenIds.every((gcId) => Boolean(nodesData[gcId]));\\n    const labelEl = document.getElementById(`label-${childId}`);\\n    if (!labelEl) return;\\n    if (isChildLayerReady) {\\n      labelEl.classList.remove('label-loading', 'label-loading-pending');\\n      const spinnerEl = labelEl.querySelector('.label-spinner');\\n      if (spinnerEl && !spinnerEl.classList.contains('label-spinner-done')) {\\n        spinnerEl.classList.add('label-spinner-done');\\n        setTimeout(() => spinnerEl.remove(), 250);\\n      }\\n    }\\n  });\\n}\\n\\n/**\\n * Resets all active world state, clearing nodesData, animations, and DOM\\n * overlays so the shell can switch to a new world or re-hydrate cleanly.\\n */\\nfunction resetWorldState() {\\n  if (typeof clearActiveTransitions === 'function') {\\n    clearActiveTransitions();\\n  }\\n  isAnimating = false;\\n  isLightboxTransitioning = false;\\n  isDragging = false;\\n  pendingLayerZoomChildId = null;\\n  pendingZoomChildId = null;\\n  pinnedChildId = null;\\n  hoveringChildId = null;\\n  currentNodeId = null;\\n  rootId = '';\\n  window.rootId = '';\\n\\n  if (typeof nodesData === 'object' && nodesData !== null) {\\n    for (const key of Object.keys(nodesData)) {\\n      delete nodesData[key];\\n    }\\n  }\\n\\n  if (activeTempImage) {\\n    try {\\n      activeTempImage.remove();\\n    } catch (e) {\\n    }\\n    activeTempImage = null;\\n  }\\n  if (mainImage) {\\n    mainImage.removeAttribute('src');\\n    mainImage.style.transform = '';\\n    mainImage.style.transition = 'none';\\n    mainImage.style.filter = 'none';\\n  }\\n  if (typeof miniMapBg !== 'undefined' && miniMapBg) {\\n    miniMapBg.removeAttribute('src');\\n  }\\n  if (typeof miniMapContainer !== 'undefined' && miniMapContainer) {\\n    miniMapContainer.style.display = 'none';\\n  }\\n  if (typeof miniMapViewport !== 'undefined' && miniMapViewport) {\\n    miniMapViewport.style.top = '0%';\\n    miniMapViewport.style.left = '0%';\\n    miniMapViewport.style.width = '100%';\\n    miniMapViewport.style.height = '100%';\\n  }\\n  const dotsContainer = document.getElementById('mini-map-dots');\\n  if (dotsContainer) {\\n    dotsContainer.innerHTML = '';\\n    dotsContainer.removeAttribute('data-parent-id');\\n  }\\n  if (labelsContainer) {\\n    labelsContainer.querySelectorAll('.label').forEach((el) => el.remove());\\n    if (labelsSvg && !labelsContainer.contains(labelsSvg)) {\\n      labelsContainer.appendChild(labelsSvg);\\n    }\\n    labelsContainer.classList.remove('hidden-instant');\\n  }\\n  if (labelsSvg) {\\n    labelsSvg.innerHTML = '';\\n    labelsSvg.classList.remove('hidden-instant');\\n  }\\n  const bc = document.getElementById('viewer-header-breadcrumbs');\\n  if (bc) bc.innerHTML = '';\\n  const titleEl = document.getElementById('node-title');\\n  const descEl = document.getElementById('node-description');\\n  if (titleEl) titleEl.textContent = '';\\n  if (descEl) descEl.innerHTML = '';\\n  if (typeof hideHoverOverlay === 'function') hideHoverOverlay();\\n  setProgressiveLoadingIndicator(false);\\n}\\n\\n/**\\n * Merges incoming node data into an existing node record without clobbering\\n * non-null parentId, edge geometry (box/zoomedBox), or childrenIds with nulls.\\n * @param {?Object} existing\\n * @param {!Object} incoming\\n * @return {!Object}\\n */\\nfunction mergeNodeData(existing, incoming) {\\n  if (!existing) return Object.assign({}, incoming);\\n  const merged = Object.assign({}, existing, incoming);\\n  if (!incoming.parentId && existing.parentId) {\\n    merged.parentId = existing.parentId;\\n    merged.ParentNodeUuid = existing.ParentNodeUuid || existing.parentId;\\n  }\\n  if (!incoming.box && existing.box) merged.box = existing.box;\\n  if (!incoming.zoomedBox && existing.zoomedBox) {\\n    merged.zoomedBox = existing.zoomedBox;\\n  }\\n  if (!incoming.labelPosition && existing.labelPosition) {\\n    merged.labelPosition = existing.labelPosition;\\n  }\\n  if (!incoming.label_anchor_points && existing.label_anchor_points) {\\n    merged.label_anchor_points = existing.label_anchor_points;\\n  }\\n  if (!incoming.maskSrc && existing.maskSrc) merged.maskSrc = existing.maskSrc;\\n  if (!incoming.imageSrc && existing.imageSrc) {\\n    merged.imageSrc = existing.imageSrc;\\n  }\\n  if (!incoming.label && existing.label) merged.label = existing.label;\\n  if (!incoming.text && existing.text) merged.text = existing.text;\\n  if ((!incoming.childrenIds || incoming.childrenIds.length === 0) &&\\n      existing.childrenIds && existing.childrenIds.length > 0) {\\n    merged.childrenIds = existing.childrenIds;\\n  } else if (\\n      incoming.childrenIds && incoming.childrenIds.length > 0 &&\\n      existing.childrenIds && existing.childrenIds.length > 0) {\\n    merged.childrenIds =\\n        Array.from(new Set([...incoming.childrenIds, ...existing.childrenIds]));\\n  }\\n  return merged;\\n}\\n\\n/**\\n * Dynamically loads or updates DeepZoom graph data from a payload object/JSON\\n * string. Supports incremental/progressive streaming updates without losing\\n * current node context.\\n * @param {*} payload\\n */\\nfunction loadDeepZoomData(payload) {\\n  if (!payload) return;\\n  if (typeof payload === 'string') {\\n    try {\\n      payload = JSON.parse(payload);\\n    } catch (e) {\\n      Logger.error('Failed to parse DeepZoom payload:', e);\\n      return;\\n    }\\n  }\\n\\n  const incomingRootId = String(payload.rootId || payload.root_id || '');\\n  const isNewWorld = Boolean(incomingRootId && incomingRootId !== rootId);\\n  if (isNewWorld) {\\n    resetWorldState();\\n    rootId = incomingRootId;\\n    window.rootId = rootId;\\n  }\\n\\n  if (payload.isProgressiveLoading === true) {\\n    setProgressiveLoadingIndicator(true);\\n  } else if (payload.isProgressiveLoading === false) {\\n    setProgressiveLoadingIndicator(false);\\n  }\\n\\n  const incomingNodes = payload.nodes || payload.nodesData;\\n  if (incomingNodes) {\\n    if (Array.isArray(incomingNodes)) {\\n      for (const node of incomingNodes) {\\n        if (node && node.id) {\\n          nodesData[node.id] = mergeNodeData(nodesData[node.id], node);\\n        }\\n      }\\n    } else if (typeof incomingNodes === 'object') {\\n      for (const [id, node] of Object.entries(incomingNodes)) {\\n        if (node) {\\n          const nodeId = node.id || id;\\n          nodesData[nodeId] = mergeNodeData(\\n              nodesData[nodeId], Object.assign({}, node, {id: nodeId}));\\n        }\\n      }\\n    }\\n  }\\n\\n  if (incomingRootId) {\\n    rootId = incomingRootId;\\n    window.rootId = rootId;\\n  } else if (!rootId && Object.keys(nodesData).length > 0) {\\n    const rootCandidate =\\n        Object.values(nodesData).find((n) => n && !n.parentId);\\n    rootId = rootCandidate ? rootCandidate.id : Object.keys(nodesData)[0];\\n    window.rootId = rootId;\\n  }\\n\\n  if (payload.audio !== undefined || payload.staticAudio !== undefined) {\\n    staticAudio = payload.audio || payload.staticAudio || '';\\n  }\\n  if (payload.timeline !== undefined || payload.staticTimeline !== undefined) {\\n    staticTimeline = payload.timeline || payload.staticTimeline || [];\\n  }\\n  if ((payload.audio || payload.staticAudio || payload.timeline ||\\n       payload.staticTimeline) &&\\n      typeof initStaticAudioTour === 'function') {\\n    initStaticAudioTour();\\n  }\\n\\n  if (pendingLayerZoomChildId && nodesData[pendingLayerZoomChildId]) {\\n    const pendingNode = nodesData[pendingLayerZoomChildId];\\n    const isPendingLayerReady = !pendingNode.childrenIds ||\\n        pendingNode.childrenIds.length === 0 ||\\n        pendingNode.childrenIds.every((gcId) => Boolean(nodesData[gcId]));\\n    if (isPendingLayerReady) {\\n      const targetToZoom = pendingLayerZoomChildId;\\n      pendingLayerZoomChildId = null;\\n      setProgressiveLoadingIndicator(false);\\n      updateLabelReadyStatesInPlace();\\n      zoomToChild(targetToZoom);\\n      return;\\n    }\\n  }\\n\\n  const requestedStartNodeId = payload.initialNodeId || payload.targetNodeId;\\n  if (rootId && nodesData[rootId]) {\\n    const targetId = (requestedStartNodeId && nodesData[requestedStartNodeId]) ?\\n        requestedStartNodeId :\\n        ((currentNodeId && nodesData[currentNodeId]) ? currentNodeId : rootId);\\n    if (isNewWorld || !currentNodeId ||\\n        (requestedStartNodeId && currentNodeId !== requestedStartNodeId)) {\\n      renderNode(targetId);\\n      if (isImmersiveMode) {\\n        resetImmersiveViewport();\\n      }\\n    } else {\\n      const currentNode = nodesData[targetId];\\n      const allDirectLabelsRendered = Boolean(\\n          currentNode && currentNode.childrenIds &&\\n          currentNode.childrenIds.every(\\n              (cid) => Boolean(document.getElementById(`label-${cid}`))));\\n      if (allDirectLabelsRendered) {\\n        updateLabelReadyStatesInPlace();\\n      } else {\\n        renderNode(targetId);\\n      }\\n    }\\n    if (isImmersiveMode && typeof updateImmersiveHeader === 'function') {\\n      updateImmersiveHeader();\\n    }\\n    if (typeof updateNavigationControls === 'function') {\\n      updateNavigationControls();\\n    }\\n    if (typeof updateMinimapLayout === 'function') {\\n      updateMinimapLayout();\\n    }\\n    const finalCurrentNode = nodesData[currentNodeId || targetId];\\n    const hasHydratedChildren = Boolean(\\n        finalCurrentNode && finalCurrentNode.childrenIds &&\\n        finalCurrentNode.childrenIds.length > 0 &&\\n        finalCurrentNode.childrenIds.every((cid) => Boolean(nodesData[cid])));\\n    if (payload.isProgressiveLoading === false ||\\n        (!payload.isProgressiveLoading && hasHydratedChildren)) {\\n      setProgressiveLoadingIndicator(false);\\n    }\\n  }\\n}\\n\\nwindow.loadDeepZoomData = loadDeepZoomData;\\nwindow.resetWorldState = resetWorldState;\\nwindow.addEventListener('message', handleHostMessage);\\ndocument.addEventListener('click', handleFirstClick, true);\\n\\n/**\\n * Computes bounding rectangle and screen position for an anchor pin.\\n * Coordinates are relative to the iframe's viewport / window.\\n * @param {!Object} anchor\\n * @param {?Element=} opt_pinEl\\n * @return {!Object}\\n */\\nfunction getAnchorScreenMetrics(anchor, opt_pinEl) {\\n  const pinEl = opt_pinEl ||\\n      document.getElementById(`conversation-anchor-${anchor.conversationId}`);\\n  const metrics = (typeof getActiveCanvasMetrics === 'function') ?\\n      getActiveCanvasMetrics() :\\n      null;\\n\\n  let screenX = 0;\\n  let screenY = 0;\\n  if (metrics) {\\n    screenX = metrics.offsetX + anchor.naturalX * metrics.scaleX;\\n    screenY = metrics.offsetY + anchor.naturalY * metrics.scaleY;\\n  }\\n\\n  let rect = null;\\n  let pointRect = null;\\n  let bubbleRect = null;\\n\\n  if (pinEl) {\\n    const r = pinEl.getBoundingClientRect();\\n    rect = {\\n      left: r.left,\\n      top: r.top,\\n      right: r.right,\\n      bottom: r.bottom,\\n      width: r.width,\\n      height: r.height,\\n      x: r.x,\\n      y: r.y,\\n    };\\n    const pointEl = pinEl.querySelector('.conversation-anchor-point');\\n    if (pointEl) {\\n      const pr = pointEl.getBoundingClientRect();\\n      pointRect = {\\n        left: pr.left,\\n        top: pr.top,\\n        right: pr.right,\\n        bottom: pr.bottom,\\n        width: pr.width,\\n        height: pr.height,\\n      };\\n      screenX = pr.left + pr.width / 2;\\n      screenY = pr.top + pr.height / 2;\\n    }\\n    const bubbleEl = pinEl.querySelector('.conversation-chat-bubble');\\n    if (bubbleEl) {\\n      const br = bubbleEl.getBoundingClientRect();\\n      bubbleRect = {\\n        left: br.left,\\n        top: br.top,\\n        right: br.right,\\n        bottom: br.bottom,\\n        width: br.width,\\n        height: br.height,\\n      };\\n    }\\n  }\\n\\n  return {\\n    screenX: Math.round(screenX),\\n    screenY: Math.round(screenY),\\n    rect: rect,\\n    pointRect: pointRect,\\n    bubbleRect: bubbleRect,\\n  };\\n}\\n\\n/**\\n * Enters interaction mode for an inline conversation anchor.\\n * Highlights the anchor, dims other anchors, and notifies host with screen\\n * metrics.\\n * @param {!Object} anchor\\n * @param {?Element=} opt_pinEl\\n * @param {boolean=} opt_notifyParent\\n */\\nfunction enterConversationInteractionMode(\\n    anchor, opt_pinEl, opt_notifyParent = true) {\\n  if (!anchor || !anchor.conversationId) return;\\n\\n  activeConversationId = String(anchor.conversationId);\\n  document.body.classList.add('conversation-interaction-active');\\n\\n  const pinEl = opt_pinEl ||\\n      document.getElementById(`conversation-anchor-${anchor.conversationId}`);\\n\\n  if (conversationAnchorsContainer) {\\n    const pins = conversationAnchorsContainer.querySelectorAll(\\n        '.conversation-anchor-pin');\\n    pins.forEach(pin => {\\n      if (pin.getAttribute('data-conversation-id') === activeConversationId) {\\n        pin.classList.add('conversation-anchor-pin--active');\\n      } else {\\n        pin.classList.remove('conversation-anchor-pin--active');\\n      }\\n    });\\n  }\\n\\n  if (typeof emitUserInteraction === 'function') {\\n    emitUserInteraction('INLINE_CONVERSATION_CLICK');\\n  }\\n\\n  if (opt_notifyParent && window.parent) {\\n    const screenMetrics = getAnchorScreenMetrics(anchor, pinEl);\\n    window.parent.postMessage(\\n        {\\n          type: 'lightboxInlineConversationClick',\\n          conversationId: anchor.conversationId,\\n          nodeId: anchor.nodeId,\\n          naturalX: anchor.naturalX,\\n          naturalY: anchor.naturalY,\\n          anchorLabel: anchor.anchorLabel,\\n          anchor: anchor,\\n          screenX: screenMetrics.screenX,\\n          screenY: screenMetrics.screenY,\\n          rect: screenMetrics.rect,\\n          pointRect: screenMetrics.pointRect,\\n          bubbleRect: screenMetrics.bubbleRect,\\n        },\\n        '*');\\n  }\\n}\\n\\n/**\\n * Exits conversation interaction mode and restores default pin states.\\n * @param {boolean=} opt_notifyParent Whether to emit postMessage to host.\\n */\\nfunction exitConversationInteractionMode(opt_notifyParent = false) {\\n  const previousActiveId = activeConversationId;\\n  activeConversationId = null;\\n  document.body.classList.remove('conversation-interaction-active');\\n\\n  if (conversationAnchorsContainer) {\\n    const activePins = conversationAnchorsContainer.querySelectorAll(\\n        '.conversation-anchor-pin--active');\\n    activePins.forEach(\\n        pin => pin.classList.remove('conversation-anchor-pin--active'));\\n  }\\n\\n  if (opt_notifyParent && previousActiveId && window.parent) {\\n    window.parent.postMessage(\\n        {\\n          type: 'lightboxInlineConversationDismiss',\\n          conversationId: previousActiveId,\\n        },\\n        '*');\\n  }\\n}\\n\\n/**\\n * Handles user clicking on a conversation anchor pin / chat bubble.\\n * @param {!Object} anchor\\n * @param {?Element=} opt_pinEl\\n */\\nfunction handleAnchorClick(anchor, opt_pinEl) {\\n  enterConversationInteractionMode(\\n      anchor, opt_pinEl, /* opt_notifyParent= */ true);\\n}\\n\\n/**\\n * Handles user clicking delete on a conversation anchor pin.\\n * @param {!Object} anchor\\n */\\nfunction handleAnchorDelete(anchor) {\\n  if (activeConversationId === String(anchor.conversationId)) {\\n    exitConversationInteractionMode(/* opt_notifyParent= */ false);\\n  }\\n  if (typeof emitUserInteraction === 'function') {\\n    emitUserInteraction('INLINE_CONVERSATION_DELETE');\\n  }\\n  if (window.parent) {\\n    window.parent.postMessage(\\n        {\\n          type: 'deleteInlineConversation',\\n          conversationId: anchor.conversationId,\\n          nodeId: anchor.nodeId,\\n        },\\n        '*');\\n  }\\n}\\n\\nwindow.enterConversationInteractionMode = enterConversationInteractionMode;\\nwindow.exitConversationInteractionMode = exitConversationInteractionMode;\\n\\nwindow.addEventListener('keydown', (e) => {\\n  if (e.key === 'Escape' && activeConversationId) {\\n    if (typeof exitConversationInteractionMode === 'function') {\\n      exitConversationInteractionMode(/* opt_notifyParent= */ true);\\n    }\\n  }\\n});\\n\\n\\n/**\\n * @fileoverview UI chrome visibility, top navigation controls, minimap viewport\\n * indicator sync & dot rendering, and hover overlay.\\n */\\n\\n/** Hides UI chrome elements during transitions or dragging. */\\nfunction hideUI() {\\n  if (labelsContainer) labelsContainer.style.opacity = '0';\\n  if (labelsSvg) labelsSvg.style.opacity = '0';\\n  if (textPanel) textPanel.style.opacity = '0';\\n  if (miniMapContainer && !isDragging) miniMapContainer.style.opacity = '0';\\n  if (regionHighlight) regionHighlight.style.opacity = '0';\\n  const buttons = document.querySelectorAll('.edge-arrow');\\n  buttons.forEach(b => b.style.opacity = '0');\\n  const tooltip = document.getElementById('onboarding-tooltip');\\n  if (tooltip) tooltip.classList.remove('visible');\\n}\\n\\n/** Shows UI. */\\nfunction showUI() {\\n  if (labelsContainer) labelsContainer.style.opacity = '';\\n  if (labelsSvg) labelsSvg.style.opacity = '';\\n  if (textPanel) textPanel.style.opacity = '';\\n  if (miniMapContainer) miniMapContainer.style.opacity = '';\\n  if (regionHighlight) regionHighlight.style.opacity = '';\\n  const buttons = document.querySelectorAll('.edge-arrow');\\n  buttons.forEach(b => b.style.opacity = '');\\n  showOnboardingTooltip();\\n}\\n\\n// Update Arrow Affordances and Mini Map Updates\\n/** Updates navigation controls. */\\nfunction updateNavigationControls() {\\n  const currentNode = nodesData[currentNodeId];\\n  if (!currentNode) return;\\n\\n  if (currentNodeId === rootId) {\\n    if (lightboxZoomOutBtn) lightboxZoomOutBtn.classList.remove('lightbox-zoom-out-button--visible');\\n  } else {\\n    if (lightboxZoomOutBtn && !isImmersiveMode) {\\n      lightboxZoomOutBtn.classList.add('lightbox-zoom-out-button--visible');\\n    } else if (lightboxZoomOutBtn) {\\n      lightboxZoomOutBtn.classList.remove('lightbox-zoom-out-button--visible');\\n    }\\n  }\\n\\n  const isLightboxOpen = !isInlineModeRestricted &&\\n      (isImmersiveMode || document.body.classList.contains('lightbox-active'));\\n  const canShow = isLightboxOpen && !!currentNode.imageSrc;\\n\\n  if (canShow) {\\n    miniMapContainer.style.display = 'block';\\n\\n    const dotsContainer = document.getElementById('mini-map-dots');\\n    if (dotsContainer) {\\n      const contextId = currentNodeId;\\n      const existingContextId = dotsContainer.getAttribute('data-parent-id');\\n\\n      if (existingContextId === contextId && dotsContainer.children.length > 0) {\\n        const dots = dotsContainer.querySelectorAll('.mini-map-dot');\\n        dots.forEach(d => {\\n          if (d.getAttribute('data-node-id') === currentNodeId) {\\n            d.classList.add('active');\\n          } else {\\n            d.classList.remove('active');\\n          }\\n        });\\n      } else {\\n        const bgSrc = getMinimapImageUrl(currentNode.imageSrc);\\n        if (miniMapBg.src !== bgSrc) {\\n          miniMapBg.src = bgSrc || '';\\n        } else if (miniMapBg.complete) {\\n          miniMapBg.onload();\\n        }\\n      }\\n    }\\n\\n    const bgSrc = getMinimapImageUrl(currentNode.imageSrc);\\n    if (miniMapBg.src === bgSrc && miniMapBg.complete) {\\n      syncMinimapViewport();\\n    }\\n  } else {\\n    if (miniMapContainer) miniMapContainer.style.display = 'none';\\n  }\\n}\\n\\n/**\\n * Synchronizes the minimap viewport box with the currently visible area of the main image.\\n * Supports dynamic panning and zooming in immersive mode.\\n * @param {number=} dragX Current drag horizontal offset (clamped)\\n * @param {number=} dragY Current drag vertical offset (clamped)\\n */\\nfunction syncMinimapViewport(dragX = null, dragY = null) {\\n  const currentNode = nodesData[currentNodeId];\\n  if (!currentNode) return;\\n\\n  if (!isImmersiveMode) {\\n    miniMapViewport.style.top = '0%';\\n    miniMapViewport.style.left = '0%';\\n    miniMapViewport.style.width = '100%';\\n    miniMapViewport.style.height = '100%';\\n    return;\\n  }\\n\\n  const containerRect = mainContainer.getBoundingClientRect();\\n  const isFife = Boolean(\\n      currentNode.imageSrc &&\\n      currentNode.imageSrc.includes('googleusercontent.com/'));\\n  const dims = (isFife && typeof getNaturalDimensions === 'function') ?\\n      getNaturalDimensions(currentNodeId) :\\n      {width: mainImage.naturalWidth, height: mainImage.naturalHeight};\\n  const naturalWidth = mainImage.naturalWidth || dims.width;\\n  const naturalHeight = mainImage.naturalHeight || dims.height;\\n  if (!naturalWidth || !naturalHeight || containerRect.width === 0) {\\n    if (isFife) {\\n      miniMapViewport.style.top = '0%';\\n      miniMapViewport.style.left = '0%';\\n      miniMapViewport.style.width = '100%';\\n      miniMapViewport.style.height = '100%';\\n    }\\n    return;\\n  }\\n\\n  const scale = currentImmersiveScale ||\\n      (isFife ? Math.max(\\n                    containerRect.width / naturalWidth,\\n                    containerRect.height / naturalHeight) *\\n               IMMERSIVE_ZOOM_BUFFER :\\n                1);\\n  const tx = dragX !== null ? dragX : currentImmersiveX;\\n  const ty = dragY !== null ? dragY : currentImmersiveY;\\n\\n  const renderedWidth = naturalWidth * scale;\\n  const renderedHeight = naturalHeight * scale;\\n\\n  const Cw = containerRect.width;\\n  const Ch = containerRect.height;\\n\\n  const img_left = Cw / 2 + tx - renderedWidth / 2;\\n  const img_top = Ch / 2 + ty - renderedHeight / 2;\\n\\n  const vis_left = Math.max(0, img_left);\\n  const vis_right = Math.min(Cw, img_left + renderedWidth);\\n  const vis_top = Math.max(0, img_top);\\n  const vis_bottom = Math.min(Ch, img_top + renderedHeight);\\n\\n  const vx0 = (vis_left - img_left) / renderedWidth;\\n  const vx1 = (vis_right - img_left) / renderedWidth;\\n  const vy0 = (vis_top - img_top) / renderedHeight;\\n  const vy1 = (vis_bottom - img_top) / renderedHeight;\\n\\n  const left = vx0 * 100;\\n  const top = vy0 * 100;\\n  const width = (vx1 - vx0) * 100;\\n  const height = (vy1 - vy0) * 100;\\n\\n  miniMapViewport.style.left = `${left}%`;\\n  miniMapViewport.style.top = `${top}%`;\\n  miniMapViewport.style.width = `${width}%`;\\n  miniMapViewport.style.height = `${height}%`;\\n}\\n\\n\\n/**\\n * Renders dots on the minimap scaled to the background image dimensions.\\n * @param {number} bgWidth Natural width of the minimap background image\\n * @param {number} bgHeight Natural height of the minimap background image\\n */\\nfunction renderMinimapDots(bgWidth, bgHeight) {\\n  const dotsContainer = document.getElementById('mini-map-dots');\\n  if (!dotsContainer) return;\\n\\n  const currentNode = nodesData[currentNodeId];\\n  if (!currentNode) return;\\n  const contextId = currentNodeId;\\n\\n  dotsContainer.innerHTML = '';\\n  dotsContainer.setAttribute('data-parent-id', contextId || '');\\n\\n  const isThumbnail =\\n      Boolean(miniMapBg && miniMapBg.src && miniMapBg.src.includes('=w320'));\\n  const refWidth =\\n      isThumbnail ? ((mainImage && mainImage.naturalWidth) || 5504) : bgWidth;\\n  const refHeight =\\n      isThumbnail ? ((mainImage && mainImage.naturalHeight) || 3072) : bgHeight;\\n\\n  for (const id in nodesData) {\\n    const sibling = nodesData[id];\\n    if (sibling.parentId === contextId) {\\n      const b = sibling.box;\\n      if (b) {\\n        let cx, cy;\\n        if (sibling.labelPosition) {\\n          cx = sibling.labelPosition.anchorX;\\n          cy = sibling.labelPosition.anchorY;\\n        } else {\\n          cy = (b[0] + b[2]) / 2;\\n          cx = (b[1] + b[3]) / 2;\\n        }\\n        const dot = document.createElement('div');\\n        dot.className = 'mini-map-dot';\\n        if (sibling.childrenIds &&\\n            sibling.childrenIds.length > 0) {\\n          dot.classList.add('hollow');\\n        }\\n        dot.setAttribute('data-node-id', id);\\n        dot.style.left = `${(cx / refWidth) * 100}%`;\\n        dot.style.top = `${(cy / refHeight) * 100}%`;\\n        dotsContainer.appendChild(dot);\\n      }\\n    }\\n  }\\n\\n  const dots = dotsContainer.querySelectorAll('.mini-map-dot');\\n  dots.forEach(d => {\\n    if (d.getAttribute('data-node-id') === currentNodeId) {\\n      d.classList.add('active');\\n    } else {\\n      d.classList.remove('active');\\n    }\\n  });\\n}\\n\\n/**\\n/**\\n * Shows hover overlay.\\n * @param {string} childId\\n * @return {boolean}\\n */\\nfunction showHoverOverlay(childId) {\\n  const childNode = nodesData[childId];\\n  if (!childNode) return false;\\n  const isChildLayerReady = !childNode.childrenIds ||\\n      childNode.childrenIds.length === 0 ||\\n      childNode.childrenIds.every((gcId) => Boolean(nodesData[gcId]));\\n  if (!isChildLayerReady) {\\n    try {\\n      if (window.parent && window.parent !== window) {\\n        window.parent.postMessage(\\n            {\\n              type: 'requestLayer',\\n              node_id: childId,\\n            },\\n            '*');\\n      }\\n    } catch (err) {\\n    }\\n  }\\n  const canvas = document.getElementById(`mask-canvas-${childId}`);\\n  if (!canvas || canvas.width === 0) return false;\\n\\n  if (childNode._cachedHoverMaskUrl === undefined) {\\n    const ctx = canvas.getContext('2d');\\n    const w = canvas.width;\\n    const h = canvas.height;\\n    const imageData = ctx.getImageData(0, 0, w, h);\\n\\n    let imgCanvas = null;\\n    try {\\n      imgCanvas = document.createElement('canvas');\\n      imgCanvas.width = w;\\n      imgCanvas.height = h;\\n      const imgCtx = imgCanvas.getContext('2d');\\n      imgCtx.drawImage(mainImage, 0, 0, w, h);\\n      const imgPixelData = imgCtx.getImageData(0, 0, w, h).data;\\n      const maskPixelData = imageData.data;\\n\\n      let totalBrightness = 0;\\n      let count = 0;\\n      for (let i = 0; i < maskPixelData.length; i += 16) {\\n        if (maskPixelData[i] > 200) {\\n          const r = imgPixelData[i];\\n          const g = imgPixelData[i + 1];\\n          const b = imgPixelData[i + 2];\\n          const brightness = 0.299 * r + 0.587 * g + 0.114 * b;\\n          totalBrightness += brightness;\\n          count++;\\n        }\\n      }\\n      const avgBrightness = count > 0 ? totalBrightness / count : 0;\\n      childNode._cachedHighBrightness = avgBrightness > 200;\\n    } catch (e) {\\n      childNode._cachedHighBrightness = false;\\n    } finally {\\n      if (imgCanvas) {\\n        // Immediately release scratch canvas GPU memory (critical on WebKit/iOS).\\n        imgCanvas.width = 0;\\n        imgCanvas.height = 0;\\n      }\\n    }\\n\\n    // Convert opaque black/white mask into a transparent-background alpha mask\\n    // so both alpha-masking (-webkit-mask-image) and luminance-masking feather\\n    // smoothly into the background without sharp bilevel edges.\\n    const alphaScratch = document.createElement('canvas');\\n    alphaScratch.width = w;\\n    alphaScratch.height = h;\\n    const alphaCtx = alphaScratch.getContext('2d');\\n    const alphaImgData = alphaCtx.createImageData(w, h);\\n    const srcPixels = imageData.data;\\n    const dstPixels = alphaImgData.data;\\n    for (let i = 0; i < srcPixels.length; i += 4) {\\n      const lum = Math.max(srcPixels[i], srcPixels[i + 1], srcPixels[i + 2]);\\n      dstPixels[i] = 255;\\n      dstPixels[i + 1] = 255;\\n      dstPixels[i + 2] = 255;\\n      dstPixels[i + 3] = lum;\\n    }\\n    alphaCtx.putImageData(alphaImgData, 0, 0);\\n\\n    const blurW = 1024;\\n    const blurH = Math.max(1, Math.round(blurW * (h / (w || 1))));\\n    const blurCanvas = document.createElement('canvas');\\n    blurCanvas.width = blurW;\\n    blurCanvas.height = blurH;\\n    const blurCtx = blurCanvas.getContext('2d');\\n    const blurRadius = Math.max(\\n        44,\\n        Math.round(\\n            MASK_BLUR_RADIUS_PX *\\n            (blurW / (mainImage.naturalWidth || blurW || 1000))));\\n    blurCtx.filter = `blur(${blurRadius}px)`;\\n    blurCtx.drawImage(alphaScratch, 0, 0, w, h, 0, 0, blurW, blurH);\\n    // Second Gaussian pass to eliminate staircase artifacts from low-res masks.\\n    blurCtx.filter = `blur(${Math.round(blurRadius * 0.6)}px)`;\\n    blurCtx.drawImage(blurCanvas, 0, 0);\\n\\n    childNode._cachedHoverMaskUrl = blurCanvas.toDataURL();\\n    // Immediately release scratch canvas GPU memory (critical on WebKit/iOS).\\n    alphaScratch.width = 0;\\n    alphaScratch.height = 0;\\n    blurCanvas.width = 0;\\n    blurCanvas.height = 0;\\n  }\\n\\n  if (childNode._cachedHighBrightness) {\\n    Logger.log('Switching to high-brightness mode');\\n    regionHighlight.classList.add('high-brightness');\\n  } else {\\n    regionHighlight.classList.remove('high-brightness');\\n  }\\n  const directMaskUrl = childNode._cachedHoverMaskUrl;\\n\\n  const rect = mainImage.getBoundingClientRect();\\n  const containerRect = mainContainer.getBoundingClientRect();\\n  const containerWidth = mainContainer.offsetWidth || containerRect.width || 1;\\n  const containerHeight =\\n      mainContainer.offsetHeight || containerRect.height || 1;\\n  const scaleX = (containerRect.width > 0 && containerWidth > 0) ?\\n      (containerRect.width / containerWidth) || 1 :\\n      1;\\n  const scaleY = (containerRect.height > 0 && containerHeight > 0) ?\\n      (containerRect.height / containerHeight) || 1 :\\n      1;\\n\\n  const localWidth = rect.width / scaleX;\\n  const localHeight = rect.height / scaleY;\\n  const localOffsetX = (rect.left - containerRect.left) / scaleX;\\n  const localOffsetY = (rect.top - containerRect.top) / scaleY;\\n\\n  regionHighlight.style.width = `${localWidth}px`;\\n  regionHighlight.style.height = `${localHeight}px`;\\n  regionHighlight.style.left = `${localOffsetX}px`;\\n  regionHighlight.style.top = `${localOffsetY}px`;\\n\\n  regionHighlight.style.backgroundImage = `url(${mainImage.src})`;\\n  regionHighlight.style.webkitMaskImage = `url(${directMaskUrl})`;\\n  regionHighlight.style.maskImage = `url(${directMaskUrl})`;\\n  regionHighlight.style.webkitMaskSize = '100% 100%';\\n\\n  // Reset the Off-Screen scroll left behind by Wash Animation!\\n  regionHighlight.style.webkitMaskPosition = '0px 0px';\\n\\n  regionHighlight.style.opacity = '1';\\n  regionHighlight.style.transition = '';\\n  return true;\\n}\\n\\n/** Hides hover overlay. */\\nfunction hideHoverOverlay() {\\n  regionHighlight.style.opacity = '0';\\n}\\n\\n// Simple markdown to HTML parser\\n/**\\n * Parses markdown.\\n * @param {string} text\\n * @return {string}\\n */\\n\\n\\n/**\\n * @fileoverview Markdown parser, mobile node tap handling, label highlight/pin\\n * classes, text panel rendering/minimization/DYK toggles, and floating leaf\\n * card positioning.\\n */\\n\\n/**\\n * Parses a markdown string into sanitized HTML.\\n * @param {string} text\\n * @return {string}\\n */\\nfunction parseMarkdown(text) {\\n  if (!text) return '';\\n  // clang-format off\\n  let html = text\\n      // Escape HTML\\n      .replace(/&/g, '&amp;')\\n      .replace(/</g, '&lt;')\\n      .replace(/>/g, '&gt;')\\n      // Code blocks (must be before inline code)\\n      .replace(/```([\\\\\\\\s\\\\\\\\S]*?)```/g, '<pre><code>$1</code></pre>')\\n      // Inline code\\n      .replace(/`([^`]+)`/g, '<code>$1</code>')\\n      // Headers\\n      .replace(/^###### (.+)$/gm, '<h6 class=\\\"text-panel-title\\\">$1</h6>')\\n      .replace(/^##### (.+)$/gm, '<h5 class=\\\"text-panel-title\\\">$1</h5>')\\n      .replace(/^#### (.+)$/gm, '<h4 class=\\\"text-panel-title\\\">$1</h4>')\\n      .replace(/^### (.+)$/gm, '<h3 class=\\\"text-panel-title\\\">$1</h3>')\\n      .replace(/^## (.+)$/gm, '<h2 class=\\\"text-panel-title\\\">$1</h2>')\\n      .replace(/^# (.+)$/gm, '<h1 class=\\\"text-panel-title\\\">$1</h1>')\\n      // Unordered lists\\n      .replace(/^\\\\s*[*-]\\\\s+(.+)$/gm, '<li>$1</li>')\\n      // Bold\\n      .replace(/[*][*]([^*]+)[*][*]/g, '<strong>$1</strong>')\\n      // Italic\\n      .replace(/[*]([^*]+)[*]/g, '<em>$1</em>');\\n  // clang-format on\\n  // Wrap consecutive <li> elements in a single <ul>, handling newlines between\\n  // items.\\n  html = html.replace(\\n      /(<li>[\\\\s\\\\S]*?<[/]li>([\\\\s\\\\n]*<li>[\\\\s\\\\S]*?<[/]li>)*)/g, match => {\\n        return '<ul>' + match + '</ul>';\\n      });\\n  return html;\\n}\\n\\n// utility function: check if the pixel is white (allow some deviation)\\n/**\\n * Checks if white pixel.\\n * @param {number} r\\n * @param {number} g\\n * @param {number} b\\n * @return {boolean}\\n */\\nfunction isWhitePixel(r, g, b) {\\n  return r > 230 && g > 230 && b > 230;\\n}\\n\\n/**\\n * Strips the rabbit emoji and leading spaces from label.\\n * @param {string} text\\n * @return {string}\\n */\\nfunction stripRabbitEmoji(text) {\\n  if (!text) return '';\\n  return text.replace(/^(?:\\ud83d\\udc07\\\\s*)+/u, '').trim();\\n}\\n\\n\\n\\n/**\\n * Handles dot/label tap interaction for mobile peeking and navigation.\\n * Returns true if navigation was triggered, false if just highlighted.\\n * @param {string} childId\\n * @param {!Object} childNode\\n * @return {boolean}\\n */\\nfunction handleMobileNodeTap(childId, childNode) {\\n  const isRabbitHole = childNode &&\\n      (childNode.nodeType === 'rabbit_hole' ||\\n       (childNode.label && childNode.label.startsWith('\\ud83d\\udc07')));\\n  if (isRabbitHole && window.__deepZoomTour__ &&\\n      (window.__deepZoomTour__.isPlaying ||\\n       window.__deepZoomTour__.isTourMode)) {\\n    window.__deepZoomTour__.stop(true, true);\\n  }\\n\\n  if (childNode.url) {\\n    window.open(childNode.url, '_blank');\\n  } else {\\n    zoomToChild(childId);\\n  }\\n  return true;\\n}\\n\\n\\n// Highlight a label and its line\\n/**\\n * Highlights label.\\n * @param {string} childId\\n * @param {boolean} highlight\\n */\\nfunction highlightLabel(childId, highlight) {\\n  const label = document.getElementById(`label-${childId}`);\\n  const line = document.getElementById(`line-${childId}`);\\n  const dot = document.getElementById(`dot-${childId}`);\\n  if (label) {\\n    if (highlight) {\\n      label.classList.add('highlight');\\n    } else {\\n      label.classList.remove('highlight');\\n    }\\n  }\\n  if (line) {\\n    if (highlight) {\\n      line.classList.add('highlight');\\n    } else {\\n      line.classList.remove('highlight');\\n    }\\n  }\\n  if (dot) {\\n    if (highlight) {\\n      dot.classList.add('highlight');\\n    } else {\\n      dot.classList.remove('highlight');\\n    }\\n  }\\n}\\n\\n/**\\n * Sets pinned class.\\n * @param {string} childId\\n * @param {boolean} isPinned\\n */\\nfunction setPinnedClass(childId, isPinned) {\\n  const label = document.getElementById(`label-${childId}`);\\n  const line = document.getElementById(`line-${childId}`);\\n  const dot = document.getElementById(`dot-${childId}`);\\n  if (isPinned) {\\n    if (label) label.classList.add('pinned');\\n    if (line) line.classList.add('pinned');\\n    if (dot) dot.classList.add('pinned');\\n  } else {\\n    if (label) label.classList.remove('pinned');\\n    if (line) line.classList.remove('pinned');\\n    if (dot) dot.classList.remove('pinned');\\n  }\\n}\\n\\n/**\\n * Formats seconds into mm:ss format for audio tour display.\\n * @param {number} sec\\n * @return {string}\\n */\\nfunction formatTourTime(sec) {\\n  if (isNaN(sec) || sec < 0) return '0:00';\\n  const m = Math.floor(sec / 60);\\n  const s = Math.floor(sec % 60);\\n  return `${m}:${s < 10 ? '0' : ''}${s}`;\\n}\\n\\n/**\\n * Updates text panel in standard or immersive mode.\\n * @param {string} text\\n * @param {string} [nodeId]\\n */\\nfunction updateTextPanel(text, nodeId = null) {\\n  const isTourPlaying = window.__deepZoomTour__ && window.__deepZoomTour__.isPlaying;\\n  const hasTour = window.__deepZoomTour__ && window.__deepZoomTour__.hasTour;\\n  let tourButtonHtml = '';\\n  const targetNodeId = nodeId || (typeof currentNodeId !== 'undefined' ? currentNodeId : (typeof rootId !== 'undefined' ? rootId : null));\\n  const isSolidDotNoZoom = targetNodeId && nodesData[targetNodeId] &&\\n      (!nodesData[targetNodeId].childrenIds || nodesData[targetNodeId].childrenIds.length === 0);\\n  const nodeHasTour = !isSolidDotNoZoom &&\\n      ((targetNodeId === rootId && hasTour) ||\\n       (targetNodeId && nodesData[targetNodeId] &&\\n        (nodesData[targetNodeId].audio || nodesData[targetNodeId].tour)) ||\\n       (typeof window.__pageTours__ !== 'undefined' && window.__pageTours__ &&\\n        window.__pageTours__[targetNodeId]) ||\\n       (window.__deepZoomTour__ &&\\n        typeof window.__deepZoomTour__.hasTourForNode === 'function' &&\\n        window.__deepZoomTour__.hasTourForNode(targetNodeId)));\\n\\n  if (isTourPlaying) {\\n    const isPaused = window.__deepZoomTour__.isPaused;\\n    const playPauseIcon = isPaused ? 'play_arrow' : 'pause';\\n    const currentCaption = window.__deepZoomTour__.currentCaption || '';\\n    tourButtonHtml = `\\n      <div id=\\\"tour-player-box\\\" class=\\\"tour-player-box lumi-audio-overview\\\">\\n        <div class=\\\"tour-player-controls-row\\\">\\n          <button id=\\\"tour-pause-resume-btn\\\" class=\\\"tour-control-btn tour-play-pause-btn lumi-icon-btn\\\" aria-label=\\\"Pause/Resume\\\" onclick=\\\"__deepZoomTour__.togglePause(event)\\\">\\n            <span class=\\\"google-symbols google-symbols--lum lumi-icon tour-play-pause-icon\\\">${\\n        playPauseIcon}</span>\\n          </button>\\n          <div class=\\\"tour-scrubber-container\\\">\\n            <input type=\\\"range\\\" id=\\\"tour-scrubber\\\" class=\\\"tour-scrubber-slider\\\" min=\\\"0\\\" max=\\\"100\\\" value=\\\"0\\\" step=\\\"0.1\\\" oninput=\\\"__deepZoomTour__.onScrub(this.value)\\\" onchange=\\\"__deepZoomTour__.onScrubEnd(this.value)\\\" />\\n          </div>\\n          <div id=\\\"tour-time-display\\\" class=\\\"tour-time-display\\\">0:00 / 0:00</div>\\n          <button id=\\\"tour-close-btn\\\" class=\\\"tour-control-btn tour-close-btn lumi-icon-btn\\\" aria-label=\\\"Close Tour\\\" onclick=\\\"__deepZoomTour__.stop(true, true)\\\">\\n            <span class=\\\"google-symbols google-symbols--lum lumi-icon\\\">close</span>\\n          </button>\\n        </div>\\n        <div id=\\\"tour-caption\\\" class=\\\"tour-caption-text audio-transcript-text\\\">${\\n        currentCaption}</div>\\n      </div>\\n    `;\\n  } else if (nodeHasTour) {\\n    tourButtonHtml = `\\n      <div id=\\\"start-tour-btn-container\\\" style=\\\"display: flex; justify-content: flex-start; margin-top: 16px;\\\">\\n        <button id=\\\"start-tour-btn\\\" class=\\\"audio-tour-chip lumi-btn\\\" onclick=\\\"__deepZoomTour__.toggle()\\\">\\n          <span class=\\\"google-symbols google-symbols--lum lumi-icon play-icon\\\">play_arrow</span>\\n          <span class=\\\"chip-label\\\">Audio Tour</span>\\n        </button>\\n      </div>\\n    `;\\n  }\\n\\n  let parsedHtml = text ? parseMarkdown(text) : '';\\n  let didYouKnowHtml = '';\\n\\n  if (nodeId && nodesData[nodeId]) {\\n    const node = nodesData[nodeId];\\n    if (node.childrenIds && node.childrenIds.length > 0) {\\n      const didYouKnowCards = [];\\n      const isMobileView = window.innerWidth <= 640 || isMobileApp || (window.innerWidth <= 912 && window.innerHeight < window.innerWidth);\\n      node.childrenIds.forEach(cid => {\\n        const childNode = nodesData[cid];\\n        if (childNode && (childNode.nodeType === 'rabbit_hole' || (childNode.label && childNode.label.startsWith('\\ud83d\\udc07')))) {\\n          const cleanLabel = stripRabbitEmoji(childNode.label);\\n          const initialClass = isMobileView ? 'did-you-know-card is-collapsed' : 'did-you-know-card is-expanded';\\n          const chevronIcon = isMobileView ? CHEVRON_DOWN_SVG : CHEVRON_UP_SVG;\\n          didYouKnowCards.push(`\\n            <div class=\\\"${initialClass}\\\" id=\\\"did-you-know-${cid}\\\" onclick=\\\"handleDidYouKnowClick(event, '${cid}')\\\">\\n              <div class=\\\"did-you-know-header-row\\\" onclick=\\\"handleDidYouKnowToggle(event, '${cid}')\\\">\\n                <span class=\\\"did-you-know-title\\\">Did you know?</span>\\n                <button class=\\\"did-you-know-toggle-btn\\\" aria-label=\\\"Toggle Did You Know\\\" onclick=\\\"handleDidYouKnowToggle(event, '${cid}')\\\">\\n                  <span class=\\\"did-you-know-chevron\\\">${chevronIcon}</span>\\n                </button>\\n              </div>\\n              <div class=\\\"did-you-know-body\\\">\\n                <div class=\\\"did-you-know-text\\\">${cleanLabel}</div>\\n                <button class=\\\"did-you-know-action-btn\\\" aria-label=\\\"Explore\\\" onclick=\\\"handleExploreMoreClick('${cid}')\\\">\\n                  <span class=\\\"google-symbols\\\">prompt_suggestion</span>\\n                </button>\\n              </div>\\n            </div>\\n          `);\\n        }\\n      });\\n      if (didYouKnowCards.length > 0) {\\n        didYouKnowHtml = `\\n          <div class=\\\"did-you-know-container\\\">\\n            ${didYouKnowCards.join('')}\\n          </div>\\n        `;\\n      }\\n    }\\n  }\\n\\n  if (textPanel) {\\n    textPanel.classList.remove('has-expanded-rabbit-hole');\\n  }\\n  document.body.classList.remove('has-expanded-rabbit-hole');\\n\\n  let finalHtml = parsedHtml;\\n  let hasTitle = false;\\n  {\\n    const isRootNode = !nodeId || String(nodeId) === String(rootId);\\n    const customTitle =\\n        (isInlineModeRestricted && isRootNode &&\\n         typeof customWidgetTitle !== 'undefined' && customWidgetTitle) ?\\n        customWidgetTitle.replace(/&/g, '&amp;')\\n            .replace(/</g, '&lt;')\\n            .replace(/>/g, '&gt;') :\\n        '';\\n    const headingMatch = parsedHtml.match(/<h[1-6]\\\\b[^>]*>[\\\\s\\\\S]*?<\\\\/h[1-6]>/i);\\n    hasTitle = !!headingMatch || !!customTitle;\\n    if (customTitle) {\\n      if (headingMatch) {\\n        const headingHtml = headingMatch[0];\\n        const headingIndex = parsedHtml.indexOf(headingHtml);\\n        const beforeHeading = parsedHtml.substring(0, headingIndex);\\n        const afterHeading =\\n            parsedHtml.substring(headingIndex + headingHtml.length);\\n        finalHtml = beforeHeading +\\n            `<h3 class=\\\"text-panel-title\\\">${customTitle}</h3>` +\\n            '<div class=\\\"text-panel-description\\\">' + afterHeading + '</div>' +\\n            didYouKnowHtml + tourButtonHtml;\\n      } else {\\n        finalHtml = `<h3 class=\\\"text-panel-title\\\">${customTitle}</h3>` +\\n            '<div class=\\\"text-panel-description\\\">' + parsedHtml + '</div>' +\\n            didYouKnowHtml + tourButtonHtml;\\n      }\\n    } else if (headingMatch) {\\n      const headingHtml = headingMatch[0];\\n      const headingIndex = parsedHtml.indexOf(headingHtml);\\n      const beforeHeading = parsedHtml.substring(0, headingIndex);\\n      const afterHeading =\\n          parsedHtml.substring(headingIndex + headingHtml.length);\\n      finalHtml = beforeHeading + headingHtml +\\n          '<div class=\\\"text-panel-description\\\">' + afterHeading + '</div>' +\\n          didYouKnowHtml +\\n          tourButtonHtml;\\n    } else {\\n      // Fallback when there is no heading tag: extract node label or first line of description\\n      let fallbackTitle = '';\\n      if (nodeId && nodesData[nodeId] && nodesData[nodeId].label) {\\n        fallbackTitle = nodesData[nodeId].label;\\n      } else {\\n        const tempDiv = document.createElement('div');\\n        tempDiv.innerHTML = parsedHtml;\\n        const textContent = (tempDiv.textContent || tempDiv.innerText || '').trim();\\n        const firstLine = textContent.split('\\\\n')[0].trim();\\n        fallbackTitle = firstLine;\\n      }\\n\\n      if (fallbackTitle) {\\n        hasTitle = true;\\n        finalHtml = `<h3 class=\\\"text-panel-title fallback-title\\\">${fallbackTitle}</h3>` +\\n            '<div class=\\\"text-panel-description\\\">' + parsedHtml + '</div>' +\\n            didYouKnowHtml +\\n            tourButtonHtml;\\n      } else {\\n        finalHtml =\\n            '<div class=\\\"text-panel-description\\\">' + parsedHtml + '</div>' +\\n            didYouKnowHtml +\\n            tourButtonHtml;\\n      }\\n    }\\n  }\\n\\n  if (textPanel) {\\n    textPanel.classList.toggle('no-title', !hasTitle);\\n    {\\n      const existingTourBtn =\\n          document.getElementById('inline-virtual-tour-button');\\n      if (existingTourBtn && existingTourBtn.parentNode) {\\n        existingTourBtn.parentNode.removeChild(existingTourBtn);\\n      }\\n      const toggleButtonHtml = `\\n        <button id=\\\"text-panel-toggle\\\" class=\\\"text-panel-toggle-btn\\\" aria-label=\\\"Toggle Text Panel\\\">\\n          <span class=\\\"toggle-icon\\\">${CHEVRON_DOWN_SVG}</span>\\n        </button>\\n      `;\\n      textPanel.innerHTML = `\\n        <div class=\\\"text-panel-backdrop blur-active\\\"></div>\\n        ${toggleButtonHtml}\\n        <div class=\\\"text-panel-content\\\">${finalHtml}</div>\\n      `;\\n      if (existingTourBtn) {\\n        if (isInlineModeRestricted) {\\n          const contentEl = textPanel.querySelector('.text-panel-content');\\n          if (contentEl) {\\n            existingTourBtn.style.display = 'flex';\\n            contentEl.prepend(existingTourBtn);\\n          }\\n        } else {\\n          const wrapperEl = document.getElementById('content-wrapper');\\n          if (wrapperEl) {\\n            wrapperEl.appendChild(existingTourBtn);\\n          }\\n        }\\n      }\\n      const toggleBtn = textPanel.querySelector('#text-panel-toggle');\\n      if (toggleBtn) {\\n        toggleBtn.addEventListener('click', (e) => {\\n          e.stopPropagation();\\n          toggleBtn.blur();\\n          toggleTextPanelMinimization();\\n        });\\n      }\\n      if (userCollapsedTextPanel) {\\n        textPanel.classList.add('minimized');\\n        isTextPanelMinimized = true;\\n      }\\n      updateTextPanelToggleIcon();\\n    }\\n  }\\n  const preTextEl = document.getElementById('immersive-pre-text');\\n  if (preTextEl) {\\n    preTextEl.innerHTML = finalHtml;\\n  }\\n  if (isTourPlaying && window.__deepZoomTour__) {\\n    window.__deepZoomTour__.updatePlayerUi();\\n  }\\n}\\n\\n/**\\n * Recalculates and re-renders labels when the text panel state changes.\\n */\\nfunction recalculateLabelsForPanelState() {\\n  if (recalculateLabelsTimerId) {\\n    clearTimeout(recalculateLabelsTimerId);\\n    recalculateLabelsTimerId = null;\\n  }\\n\\n  renderLabels();\\n\\n  // Run a second pass after CSS transition (300ms) completes to ensure final\\n  // layout stability\\n  recalculateLabelsTimerId = setTimeout(() => {\\n    recalculateLabelsTimerId = null;\\n    renderLabels();\\n  }, 320);\\n}\\n\\n/**\\n * Sets the minimized/maximized state of the text panel.\\n * @param {boolean} minimize\\n * @param {boolean=} shouldRecalculateLabels\\n */\\nfunction minimizeTextPanel(minimize, shouldRecalculateLabels = true) {\\n  if (!textPanel) return;\\n  const wasMinimized = isTextPanelMinimized;\\n  if (minimize) {\\n    textPanel.classList.add('minimized');\\n    isTextPanelMinimized = true;\\n  } else {\\n    textPanel.classList.remove('minimized');\\n    isTextPanelMinimized = false;\\n  }\\n  updateTextPanelToggleIcon();\\n\\n  // Recalculate label positions whenever the panel is collapsed or expanded\\n  if (shouldRecalculateLabels && wasMinimized !== isTextPanelMinimized) {\\n    recalculateLabelsForPanelState();\\n  }\\n}\\n\\n/**\\n * Toggles the text panel minimization state from the button click.\\n */\\nfunction toggleTextPanelMinimization() {\\n  if (!textPanel) return;\\n  if (isTextPanelMinimized) {\\n    userCollapsedTextPanel = false;\\n    minimizeTextPanel(false, true);\\n  } else {\\n    userCollapsedTextPanel = true;\\n    minimizeTextPanel(true, true);\\n  }\\n}\\n\\n/**\\n * Updates the toggle icon based on the minimized state.\\n */\\nfunction updateTextPanelToggleIcon() {\\n  const toggleIcon = document.querySelector('#text-panel-toggle .toggle-icon');\\n  if (toggleIcon) {\\n    toggleIcon.innerHTML =\\n        isTextPanelMinimized ? CHEVRON_UP_SVG : CHEVRON_DOWN_SVG;\\n  }\\n}\\n\\n/**\\n * Checks if any visible anchor dots overlap with the text panel,\\n * and automatically minimizes or maximizes the panel accordingly.\\n */\\nfunction checkDotsOverlapWithTextPanel() {\\n  // Automatic collapse on label/dot collision feature has been disabled.\\n  return;\\n}\\n\\n/**\\n * Global click handler for \\\"Explore More\\\" / \\\"Did you know?\\\" buttons inside the text panel.\\n * @param {string} childId\\n */\\nfunction handleExploreMoreClick(childId) {\\n  const childNode = nodesData[childId];\\n  const isRabbitHole = childNode &&\\n      (childNode.nodeType === 'rabbit_hole' ||\\n       (childNode.label && childNode.label.startsWith('\\ud83d\\udc07')));\\n  if (isRabbitHole && window.__deepZoomTour__ &&\\n      window.__deepZoomTour__.isPlaying) {\\n    window.__deepZoomTour__.stop(true);\\n  }\\n  if (typeof zoomToChild === 'function') {\\n    zoomToChild(childId);\\n  }\\n}\\nwindow.handleExploreMoreClick = handleExploreMoreClick;\\n\\n/**\\n * Toggles the collapsed/expanded state of the \\\"Did you know?\\\" card on mobile.\\n * @param {!Event} event\\n * @param {string} childId\\n */\\nfunction handleDidYouKnowToggle(event, childId) {\\n  if (event) {\\n    event.stopPropagation();\\n  }\\n  const card = document.getElementById(`did-you-know-${childId}`);\\n  if (!card) return;\\n  const isExpanded = card.classList.contains('is-expanded');\\n  if (isExpanded) {\\n    card.classList.remove('is-expanded');\\n    card.classList.add('is-collapsed');\\n    const chevron = card.querySelector('.did-you-know-chevron');\\n    if (chevron) chevron.innerHTML = CHEVRON_DOWN_SVG;\\n  } else {\\n    card.classList.remove('is-collapsed');\\n    card.classList.add('is-expanded');\\n    const chevron = card.querySelector('.did-you-know-chevron');\\n    if (chevron) chevron.innerHTML = CHEVRON_UP_SVG;\\n  }\\n\\n  // Auto-expand mobile text panel height to fit the expanded rabbit hole without scrolling\\n  const anyExpanded = document.querySelector('.did-you-know-card.is-expanded') !== null;\\n  if (textPanel) {\\n    textPanel.classList.toggle('has-expanded-rabbit-hole', anyExpanded);\\n  }\\n  document.body.classList.toggle('has-expanded-rabbit-hole', anyExpanded);\\n}\\nwindow.handleDidYouKnowToggle = handleDidYouKnowToggle;\\n\\n/**\\n * Handles click on the \\\"Did you know?\\\" card container.\\n * Expands on mobile if collapsed; otherwise navigates to the rabbit hole.\\n * @param {!Event} event\\n * @param {string} childId\\n */\\nfunction handleDidYouKnowClick(event, childId) {\\n  if (event.target.closest('.did-you-know-toggle-btn') || event.target.closest('.did-you-know-chevron')) {\\n    return;\\n  }\\n  const card = document.getElementById(`did-you-know-${childId}`);\\n  const isMobile = window.innerWidth <= 640 || isMobileApp || (window.innerWidth <= 912 && window.innerHeight < window.innerWidth);\\n  if (isMobile && card && card.classList.contains('is-collapsed')) {\\n    handleDidYouKnowToggle(event, childId);\\n    return;\\n  }\\n  handleExploreMoreClick(childId);\\n}\\nwindow.handleDidYouKnowClick = handleDidYouKnowClick;\\n\\n\\n/**\\n * Restores text panel to its default stylesheet positioning.\\n */\\nfunction restoreTextPanel() {\\n  restoreFloatingNodeElements();\\n  if (textPanel) {\\n    textPanel.classList.remove('floating-active');\\n    textPanel.style.position = '';\\n    textPanel.style.top = '';\\n    textPanel.style.left = '';\\n    textPanel.style.bottom = '';\\n    textPanel.style.right = '';\\n    textPanel.style.transform = '';\\n    textPanel.style.maxHeight = '';\\n    textPanel.style.overflowY = '';\\n    textPanel.style.overflow = '';\\n\\n    const contentEl = textPanel.querySelector('.text-panel-content');\\n    if (contentEl) {\\n      contentEl.style.maxHeight = '';\\n      contentEl.style.overflowY = '';\\n    }\\n  }\\n}\\n\\n/**\\n * Detects if the viewport represents a mobile device (portrait or landscape).\\n * @return {boolean}\\n */\\nfunction isMobileViewport() {\\n  const isMobilePortrait =\\n      window.innerWidth <= 640 && window.innerHeight > window.innerWidth;\\n  const isMobileLandscape =\\n      window.innerWidth <= 912 && window.innerHeight < window.innerWidth;\\n  return isMobilePortrait || isMobileLandscape || isMobileApp;\\n}\\n\\n/**\\n * Positions text panel beneath the clicked leaf node's dot.\\n * @param {string} childId\\n */\\nfunction repositionFloatingPanel(childId) {\\n    if (isMobileViewport()) {\\n    restoreTextPanel();\\n  } else {\\n    repositionFloatingPanelToDot(`dot-${childId}`);\\n  }\\n}\\n\\n/**\\n * Calculates the projected viewport coordinate of the terminal node's anchor\\n * dot on the zoomed child image.\\n * @return {?{x: number, y: number}}\\n */\\nfunction getTerminalDotPosition() {\\n  const childNode = nodesData[currentNodeId];\\n  if (!childNode || !childNode.zoomedBox || !childNode.labelPosition) {\\n    return null;\\n  }\\n  const [yMin, xMin, yMax, xMax] = childNode.zoomedBox;\\n  const pos = childNode.labelPosition;\\n\\n  const boxWidth = Math.max(1, xMax - xMin);\\n  const boxHeight = Math.max(1, yMax - yMin);\\n  const rx = (pos.anchorX - xMin) / boxWidth;\\n  const ry = (pos.anchorY - yMin) / boxHeight;\\n\\n  if (isImmersiveMode) {\\n    const {width: naturalWidth, height: naturalHeight} =\\n        getNaturalDimensions(currentNodeId);\\n    const containerRect = mainContainer.getBoundingClientRect();\\n    const offsetX =\\n        (containerRect.width - naturalWidth * currentImmersiveScale) / 2;\\n    const offsetY =\\n        (containerRect.height - naturalHeight * currentImmersiveScale) / 2;\\n    return {\\n      x: offsetX + rx * (naturalWidth * currentImmersiveScale),\\n      y: offsetY + ry * (naturalHeight * currentImmersiveScale)\\n    };\\n  }\\n\\n  const rect = mainImage.getBoundingClientRect();\\n  const containerRect = mainContainer.getBoundingClientRect();\\n\\n  return {\\n    x: (rect.left - containerRect.left) - currentImmersiveX + rx * rect.width,\\n    y: (rect.top - containerRect.top) - currentImmersiveY + ry * rect.height\\n  };\\n}\\n\\n/**\\n * Anchors the text panel below a specific dot element.\\n * @param {string} dotId\\n */\\nfunction repositionFloatingPanelToDot(dotId) {\\n  const dotEl = document.getElementById(dotId);\\n  if (!dotEl) return;\\n\\n  const dotRect = dotEl.getBoundingClientRect();\\n  const viewportWidth = window.innerWidth;\\n  const viewportHeight = window.innerHeight;\\n\\n  textPanel.classList.add('floating-active');\\n  if (isTextPanelMinimized) {\\n    minimizeTextPanel(false);\\n  }\\n  textPanel.style.setProperty('position', 'absolute', 'important');\\n\\n  // Measure title offset dynamically\\n  const titleEl = textPanel.querySelector('.text-panel-title, h1, h2, h3');\\n  let titleOffset = 50;  // Fallback\\n  if (titleEl) {\\n    const panelRect = textPanel.getBoundingClientRect();\\n    const titleRect = titleEl.getBoundingClientRect();\\n    titleOffset = (titleRect.top - panelRect.top) + (titleRect.height / 2);\\n  }\\n\\n  const dotOffset = 16;\\n  const dotCenterY = dotRect.top + dotRect.height / 2;\\n\\n  // Align vertically: title center aligns with dot center\\n  let top = dotCenterY - titleOffset;\\n  const panelHeight = textPanel.offsetHeight || 250;\\n\\n  if (top + panelHeight > viewportHeight - 16) {\\n    top = viewportHeight - panelHeight - 16;\\n  }\\n  top = Math.max(16, top);\\n\\n  textPanel.style.setProperty('top', `${top}px`, 'important');\\n  textPanel.style.setProperty('bottom', 'auto', 'important');\\n\\n  // Align horizontally: to the right of the dot\\n  let left = dotRect.right + dotOffset;\\n  const panelWidth = textPanel.offsetWidth || 400;\\n\\n  if (left + panelWidth > viewportWidth - 16) {\\n    left = viewportWidth - panelWidth - 16;\\n  }\\n  left = Math.max(16, left);\\n\\n  textPanel.style.setProperty('left', `${left}px`, 'important');\\n\\n  textPanel.style.setProperty('overflow', 'visible', 'important');\\n\\n  const maxH = viewportHeight - top - 16;\\n  const contentEl = textPanel.querySelector('.text-panel-content');\\n  if (contentEl) {\\n    contentEl.style.setProperty('max-height', `${maxH}px`, 'important');\\n    contentEl.style.setProperty('overflow-y', 'auto', 'important');\\n  }\\n}\\n\\n/**\\n * Updates the floating position of the text panel to follow its active dot.\\n */\\nfunction updateActiveFloatingPanelPosition() {\\n  if (!textPanel ||\\n      !textPanel.classList.contains('floating-active')) {\\n    return;\\n  }\\n  const childNode = nodesData[currentNodeId];\\n  if (!childNode) return;\\n  const isTerminal = childNode.childrenIds.length === 0;\\n\\n  if (isTerminal) {\\n    repositionFloatingPanelToDot(`dot-${currentNodeId}`);\\n    if (!isMobileViewport()) {\\n      const dotEl = document.getElementById(`dot-${currentNodeId}`);\\n      if (dotEl) dotEl.classList.add('floating-node-hidden');\\n    }\\n  } else if (pinnedChildId) {\\n    repositionFloatingPanelToDot(`dot-${pinnedChildId}`);\\n    if (!isMobileViewport()) {\\n      hideFloatingNodeElements(pinnedChildId);\\n    }\\n  }\\n}\\n\\n/**\\n * Renders a single active locator dot for the terminal node on screen and\\n * anchors text panel to it.\\n */\\nfunction renderTerminalDot() {\\n  const childNode = nodesData[currentNodeId];\\n  if (!childNode) return;\\n\\n  const dotPos = getTerminalDotPosition();\\n  if (!dotPos) return;\\n\\n  labelsSvg.innerHTML = '';\\n\\n  const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\\n  dot.setAttribute('id', `dot-${currentNodeId}`);\\n  dot.setAttribute('class', 'anchor-dot terminal-node highlight pinned');\\n  dot.setAttribute('cx', dotPos.x);\\n  dot.setAttribute('cy', dotPos.y);\\n\\n  const strokeWidth = isImmersiveMode ? 6 : 5;\\n  const dotRadius = isImmersiveMode ? 9 : 7.5;\\n  dot.setAttribute('r', dotRadius);\\n  dot.style.strokeWidth = `${strokeWidth}px`;\\n  dot.setAttribute('stroke-width', strokeWidth);\\n  dot.setAttribute('fill', '#fff');\\n  dot.setAttribute('stroke', 'rgba(255, 255, 255, 0.6)');\\n\\n  if (childNode.label) {\\n    const titleEl =\\n        document.createElementNS('http://www.w3.org/2000/svg', 'title');\\n    titleEl.textContent = stripRabbitEmoji(childNode.label);\\n    dot.appendChild(titleEl);\\n  }\\n\\n  labelsSvg.appendChild(dot);\\n\\n  requestAnimationFrame(() => {\\n    repositionFloatingPanelToDot(`dot-${currentNodeId}`);\\n    if (!isMobileViewport()) {\\n      dot.classList.add('floating-node-hidden');\\n    }\\n  });\\n}\\n\\n\\n\\n/**\\n * Hides the dot, dashed line, and label when an active floating terminal panel is shown.\\n * @param {string} childId\\n */\\nfunction hideFloatingNodeElements(childId) {\\n  const label = document.getElementById(`label-${childId}`);\\n  const line = document.getElementById(`line-${childId}`);\\n  const dot = document.getElementById(`dot-${childId}`);\\n  const lineHit = document.getElementById(`line-hit-${childId}`);\\n  const dotHit = document.getElementById(`dot-hit-${childId}`);\\n  [label, line, dot, lineHit, dotHit].forEach(el => {\\n    if (el) {\\n      el.classList.add('floating-node-hidden');\\n    }\\n  });\\n}\\n\\n/**\\n * Restores visibility for any hidden floating terminal node elements.\\n * @param {string=} childId\\n */\\nfunction restoreFloatingNodeElements(childId) {\\n  if (!childId) {\\n    document.querySelectorAll('.floating-node-hidden').forEach(el => {\\n      el.classList.remove('floating-node-hidden');\\n    });\\n    return;\\n  }\\n  const label = document.getElementById(`label-${childId}`);\\n  const line = document.getElementById(`line-${childId}`);\\n  const dot = document.getElementById(`dot-${childId}`);\\n  const lineHit = document.getElementById(`line-hit-${childId}`);\\n  const dotHit = document.getElementById(`dot-hit-${childId}`);\\n  [label, line, dot, lineHit, dotHit].forEach(el => {\\n    if (el) {\\n      el.classList.remove('floating-node-hidden');\\n    }\\n  });\\n}\\n\\n/** Unpins leaf. */\\nfunction unpinLeaf() {\\n  if (pinnedChildId) {\\n    restoreFloatingNodeElements(pinnedChildId);\\n    setPinnedClass(pinnedChildId, false);\\n    highlightLabel(pinnedChildId, false);\\n    hideHoverOverlay();\\n    restoreTextPanel();\\n    const currentText = nodesData[currentNodeId].text;\\n    updateTextPanel(currentText, currentNodeId);\\n    pinnedChildId = null;\\n    hoveringChildId = null;\\n  }\\n}\\n\\n/**\\n * Pins leaf.\\n * @param {string} childId\\n */\\nfunction pinLeaf(childId) {\\n  const childNode = nodesData[childId];\\n  if (pinnedChildId === childId) {\\n    unpinLeaf();\\n    return;\\n  }\\n  if (pinnedChildId) {\\n    restoreFloatingNodeElements(pinnedChildId);\\n    setPinnedClass(pinnedChildId, false);\\n    highlightLabel(pinnedChildId, false);\\n  }\\n  restoreTextPanel();\\n  pinnedChildId = childId;\\n  hoveringChildId = childId;\\n  highlightLabel(childId, true);\\n  setPinnedClass(childId, true);\\n  showHoverOverlay(childId);\\n  if (childNode.hoverSrc) {\\n    mainImage.src = childNode.hoverSrc;\\n    document.body.classList.add('widget-content-loaded');\\n  }\\n  updateTextPanel(childNode.text, childId);\\n\\n  if (typeof emitUserInteraction === 'function') {\\n    const currNode = typeof nodesData !== 'undefined' && currentNodeId ?\\n        nodesData[currentNodeId] :\\n        null;\\n    emitUserInteraction('PIN_LEAF', {\\n      childId: childId,\\n      label: childNode.label,\\n      currentNodeId: currentNodeId,\\n      currentNodeName: currNode ? currNode.label : '',\\n    });\\n  }\\n\\n  // Automatically expand text panel when user taps on a leaf node\\n  userCollapsedTextPanel = false;\\n  minimizeTextPanel(false);\\n\\n  const isTerminal = childNode.childrenIds.length === 0;\\n  if (isTerminal && !isMobileViewport()) {\\n    repositionFloatingPanel(childId);\\n    hideFloatingNodeElements(childId);\\n  }\\n}\\n\\n/**\\n * Calculates dynamic transition duration based on distance and scale difference.\\n * Zooming out is boosted to be 30% faster.\\n * @param {number} translateX\\n * @param {number} translateY\\n * @param {number} scale\\n * @param {boolean=} isZoomOut\\n * @return {number} The computed duration in milliseconds.\\n */\\n\\n\\n/**\\n * @fileoverview Dynamic zoom duration curve, zoomToChild forward animation,\\n * zoomToParent backward animation with re-entrancy guard, and zoomToAncestor\\n * multi-layer jump.\\n */\\n\\n/**\\n * Calculates dynamic transition duration based on pan distance and zoom scale.\\n * @param {number} translateX\\n * @param {number} translateY\\n * @param {number} scale\\n * @param {boolean=} isZoomOut\\n * @return {number}\\n */\\nfunction getDynamicDuration(translateX, translateY, scale, isZoomOut = false) {\\n  const distPx = Math.sqrt(translateX * translateX + translateY * translateY);\\n  const scaleRatio = Math.max(scale, 1 / scale);\\n  const logScale = Math.log2(scaleRatio);\\n  const baseDuration = Math.round(400 + distPx * 0.25 + logScale * 60);\\n\\n  if (isZoomOut) {\\n    const computedBase = Math.min(780, Math.max(400, baseDuration));\\n    return Math.min(540, Math.max(280, Math.round(computedBase * 0.70)));\\n  }\\n\\n  return Math.min(780, Math.max(400, baseDuration));\\n}\\n\\n/**\\n * Dynamically compares the child image against the parent's cropped region\\n * inside a canvas. Returns true if the child image is visually similar (static\\n * zoom-in crop).\\n *\\n * How it works:\\n * 1. Downsamples the parent's crop region and the child's image to two 32x32\\n * canvases.\\n * 2. Normalizes pixel colors to grayscale luminosity values (0.0 to 1.0).\\n * 3. Calculates the Mean Squared Error (MSE) of the pixel arrays.\\n *    MSE represents the average squared difference in pixel brightness.\\n *    - MSE = 0.0: Pixel-for-pixel identical.\\n *    - MSE < 0.02: Visually very similar (usually same image with minor\\n * compression noise).\\n *    - MSE >= 0.02: Visually different (contains newly generated visual\\n * structures).\\n// Zoom transition to child node\\n/**\\n * Zooms to child.\\n * @param {string} childId\\n */\\nasync function zoomToChild(childId) {\\n  const childNode = nodesData[childId];\\n  if (!childNode) return;\\n\\n  const isRabbitHole = childNode.nodeType === 'rabbit_hole' ||\\n      (childNode.label && childNode.label.startsWith('\\ud83d\\udc07'));\\n\\n  if (isRabbitHole && window.__deepZoomTour__ &&\\n      (window.__deepZoomTour__.isPlaying ||\\n       window.__deepZoomTour__.isTourMode)) {\\n    window.__deepZoomTour__.stop(true, true);\\n  }\\n\\n  if (isAnimating) {\\n    if (isRabbitHole ||\\n        (regionHighlight &&\\n         parseFloat(regionHighlight.style.opacity || '0') > 0)) {\\n      clearActiveTransitions();\\n      if (regionHighlight) {\\n        regionHighlight.style.transition = 'none';\\n        regionHighlight.style.opacity = '0';\\n      }\\n      isAnimating = false;\\n    } else {\\n      Logger.log('\\u27a1\\ufe0f zoomToChild ignored: isAnimating is true');\\n      return;\\n    }\\n  }\\n\\n  const videoClipUrl = childNode.video_clip || childNode.videoClip || childNode.videoSrc || childNode.video_url || childNode.videoUrl;\\n\\n  const isTerminal =\\n      !childNode.childrenIds || childNode.childrenIds.length === 0;\\n  if (isTerminal && !isRabbitHole) {\\n    Logger.log('\\u27a1\\ufe0f zoomToChild early exit: childNode is terminal (no children)');\\n    pinLeaf(childId);\\n    return;\\n  }\\n\\n  Logger.log('\\u27a1\\ufe0f zoomToChild started for childId:', childId);\\n\\n  // Audio Tour Mode auto-advance:\\n  const isTourActive = window.__deepZoomTour__ &&\\n      (window.__deepZoomTour__.isTourMode ||\\n       window.__deepZoomTour__.isPlaying) &&\\n      !window.__deepZoomTour__.isExecutingTimelineZoom;\\n  const childHasTour =\\n      isTourActive && window.__deepZoomTour__.hasTourForNode(childId);\\n\\n  if (isTourActive) {\\n    window.__deepZoomTour__.stopCurrentAudioOnly();\\n    if (childHasTour) {\\n      window.__deepZoomTour__.start(childId);\\n    } else {\\n      const playerBox = document.getElementById('tour-player-box');\\n      if (playerBox) playerBox.remove();\\n    }\\n  }\\n\\n  if (typeof emitUserInteraction === 'function') {\\n    const currNode = typeof nodesData !== 'undefined' && currentNodeId ?\\n        nodesData[currentNodeId] :\\n        null;\\n    emitUserInteraction('ZOOM_IN', {\\n      targetNodeId: childId,\\n      label: childNode.label,\\n      currentNodeId: currentNodeId,\\n      currentNodeName: currNode ? currNode.label : '',\\n    });\\n  }\\n  isAnimating = true;\\n  cancelNudge();\\n  dismissOnboardingTooltip();\\n\\n  const isMobilePortrait =\\n      window.innerWidth <= 640 && window.innerHeight > window.innerWidth;\\n  const zoomBuffer = isMobilePortrait ? 1 : IMMERSIVE_ZOOM_BUFFER;\\n\\n  // Evict old preloads on new navigation\\n  evictPreloadedImages();\\n\\n  // Reset cursor and hide tooltip immediately\\n  mainImage.style.cursor = '';\\n  if (urlTooltip) urlTooltip.style.display = 'none';\\n\\n  // Unpin leaf immediately on navigation to prevent lingering descriptions\\n  if (pinnedChildId) {\\n    unpinLeaf();\\n  }\\n  restoreTextPanel();\\n\\n  // Fade out UI immediately for visual block\\n  [labelsContainer, labelsSvg, miniMapContainer].forEach(el => {\\n    if (el) {\\n      el.style.transition = UI_ELEMENT_FADE_IN;\\n      el.style.opacity = '0';\\n      el.style.pointerEvents = 'none';\\n    }\\n  });\\n  if (textPanel) {\\n    if (childHasTour) {\\n      textPanel.style.display = '';\\n      textPanel.style.transition = 'opacity 200ms ease-in';\\n      textPanel.style.opacity = '1';\\n      textPanel.style.pointerEvents = 'auto';\\n      textPanel.style.zIndex = '500';\\n    } else {\\n      textPanel.style.transition = 'none';\\n      textPanel.style.opacity = '0';\\n      textPanel.style.pointerEvents = 'none';\\n      if (!childNode.text || childNode.text.trim().length === 0) {\\n        textPanel.style.display = 'none';\\n        textPanel.innerHTML = '';\\n      }\\n    }\\n  }\\n\\n  // If node has video clip data, play video clip and bypass existing image transition animation\\n  if (videoClipUrl) {\\n    Logger.log('\\ud83c\\udfac Playing video clip for childId:', childId, videoClipUrl);\\n    clearActiveTransitions();\\n    const isTourPlayingNow = !!(window.__deepZoomTour__ && (window.__deepZoomTour__.isPlaying || window.__deepZoomTour__.isTourMode));\\n    if (!isTourPlayingNow) {\\n      pauseAudioForTransition();\\n    }\\n    hideHoverOverlay();\\n\\n    // Start background preloading of child image and child's children masks (do NOT touch mainImage.src here)\\n    let childImgLoaded = null;\\n    if (childNode.imageSrc) {\\n      preloadAsset(childNode.imageSrc).then(img => {\\n        childImgLoaded = img;\\n      });\\n    }\\n    if (childNode.childrenIds) {\\n      childNode.childrenIds.forEach(id => {\\n        const cNode = nodesData[id];\\n        if (cNode && cNode.maskSrc) {\\n          preloadAsset(cNode.maskSrc);\\n        }\\n      });\\n    }\\n\\n    // Resolve relative path to absolute URL if needed\\n    let resolvedVideoUrl = videoClipUrl;\\n    if (resolvedVideoUrl.startsWith('/')) {\\n      const origin = (window.location.origin && window.location.origin !== 'null') ?\\n          window.location.origin :\\n          (window.parent && window.parent.location && window.parent.location.origin && window.parent.location.origin !== 'null' ?\\n              window.parent.location.origin : '');\\n      if (origin) {\\n        resolvedVideoUrl = origin + resolvedVideoUrl;\\n      }\\n    }\\n\\n    // Remove any previous video transition overlay and skip button\\n    const oldOverlay = document.getElementById('video-transition-overlay');\\n    if (oldOverlay) oldOverlay.remove();\\n    const oldSkipBtn = document.getElementById('video-transition-skip-btn');\\n    if (oldSkipBtn) oldSkipBtn.remove();\\n\\n    // Create video overlay container inside mainContainer with transparent background so parent image stays visible until frame 1 is painted\\n    const videoOverlay = document.createElement('div');\\n    videoOverlay.id = 'video-transition-overlay';\\n    videoOverlay.style.position = 'absolute';\\n    videoOverlay.style.top = '0';\\n    videoOverlay.style.left = '0';\\n    videoOverlay.style.width = '100%';\\n    videoOverlay.style.height = '100%';\\n    videoOverlay.style.zIndex = '300';\\n    videoOverlay.style.backgroundColor = 'transparent';\\n    videoOverlay.style.display = 'flex';\\n    videoOverlay.style.alignItems = 'center';\\n    videoOverlay.style.justifyContent = 'center';\\n    videoOverlay.style.overflow = 'hidden';\\n    videoOverlay.style.borderRadius = isImmersiveMode ? '0' : '32px';\\n    videoOverlay.style.opacity = '0';\\n\\n    const videoEl = document.createElement('video');\\n    videoEl.src = resolvedVideoUrl;\\n    videoEl.style.width = '100%';\\n    videoEl.style.height = '100%';\\n    videoEl.style.objectFit = isImmersiveMode ? 'cover' : 'contain';\\n    videoEl.style.backgroundColor = 'transparent';\\n    videoEl.playsInline = true;\\n    videoEl.controls = false;\\n    if (isTourPlayingNow) {\\n      videoEl.muted = true;\\n      videoEl.volume = 0;\\n    }\\n\\n    // Skip button positioned left to the share and feedback button\\n    const skipBtn = document.createElement('button');\\n    skipBtn.id = 'video-transition-skip-btn';\\n    skipBtn.textContent = 'Skip animation';\\n    skipBtn.setAttribute('title', 'Skip animation');\\n    skipBtn.setAttribute('aria-label', 'Skip animation');\\n    skipBtn.style.padding = isImmersiveMode ? '0 20px' : '0 16px';\\n    skipBtn.style.height = isImmersiveMode ? '48px' : '36px';\\n    skipBtn.style.borderRadius = '999px';\\n    skipBtn.style.backgroundColor = 'rgba(242, 240, 240, 0.6)';\\n    skipBtn.style.color = '#000';\\n    skipBtn.style.border = 'none';\\n    skipBtn.style.outline = 'none';\\n    skipBtn.style.fontSize = isImmersiveMode ? '14px' : '13px';\\n    skipBtn.style.fontFamily = '\\\\'Google Sans Flex\\\\', var(--font-family, \\\"Google Sans\\\", -apple-system, sans-serif)';\\n    skipBtn.style.fontWeight = '400';\\n    skipBtn.style.letterSpacing = '0.1px';\\n    skipBtn.style.cursor = 'pointer';\\n    skipBtn.style.backdropFilter = 'blur(60px)';\\n    skipBtn.style.webkitBackdropFilter = 'blur(60px)';\\n    skipBtn.style.display = 'inline-flex';\\n    skipBtn.style.alignItems = 'center';\\n    skipBtn.style.justifyContent = 'center';\\n    skipBtn.style.boxSizing = 'border-box';\\n    skipBtn.style.zIndex = '10001';\\n    skipBtn.style.pointerEvents = 'auto';\\n    skipBtn.style.opacity = '0';\\n    skipBtn.style.transition = 'background-color 200ms ease, opacity 150ms ease-out';\\n    skipBtn.addEventListener('mouseenter', () => {\\n      skipBtn.style.backgroundColor = 'rgba(242, 240, 240, 0.8)';\\n    });\\n    skipBtn.addEventListener('mouseleave', () => {\\n      skipBtn.style.backgroundColor = 'rgba(242, 240, 240, 0.6)';\\n    });\\n\\n    videoOverlay.appendChild(videoEl);\\n    mainContainer.appendChild(videoOverlay);\\n\\n    // Place skip button to the left of the share and feedback button\\n    const toolbarRight = document.querySelector('#lightbox-toolbar .toolbar-right') || document.querySelector('.toolbar-right');\\n    const feedbackShareGroup = document.getElementById('lightbox-feedback-share-group');\\n    if (toolbarRight && feedbackShareGroup && feedbackShareGroup.parentElement === toolbarRight) {\\n      toolbarRight.insertBefore(skipBtn, feedbackShareGroup);\\n    } else if (toolbarRight) {\\n      toolbarRight.insertBefore(skipBtn, toolbarRight.firstChild);\\n    } else if (feedbackShareGroup && feedbackShareGroup.parentElement) {\\n      feedbackShareGroup.parentElement.insertBefore(skipBtn, feedbackShareGroup);\\n    } else {\\n      skipBtn.style.position = 'absolute';\\n      skipBtn.style.top = '16px';\\n      skipBtn.style.right = '16px';\\n      skipBtn.style.zIndex = '310';\\n      videoOverlay.appendChild(skipBtn);\\n    }\\n\\n    // Fade in overlay and skip button ONLY after the first actual video frame is decoded and painted (prevents black screen flash)\\n    let videoRevealed = false;\\n    const revealVideo = () => {\\n      if (videoRevealed) return;\\n      videoRevealed = true;\\n      videoOverlay.style.transition = 'opacity 120ms ease-out';\\n      videoOverlay.style.opacity = '1';\\n      skipBtn.style.opacity = '1';\\n    };\\n    if (typeof videoEl.requestVideoFrameCallback === 'function') {\\n      videoEl.requestVideoFrameCallback(revealVideo);\\n    }\\n    videoEl.addEventListener('timeupdate', () => {\\n      if (videoEl.currentTime > 0.01) revealVideo();\\n    });\\n\\n    let cleanedUp = false;\\n    let finishResolve = null;\\n    const finishVideoTransition = () => {\\n      if (cleanedUp) return;\\n      cleanedUp = true;\\n      try {\\n        videoEl.pause();\\n      } catch (e) {}\\n\\n      // Fade out skip button\\n      skipBtn.style.transition = 'opacity 100ms ease-out';\\n      skipBtn.style.opacity = '0';\\n      skipBtn.style.pointerEvents = 'none';\\n\\n      const containerRect = mainContainer.getBoundingClientRect();\\n      const isMobilePortrait =\\n          window.innerWidth <= 640 && window.innerHeight > window.innerWidth;\\n      const zoomBuffer = isMobilePortrait ? 1 : IMMERSIVE_ZOOM_BUFFER;\\n\\n      const {width: childNaturalWidth, height: childNaturalHeight} =\\n          (childImgLoaded && childImgLoaded.naturalWidth) ?\\n          {\\n            width: childImgLoaded.naturalWidth,\\n            height: childImgLoaded.naturalHeight\\n          } :\\n          getNaturalDimensions(childId);\\n      const safeChildWidth = Math.max(1, childNaturalWidth || 1777.78);\\n      const safeChildHeight = Math.max(1, childNaturalHeight || 1000);\\n      const childScaleX = containerRect.width / safeChildWidth;\\n      const childScaleY = containerRect.height / safeChildHeight;\\n      const childCoverScale =\\n          (isMobilePortrait ? childScaleY :\\n                              Math.max(childScaleX, childScaleY)) *\\n          zoomBuffer;\\n\\n      // Reset mainImage transform and prepare it beneath the video overlay\\n      mainImage.style.transition = 'none';\\n      mainImage.style.filter = '';\\n      mainImage.style.opacity = '0';\\n      if (isImmersiveMode) {\\n        currentImmersiveX = 0;\\n        currentImmersiveY = 0;\\n        currentImmersiveScale = childCoverScale;\\n        mainImage.style.transform =\\n            `translate(0px, 0px) scale(${childCoverScale})`;\\n        mainImage.style.transformOrigin = '50% 50%';\\n      } else {\\n        mainImage.style.transform = 'scale(1)';\\n        mainImage.style.transformOrigin = 'center center';\\n      }\\n\\n      isAnimating = false;\\n\\n      // Render the target node state\\n      renderNode(childId);\\n\\n      // Force reflow so transition starts cleanly from opacity 0\\n      void mainImage.offsetWidth;\\n\\n      // 100ms smooth transition as background image shows again\\n      mainImage.style.transition = 'opacity 100ms ease-out';\\n      mainImage.style.opacity = '1';\\n\\n      videoOverlay.style.transition = 'opacity 100ms ease-out';\\n      videoOverlay.style.opacity = '0';\\n\\n      const restoreElements = [labelsContainer, labelsSvg, miniMapContainer];\\n      restoreElements.forEach(el => {\\n        if (el) {\\n          el.style.transition = 'opacity 100ms ease-out';\\n          el.style.opacity = '';\\n          el.style.pointerEvents = '';\\n        }\\n      });\\n      if (textPanel && childNode.text && childNode.text.trim().length > 0) {\\n        textPanel.style.transition = 'opacity 100ms ease-out';\\n        textPanel.style.opacity = '';\\n        textPanel.style.pointerEvents = '';\\n      }\\n\\n      setTimeout(() => {\\n        if (videoOverlay.parentElement) {\\n          videoOverlay.parentElement.removeChild(videoOverlay);\\n        }\\n        if (skipBtn.parentElement) {\\n          skipBtn.parentElement.removeChild(skipBtn);\\n        }\\n        mainImage.style.transition = '';\\n\\n        if (isImmersiveMode) {\\n          resetImmersiveViewport();\\n        }\\n\\n        startNudgeTimer();\\n        executePendingZoom();\\n        resumeAudioAfterTransition();\\n        if (finishResolve) {\\n          finishResolve();\\n        }\\n      }, 100);\\n    };\\n\\n    skipBtn.addEventListener('click', (e) => {\\n      e.stopPropagation();\\n      finishVideoTransition();\\n    });\\n\\n    videoEl.addEventListener('ended', finishVideoTransition);\\n\\n    videoEl.addEventListener('error', (e) => {\\n      Logger.log('Video element error, falling back to renderNode:', e);\\n      const fallbackUrl = childNode.video_clip_remote || childNode.video_url;\\n      if (fallbackUrl && fallbackUrl !== videoEl.src && fallbackUrl !== resolvedVideoUrl) {\\n        Logger.log('Retrying with fallback video URL:', fallbackUrl);\\n        videoEl.src = fallbackUrl;\\n        const retryPromise = videoEl.play();\\n        if (retryPromise !== undefined) {\\n          retryPromise.catch(() => finishVideoTransition());\\n        }\\n      } else {\\n        finishVideoTransition();\\n      }\\n    });\\n\\n    const playPromise = videoEl.play();\\n    if (playPromise !== undefined) {\\n      playPromise.catch(err => {\\n        Logger.log('Video autoplay with audio failed, retrying muted:', err);\\n        videoEl.muted = true;\\n        videoEl.play().catch(e => {\\n          Logger.log('Muted video playback also failed:', e);\\n          finishVideoTransition();\\n        });\\n      });\\n    }\\n\\n    await new Promise((resolve) => {\\n      finishResolve = resolve;\\n      if (cleanedUp) {\\n        resolve();\\n      }\\n    });\\n    return;\\n  }\\n\\n  if (!childNode.imageSrc) {\\n    Logger.log('\\u27a1\\ufe0f zoomToChild early exit: childNode has no imageSrc');\\n    isAnimating = false;\\n    // Restore UI on early return\\n    labelsContainer.style.opacity = '';\\n    labelsContainer.style.pointerEvents = '';\\n    labelsSvg.style.opacity = '';\\n    labelsSvg.style.pointerEvents = '';\\n    textPanel.style.opacity = '';\\n    textPanel.style.pointerEvents = '';\\n    if (miniMapContainer) {\\n      miniMapContainer.style.opacity = '';\\n      miniMapContainer.style.pointerEvents = '';\\n    }\\n    pinLeaf(childId);\\n    return;\\n  }\\n\\n  // Preload assets before transition\\n  const loader = document.getElementById('lightbox-loading-indicator');\\n  if (loader) {\\n    loader.classList.add('visible');\\n  }\\n\\n  const assetsToPreload = [childNode.imageSrc];\\n  if (childNode.childrenIds) {\\n    childNode.childrenIds.forEach(id => {\\n      const cNode = nodesData[id];\\n      if (cNode && cNode.maskSrc) {\\n        assetsToPreload.push(cNode.maskSrc);\\n      }\\n    });\\n  }\\n\\n  const preloadedResults = await Promise.all(assetsToPreload.map(preloadAsset));\\n  const childImgLoaded = preloadedResults[0];\\n\\n  if (loader) {\\n    loader.classList.remove('visible');\\n  }\\n\\n  const containerRect = mainContainer.getBoundingClientRect();\\n\\n  // Rabbit Hole Transition Animation:\\n  // Fade out current image to the left, turn screen to entire black, and fade in next image from the right.\\n  if (isRabbitHole) {\\n    clearActiveTransitions();\\n    pauseAudioForTransition();\\n    isAnimating = true;\\n    hideHoverOverlay();\\n\\n    // Hide UI\\n    labelsContainer.style.transition = UI_ELEMENT_FADE_IN;\\n    labelsContainer.style.opacity = '0';\\n    labelsSvg.style.transition = UI_ELEMENT_FADE_IN;\\n    labelsSvg.style.opacity = '0';\\n    textPanel.style.transition = UI_ELEMENT_FADE_IN;\\n    textPanel.style.opacity = '0';\\n    if (miniMapContainer) {\\n      miniMapContainer.style.transition = UI_ELEMENT_FADE_IN;\\n      miniMapContainer.style.opacity = '0';\\n    }\\n\\n    // Ensure main container background is solid black\\n    mainContainer.style.backgroundColor = '#000';\\n\\n    const fadeOutDuration = 380;\\n    const fadeInDuration = 260;\\n    const slideOffset = isImmersiveMode ? (containerRect.width * 0.45) : (containerRect.width * 0.35);\\n\\n    // Apply soft gradient mask and blur during transit to avoid sharp edges\\n    const softEdgeMask =\\n        'linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%)';\\n\\n    // 1. Current image fades out to the left with blurred/feathered edges and turns screen to black\\n    mainImage.style.webkitMaskImage = softEdgeMask;\\n    mainImage.style.maskImage = softEdgeMask;\\n    mainImage.style.filter = 'blur(0px)';\\n    mainImage.style.transition = `transform ${fadeOutDuration}ms cubic-bezier(0.4, 0, 1, 1), opacity ${fadeOutDuration}ms ease-out, filter ${fadeOutDuration}ms ease-out`;\\n    if (isImmersiveMode) {\\n      mainImage.style.transform = `translate(${currentImmersiveX - slideOffset}px, ${currentImmersiveY}px) scale(${currentImmersiveScale})`;\\n    } else {\\n      mainImage.style.transform = `translate(${-slideOffset}px, 0px) scale(1)`;\\n    }\\n    mainImage.style.opacity = '0';\\n    mainImage.style.filter = 'blur(20px)';\\n\\n    // Calculate child cover scale for pixel-identical sizing\\n    const {width: childNaturalWidth, height: childNaturalHeight} =\\n        (childImgLoaded && childImgLoaded.naturalWidth) ?\\n        {\\n          width: childImgLoaded.naturalWidth,\\n          height: childImgLoaded.naturalHeight\\n        } :\\n        getNaturalDimensions(childId);\\n    const safeChildWidth = Math.max(1, childNaturalWidth || 1777.78);\\n    const safeChildHeight = Math.max(1, childNaturalHeight || 1000);\\n    const childScaleX = containerRect.width / safeChildWidth;\\n    const childScaleY = containerRect.height / safeChildHeight;\\n    const childCoverScale =\\n        (isMobilePortrait ? childScaleY : Math.max(childScaleX, childScaleY)) *\\n        zoomBuffer;\\n\\n    if (activeTempImage) {\\n      releaseImageElement(activeTempImage);\\n      activeTempImage.remove();\\n    }\\n    const tempImage = document.createElement('img');\\n    activeTempImage = tempImage;\\n    tempImage.src = childNode.imageSrc;\\n    tempImage.style.pointerEvents = 'none';\\n    tempImage.style.position = 'absolute';\\n    tempImage.style.display = 'block';\\n    tempImage.style.webkitMaskImage = softEdgeMask;\\n    tempImage.style.maskImage = softEdgeMask;\\n    tempImage.style.filter = 'blur(20px)';\\n\\n    if (isImmersiveMode) {\\n      tempImage.style.width = 'auto';\\n      tempImage.style.height = 'auto';\\n      tempImage.style.maxWidth = 'none';\\n      tempImage.style.maxHeight = 'none';\\n      tempImage.style.transformOrigin = '50% 50%';\\n      tempImage.style.transform = `translate(${slideOffset}px, 0px) scale(${childCoverScale})`;\\n    } else {\\n      tempImage.style.top = '0';\\n      tempImage.style.left = '0';\\n      tempImage.style.width = '100%';\\n      tempImage.style.height = '100%';\\n      tempImage.style.objectFit = 'contain';\\n      tempImage.style.transformOrigin = 'center center';\\n      tempImage.style.transform = `translate(${slideOffset}px, 0px) scale(1)`;\\n    }\\n    tempImage.style.opacity = '0';\\n    mainContainer.appendChild(tempImage);\\n\\n    await new Promise((resolve) => {\\n      // Wait for the current image to fade out to black (turning screen to\\n      // entire black)\\n      setTrackedTimeout(() => {\\n        if (!isAnimating) {\\n          resolve();\\n          return;\\n        }\\n        // Force reflow\\n        void tempImage.offsetWidth;\\n\\n        // 2. Fade in the next image rapidly from the right, clearing blur to\\n        // crisp center\\n        tempImage.style.transition = `transform ${\\n            fadeInDuration}ms cubic-bezier(0.05, 0.9, 0.2, 1), opacity ${\\n            fadeInDuration}ms ease-out, filter ${fadeInDuration}ms ease-out`;\\n        if (isImmersiveMode) {\\n          tempImage.style.transform =\\n              `translate(0px, 0px) scale(${childCoverScale})`;\\n        } else {\\n          tempImage.style.transform = `translate(0px, 0px) scale(1)`;\\n        }\\n        tempImage.style.opacity = '1';\\n        tempImage.style.filter = 'blur(0px)';\\n\\n        setTrackedTimeout(() => {\\n          if (!isAnimating) {\\n            resolve();\\n            return;\\n          }\\n          // Reset mainImage and clear temporary masks/filters\\n          mainImage.style.transition = 'none';\\n          mainImage.style.filter = '';\\n          mainImage.style.webkitMaskImage = '';\\n          mainImage.style.maskImage = '';\\n          mainImage.style.opacity = '1';\\n          if (isImmersiveMode) {\\n            currentImmersiveX = 0;\\n            currentImmersiveY = 0;\\n            currentImmersiveScale = childCoverScale;\\n            mainImage.style.transform =\\n                `translate(0px, 0px) scale(${childCoverScale})`;\\n            mainImage.style.transformOrigin = '50% 50%';\\n          } else {\\n            mainImage.style.transform = 'scale(1)';\\n            mainImage.style.transformOrigin = 'center center';\\n          }\\n\\n          isAnimating = false;\\n          renderNode(childId);\\n\\n          setTrackedTimeout(() => {\\n            mainImage.style.transition = TRANSITION_IMAGE_DEFAULT;\\n            if (miniMapContainer) {\\n              miniMapContainer.style.transition = UI_ELEMENT_FADE_IN;\\n              miniMapContainer.style.opacity = '';\\n              miniMapContainer.style.pointerEvents = '';\\n            }\\n            textPanel.style.transition = 'none';\\n           