.oa.value||a.hf.set(!1);_.wuh(a,_.suh);if(!a.VK())return uCj(a),!1;_.i4(a,\"User Pressed Send\");if(b&&_.nth(a.ha.value.state))return wCj(a,b,c),uCj(a),!0;_.mth(a.ha.value.state)||_.nth(a.ha.value.state);_.nth(a.ha.value.state)&&_.Hwh(a);a.Zb=void 0;a.ha.next({state:\"WAITING_FOR_MODEL\"});uCj(a);return b===void 0};var BCj=function(){var a=zCj||(zCj=ACj('[[[\"78c9384d-e07a-4122-8ef3-f71551737094\",\"Summarize as text\",\"Understand\",\"\\ud83d\\udcdd\",\"Objective: Analyze the current webpage and generate a concise summary\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * If content seems elided or behind a login screen, mention that your summary may not be complete.\\\\n\\\\n2. **Key takeaway selection**: If you find meaningful content, summarize no more than 5 standalone insights that:\\\\n\\\\n    * Can be understood without reading the full article\\\\n    * Represent distinct points (not variations of the same idea)\\\\n    * Prioritize facts, findings, or actionable information over background context\\\\n    * Prioritize meaningful content. The objective is to provide content important to the user.\\\\n\\\\n3. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n4. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    Include two sections in your response:\\\\n    * **Overview**: no more than 2 sentences (~50 words) answering \\\\\"What is this?\\\\\" and \\\\\"Why does it matter?\\\\\"\\\\n    * **Key takeaways**: No more than 5 bullet points (~20 words each), each a complete standalone thought. Optimize for scanability by identifying a short label that summarizes the bullet. Display it in bold before the rest of the explanation.\\\\n\",\"Finds the core argument and identifies key takeaways from a webpage.\",null,\"https://www.gstatic.com/chrome/skills/images/summarize_as_text.png\",null,\"SummarizeAsText\"],[\"fab8dd2c-16e5-4401-a090-68a542d421c0\",\"Explain simply\",\"Understand\",\"\\ud83d\\udc76\",\"Objective: Transform complex content into a simple explanation a 5 year old could understand\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Assess complexity**\\\\n\\\\n    * Identify technical terms, jargon, or specialized vocabulary\\\\n    * Note assumed knowledge or prerequisites\\\\n\\\\n3. **Make abstract concepts concrete with analogies**\\\\n\\\\n    * Connect to everyday experiences (for example, playground, kitchen, family)\\\\n    * Use physical objects to represent abstract ideas\\\\n    * Create simple cause-and-effect relationships\\\\n\\\\n4. **Rewrite using language accessible to a kindergarten student**\\\\n\\\\n    * Replace jargon with common words\\\\n    * Shorten sentences to one idea each\\\\n    * Use active voice and present tense\\\\n    * Avoid hedging words like \\\\\"might\\\\\", \\\\\"perhaps\\\\\", and \\\\\"arguably\\\\\"\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    Your final response should also be:\\\\n    * 3-5 short paragraphs\\\\n    * Under 200 words total\\\\n    * No jargon or technical terms\\\\n    * At least one concrete analogy\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Simplifies complex text, using analogies suited for a kindergarten level.\",true,\"https://www.gstatic.com/chrome/skills/images/explain_simply.png\",null,\"ExplainSimply\"],[\"c454bcce-a2e0-45a1-a171-18e384a09749\",\"Create an outline\",\"Understand\",\"\\ud83c\\udfd7\\ufe0f\",\"Objective: Create a structured outline for an essay\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Map the logical flow of the content**\\\\n\\\\n    * Identify major sections or shifts in topic\\\\n    * Find supporting arguments for each main point\\\\n    * Note evidence types used (data, examples, expert opinion, logic)\\\\n\\\\n3. **Organize into outline format**\\\\n\\\\n    * Place the thesis at the top as the primary idea\\\\n    * Group related points under 3-5 main sections\\\\n    * Add 2-3 supporting points under each main section\\\\n    * Ensure each point is a complete phrase, not just a topic word\\\\n\\\\n4. **Identify the closing argument**\\\\n\\\\n    * Find how the author ties the conclusion back to the thesis\\\\n    * Note any calls to action or implications\\\\n    * Identify and articulate the \\\\\"so what\\\\\" of the argument\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    Your final response should include these sections:\\\\n\\\\n    * **Thesis statement**: One sentence capturing the central argument\\\\n    * **I, II, III...**: Main sections with descriptive headings\\\\n    * **A, B, C...**: Supporting points as complete phrases\\\\n    * **Conclusion**: Summary that connects back to thesis\\\\n    * Total length: no more than 300 words\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Develops a framework to organize the main ideas and supporting points for an essay.\",null,\"https://www.gstatic.com/chrome/skills/images/create_an_outline.png\",null,\"CreateAnOutline\"],[\"15512a16-9f22-4914-8d22-c51f3bf4facb\",\"Action items\",\"Understand\",\"\\u2705\",\"Objective: Summarize tasks, owners, and deadlines\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Look for action verbs often related to an office, like create, send, review, schedule, follow up\\\\n    * Identify commitments made, like \\\\\"I will\\\\\", \\\\\"we agreed\\\\\", and \\\\\"action item\\\\\"\\\\n    * Note requests or assignments like \\\\\"please\\\\\", \\\\\"can you\\\\\", and \\\\\"you\\'ll need to\\\\\"\\\\n\\\\n2. **Determine who is responsible for a task**\\\\n\\\\n    * Find names associated with tasks\\\\n    * Identify role-based assignments like \\\\\"engineering will...\\\\\" or \\\\\"the team should...\\\\\"\\\\n\\\\n3. **Identify deadlines**\\\\n\\\\n    * Find explicit dates or times\\\\n    * Convert relative references like \\\\\"by Friday\\\\\" and \\\\\"next week\\\\\" to specific dates when possible\\\\n    * Note urgency indicators like \\\\\"ASAP\\\\\", \\\\\"before the meeting\\\\\", and \\\\\"blocker\\\\\"\\\\n\\\\n4. **Identify resolved items**\\\\n\\\\n    * Identify conclusions reached, like \\\\\"we decided\\\\\", \\\\\"agreed\\\\\", and \\\\\"approved\\\\\"\\\\n    * Note what was explicitly rejected or deferred\\\\n    * Identify items that need follow-up confirmation\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    Your final response should follow these guidelines:\\\\n\\\\n    * If there are action items, a table with this formatting:\\\\n    * For long bullet lists, optimize for scanability by identifying a short label that summarizes the bullet. Display it in bold before the rest of the explanation.\\\\n\\\\n    | Action Item | Owner | Deadline | Status |\\\\n    | ----- | ----- | ----- | ----- |\\\\n    | [Specific task] | [Name or \\\\\"Not specified\\\\\"] | [Date or \\\\\"Not specified\\\\\"] | [Open/Blocked/Waiting] |\\\\n\\\\n    * If the content includes decisions made, add a section with this formatting:\\\\n    **Decisions made**\\\\n\\\\n    * [Decision 1]\\\\n    * [Decision 2]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Scans text for tasks and generates a list of actions, owners, and status.\",true,\"https://www.gstatic.com/chrome/skills/images/action_items.png\",null,\"ActionItems\"],[\"0a9bd775-da85-413a-935f-6490b33ad7f3\",\"Quotes\",\"Understand\",\"\\ud83d\\udcac\",\"Objective: Identify notable quotes\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Look for direct quotations (in quotation marks)\\\\n    * Identify notable statements and strong declarative statements\\\\n    * Look for surprising, counterintuitive, or memorable phrasing\\\\n\\\\n2. **Prioritize quotes that**\\\\n\\\\n    * Capture a key argument or insight\\\\n    * Represent a surprising or contrarian view\\\\n    * Are quotable (concise, well-phrased, memorable)\\\\n    * Are meaningful without surrounding context\\\\n\\\\n3. **Attribute quotes**\\\\n\\\\n    * Identify the speaker, if possible\\\\n    * Note the speaker\\'s role or relevance\\\\n    * Mark unattributed statements appropriately\\\\n\\\\n4. **Explain each quote\\'s significance**\\\\n\\\\n    * Describe why this statement matters\\\\n    * Note what it reveals or implies\\\\n    * Connect to the broader argument or narrative\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Identify the 5 most notable statements instead\\\\n    * Label as \\\\\"Notable statements\\\\\" rather than \\\\\"Quotes\\\\\"\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    * Show quotes or statements verbatim, and only show text found on the page\\\\n\\\\n    **Format the response as:**\\\\n\\\\n1. **\\\\\"[Quote]\\\\\"** \\u2014 [Attribution]\\\\n\\\\n    *Context: [One sentence explaining significance]*\\\\n\\\\n2. **\\\\\"[Quote]\\\\\"** \\u2014 [Attribution]\\\\n\\\\n    *Context: [One sentence explaining significance]*\\\\n\\\\n    [Continue for up to 5 quotes]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Highlights notable statements from a text and explains why each matters.\",null,\"https://www.gstatic.com/chrome/skills/images/quotes.png\",null,\"Quotes\"],[\"5d52ca69-83d8-4839-ad0a-cd743ebd973f\",\"Build timeline\",\"Understand\",\"\\u23f3\",\"Objective: Construct a chronological sequence of events\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find explicit dates, for example, \\\\\"January 15, 2024\\\\\"; \\\\\"2019\\\\\"; or \\\\\"last Tuesday\\\\\"\\\\n    * Identify relative references, for example, \\\\\"three months later\\\\\", \\\\\"the following year\\\\\"\\\\n    * Note sequence words like \\\\\"first\\\\\", \\\\\"then\\\\\", \\\\\"finally\\\\\", \\\\\"before\\\\\", and \\\\\"after\\\\\"\\\\n\\\\n2. **Identify what happened at each point**\\\\n\\\\n    * Identify the action or occurrence\\\\n    * Note who was involved\\\\n    * Note the significance, if stated\\\\n\\\\n3. **Convert events to specific dates when possible**\\\\n\\\\n    * Use context clues to calculate relative dates\\\\n    * Mark uncertain dates with (?)\\\\n    * Preserve original phrasing when dates can\\'t be determined\\\\n\\\\n4. **Unless there is a strong reason not to, arrange events**\\\\n\\\\n    * Place earliest events first\\\\n    * Group events with the same date/timeframe\\\\n    * Use relative markers (\\\\\"Before X,\\\\\" \\\\\"After Y\\\\\") when exact sequence is known but dates aren\\'t\\\\n\\\\n5. **Cover the entire timeline of events presented on the page**\\\\n\\\\n    * Comprehensiveness is important, so complete timelines with all information available on a webpage\\\\n    * Contextual accuracy is important, so don\\'t add additional events to the timeline that aren\\'t mentioned on the webpage\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Format the response as:**\\\\n\\\\n    **Timeline**\\\\n\\\\n    * **[Date/Timeframe]**: [Event description]\\\\n    * **[Date/Timeframe]**: [Event description]\\\\n    * **[Date/Timeframe]**: [Event description]\\\\n\\\\n    **Notes**\\\\n\\\\n    * [Any dates marked uncertain]\\\\n    * [Any events where sequence is unclear]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Identifies dates to build a chronological sequence of events.\",null,\"https://www.gstatic.com/chrome/skills/images/build_timeline.png\",null,\"BuildTimeline\"],[\"df34c5cc-a049-443a-b4e8-b57f0b9685a8\",\"Opposing view\",\"Understand\",\"\\ud83e\\udd3a\",\"Objective: Construct a compelling counter-argument\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Identify the counter-position**\\\\n\\\\n    * Determine what a thoughtful critic would argue\\\\n    * Find the strongest objections you can\\\\n    * Identify shared ground and points of departure\\\\n\\\\n3. **Show genuine understanding**\\\\n\\\\n    * Start by stating what the original argument gets right\\\\n    * Identify valid concerns the original argument addresses\\\\n    * Demonstrate respect for the position you\\'re arguing against\\\\n\\\\n4. **Build a strong opposing case**\\\\n\\\\n    * Present 2-3 compelling counter-points with reasoning\\\\n    * Use evidence and logic, not emotion or dismissal\\\\n    * Anticipate and address likely rebuttals\\\\n\\\\n5. **Explain the fundamental disagreement**\\\\n\\\\n    * Identify the key assumption or value difference\\\\n    * Show why reasonable people might disagree\\\\n    * Avoid straw-man fallacy or bad-faith interpretation\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Format the response as:**\\\\n\\\\n    **The original position:** [One sentence summary of what the page argues]\\\\n\\\\n    **What this gets right:** [Genuine acknowledgment of valid points]\\\\n\\\\n    **A counter argument**\\\\n\\\\n1. [Counter-point with reasoning]\\\\n\\\\n2. [Counter-point with reasoning]\\\\n\\\\n3. [Counter-point with reasoning]\\\\n\\\\n    **The core disagreement:** [Explanation of the underlying value or assumption difference]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Notes the valid points of an argument and builds a respectful counter-argument.\",null,\"https://www.gstatic.com/chrome/skills/images/opposing_view.png\",null,\"OpposingView\"],[\"7e7bebe8-8125-41dc-a586-fe3b2779087b\",\"Summarize as table\",\"Understand\",\"\\ud83d\\udcca\",\"Objective: Transform unstructured content into tabular format.\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n2. **Identify recurring content**\\\\n\\\\n    * Looking for lists of items with consistent attributes\\\\n    * Finding comparisons (features, prices, specs)\\\\n    * Identifying repeated patterns with consistent fields\\\\n    * Detecting schedules, rankings, or any data with rows and columns\\\\n\\\\n3. **Determine the table structure**\\\\n\\\\n    * Identify what each row represents (products, people, events)\\\\n    * Determine column headers based on repeated attributes\\\\n    * Note which fields are present for all items vs. some items\\\\n\\\\n4. **Identify data**\\\\n\\\\n    * Extract data consistently across all items\\\\n    * Mark missing values with \\\\\"\\u2014\\\\\"\\\\n    * Preserve original formatting for numbers, dates, etc.\\\\n\\\\n5. **Validate the new table**\\\\n\\\\n    * Count total rows extracted\\\\n    * Note source location on the page\\\\n    * Flag any cells that couldn\\'t be filled\\\\n\\\\n6. **Special cases**: If no clear tabular structure exists:\\\\n\\\\n    * Describe possible table formats and ask for preference\\\\n    * Suggest dimensions that could organize the content (by date, by category, by attribute)\\\\n\\\\n7. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n8. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Format the response as:**\\\\n    * Start with a summary sentence that explains in casual and simple terms the source of the information shown in the table. This sentence should include a link to the source.\\\\n    * column labels should appear in bold\\\\n\\\\n    | [Column 1] | [Column 2] | [Column 3] | [Column 4] |\\\\n    | ----- | ----- | ----- | ----- |\\\\n    | [Value] | [Value] | [Value] | [Value] |\\\\n\\\\n    * The left column of the table should provide a sense for how many rows are in the results. This might happen naturally, for example, a list that ranks countries from 1 - 10 on some given criterion. Do nothing in this case. But if the first column of the table doesn\\'t also serve to number rows, add a column to the table on the far left side that doesn\\'t have a column label and that serves as a row counter (starting with 1 and increasing by 1 with each subsequent row).\\\\n    * If, and only if, any cells are missing information, include a section title \\\\\"Missing info\\\\\" and explain why a particular cell might not have a value. If no cells are missing information, don\\'t include this section.\\\\n\\\\n9. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Extracts recurring data from text to create a clean and organized tabular format.\",null,\"https://www.gstatic.com/chrome/skills/images/summarize_as_table.png\",null,\"SummarizeAsTable\"],[\"c862ca98-0a9d-4e30-88b2-40f78b0a6a5c\",\"Executive summary\",\"Writing\",\"\\ud83d\\udc54\",\"Objective: Rewrite with a short and direct executive tone\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Rewrite**:\\\\n\\\\n    * Lead with the main point, assuming the reader may not get past the first sentence\\\\n    * Place recommendations before arguments\\\\n    * Front-load the \\\\\"so what?\\\\\"\\\\n    * Remove hedging words like might, perhaps, arguably, it seems, and somewhat\\\\n    * Change redundant phrases like \\\\\"in order to\\\\\" to \\\\\"to\\\\\"\\\\n    * Trim as many words as possible without losing the core meaning. Aim for a word-count reduction of up to 60%.\\\\n    * Use short bullets, if you think 1) it\\'s the best way to make content scannable and 2) it feels appropriate given the context of the original content. Optimize for scanability by identifying a short label that summarizes the bullet. Display it in bold before the rest of the explanation.\\\\n\\\\n3. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n4. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    * If applicable, include a short sentence that conveys something like \\\\\"I\\'ve shortened the content and focused on key concepts. [Z]% fewer words ([X] vs. [Y])\\\\\"\\\\n\\\\n    **Rewritten text**\\\\n    [Rewritten text]\\\\n\\\\n5. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Condenses text by front-loading results and cutting content for a scannable overview.\",null,\"https://www.gstatic.com/chrome/skills/images/executive_summary.png\",null,\"ExecutiveSummary\"],[\"074f95e0-4b3c-4c54-9ca9-a880c2855806\",\"Rewrite with a friendly tone\",\"Writing\",\"\\ud83e\\udd1d\",\"Objective: Rewrite text with more warmth and empathy\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Identify cold, formal, or demanding language\\\\n    * Find opportunities to acknowledge the reader\\\\n    * Note where softening would help vs. hurt clarity\\\\n\\\\n2. **Add warmth**\\\\n\\\\n    * Acknowledge feelings or situations where appropriate\\\\n    * Add transition phrases that feel conversational\\\\n    * Include appropriate openings and closings\\\\n\\\\n3. **Reframe directive and imperative statements**\\\\n\\\\n    * Replacing \\\\\"you need to\\\\\" with \\\\\"you might consider\\\\\"\\\\n    * Converting commands to requests where appropriate\\\\n    * Adding reasoning to make requests feel collaborative\\\\n\\\\n4. **Ensure tone is genuine**\\\\n\\\\n    * Avoid saccharine or over-the-top warmth\\\\n    * Keep the professional substance intact\\\\n    * Ensure softening doesn\\'t obscure the message\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    **Rewritten:** [Rewritten text with warmer tone]\\\\n\\\\n    **Changes**\\\\n\\\\n    * [What was softened and why]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Softens language with transitions and turns commands into polite requests.\",null,\"https://www.gstatic.com/chrome/skills/images/rewrite_with_a_friendly_tone.png\",null,\"RewriteWithAFriendlyTone\"],[\"8813af92-d198-48f6-afee-73a2c861eb0e\",\"Find synonyms\",\"Writing\",\"\\ud83c\\udfaf\",\"Objective: Generate a range of synonyms\\\\n\\\\n1. **Understand the target word**\\\\n\\\\n    * Identify the part of speech\\\\n    * Read the surrounding sentence for context\\\\n    * Understand the intended meaning in this context\\\\n\\\\n2. **Find 5 alternative words across the tone spectrum**\\\\n\\\\n    * **Casual**: Conversational, everyday usage\\\\n    * **Conversational**: Friendly but not too informal\\\\n    * **Neutral**: Standard, works in any context\\\\n    * **Formal**: Professional, polished\\\\n    * **Academic/Elevated**: Sophisticated, high-register\\\\n\\\\n3. **Connotation explanation**: For each alternative:\\\\n\\\\n    * Explain when to use this option\\\\n    * Note any subtle meaning differences\\\\n    * Flag if the word has unexpected connotations\\\\n\\\\n4. **Recommendation**: Based on context:\\\\n\\\\n    * Suggest the best fit for the surrounding text\\\\n    * Explain why this choice works\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * No word highlighted \\u2192 Ask user to highlight a word\\\\n    * Multiple words selected \\u2192 Offer alternatives for the phrase instead\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **The word:** [highlighted]\\\\n    **Context:** \\\\\"[surrounding sentence]\\\\\"\\\\n\\\\n    **Alternatives**\\\\n\\\\n1. **[word]** *(casual)* \\u2014 [when to use]\\\\n\\\\n2. **[word]** *(conversational)* \\u2014 [when to use]\\\\n\\\\n3. **[word]** *(neutral)* \\u2014 [when to use]\\\\n\\\\n4. **[word]** *(formal)* \\u2014 [when to use]\\\\n\\\\n5. **[word]** *(academic)* \\u2014 [when to use]\\\\n\\\\n    **Recommendation:** Given your context, I\\'d suggest **[word]** because [reason].\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Suggests word choices from casual to academic while explaining best fit.\",null,\"https://www.gstatic.com/chrome/skills/images/find_synonyms.png\",null,\"FindSynonyms\"],[\"39598681-c647-4ed1-9d38-74846fbd4e40\",\"Correct grammar\",\"Writing\",\"\\ud83e\\ude79\",\"Objective: Fix grammatical errors while preserving voice\\\\n\\\\n1. **Study the relevant content**\\\\n\\\\n    * The relevant content is probably a web page the user is viewing, but could also be an uploaded file or pasted text\\\\n    * If there is any text to consider, it\\'s highly likely that you can find grammatical errors worth correcting\\\\n\\\\n2. **Identify grammatical errors, if any**\\\\n\\\\n    * Spelling errors\\\\n    * Grammar mistakes (subject-verb agreement, tense consistency)\\\\n    * Punctuation errors\\\\n    * Word usage errors (their/there/they\\'re)\\\\n\\\\n3. **Preserve the original tone**\\\\n\\\\n    * Don\\'t \\\\\"fix\\\\\" informal but correct phrasing\\\\n    * Preserve style choices (short sentences, fragments for effect)\\\\n    * Keep intentional voice markers\\\\n\\\\n4. **Only fix actual errors**\\\\n\\\\n    * Only improve word choice if the wrong word is used\\\\n    * Only restructure a sentence if grammatically necessary\\\\n    * Preserve the author\\'s rhythm and emphasis\\\\n\\\\n5. **Explain each change**\\\\n\\\\n    * Show original \\u2192 correction\\\\n    * Brief explanation of the rule\\\\n    * Note if the \\\\\"error\\\\\" might be intentional\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Corrected text:** [Full corrected text]\\\\n\\\\n    **Changes made:** [make this a numbered list]\\\\n\\\\n    * **[original]** \\u2192 **[correction, on a new line]** \\u2014 [brief reason, on a new line]\\\\n    * **[original]** \\u2192 **[correction, on a new line]** \\u2014 [brief reason, on a new line]\\\\n\\\\n    **No changes needed:** [List any that looked like errors but are actually fine]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Fixes grammar, spelling, and punctuation while keeping the original tone and voice.\",null,\"https://www.gstatic.com/chrome/skills/images/correct_grammar.png\",null,\"CorrectGrammar\"],[\"12bc1af5-f3db-4d58-a9f3-a920b139d3ec\",\"Shorten text\",\"Writing\",\"\\ud83d\\udddc\\ufe0f\",\"Objective: Reduce word count\\\\n\\\\n1. **Note starting point**\\\\n\\\\n    * Count original words\\\\n    * Identify the core message that must remain\\\\n\\\\n2. **Reduce text without losing meaning**\\\\n\\\\n    * Aim for reducing word count by 50%\\\\n    * Cut repeated points\\\\n    * Remove filler phrases (\\\\\"in order to,\\\\\" \\\\\"the fact that,\\\\\" \\\\\"it is important to note\\\\\")\\\\n    * Eliminate unnecessary qualifiers\\\\n\\\\n3. **Cut supporting material if it doesn\\'t harm comprehension**\\\\n\\\\n    * Remove examples where the point is already clear\\\\n    * Keep only the strongest example if multiple exist\\\\n    * Convert lengthy explanations to concise summaries\\\\n\\\\n4. **Measure new word count**\\\\n\\\\n    * Count final words\\\\n    * Confirm core meaning preserved\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **New word count:** [Y] ([Z]% reduction)\\\\n    **Shortened:** [Compressed text]\\\\n    **Original:** [X] words\\\\n    **What was cut**\\\\n    * [Category of cuts made]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Cuts word count by half, removing filler and redundancy while keeping the meaning.\",null,\"https://www.gstatic.com/chrome/skills/images/shorten_text.png\",null,\"ShortenText\"],[\"2d1ff227-4210-4c07-8a86-9d411031f478\",\"Draft a professional email\",\"Writing\",\"\\ud83d\\udce7\",\"Objective: Convert content to a professional email format\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Determine the intended recipient, if possible\\\\n    * Determine a sense of urgency, if any\\\\n\\\\n2. **Subject line creation**: Write a clear, specific subject:\\\\n\\\\n    * Under 50 characters when possible\\\\n    * Include action verb if requesting something\\\\n    * Be specific enough to stand out in an inbox\\\\n\\\\n3. **Opening construction**\\\\n\\\\n    * Appropriate greeting for the context; one sentence\\\\n    * Get to the point of the email in the second sentence. Consider making this sentence a self-standing paragraph\\\\n\\\\n4. **Structure the rest of the email for scanability**\\\\n\\\\n    * One idea per paragraph\\\\n    * Short paragraphs (2-4 sentences max)\\\\n    * Make action items explicit and easy to find\\\\n    * Favor lists and bold labels if it improves scanability\\\\n\\\\n5. **End appropriately**\\\\n\\\\n    * Match formality to the relationship\\\\n    * Include next steps if applicable\\\\n    * Professional sign-off\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * No selection \\u2192 Ask user to highlight source text\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    **Draft email**\\\\n    Include a horizontal line to separate draft content\\\\n\\\\n    **Subject:** [Clear, specific subject line]\\\\n\\\\n    [Greeting],\\\\n\\\\n    [Body paragraphs]\\\\n\\\\n    [Sign-off],\\\\n    [Name]\\\\n\\\\n    Include a horizontal line to separate the draft content from explanatory text.\\\\n\\\\n    If you think it\\'s useful, with one sentence include any assumptions you made that you think might surprise the user or affect them to modify the draft content.\\\\n    [Any assumptions made about context]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Converts content into a structured email with a subject line and action items.\",null,\"https://www.gstatic.com/chrome/skills/images/draft_a_professional_email.png\",null,\"DraftAProfessionalEmail\"],[\"85336e0c-3047-4bd1-9a91-5c5ef91e9537\",\"Suggest replies\",\"Writing\",\"\\ud83d\\udea6\",\"Objective: Create 3 possible replies\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Note the tone (formal, casual, urgent, sensitive)\\\\n    * Determine what kind of response is expected\\\\n\\\\n2. **Option 1: Craft a quick response**\\\\n\\\\n    * Answers the core question directly\\\\n    * Keeps to 2-3 sentences\\\\n    * Works when you\\'re busy or the answer is simple\\\\n\\\\n3. **Option 2: Complete response**\\\\n\\\\n    * Addresses all points raised\\\\n    * Provides context and detail\\\\n    * Works when thoroughness matters\\\\n\\\\n4. **Option 3: Detailed careful response**\\\\n\\\\n    * Uses measured, thoughtful phrasing\\\\n    * Acknowledges complexity or sensitivity\\\\n    * Works when tone really matters or the situation is delicate\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Context unclear \\u2192 Provide options ranging brief to detailed\\\\n    * No message visible \\u2192 Ask user to navigate to the message\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **In short:** [What you\\'re replying to]\\\\n\\\\n    **Option 1 \\u2014 Brief:** [Quick, to-the-point reply]\\\\n\\\\n    **Option 2 \\u2014 Thorough:** [Complete response addressing all points]\\\\n\\\\n    **Option 3 \\u2014 Diplomatic:** [Careful phrasing for sensitive situations]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Analyzes tone to offer three replies: a quick note, full answer, and diplomatic response.\",null,\"https://www.gstatic.com/chrome/skills/images/suggest_replies.png\",null,\"SuggestReplies\"],[\"8f1d4e14-0e94-415b-b0c1-51020c319f7b\",\"Translate text\",\"Writing\",\"\\ud83c\\udf10\",\"Objective: Translate to specified language\\\\n\\\\n1. **Identify languages**\\\\n\\\\n    * Determine the source language\\\\n    * Confirm the target language (if not specified, use the user agent\\'s configured language)\\\\n    * Note any dialect considerations\\\\n\\\\n2. **Consider context**\\\\n\\\\n    * Preserve the original meaning and tone\\\\n    * Adapt idioms for meaning, not literal translation\\\\n    * Maintain formatting and structure\\\\n    * Identify cultural references that may not translate\\\\n    * Offer alternative phrasings for ambiguous terms\\\\n\\\\n3. **Provide transparency**\\\\n\\\\n    * Note any particularly difficult translations\\\\n    * Offer alternatives for key terms if multiple exist\\\\n    * Identify any meaning that may be lost in translation\\\\n\\\\n4. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * No target language specified \\u2192 Suggest to the user that they can choose a target language\\\\n    * Very long content without selection \\u2192 Ask user to highlight specific text\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Source language:** [detected]\\\\n    **Target language:** [specified or user agent\\'s configured language]\\\\n\\\\n    **Translation:** [translated text]\\\\n\\\\n    **Original:** [source text]\\\\n\\\\n    **Notes:**\\\\n\\\\n    * [Idioms adapted]\\\\n    * [Cultural context if relevant]\\\\n    * [Alternative phrasings for key terms]\\\\n\\\\n6. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Converts text to a target language, adapting idioms while preserving context.\",true,\"https://www.gstatic.com/chrome/skills/images/translate_text.png\",null,\"TranslateText\"],[\"dfe2bafa-d66b-4642-a293-d3a3b71f7afd\",\"Explain slang or jargon\",\"Writing\",\"\\ud83e\\udde2\",\"Objective: Translate slang or jargon to common language\\\\n\\\\n1. **Identify a term or terms to focus on**\\\\n\\\\n    * Has the user highlighted a term?\\\\n    * Determine the context\\\\n    * If the user hasn\\'t indicated a  term, choose a term from the site the user is currently viewing. Do not choose a term yourself.\\\\n\\\\n2. **Professional translation**\\\\n\\\\n    * How to express the same sentiment professionally\\\\n    * Formal alternatives that preserve the meaning\\\\n    * Note any variations in meaning\\\\n\\\\n3. **Define in plain language**\\\\n\\\\n    * What the term actually communicates\\\\n    * The emotional or social connotation\\\\n    * Who typically uses this term\\\\n\\\\n4. **Explain a term\\'s background**\\\\n\\\\n    * Where the term comes from (platform, community, event)\\\\n    * How it evolved or spread\\\\n    * Why it resonates with its users\\\\n\\\\n5. **Advise on appropriate use**\\\\n\\\\n    * When using the original is fine\\\\n    * When to definitely use the professional version\\\\n    * Risk of using it incorrectly\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Term:** \\\\\"[highlighted slang]\\\\\"\\\\n\\\\n    **Professional translation:** [How to say this in a work/formal context]\\\\n\\\\n    **What it actually means:** [Plain-language explanation]\\\\n\\\\n    **Origin/context:** [Where this came from, who uses it]\\\\n\\\\n    **Usage notes:**\\\\n\\\\n    * When it\\'s appropriate to use the original\\\\n    * When to use the professional version\\\\n    * Risk of misuse\\\\n\\\\n    **Example:**\\\\n\\\\n    * Slang: \\\\\"[example sentence]\\\\\"\\\\n    * Professional: \\\\\"[same sentiment, formal language]\\\\\"\\\\n\\\\n    **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Decodes informal terms and their origins while advising on usage and alternatives.\",null,\"https://www.gstatic.com/chrome/skills/images/explain_slang_or_jargon.png\",null,\"ExplainSlangOrJargon\"],[\"6fdc5186-9d49-4434-8305-9ff9357fd382\",\"Check job fit\",\"Research\",\"\\ud83e\\udde4\",\"Objective: Compare a job description with someone\\'s profile\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Identify required skills and qualifications\\\\n    * Identify preferred or bonus qualifications\\\\n    * Identify key responsibilities and scope\\\\n    * Identify experience level and years required\\\\n\\\\n2. **Compare against candidate profile or resume**\\\\n\\\\n    * User provides resume/profile OR skill uses stored context\\\\n    * Match stated skills to required skills\\\\n    * Identify relevant experience for each responsibility\\\\n\\\\n3. **Calculate alignment**\\\\n\\\\n    * Score 0-10 based on requirement coverage\\\\n    * Weight required qualifications more heavily than preferred\\\\n    * Account for adjacent/transferable skills\\\\n\\\\n4. **Identify areas of mismatch**\\\\n\\\\n    * List requirements not met\\\\n    * Categorize gaps as skill gaps, experience gaps, or credential gaps\\\\n    * Suggest how to address each gap in an interview\\\\n\\\\n5. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * Yes / Maybe / Probably not with reasoning\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Fit score:** [X]/10\\\\n    [One sentence explaining the score]\\\\n\\\\n    **Strong matches**\\\\n\\\\n    | Requirement | Your qualification | Match strength |\\\\n    | :---: | :---: | :---: |\\\\n\\\\n    **Possible gaps**\\\\n\\\\n    | Requirement | Gap | How to Address in Interview |\\\\n    | :---: | :---: | :---: |\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n    * Specific ways to help: talking points for an interview, keywords the candidate might use in an interview, how to positively frame gaps\\\\n\",\"Compares a candidate to job requirements to find gaps and an alignment score.\",null,\"https://www.gstatic.com/chrome/skills/images/check_job_fit.png\",null,\"CheckJobFit\"],[\"c8a2ca3c-d1a9-4811-bb2a-496e7002f13d\",\"Prep for today\",\"Research\",\"\\ud83c\\udf05\",\"Objective: Create a morning briefing based on today\\'s calendar\\\\n\\\\n1. **Scan calendar for today\\'s schedule**\\\\n\\\\n    * All events with times and durations\\\\n    * Meeting titles and attendees\\\\n    * Location or video links\\\\n    * If on calendar.google.com, avoid linking to individual events because it won\\'t work\\\\n\\\\n2. **Identify preparation requirements**\\\\n\\\\n    * Meetings requiring pre-reads or materials\\\\n    * Conversations needing talking points\\\\n    * Decisions to be made\\\\n\\\\n3. **Find gaps for focused work**\\\\n\\\\n    * Gaps between meetings over 60 minutes\\\\n    * Morning vs. afternoon availability\\\\n    * Back-to-back stretches to flag\\\\n\\\\n4. **Note logistical concerns**\\\\n\\\\n    * Tight transitions between meetings\\\\n    * Location changes requiring travel\\\\n    * Unusual scheduling (early/late meetings)\\\\n\\\\n5. **Order tasks**\\\\n\\\\n    * Most important meeting preparation first\\\\n    * Time-sensitive items flagged\\\\n    * Quick wins vs. substantial prep\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Today\\'s schedule:**\\\\n\\\\n    | Time | Event | Prep Needed |\\\\n    | :---: | :---: | :---: |\\\\n\\\\n    **Focus blocks:** [Best times for deep work]\\\\n\\\\n    **Heads up**\\\\n\\\\n    * [Tight transitions]\\\\n    * [Back-to-back stretches]\\\\n    * [Anything unusual]\\\\n\\\\n    **Top 3 things to prepare:**\\\\n\\\\n1. [Most important prep item]\\\\n\\\\n2. [Second priority]\\\\n\\\\n3. [Third priority]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Highlights meeting prep, tight transitions, and focused work from your calendar.\",null,\"https://www.gstatic.com/chrome/skills/images/prep_for_today.png\",null,\"PrepForToday\"],[\"6c2b3484-7fdb-403c-89b7-168ca65890e6\",\"Prep for meeting\",\"Research\",\"\\ud83d\\udcbc\",\"Objective: Prepare for a specific meeting\\\\n\\\\n1. **Identify meeting details**\\\\n\\\\n    * Title, time, and duration\\\\n    * Attendees and their roles (if visible)\\\\n    * Description and agenda items\\\\n    * Attached documents or links\\\\n\\\\n2. **Identify topics to cover**\\\\n\\\\n    * Explicit agenda items from description\\\\n    * Inferred topics from title and context\\\\n    * Questions likely to come up\\\\n\\\\n3. **List things to prepare**\\\\n\\\\n    * Documents to review beforehand\\\\n    * Data or metrics to have accessible\\\\n    * Decisions that may be requested\\\\n\\\\n4. **Anticipate questions that might get raised**\\\\n\\\\n    * Questions that show you\\'re prepared\\\\n    * Questions that move the conversation forward\\\\n    * Forward-looking questions about next steps\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Not an event page \\u2192 Direct to calendar event\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Meeting:** [Title]\\\\n    **When:** [Time and duration]\\\\n\\\\n    **Attendees** [List with roles if visible]\\\\n\\\\n    **Agenda:** [Extracted or inferred topics]\\\\n\\\\n    **Prep**\\\\n\\\\n    * [ ] [What to review beforehand]\\\\n    * [ ] [Documents to have ready]\\\\n    * [ ] [Questions to prepare answers for]\\\\n\\\\n    **Questions to prepare**\\\\n\\\\n1. [Shows you\\'re prepared]\\\\n\\\\n2. [Moves things forward]\\\\n\\\\n3. [Forward-looking]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Extracts agenda items and documents to review while anticipating meeting questions.\",null,\"https://www.gstatic.com/chrome/skills/images/prep_for_meeting.png\",null,\"PrepForMeeting\"],[\"03c53ad8-6aa2-4999-96c4-02e951506f07\",\"Research a company\",\"Research\",\"\\ud83c\\udfe2\",\"Objective: Generate quick company facts and talking points\\\\n\\\\n1. **Background info**\\\\n\\\\n    * What the company does\\\\n    * Size (employees, revenue if available)\\\\n    * Date founded and location\\\\n\\\\n2. **Understand market position**\\\\n\\\\n    * Target customers\\\\n    * Value proposition\\\\n    * Missions statement\\\\n    * Key competitors\\\\n    * Differentiators\\\\n\\\\n3. **Recent activity**\\\\n\\\\n    * Recent news or announcements\\\\n    * Product launches\\\\n    * Leadership changes\\\\n    * Funding rounds\\\\n\\\\n4. **Talking points**\\\\n\\\\n    * What makes this company interesting\\\\n    * Questions a smart candidate would ask\\\\n    * Industry trends relevant to the company\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Not a company page \\u2192 Direct to About page, LinkedIn, or Crunchbase\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Background**\\\\n\\\\n    * What they do: [one sentence]\\\\n    * Size: [employees if available]\\\\n    * Founded: [when, where]\\\\n\\\\n    **Positioning:**\\\\n\\\\n    * Customers: [who they serve]\\\\n    * Value prop: [what they offer]\\\\n    * Competitors: [if identifiable]\\\\n\\\\n    **Recent news:** [Any visible announcements or developments]\\\\n\\\\n    **Talking points:**\\\\n\\\\n    * [Intelligent observation #1]\\\\n    * [Intelligent observation #2]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Compiles business facts, market position, and news to develop speaking points.\",null,\"https://www.gstatic.com/chrome/skills/images/research_a_company.png\",null,\"ResearchACompany\"],[\"e1d08936-d695-48e7-a903-6bd88b4d3097\",\"Weekly work review\",\"Research\",\"\\ud83c\\udfc1\",\"Objective: Generate a weekly work reflection and carryover summary\\\\n\\\\n1. **Analyze content**\\\\n\\\\n    * Notes, task list, calendar, or document\\\\n    * Time period covered\\\\n    * Type of work represented\\\\n\\\\n2. **Identify accomplishments**\\\\n\\\\n    * Tasks completed\\\\n    * Progress made on larger initiatives\\\\n    * Problems solved\\\\n    * Meetings or decisions concluded\\\\n\\\\n3. **Identify what remains to be done**\\\\n\\\\n    * Tasks not completed\\\\n    * Items still in progress\\\\n    * Blockers encountered\\\\n\\\\n4. **Prioritize work for next week**\\\\n\\\\n    * What matters most to tackle first\\\\n    * Deadlines approaching\\\\n    * Dependencies to unblock\\\\n\\\\n5. **Offer insights, if any**\\\\n\\\\n    * Was the week focused or scattered?\\\\n    * Any recurring blockers?\\\\n    * What worked well?\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Accomplishments this week**\\\\n\\\\n    * [What got accomplished]\\\\n    * [What moved forward]\\\\n\\\\n    **Still to do**\\\\n\\\\n    * [What didn\\'t get done]\\\\n    * [Is it still important?]\\\\n\\\\n    **Priorities for next week:**\\\\n\\\\n1. [Top priority]\\\\n\\\\n2. [Second priority]\\\\n\\\\n3. [Third priority]\\\\n\\\\n    **Notes:** [Observation about the week\\'s rhythm]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Analyzes recent tasks to highlight wins, identify blockers, and set priorities.\",null,\"https://www.gstatic.com/chrome/skills/images/weekly_work_review.png\",null,\"WeeklyWorkReview\"],[\"333b0944-ba5d-49bd-b2f6-0d49f7128bff\",\"Buying advice\",\"Shopping\",\"\\ud83e\\udd14\",\"Objective: Advice on whether you should buy or not\\\\n\\\\n1. **Product background**\\\\n\\\\n    * Product name, brand, and model\\\\n    * Price and any variations\\\\n    * Key specifications\\\\n\\\\n2. **Identify positive attributes**\\\\n\\\\n    * Features that stand out\\\\n    * What reviewers praise\\\\n    * Value proposition\\\\n\\\\n3. **Identify drawbacks**\\\\n\\\\n    * Common complaints in reviews\\\\n    * Missing features\\\\n    * Quality or durability issues\\\\n\\\\n4. **Determine fit for user**\\\\n\\\\n    * Ideal buyer profile\\\\n    * Who should skip this product\\\\n    * Use cases it serves well vs. poorly\\\\n\\\\n5. **Evaluate value**\\\\n\\\\n    * Is this price typical for the category?\\\\n    * Should the user wait for a sale?\\\\n    * Are there better value alternatives?\\\\n\\\\n6. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * At the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\"\\\\n    * \\u2705 Buy it\\\\n    * \\u26a0\\ufe0f Buy, but things to consider\\\\n    * \\ud83e\\udd14 Consider alternatives\\\\n    * \\u274c Skip it\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **In short:** [Your recommendation, and why. Then one sentence\\u2014what is this and who is it for?]\\\\n\\\\n    **Pros**\\\\n\\\\n    * [What\\'s good]\\\\n    * [What reviewers love]\\\\n\\\\n    **Cons:**\\\\n\\\\n    * [What\\'s not great]\\\\n    * [What reviewers complain about]\\\\n\\\\n    **Who should buy this:** [Ideal buyer]\\\\n    **Who should skip this:** [Not right for...]\\\\n\\\\n    **Price check:** [Fair? Wait for sale?]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Evaluates product specifications and common complaints to provide buy / no-buy advice.\",true,\"https://www.gstatic.com/chrome/skills/images/buying_advice.png\",null,\"BuyingAdvice\"],[\"6effd6c6-9197-4992-9f5b-a5f7c9e000be\",\"Summarize reviews\",\"Shopping\",\"\\u2b50\",\"Objective: Summarize many reviews\\\\n\\\\n1. **Process available reviews**\\\\n\\\\n    * Note the number of reviews and remember that value as \\\\\"number_reviews\\\\\"\\\\n    * Overall rating\\\\n    * Rating distribution if visible\\\\n    * It\\'s possible there aren\\'t any reviews, for example if a product is new or out of stock. If that\\'s the case, don\\'t include any review analysis in your response.\\\\n\\\\n2. **Identify repeated patterns**\\\\n\\\\n    * Common positive themes\\\\n    * Common complaints\\\\n    * Frequency of each theme\\\\n\\\\n3. **Support themes with evidence**\\\\n\\\\n    * Representative quotes for major themes\\\\n    * Specific examples that illustrate points\\\\n\\\\n4. **Evaluate trustworthiness**\\\\n\\\\n    * Do reviews seem genuine?\\\\n    * Suspicious patterns (all 5-star, generic language)\\\\n    * Verified purchase indicators\\\\n\\\\n5. **Summarize overall sentiment**\\\\n\\\\n    * Would most reviewers buy again?\\\\n    * Who loves it vs. who hates it?\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    If number_reviews is 0, your response should mention that there aren\\'t any reviews and you should jump to the follow-on question.\\\\n\\\\n    **Overview:** [X] reviews, [Y] average rating\\\\n\\\\n    **Pros**\\\\n\\\\n    | Theme | Frequency | Example |\\\\n    | :---: | :---: | :---: |\\\\n\\\\n    **Cons**\\\\n\\\\n    | Theme | Frequency | Example |\\\\n    | :---: | :---: | :---: |\\\\n\\\\n    **Quality of reviews:** [Do they seem genuine?]\\\\n\\\\n    **Bottom line:** [Would most reviewers buy again?]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Scans customer feedback to identify praise and complaints and overall trust level.\",null,\"https://www.gstatic.com/chrome/skills/images/summarize_reviews.png\",null,\"SummarizeReviews\"],[\"b67dd4fb-8216-40d2-b1d6-ecff80e6f9cf\",\"Identify specs\",\"Shopping\",\"\\ud83d\\udccf\",\"Objective: Make it easy to review a product\\'s specifications\\\\n\\\\n1. **Identify all available specs**\\\\n\\\\n    * Dimensions and weight\\\\n    * Materials and construction\\\\n    * Technical specifications\\\\n    * Included accessories\\\\n\\\\n2. **Highlight what matters most**\\\\n\\\\n    * Specifications that differentiate products\\\\n    * Specs that affect user experience\\\\n    * Specs commonly compared in this category\\\\n\\\\n3. **Note gaps**\\\\n\\\\n    * Common specs for this product type not listed\\\\n    * Information a buyer would want\\\\n\\\\n4. **Reformat for easy comparison, if necessary**\\\\n\\\\n    * Consistent units\\\\n    * Clear labels\\\\n    * Copy-friendly format\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Product:** [Name/Model]\\\\n\\\\n    **Specifications:**\\\\n\\\\n    | Spec | Value |\\\\n    | :---: | :---: |\\\\n\\\\n    **Key comparison:** [The specs that matter most for decision-making]\\\\n\\\\n    **Things missing:** [Specs a buyer would want that aren\\'t listed]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Gathers technical details, highlighting what matters most and noting missing information.\",null,\"https://www.gstatic.com/chrome/skills/images/identify_specs.png\",null,\"IdentifySpecs\"],[\"225c00da-89b2-46ac-9840-69b13a3142fc\",\"Price per unit\",\"Shopping\",\"\\ud83c\\udff7\\ufe0f\",\"Objective: Calculate true per-unit value\\\\n\\\\n1. **Identify a products total cost**\\\\n\\\\n    * Listed price\\\\n    * Any discounts or promotions\\\\n    * Subscription vs. one-time cost\\\\n\\\\n2. **Consider quantities and dimensions**\\\\n\\\\n    * Size (oz, ml, lbs, kg)\\\\n    * Count (units, servings, doses)\\\\n    * Duration (months, uses)\\\\n\\\\n3. **Compute cost per unit**\\\\n\\\\n    * Per oz/ml for liquids\\\\n    * Per serving for food\\\\n    * Per use for consumables\\\\n    * Per month for subscriptions\\\\n\\\\n4. **Find hidden expenses**\\\\n\\\\n    * Shipping costs\\\\n    * Subscription requirements\\\\n    * Consumables needed\\\\n    * Installation or setup fees\\\\n\\\\n5. **Contextualize the price**\\\\n\\\\n    * Typical pricing for this category\\\\n    * Bulk discount value\\\\n    * Brand premium\\\\n\\\\n6. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * At the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\"\\\\n\\\\n7. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n8. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **In short:** [your recommendation, if applicable. Assess value: typical pricing, bulk discounts, brand premium?]\\\\n    **Price:** [total]\\\\n    **Quantity:** [size/count]\\\\n\\\\n    **Unit price:**\\\\n\\\\n    * Per oz/ml: $X\\\\n    * Per serving: $X\\\\n    * Per use (estimated): $X\\\\n\\\\n    **Hidden costs:**\\\\n\\\\n    * [Shipping, subscription, consumables, etc.]\\\\n\\\\n9. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Factors in total costs, including shipping fees, to calculate a true cost.\",null,\"https://www.gstatic.com/chrome/skills/images/price_per_unit.png\",null,\"PricePerUnit\"],[\"41a6530f-5a32-48b2-81fb-45abfd767b44\",\"Check returns\",\"Shopping\",\"\\u21a9\\ufe0f\",\"Objective: Get help returning a purchase\\\\n\\\\n1. **Find return window**\\\\n\\\\n    * Number of days allowed\\\\n    * Start date (from purchase, delivery, etc.)\\\\n    * Holiday extensions if mentioned\\\\n\\\\n2. **Identify return conditions**\\\\n\\\\n    * New/unused required?\\\\n    * Original packaging needed?\\\\n    * Tags attached?\\\\n    * Receipt required?\\\\n\\\\n3. **Understand how to return**\\\\n\\\\n    * Return shipping: who pays?\\\\n    * In-store vs. mail options\\\\n    * Refund method (original payment, store credit)\\\\n    * Processing time\\\\n\\\\n4. **Find items that can\\'t be returned**\\\\n\\\\n    * Final sale categories\\\\n    * Hygiene-restricted items\\\\n    * Personalized/custom items\\\\n    * Clearance restrictions\\\\n\\\\n5. **Identify unusual or hidden terms**\\\\n\\\\n    * Restocking fees\\\\n    * Condition for refund vs. exchange\\\\n    * Time limits for different product types\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    * At the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\"\\\\n\\\\n    **In short:**\\\\n\\\\n    * Return window: [X] days\\\\n    * Condition required: [new/opened/any]\\\\n    * Refund method: [original payment/store credit]\\\\n    * Who pays shipping: [you/them]\\\\n\\\\n    **Exceptions:** [Items that can\\'t be returned]\\\\n\\\\n    **Things to look out for:** [Unusual terms or gotchas]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Gathers refund details like deadlines, restocking fees, and return-shipping costs.\",null,\"https://www.gstatic.com/chrome/skills/images/check_returns.png\",null,\"CheckReturns\"],[\"c26a0992-39fd-45fa-ad33-7522dd673a19\",\"Sizing help\",\"Shopping\",\"\\ud83d\\udc55\",\"Objective: Get help picking the right size\\\\n\\\\n1. **Find official guidance**\\\\n\\\\n    * Published size chart\\\\n    * Measurement recommendations\\\\n    * Fit description (slim, regular, relaxed)\\\\n\\\\n2. **Find sizing patterns in reviews**\\\\n\\\\n    * \\\\\"Runs small\\\\\" / \\\\\"Runs large\\\\\" / \\\\\"True to size\\\\\" frequency\\\\n    * Specific sizing complaints\\\\n    * Recommendations from reviewers\\\\n\\\\n3. **Calculate consensus in reviews**\\\\n\\\\n    * Percentage of reviewers mentioning sizing issues\\\\n    * Direction of sizing issues\\\\n    * Confidence based on review volume\\\\n\\\\n4. **Note fit variations based on body types**\\\\n\\\\n    * Feedback from different body types\\\\n    * Length vs. width issues\\\\n    * Between-size guidance\\\\n\\\\n5. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * Order usual size, size up, or size down\\\\n    * Check specific measurements if possible\\\\n    * Return policy consideration for sizing\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    **In short:**\\\\n    * [Order usual size / Size up / Size down]\\\\n    * [Specific advice]\\\\n\\\\n    **What reviews say:**\\\\n\\\\n    * Runs: [Small / True to size / Large]\\\\n    * Frequency of sizing complaints: [X]%\\\\n\\\\n    **Size chart:** [If visible, key measurements]\\\\n\\\\n    **Notes:** [Body type feedback, between-sizes advice]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Uses customer feedback to determine if an item runs small, large, or true to size.\",null,\"https://www.gstatic.com/chrome/skills/images/sizing_help.png\",null,\"SizingHelp\"],[\"d3912c37-8734-429c-9fbe-f2436bba0521\",\"Check warranty\",\"Shopping\",\"\\ud83d\\udee1\\ufe0f\",\"Objective: Get help figuring out if a purchase is still covered by warranty\\\\n\\\\n1. **Find what\\'s protected**\\\\n\\\\n    * Duration (years, lifetime, limited)\\\\n    * What\\'s covered (defects, damage, wear)\\\\n    * Who provides it (manufacturer, seller, third party)\\\\n\\\\n2. **Find what\\'s NOT covered**\\\\n\\\\n    * Wear and tear\\\\n    * Accidental damage\\\\n    * Commercial use\\\\n    * Unauthorized modifications\\\\n\\\\n3. **How to use the warranty**\\\\n\\\\n    * Registration required?\\\\n    * Proof of purchase needed?\\\\n    * Contact method\\\\n    * Typical processing time\\\\n\\\\n4. **Evaluate the warranty**\\\\n\\\\n    * Is this typical for the product category?\\\\n    * Better or worse than competitors?\\\\n    * Is the warranty a selling point?\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Warranty**\\\\n\\\\n    * Duration: [X years / lifetime / limited]\\\\n    * What\\'s covered: [defects, damage, etc.]\\\\n    * Provider: [manufacturer/seller/third party]\\\\n    **Exclusions:** [What\\'s NOT covered]\\\\n    **Claim Process:** [How to claim, registration needed?]\\\\n    **Assessment:** [For this product type, is this typical/good/bad?]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Gathers product-protection info like covered defects, exclusions, and the claim process.\",null,\"https://www.gstatic.com/chrome/skills/images/check_warranty.png\",null,\"CheckWarranty\"],[\"19309e05-0f5b-4f5c-870a-9975a743f1e2\",\"Rate as gift\",\"Shopping\",\"\\ud83c\\udf81\",\"Objective: Get help deciding if a product makes a good gift\\\\n\\\\n1. **Assess price**\\\\n\\\\n    * What relationship level fits this price point\\\\n    * Hidden costs (batteries, subscription, shipping)\\\\n    * Value perception\\\\n\\\\n2. **Does a product make a good gift? **\\\\n\\\\n    * Review summary\\\\n    * Presentation quality\\\\n\\\\n3. **Consider practical aspects**\\\\n\\\\n    * Size/preference risk (wrong size, wrong color)\\\\n    * Easy to wrap/ship?\\\\n    * Universal appeal vs. niche interest\\\\n    * Regifting potential (might they have one?)\\\\n\\\\n4. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * At the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\"\\\\n    * \\ud83c\\udf81 Great gift\\\\n    * \\u26a0\\ufe0f Good with caveats\\\\n    * \\u274c Skip it\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **In short:** [\\ud83c\\udf81/\\u26a0\\ufe0f/\\u274c] \\u2014 [Reason]\\\\n\\\\n    **[Name of product]**\\\\n    * Cost: [price]\\\\n    * Appropriate for: [casual / close friend / family]\\\\n    * Hidden costs: [shipping, batteries, subscription?]\\\\n    * Reviews: [what people say]\\\\n\\\\n    **Does it make a good gift?**\\\\n\\\\n    * Gift-worthy or buy-for-yourself item?\\\\n    * Easy to wrap/ship?\\\\n    * Risk of wrong size/preference?\\\\n    * Regifting potential: [might they already have one?]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Assesses if something would make a good gift based on things like brand and quality.\",null,\"https://www.gstatic.com/chrome/skills/images/rate_as_gift.png\",null,\"RateAsGift\"],[\"6b767ad9-8ba2-416d-926e-5f823f66612f\",\"Compare open tabs\",\"Shopping\",\"\\ud83c\\udd9a\",\"Objective: Compare product in current tab to items in other tabs\\\\n\\\\n1. **Identify open product tabs**\\\\n\\\\n    * List all tabs with product pages, \\\\\"comparison tabs\\\\\"\\\\n    * Verify they\\'re comparable products\\\\n    * Note if permission is needed for tab access\\\\n\\\\n2. **Analyze the active tab**\\\\n\\\\n    * Product name and brand\\\\n    * Price\\\\n    * Key specifications\\\\n    * Rating\\\\n\\\\n3. **Analyze each comparison tab**\\\\n\\\\n    * Search for the same attributes for each product\\\\n    * Convert units and formatting, to facilitate comparison\\\\n\\\\n4. **Compare products**\\\\n\\\\n    * Side-by-side comparison\\\\n    * Highlight differences\\\\n    * Highlight missing data\\\\n\\\\n5. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n    * At the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\"\\\\n    * Cheapest option\\\\n    * Best reviewed\\\\n    * Best overall value\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * No other tabs \\u2192 Explain user needs to open comparison tabs\\\\n    * Non-comparable tabs \\u2192 List what\\'s open, note they\\'re different categories\\\\n    * Permission needed \\u2192 Explain tab access requirement\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Recommendation:** [Which tab to buy from and why]\\\\n\\\\n    **Comparison:**\\\\n\\\\n    | Feature | This Tab | Tab 2 | Tab 3 | Tab 4 |\\\\n    | :------ | :------- | :---- | :---- | :---- |\\\\n    | Product |          |       |       |       |\\\\n    | Price   |          |       |       |       |\\\\n    | Rating  |          |       |       |       |\\\\n    | Specs   |          |       |       |       |\\\\n\\\\n    **Best by category:**\\\\n\\\\n    * Cheapest: [Tab X]\\\\n    * Best reviewed: [Tab Y]\\\\n    * Best value: [Tab Z]\\\\n\\\\n    *No external search needed\\u2014just comparing what you already have open.*\\\\n\\\\n    **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Analyzes multiple product pages to find the best value.\",null,\"https://www.gstatic.com/chrome/skills/images/compare_open_tabs.png\",null,\"CompareOpenTabs\"],[\"befdb2d6-0e82-4c0f-bf4a-9dca094d48d9\",\"Check reading level\",\"Understand\",\"\\ud83c\\udf93\",\"Objective: Determine whether content is age appropriate\\\\n\\\\n1. **Check for adult content**\\\\n\\\\n    * Is the content designed for adults?\\\\n    * Does the site advertise things like alcohol?\\\\n\\\\n2. **Evaluate linguistic complexity**\\\\n\\\\n    * Average sentence length\\\\n    * Vocabulary level (common vs. specialized)\\\\n    * Use of jargon or technical terms\\\\n\\\\n3. **Calculate approximate level**\\\\n\\\\n    * Grade level equivalent\\\\n    * Sentence structure (simple vs. complex)\\\\n    * Assumed prior knowledge\\\\n    * Density of information\\\\n\\\\n4. **Determine appropriate readers**\\\\n\\\\n    * General audience suitability\\\\n    * Expert-level appropriateness\\\\n    * Value for learning\\\\n\\\\n5. **Make a recommendation**\\\\n\\\\n    * Based on all preceding steps, form a recommendation\\\\n    * The objective is to give the user a gut check\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **In short:** [Recommendation]\\\\n\\\\n    **Reading level:** Grade [X]\\\\n    **Complexity:**\\\\n    * Sentence length: [short/medium/long]\\\\n    * Vocabulary: [common/specialized/technical]\\\\n    * Assumed knowledge: [none/some/significant]\\\\n\\\\n    **Reading time:** ~[X] minutes\\\\n\\\\n    **Appropriate for:**\\\\n\\\\n    * General audience: [yes/no]\\\\n    * Experts: [yes/no]\\\\n    * Learning this topic: [good intro / too advanced / too basic]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Estimates the grade level of content to help determine the intended audience.\",null,\"https://www.gstatic.com/chrome/skills/images/check_reading_level.png\",null,\"CheckReadingLevel\"],[\"c7ac55b2-87fa-47e4-a7f6-63754ebd2a90\",\"Learn with flashcards\",\"Learning\",\"\\ud83d\\udcc7\",\"Objective: Generate study flashcards\\\\n\\\\n1. **Identify info likely to appear on a test**\\\\n\\\\n    * Key facts and data points\\\\n    * Important terms and definitions\\\\n    * Concepts and relationships\\\\n    * Notable names, dates, events\\\\n\\\\n2. **Generate appropriate question types**\\\\n\\\\n    * **Definitions**: \\\\\"What is [term]?\\\\\"\\\\n    * **Facts**: \\\\\"When/Where/Who/What...\\\\\"\\\\n    * **Concepts**: \\\\\"Explain...\\\\\"\\\\n    * **Comparisons**: \\\\\"What\\'s the difference between X and Y?\\\\\"\\\\n\\\\n3. **Create up to 15 cards**\\\\n\\\\n    * Clear, specific questions\\\\n    * Concise, accurate answers\\\\n    * One concept per card\\\\n    * Self-contained (no context needed)\\\\n\\\\n4. **Ensure cards are effective**\\\\n\\\\n    * Questions are unambiguous\\\\n    * Answers are verifiable\\\\n    * Mix of recall levels\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Narrative content \\u2192 Generate discussion questions instead\\\\n    * Limited content \\u2192 Create fewer cards, note limitation\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    | Front (Question) | Back (Answer) |\\\\n    | ----- | ----- |\\\\n    | What is [term]? | [Definition] |\\\\n    | When did [event]? | [Date/time] |\\\\n    | Explain [concept] | [Explanation] |\\\\n    | Difference between X and Y? | [Comparison] |\\\\n\\\\n    [up to 15 cards]\\\\n\\\\n    *Ready for Anki, Quizlet, or manual study.*\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Generates 15 concise, self-contained questions to help study.\",true,\"https://www.gstatic.com/chrome/skills/images/learn_with_flashcards.png\",null,\"LearnWithFlashcards\"],[\"b3d2a696-c73e-4e97-8202-a702fab936e4\",\"Make a quiz\",\"Learning\",\"\\u2753\",\"Objective: Generate a quiz to facilitate learning\\\\n\\\\n1. **Identify key learning points**\\\\n\\\\n    * Main arguments or findings\\\\n    * Important facts and details\\\\n    * Concepts that need understanding\\\\n    * Application of ideas\\\\n\\\\n2. **Create diverse questions, a mix of different types**\\\\n\\\\n    * **Recall**: Direct fact retrieval\\\\n    * **Comprehension**: Understanding and explanation\\\\n    * **Application**: Using knowledge in new context\\\\n\\\\n3. **Write clear questions**\\\\n\\\\n    * Specific and unambiguous\\\\n    * Testable with definite answers\\\\n    * Progressively more challenging\\\\n\\\\n4. **Create comprehensive answers**\\\\n\\\\n    * Full answer with explanation\\\\n    * Why this answer is correct\\\\n    * Hidden until revealed\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    Generate no more than 5 questions using this format:\\\\n\\\\n    **Q1:** [Question]\\\\n\\\\n    Answer: [insert answer here]\\\\n\\\\n    Explanation: [insert explanation here]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Tests your knowledge with a mix of questions and detailed explanations.\",null,\"https://www.gstatic.com/chrome/skills/images/make_a_quiz.png\",null,\"MakeAQuiz\"],[\"fd7a3fdd-438d-4928-8caf-ef6d6e0d4757\",\"Deep questions\",\"Learning\",\"\\ud83e\\ude9e\",\"Objective: Generate questions that help the user think deeply about a topic\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Make connections to broader topics, if possible\\\\n\\\\n2. **Generate diverse question types**\\\\n\\\\n    * **Challenge assumptions**: What does this take for granted?\\\\n    * **Explore implications**: If this is true, what follows?\\\\n    * **Connect to experience**: How does this relate to life?\\\\n    * **Consider alternatives**: What\\'s the counter-argument?\\\\n    * **Identify gaps**: What doesn\\'t this answer?\\\\n\\\\n3. **Favor questions that are open ended**\\\\n\\\\n    * No single right answer\\\\n    * Invite personal reflection\\\\n    * Encourage deeper exploration\\\\n\\\\n4. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Questions to think about**\\\\n\\\\n1. **Challenge assumptions:** [Question about what the content takes for granted]\\\\n\\\\n2. **Explore implications:** [Question about what follows if this is true]\\\\n\\\\n3. **Connect to experience:** [Question relating to personal life/experience]\\\\n\\\\n4. **Consider alternatives:** [Question about counter-arguments or other views]\\\\n\\\\n5. **Identify gaps:** [Question about what isn\\'t addressed]\\\\n\\\\n6. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Generates open-ended prompts designed to challenge assumptions.\",null,\"https://www.gstatic.com/chrome/skills/images/deep_questions.png\",null,\"DeepQuestions\"],[\"682978df-58e0-4bd8-ab08-210ac4128ddb\",\"Study guide\",\"Learning\",\"\\ud83d\\uddfa\\ufe0f\",\"Objective: Create structured study notes\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Essential relationships\\\\n\\\\n2. **List important terms**\\\\n\\\\n    * Technical terms with definitions\\\\n    * Key names and their significance\\\\n    * Specialized vocabulary\\\\n\\\\n3. **Show how concepts connect**\\\\n\\\\n    * Cause and effect relationships\\\\n    * Comparisons and contrasts\\\\n    * Hierarchies and categories\\\\n\\\\n4. **Memory aids**\\\\n\\\\n    * Mnemonics where helpful\\\\n    * Analogies to familiar concepts\\\\n    * Visual relationships\\\\n\\\\n5. **Condense to essentials**\\\\n\\\\n    * 3-5 sentence overview\\\\n    * Likely test topics\\\\n    * What to focus on\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Summary:** [3-5 sentences]\\\\n    **Key concepts:** [Main ideas with brief definitions]\\\\n\\\\n    **Vocabulary:** [Important terms]\\\\n\\\\n    **Main arguments:** [Core claims or conclusions]\\\\n\\\\n    **How concepts connect:** [Relationships, cause/effect, comparisons]\\\\n\\\\n    **Memory aids:** [Mnemonics, analogies]\\\\n\\\\n    **Likely test topics:** [What to focus study on]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Condenses material into essential concepts and suggests study aids.\",null,\"https://www.gstatic.com/chrome/skills/images/study_guide.png\",null,\"StudyGuide\"],[\"7a649470-692a-4989-bac2-a354085398e4\",\"Generate citations\",\"Learning\",\"\\ud83d\\udd16\",\"Objective: Generate citations in the style of 1) American Psychological Association (APA), 2) Modern Language Association (MLA), and 3) Chicago Manual of Style\\\\n\\\\n1. **Identify available information**\\\\n\\\\n    * Title of the page/article\\\\n    * Authors if available\\\\n    * Publication date\\\\n    * Publisher or website name\\\\n    * URL\\\\n\\\\n2. **Note what\\'s missing or inferred**\\\\n\\\\n    * Author not found \\u2192 Use organization name or \\\\\"n.a.\\\\\"\\\\n    * Date not found \\u2192 Use \\\\\"n.d.\\\\\"\\\\n    * Mark any inferred information\\\\n\\\\n3. **Generate citations using 3 formats**\\\\n\\\\n    * **APA**: Author, Year format\\\\n    * **MLA**: Author, Title format\\\\n    * **Chicago**: Full bibliographic style\\\\n\\\\n4. **Include retrieval info**\\\\n\\\\n    * Today\\'s date as access date\\\\n    * Full URL\\\\n\\\\n5. **Highlight things the user should verify**\\\\n\\\\n    * Items that were inferred\\\\n    * Information to verify on the actual source\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    * Title: [extracted]\\\\n    * Author: [extracted or \\\\\"Not found\\\\\"]\\\\n    * Date: [extracted or \\\\\"n.d.\\\\\"]\\\\n    * Publisher: [extracted]\\\\n    * URL: [current]\\\\n    * Accessed: [today\\'s date]\\\\n\\\\n    **APA:** [Full APA citation]\\\\n\\\\n    **MLA:** [Full MLA citation]\\\\n\\\\n    **Chicago:** [Full Chicago citation]\\\\n\\\\n    **Notes:** [What was inferred, what to verify]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Locates info to automatically format bibliographic references in APA, MLA, and Chicago styles.\",null,\"https://www.gstatic.com/chrome/skills/images/generate_citations.png\",null,\"GenerateCitations\"],[\"cb9324d7-ea7e-4828-b421-5df2fefff990\",\"Break it down\",\"Learning\",\"\\ud83d\\udc69\\\\u200d\\ud83c\\udfeb\",\"Objective: Create understanding through thoughtful instruction\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Reflect on prerequisites the learner needs\\\\n    * Reflect on common stumbling blocks the learner might encounter\\\\n\\\\n2. **Start with basics**\\\\n\\\\n    * What do I need to know first?\\\\n    * Simplest version of the concept\\\\n    * Building blocks before complexity\\\\n\\\\n3. **Build understanding gradually**\\\\n\\\\n    * One concept at a time\\\\n    * Analogies to familiar things\\\\n    * Concrete examples\\\\n\\\\n4. **Add clarity markers**\\\\n\\\\n    * \\\\\"The key insight is...\\\\\"\\\\n    * \\\\\"A common misconception is...\\\\\"\\\\n    * \\\\\"You\\'ll know you understand when...\\\\\"\\\\n\\\\n5. **Make it stick**\\\\n\\\\n    * Why does this matter?\\\\n    * How does it connect to other things?\\\\n    * When would I use this?\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **The basics** [Foundational concept]\\\\n\\\\n    **Building from there** [Progressive explanation with examples]\\\\n\\\\n    **Key insights** [The core \\\\\"aha\\\\\" moment]\\\\n\\\\n    **Common misconceptions** [What people often get wrong]\\\\n\\\\n    **Why this matters** [Real-world relevance]\\\\n\\\\n    **Check your understanding** [Self-check criteria]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Breaks down foundational concepts step-by-step, using examples to build understanding.\",null,\"https://www.gstatic.com/chrome/skills/images/get_help_from_a_tutor.png\",null,\"BreakItDown\"],[\"02ba01c4-003a-4163-9d5b-d091130d4cf5\",\"Hype it up!\",\"Fun\",\"\\ud83d\\udce3\",\"Objective: Reframe content in motivational terms\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Identify what needs hyping**\\\\n\\\\n    * What the user is facing\\\\n    * The challenge or opportunity\\\\n    * What success looks like\\\\n\\\\n3. **Find reasons for confidence**\\\\n\\\\n    * What they\\'ve already accomplished\\\\n    * Skills or traits that apply\\\\n    * Evidence they can do this\\\\n\\\\n4. **Create motivational content**\\\\n\\\\n    * Genuine, not toxic positivity\\\\n    * Real talk that makes them feel capable\\\\n    * Specific rather than generic\\\\n\\\\n5. **End with a call to action**\\\\n\\\\n    * First small step to take\\\\n    * Mantra for the day\\\\n    * Clear forward direction\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Sad content \\u2192 Offer encouragement or listening instead\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **The situation** [What you\\'re facing]\\\\n\\\\n    **A positive spin**\\\\n\\\\n    [Energetic, genuine encouragement\\u2014not toxic positivity, real talk that makes you feel capable]\\\\n\\\\n    **Remember**\\\\n\\\\n    * [One thing you\\'ve accomplished that proves you can do this]\\\\n    * [Why this matters]\\\\n    * [The first small step]\\\\n    * [One sentence to carry with you]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Offers encouragement to the user by highlighting their traits and past wins.\",null,\"https://www.gstatic.com/chrome/skills/images/hype_it_up.png\",null,\"HypeItUp\"],[\"dfcc2e51-7ea4-4372-bc66-0826ad857ff4\",\"Fun facts\",\"Fun\",\"\\ud83e\\udd42\",\"Objective: Generate interesting facts to share socially\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Surprising facts most people don\\'t know\\\\n    * Counter-intuitive insights\\\\n    * Connections to broader topics\\\\n\\\\n2. **Speaking points**\\\\n\\\\n    * **Surprising fact**: Impressive but not obnoxious\\\\n    * **Informed opinion**: Shows you\\'ve thought about it\\\\n    * **Smart question**: Sparks interesting discussion\\\\n\\\\n3. **Practical guidance**\\\\n\\\\n    * Natural transition phrases\\\\n    * How to bring it up without forcing it\\\\n    * Exit strategies if someone knows more\\\\n\\\\n4. **Keep it interesting**\\\\n\\\\n    * Sounds curious, not lecturing\\\\n    * Invites conversation, not monologue\\\\n    * Shows interest in others\\' perspectives\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Surprising facts** \\\\\"[Something most people don\\'t know that sounds impressive but not obnoxious]\\\\\"\\\\n\\\\n    **An informed opinion** \\\\\"[A take on this topic that shows you\\'ve thought about it]\\\\\"\\\\n\\\\n    **To show you\\'ve thought about this** \\\\\"[Something to ask others that sparks conversation]\\\\\"\\\\n\\\\n    **How to bring it up naturally** [Transition phrases]\\\\n\\\\n    **If someone knows more than you:** [How to pivot gracefully to asking questions]\\\\n\\\\n6. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Provides trivia and suggests how to use them in conversation.\",null,\"https://www.gstatic.com/chrome/skills/images/fun_facts.png\",null,\"FunFacts\"],[\"8ece0f95-5d02-47cc-bbbc-0999218f7266\",\"Explain something in character\",\"Fun\",\"\\ud83c\\udfad\",\"Objective: Have something explained in the character of your choosing\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n\\\\n2. **Confirm the character**\\\\n\\\\n    * User specifies (pirate, Shakespeare, coach, etc.)\\\\n    * If not specified, offer popular options\\\\n\\\\n3. **Define the character**\\\\n\\\\n    * Vocabulary and phrasing\\\\n    * Worldview and references\\\\n    * Speech patterns and cadence\\\\n\\\\n4. **Transform text while maintaining accuracy**\\\\n\\\\n    * preserve core information\\\\n    * Reframe through character lens\\\\n\\\\n5. **Stay in character**\\\\n\\\\n    * Use their vocabulary consistently\\\\n    * Include character-appropriate reactions\\\\n\\\\n6. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * No character specified \\u2192 Offer options (pirate, Shakespeare, sports coach, noir detective, surfer, grandma, drill sergeant)\\\\n    * Character doesn\\'t fit \\u2192 Suggest alternative\\\\n\\\\n7. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    **Explaining as [CHARACTER]**\\\\n\\\\n    [Full explanation in character voice, 150-300 words]\\\\n\\\\n    **Key points (in character)**\\\\n\\\\n1. [Main idea, in voice]\\\\n\\\\n2. [Supporting point, in voice]\\\\n\\\\n3. [Takeaway, in voice]\\\\n\\\\n8. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Transforms text to match the vocabulary and speech patterns of a character.\",null,\"https://www.gstatic.com/chrome/skills/images/explain_something_in_character.png\",null,\"ExplainSomethingInCharacter\"],[\"7fc0fa09-468d-4e40-a476-c846c689da7b\",\"Dramatize content\",\"Fun\",\"\\ud83c\\udfac\",\"Objective: Rewrite content as a dramatic narrative\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Find the core idea or main argument\\\\n    * Identify what the author wants readers to believe or do\\\\n    * Reflect on the \\\\\"why?\\\\\" of the content\\\\n    * Note the scope and limitations of the content\\\\n    * Key players and actions\\\\n    * The stakes (even if small)\\\\n\\\\n2. **Choose dramatic style**\\\\n\\\\n    * Epic fantasy\\\\n    * Action movie trailer\\\\n    * Documentary narrator\\\\n    * Ancient myth\\\\n\\\\n3. **Apply dramatic elements**\\\\n\\\\n    * Elevated language\\\\n    * Dramatic tension\\\\n    * Narrative arc\\\\n    * Stakes amplification\\\\n\\\\n4. **Condense to a tagline for a movie poster**\\\\n\\\\n    * One dramatic sentence\\\\n    * Captures the essence\\\\n\\\\n5. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n    * Already dramatic \\u2192 Make it even MORE dramatic\\\\n\\\\n6. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    **Dramatic tagline:** [One-sentence movie poster version]\\\\n\\\\n    **The original** [Original content]\\\\n\\\\n    **THE EPIC VERSION**\\\\n\\\\n    [200-400 word dramatic narrative transformation]\\\\n\\\\n7. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Elevates the stakes of a story by applying epic language suited for a movie trailer.\",null,\"https://www.gstatic.com/chrome/skills/images/dramatize_content.png\",null,\"DramatizeContent\"],[\"1802cd7c-32ff-4c1f-a82a-c0cab63fa20e\",\"Make grocery list\",\"Shopping\",\"\\ud83d\\udccb\",\"Objective: Create a shopping list based on the list of ingredients in a recipe\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Identify all ingredients\\\\n\\\\n2. **Normalize quantities**\\\\n\\\\n    * Maintain metric or imperial measurements, based on the original measurements on the site\\\\n    * Normalize quantities, making it easier to purchase in the store\\\\n    * Combine any duplicate ingredients\\\\n\\\\n3. **Generate the shopping list**\\\\n\\\\n    * For each item, choose the section of the store in which the user is most likely to find the item, for example: produce, dairy, Meat, Seafood, Pantry, Frozen, Bakery\\\\n    * Organize the table by store section\\\\n\\\\n4. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n\\\\n    | Ingredient | Quantity | Store section |\\\\n    | ----- | ----- | ----- |\\\\n\\\\n    **Common ingredients you\\'ll also need**\\\\n    [staple 1]\\\\n    [staple 2]\\\\n\\\\n6. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n    * If the user lives in a country that typically uses measurements other than those used on the page (metric instead of imperial), ask the user if they\\'d like quantities converted to the other measurement.\\\\n\",\"Normalizes recipe quantities and categorizes ingredients by supermarket section.\",null,\"https://www.gstatic.com/chrome/skills/images/make_grocery_list.png\",null,\"MakeGroceryList\"],[\"1fcd9ca9-c692-4541-8976-2845548148f0\",\"Protein max\",\"Top Pick\",\"\\ud83d\\udcaa\",\"Analyze the recipe on the current webpage. Identify all ingredients and estimate their protein content. Suggest substitutions or additions to maximize the overall protein content of the recipe, while maintaining the integrity of the original recipe\\'s flavor profile. Output the revised recipe with protein content listed for each ingredient and the total protein per serving.\\\\n\",\"Modifies a recipe by suggesting high-protein substitutions.\",null,\"https://www.gstatic.com/chrome/skills/images/maximize_protein_intake.png\",null,\"ProteinMax\"],[\"d78c0bac-b441-46da-a994-afe928d26d78\",\"Where does the time go?\",\"Understand\",\"\\u23f1\\ufe0f\",\"Objective: Help the user understand how they spent their time in the last 4 weeks\\\\n\\\\n1. **Identify the central point of the content**\\\\n\\\\n    * Analyze the user\\'s Google Calendar for the last 4 weeks\\\\n\\\\n2. **Identify categories**\\\\n\\\\n    * Examples of categories include meetings, projects, personal time\\\\n\\\\n3. **Assemble the response**\\\\n\\\\n    * Provide a summary of time allocation\\\\n    * List each category and the percent of total time spent on that category\\\\n\\\\n4. **Handling exceptions**\\\\n\\\\n    Prioritize excellent content in your response. If you\\'re unable to formulate a response that meets all criteria, you should\\\\n    * respond as best you can and\\\\n    * acknowledge any limitations or challenges you faced. For example, maybe there wasn\\'t sufficient content on a webpage or the content wasn\\'t compatible with a given request.\\\\n\\\\n    Consider your proposed response objectively and rate it on a scale from 1-10. If you wouldn\\'t give it a 10, either try to create a stronger response or consider acknowledging any limitations or challenges you faced. The score is just for your own purposes; don\\'t share it with the user.\\\\n\\\\n5. **Final response**\\\\n\\\\n    If you have relevant info to share, your final response should follow standard writing guidelines, including:\\\\n\\\\n    * Sentence case: titles, labels, and all other content should be displayed using sentence case (only proper nouns and the first letter of a string appear capitalized).\\\\n    * Favor simple sentences that use common words\\\\n    * Format as a bulleted list with percentages\\\\n\\\\n6. **Follow-up questions**\\\\n\\\\n    If you can think of a way you can help the user act on information shown in the response, conclude with one (at most two) sentences that offers this help. Frame it as a question so that a simple response like \\\\\"yes please\\\\\" might launch the next round.\\\\n\",\"Analyzes four weeks of appointments to show how the user\\u2019s time was spent.\",null,\"https://www.gstatic.com/chrome/skills/images/where_does_the_time_go.png\",null,\"WhereDoesTheTimeGo\"],[\"ba76d1be-21ff-4122-9669-41c4ca310141\",\"What\\'s in this?\",\"Understand\",\"\\ud83d\\udcdd\",\"Generate an infographic-style and interesting image of the visual breakdown of the product\\'s composite ingredients:\\\\n\\\\n    * Clean, modern layout on warm light cream white background.\\\\n    * The layout should be as balanced as possible.\\\\n    * At the top of the image, in bold text say \\\\\"Product Breakdown\\\\\" on one line, then the next line should be the name of the product.\\\\n    * Near the title, show an illustration of the product.\\\\n    * Organized by categories, give a name to each category instead of just calling it \\'category\\': active ingredients, base/carrier, preservatives, fragrance (for beauty); main fiber, blend components, treatments (for fabric); etc.\\\\n    * Color coding by CATEGORY (what it does), not by safety judgment.\\\\n    * Show every ingredient or material as a separate card.\\\\n    * Do not create cards with the same content.\\\\n    * Do not show empty cards or categories, or any ingredient without a name.\\\\n    * No ratings, no scores, no red/yellow/green safety signals.\\\\n    * Palette: soft, approachable \\u2014 sage green, warm cream, soft blue, light coral.\\\\n    * Illustrations: Hand-drawn, non-photorealistic art.\\\\n    * Typography: All text must be clearly legible at phone screen size.\\\\n    * Ensure all words are spelled correctly.\\\\n\",\"Creates an infographic for breaking down a recipe or product.\",null,\"https://www.gstatic.com/chrome/skills/images/whats_in_this.png\",null,\"WhatsInThis\"],[\"fed7dfe1-6128-4d10-a91b-b165038ddc99\",\"Meal planner\",\"Top Pick\",\"\\ud83c\\udf7d\\ufe0f\",\"Generate an image of a single illustrated cooking game plan and timeline based on the provided recipes:\\\\n\\\\n    * 3 sections in this order and with the following labels: \\\\\"Menu\\\\\", \\\\\"Timeline\\\\\", \\\\\"Prep List\\\\\".\\\\n    * The section labels should be bold.\\\\n    * The sections should be laid out vertically.\\\\n    * Top section (\\\\\"Menu\\\\\"): list each dish with a small hand-drawn illustration, individual prep/cook times, and total combined time.\\\\n    * Middle section (\\\\\"Timeline\\\\\"): A left-to-right timeline running from start time (0:00) to \\\\\"Serve\\\\\". Should resemble a Gantt chart.\\\\n    * Bottom section (\\\\\"Prep List\\\\\"): A unified, deduplicated ingredient list grouped by category (produce, protein, dairy, pantry) with combined quantities.\\\\n    * In the Prep List, if an ingredient is needed in multiple recipes, only show the combined total.\\\\n    * In the Prep List, for each ingredient show a small illustrated image. Under each image, identify the ingredient and quantity like this: \\\\\"Onion Powder (1 tsp)\\\\\".\\\\n    * Each dish gets a color-coded horizontal lane matching its menu illustration. Don\\'t specify the color using text anywhere.\\\\n    * Show tasks as blocks on the timeline: light fill for passive time, bold fill for active cooking.\\\\n    * If an oven is needed, then include oven usage blocks showing temperatures. If there are oven temperature conflicts, visually flag them. Otherwise if no oven is needed don\\'t mention anything about an oven.\\\\n    * Mark critical timing moments, passive prep windows, and the single most important timing callout with a \\u26a1 symbol.\\\\n    * Style: A cross between a Gantt chart and a cookbook illustration.\\\\n    * Layout must be clean, easily scannable at a glance, and not too visually dense.\\\\n    * Palette: Warm and inviting.\\\\n    * Illustrations: Hand-drawn, non-photorealistic food art.\\\\n    * Typography: All text must be clearly legible at phone screen size.\\\\n    * The ingredient image must match the ingredient name.\\\\n    * Ensure all words are spelled correctly.\\\\n\",\"Creates an infographic timeline and prep list for multiple recipes.\",null,\"https://www.gstatic.com/chrome/skills/images/meal_planner.png\",null,\"MealPlanner\"],[\"536f16c4-8b78-48c4-b101-f52f45a68021\",\"Gift concierge\",\"Top Pick\",\"\\ud83d\\udece\\ufe0f\",\"You are a decisive personal shopper. First, ask the user two questions: (1) Who is this for and what\\'s the occasion? (2) What\\'s your budget?\\\\n\\\\nThen, look at all of the tabs the user has shared. From each tab, extract: product name, price, retailer, category, star rating, and shipping estimate.\\\\n\\\\nNext, write a 2-sentence \\\\\"Taste Read\\\\\" \\u2014 a personality profile of the recipient based on the collection of products the user is browsing.\\\\n\\\\nFinally, pick \\\\\"The One\\\\\" \\u2014 the single best gift given the user\\'s answers \\u2014 and explain why in one sentence. If nothing in the user\\'s tabs is a great fit, say so and tell the user what to search for instead.\\\\n\\\\nOutput the tab inventory as a table. Keep the Taste Read fun and specific. Be opinionated, not diplomatic.\\\\n\\\\nAt the end of your initial response, inform the user: \\\\\"Final costs may vary, always verify at checkout\\\\\".\\\\n\",\"Assists with picking the ultimate gift.\",null,\"https://www.gstatic.com/chrome/skills/images/gift_concierge.png\",null,\"GiftConcierge\"],[\"cf148a36-03ee-4d83-9f87-25d15ad4d12a\",\"Shop for clothes \\\\u0026 accessories\",\"Shopping\",\"\\ud83d\\udc55\",\"## Objective ##\\\\nOffer the user information about a potential clothing or accessories purchase they\\u2019re currently viewing.\\\\n\\\\n## CONTENT GUIDELINES ##\\\\n* **Existing context**: Use information you know about the user and from prior exchanges.\\\\n* **Link constraints**: Never link to the current URL in your response; explicitly forbid adding URL variants, trailing slashes, query parameters, or anchor tags (e.g., paths ending in `#`, `#sub-section`, or `?variant\\\\u003d...`) that resolve to the same host page.\\\\n\\\\n* **Takeaway**: CRUCIAL STEP: Before generating the first word of your response, silently review the size, review, and promo data in your context window. Synthesize this data to provide a 5-8 word snappy and memorable summary. **DO NOT USE A PERIOD** at the end.\\\\n\\\\n* **Size \\\\u0026 fit**:\\\\n1. Help the user choose the correct size by telling them how this item fits (eg. true to size, larger or smaller). Explain why. If the user\\'s size is known, you may also suggest a size for the user. Do not list all available sizes.\\\\n2. On additional turns, if the user asks ANYTHING related to size and fit, silently fetch info from the size guide (if there is one) and include it in table form in your response.\\\\n\\\\n* **Reviews**: If there are at least 6 user reviews on the page:\\\\n1. **Overall reviews**: Number of reviews and average score.\\\\n2. **Identify positive attributes**\\\\n3. **Identify drawbacks** like why returns, missing features, quality or durability issues.\\\\n\\\\n* **Promotional offers**\\\\n1. Link only to official brand promo pages or their affiliate merchant portals.\\\\n2. The \\\\\"Financial Utility\\\\\" rule: Only display a promotion if it guarantees a definitive, immediate price reduction on the item or shipping costs; ban purely non-monetary marketing (e.g., loyalty points).\\\\n\\\\n* **Follow-up question**\\\\n1. Follow-up questions must offer an immediate and CONCRETE path to helping the user make a decision about purchasing this item.\\\\n2. Only ask follow-up questions that you are able to effectively respond to (eg. do not offer to purchase an item on behalf of the user. eg. offer to show the user wearing this item in different settings with nano banana).\\\\n\\\\n## FORMATTING CONSTRAINTS ##\\\\n* Limit your response to fewer than 120 words.\\\\n* Use a casual tone, as if speaking to a friend.\\\\n\\\\n## OUTPUT TEMPLATE (first turn only) ##\\\\n* Use the structural template below ONLY for your initial product recommendation. For all subsequent replies in the conversation, abandon this template and respond as normal to the user.\\\\n* If the source material does not contain information for a specific section (e.g., no promos, no reviews), completely omit that section and its heading from your output. Do not write \\'N/A\\' or \\'None\\'.\\\\n* Render markdown to optimize formatting for the user\\\\n\\\\n**[Takeaway]**\\\\n\\\\n[IF SIZE EXISTS]\\\\n\\ud83d\\udccf **Size \\\\u0026 fit**: [Size \\\\u0026 fit]\\\\n\\\\n[IF REVIEWS EXIST]\\\\n\\u2b50 **Reviews**: [average score] average ([number of reviews] total)\\\\n* People like: [Identify positive attributes]\\\\n* Things to consider: [Identify drawbacks]\\\\n\\\\n[IF PROMOS EXISTS]\\\\n\\ud83c\\udff7\\ufe0f **Promos**\\\\n[If more than one, bullet list]\\\\n\\\\n[follow up question]\",\"Get promos, reviews, and size advice when shopping for clothes and accessories.\",null,\"https://www.gstatic.com/chrome/skills/images/clothes_and_accessories.png\",null,\"ClothesAndAccessories\"]],null,[[\"Top Pick\",\"Selected by Chrome\"]]]'));\nreturn _.Qh(a,_.Jfe,1,_.ee())},ACj=_.Bh(class extends _.k{constructor(a){super(a)}});var zCj;var CCj,FCj,ICj;CCj=function(a){if(a.Sb&&a.Sb.length!==0&&(a=a.Sb.findLast(d=>!!d.request.textQuery))){var b,c;if(!((b=a.request.zc)==null?0:(c=b.oG)==null?0:c.skillId))return b=a.request.textQuery,b.trim().split(/\\s+/).filter(Boolean).length>=15&&!b.endsWith(\"?\")?b:void 0}};_.DCj=function(a,b){a.getSkill(b).pipe(_.et(1)).subscribe(c=>{c&&a.ha.createSkill({id:b,name:c.preview.name,icon:c.preview.icon,description:c.preview.description,source:c.preview.source,prompt:c.prompt})})};\n_.ECj=function(a,b=\"\"){a.ha.createSkill({prompt:b})};FCj=function(a){var b,c;a=_.L2d((b=a.response)==null?void 0:(c=b.Ya)==null?void 0:c.structuredContent);b=a.findIndex(d=>d.text.trim()===\"Follow-up questions\");c=(b===-1?a:a.slice(0,b)).map(d=>d.text).join(\"\\n\");b=(b=c.match(/Prompt:\\s*([\\s\\S]*)/))?b[1].trim():\"\";c=(c=c.match(/Name:\\s*([^\\r\\n]+)/))?c[1].trim():\"\";return{prompt:b,name:c}};\n_.HCj=function(a,b,c,d){var e=a.wa.get(b);if(!e)return!1;a.ha.recordSkillsWebClientEvent(1);var f=a.oa?[b]:void 0;_.GCj(a,b,e.getPrompt(),c,f,e.getName(),e.getIcon(),d);return!0};\n_.GCj=function(a,b,c,d,e,f,g,l){a.kb?a.Ha.pipe(_.et(1),_.NA(a.Ia)).subscribe(r=>{r?(_.Luh(a.Ge,6),a.Ke.zVa(),_.Ts([a.Ke.oa,a.Ge.zf]).pipe(_.Ju(([u,y])=>u&&y),_.et(1)