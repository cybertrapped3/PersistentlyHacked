px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n        }\\\\n\\\\n        aside {\\\\n            width: 360px;\\\\n            background-color: var(--bg-secondary);\\\\n            border-left: 1px solid var(--border-color);\\\\n            padding: 20px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            gap: 16px;\\\\n            overflow-y: auto;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            aside {\\\\n                width: 100%;\\\\n                border-left: none;\\\\n                border-top: 1px solid var(--border-color);\\\\n            }\\\\n        }\\\\n\\\\n        .sidebar-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            padding-bottom: 12px;\\\\n            border-bottom: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .sidebar-header h2 {\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 700;\\\\n            text-transform: uppercase;\\\\n            letter-spacing: 0.05em;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .live-badge {\\\\n            background-color: rgba(37, 99, 235, 0.1);\\\\n            color: #60a5fa;\\\\n            border: 1px solid rgba(37, 99, 235, 0.2);\\\\n            padding: 2px 8px;\\\\n            border-radius: 4px;\\\\n            font-size: 0.7rem;\\\\n            font-weight: 60\\\\n```\\\",null,null,null,null,\\\"index.html\\\",2,null,false,null,[\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: ce