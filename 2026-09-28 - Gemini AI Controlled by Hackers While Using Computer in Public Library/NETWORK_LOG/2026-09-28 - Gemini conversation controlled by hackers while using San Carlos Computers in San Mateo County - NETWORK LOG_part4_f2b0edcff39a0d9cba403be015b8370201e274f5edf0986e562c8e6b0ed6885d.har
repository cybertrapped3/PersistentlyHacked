\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 8px 14px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 500;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n            transition: background-color 0.2s;\\\\n        }\\\\n\\\\n        .btn:hover {\\\\n            background-color: #374151;\\\\n        }\\\\n\\\\n        .btn-primary {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-primary:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n        }\\\\n\\\\n        aside {\\\\n            width: 360px;\\\\n            background-color: var(--bg-secondary);\\\\n            border-left: 1px solid var(--border-color);\\\\n            padding: 20px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            gap: 16px;\\\\n            overflow-y: auto;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            aside {\\\\n                width: 100%;\\\\n                border-left: none;\\\\n                border-top: 1px solid var(--border-color);\\\\n            }\\\\n        }\\\\n\\\\n        .sidebar-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            padding-bottom: 12px;\\\\n            border-bottom: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .sidebar-header h2 {\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 700;\\\\n            text-transform: uppercase;\\\\n            letter-spacing: 0.05em;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .live-badge {\\\\n            background-color: rgba(37, 99, 235, 0.1);\\\\n            color: #60a5fa;\\\\n            border: 1px solid rgba(37, 99, 235, 0.2);\\\\n            padding: 2px 8px;\\\\n            border-radius: 4px;\\\\n            font-size: 0.7rem;\\\\n            font-weight: 600;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n        }\\\\n\\\\n        .live-dot {\\\\n            width: 6px;\\\\n            height: 6px;\\\\n            background-color: #60a5fa;\\\\n            border-radius: 50%;\\\\n        }\\\\n\\\\n        .stat-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 10px;\\\\n        }\\\\n\\\\n        .stat-label {\\\\n            font-size: 0.7rem;\\\\n            font-weight: 500;\\\\n            color: var(--text-muted);\\\\n            margin-bottom: 4px;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .stat-value {\\\\n            font-family: monospace;\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            color: #60a5fa;\\\\n        }\\\\n\\\\n        .stat-value-sm {\\\\n            font-family: monospace;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n        }\\\\n\\\\n        .stat-grid-2 {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .hexdump-box {\\\\n            font-family: monospace;\\\\n            font-size: 0.65rem;\\\\n            color: var(--text-muted);\\\\n            background-color: black;\\\\n            padding: 8px;\\\\n            border-radius: 6px;\\\\n            overflow-x: auto;\\\\n            white-space: pre;\\\\n            line-height: 1.3;\\\\n            max-height: 100px;\\\\n            border: 1px solid #111;\\\\n        }\\\\n\\\\n        .shortcuts-box {\\\\n            margin-top: auto;\\\\n            padding-top: 12px;\\\\n            border-top: 1px solid var(--border-color);\\\\n            font-size: 0.7rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .shortcuts-box p {\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n            margin-bottom: 4px;\\\\n        }\\\\n\\\\n        .shortcut-grid {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        kbd {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 2px 4px;\\\\n            border-radius: 4px;\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n    \\\\u003c/style\\\\u003e\\\\n\\\\u003c/head\\\\u003e\\\\n\\\\u003cbody\\\\u003e\\\\n\\\\n    \\\\u003cheader role\\\\u003d\\\\\\\"banner\\\\\\\"\\\\u003e\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"header-title\\\\\\\"\\\\u003e\\\\n            \\\\u003ch1\\\\u003eQuickTime MOV Analyzer \\\\u0026 Extractor\\\\u003c/h1\\\\u003e\\\\n            \\\\u003cp\\\\u003eSan Carlos Library Station • Pure Browser Implementation\\\\u003c/p\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n        \\\\u003cdiv\\\\u003e\\\\n            \\\\u003clabel for\\\\u003d\\\\\\\"video-upload-input\\\\\\\" class\\\\u003d\\\\\\\"upload-btn-label\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" id\\\\u003d\\\\\\\"file-label-btn\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan\\\\u003eSelect .mov Video File\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/label\\\\u003e\\\\n            \\\\u003cinput type\\\\u003d\\\\\\\"file\\\\\\\" id\\\\u003d\\\\\\\"video-upload-input\\\\\\\" accept\\\\u003d\\\\\\\".mov,video/quicktime,video/*\\\\\\\" style\\\\u003d\\\\\\\"display: none;\\\\\\\"\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n    \\\\u003c/header\\\\u003e\\\\n\\\\n    \\\\u003cmain\\\\u003e\\\\n        \\\\u003c!-- Left Workspace: Video \\\\u0026 Controls --\\\\u003e\\\\n        \\\\u003csection class\\\\u003d\\\\\\\"workspace\\\\\\\" aria-label\\\\u003d\\\\\\\"Video Player Workspace\\\\\\\"\\\\u003e\\\\n            \\\\n            \\\\u003c!-- Dropzone / Empty State --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"drop-zone\\\\\\\" class\\\\u003d\\\\\\\"drop-zone\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" aria-label\\\\u003d\\\\\\\"Dropzone for video file. Press Enter to browse files.\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"margin-bottom: 16px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003csvg width\\\\u003d\\\\\\\"48\\\\\\\" height\\\\u003d\\\\\\\"48\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"#60a5fa\\\\\\\" stroke-width\\\\u003d\\\\\\\"1.5\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\"\\\\u003e\\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\" d\\\\u003d\\\\\\\"M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12\\\\\\\"/\\\\u003e\\\\u003c/svg\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003ch2\\\\u003eDrag \\\\u0026 Drop your QuickTime .mov Video\\\\u003c/h2\\\\u003e\\\\n                \\\\u003cp\\\\u003eSupports QuickTime container files including Vivitar AquaSnap MJPEG captures and standard MP4/MOV formats.\\\\u003c/p\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"drop-zone-badge\\\\\\\"\\\\u003ePress Enter or click here to browse files\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Active Video View (Hidden Initially) --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"video-container\\\\\\\" class\\\\u003d\\\\\\\"video-container\\\\\\\"\\\\u003e\\\\n                \\\\n                \\\\u003c!-- Video Display Frame --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"video-wrapper\\\\\\\"\\\\u003e\\\\n                    \\\\u003cvideo id\\\\u003d\\\\\\\"main-video\\\\\\\" preload\\\\u003d\\\\\\\"metadata\\\\\\\" playsinline\\\\u003e\\\\u003c/video\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Timeline Scrubber --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"scrubber-row\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan id\\\\u003d\\\\\\\"current-time-display\\\\\\\" class\\\\u003d\\\\\\\"time-label\\\\\\\"\\\\u003e00:00\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cinput type\\\\u003d\\\\\\\"range\\\\\\\" id\\\\u003d\\\\\\\"timeline-slider\\\\\\\" min\\\\u003d\\\\\\\"0\\\\\\\" max\\\\u003d\\\\\\\"100\\\\\\\" value\\\\u003d\\\\\\\"0\\\\\\\" step\\\\u003d\\\\\\\"0.001\\\\\\\" aria-label\\\\u003d\\\\\\\"Video timeline scrubber\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan id\\\\u003d\\\\\\\"duration-display\\\\\\\" class\\\\u003d\\\\\\\"time-label\\\\\\\"\\\\u003e00:00\\\\u003c/span\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Primary Playback Controls --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"control-toolbar\\\\\\\" role\\\\u003d\\\\\\\"toolbar\\\\\\\" aria-label\\\\u003d\\\\\\\"Playback controls\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"btn-group\\\\\\\"\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-skip-back\\\\\\\" class\\\\u003d\\\\\\\"btn\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Skip back 5 seconds\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003e-5s\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-play-pause\\\\\\\" class\\\\u003d\\\\\\\"btn btn-primary\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan id\\\\u003d\\\\\\\"play-pause-text\\\\\\\"\\\\u003ePlay\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-skip-forward\\\\\\\" class\\\\u003d\\\\\\\"btn\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Skip forward 5 seconds\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003e+5s\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n\\\\n                    \\\\u003cdiv\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-capture\\\\\\\" class\\\\u003d\\\\\\\"btn btn-capture\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Extract still image at current timestamp\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003eTake Still Image\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Speed Selector Toolbar --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"speed-toolbar\\\\\\\" role\\\\u003d\\\\\\\"toolbar\\\\\\\" aria-label\\\\u003d\\\\\\\"Playback speed selector\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan\\\\u003ePlayback Speed:\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"speed-buttons\\\\\\\"\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.25\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.25x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.5\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.5x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.75\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.75x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn active\\\\\\\" data-speed\\\\u003d\\\\\\\"1\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.25\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.25x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.5\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.5x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.75\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.75x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"2\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e2x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"3\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e3x\\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Extracted Frames Gallery --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"gallery-box\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"gallery-header\\\\\\\"\\\\u003e\\\\n                        \\\\u003ch3\\\\u003eExtracted Still Frames Gallery\\\\u003c/h3\\\\u003e\\\\n                        \\\\u003cspan id\\\\u003d\\\\\\\"gallery-count\\\\\\\" class\\\\u003d\\\\\\\"drop-zone-badge\\\\\\\"\\\\u003e0 captured\\\\u003c/span\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"gallery-grid\\\\\\\" class\\\\u003d\\\\\\\"gallery-grid\\\\\\\"\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"gallery-empty\\\\\\\" class\\\\u003d\\\\\\\"gallery-empty\\\\\\\"\\\\u003e\\\\n                            No frames captured yet. Click \\\\\\\"Take Still Image\\\\\\\" or press 'C' while playing.\\\\n                        \\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n        \\\\u003c/section\\\\u003e\\\\n\\\\n        \\\\u003c!-- Right Sidebar: Live Telemetry \\\\u0026 Metadata --\\\\u003e\\\\n        \\\\u003caside aria-label\\\\u003d\\\\\\\"Live Statistics Sidebar\\\\\\\"\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"sidebar-header\\\\\\\"\\\\u003e\\\\n                \\\\u003ch2\\\\u003eLive Telemetry\\\\u003c/h2\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"live-badge\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"live-dot\\\\\\\"\\\\u003e\\\\u003c/div\\\\u003e\\\\n                    Active\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Current Timestamp --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eCurrent Timestamp\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-timestamp\\\\\\\" class\\\\u003d\\\\\\\"stat-value\\\\\\\"\\\\u003e00:00.000\\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-seconds\\\\\\\" style\\\\u003d\\\\\\\"font-size: 0.7rem; color: var(--text-muted); font-family: monospace; margin-top: 2px;\\\\\\\"\\\\u003e0.000 seconds\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Frame Number \\\\u0026 FPS --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-grid-2\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eFrame #\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-frame-num\\\\\\\" class\\\\u003d\\\\\\\"stat-value\\\\\\\" style\\\\u003d\\\\\\\"color: #34d399;\\\\\\\"\\\\u003e0\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEst. FPS\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-fps\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e30.0 fps\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- MIME Type --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eVideo MIME Type\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-mimetype\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\" style\\\\u003d\\\\\\\"word-break: break-all;\\\\\\\"\\\\u003eNo video loaded\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Encoding \\\\u0026 Codec Inspection --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEncoding / Codec Inspection\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-encoding\\\\\\\" style\\\\u003d\\\\\\\"font-size: 0.75rem; color: #fbbf24; font-family: monospace; line-height: 1.4;\\\\\\\"\\\\u003eWaiting for file header analysis...\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Duration \\\\u0026 Resolution --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-grid-2\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eDuration\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-duration\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e00:00\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eResolution\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-resolution\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e0 × 0\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Header Hex Dump Inspector --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\" style\\\\u003d\\\\\\\"margin-bottom:0;\\\\\\\"\\\\u003eMOV Header \\\\u0026 Markers\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cspan style\\\\u003d\\\\\\\"font-size: 0.65rem; color: var(--text-muted); font-family: monospace;\\\\\\\"\\\\u003eFirst 128 bytes\\\\u003c/span\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-hexdump\\\\\\\" class\\\\u003d\\\\\\\"hexdump-box\\\\\\\"\\\\u003eNo header bytes read yet.\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Keyboard Guide --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"shortcuts-box\\\\\\\"\\\\u003e\\\\n                \\\\u003cp\\\\u003eKeyboard Shortcuts:\\\\u003c/p\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"shortcut-grid\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eSpace/Enter\\\\u003c/kbd\\\\u003e Play/Pause\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003e← / →\\\\u003c/kbd\\\\u003e Skip -/+ 5s\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eC\\\\u003c/kbd\\\\u003e Capture Frame\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eTab\\\\u003c/kbd\\\\u003e Navigate UI\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n        \\\\u003c/aside\\\\u003e\\\\n    \\\\u003c/main\\\\u003e\\\\n\\\\n    \\\\u003cscript\\\\u003e\\\\n        document.addEventListener('DOMContentLoaded', () \\\\u003d\\\\u003e {\\\\n            const videoUploadInput \\\\u003d document.getElementById('video-upload-input');\\\\n            const fileLabelBtn \\\\u003d document.getElementById('file-label-btn');\\\\n            const dropZone \\\\u003d document.getElementById('drop-zone');\\\\n            const videoContainer \\\\u003d document.getElementById('video-container');\\\\n            const mainVideo \\\\u003d document.getElementById('main-video');\\\\n            const playPauseBtn \\\\u003d document.getElementById('btn-play-pause');\\\\n            const playPauseText \\\\u003d document.getElementById('play-pause-text');\\\\n            const skipBackBtn \\\\u003d document.getElementById('btn-skip-back');\\\\n            const skipForwardBtn \\\\u003d document.getElementById('btn-skip-forward');\\\\n            const captureBtn \\\\u003d document.getElementById('btn-capture');\\\\n            const timelineSlider \\\\u003d document.getElementById('timeline-slider');\\\\n            const currentTimeDisplay \\\\u003d document.getElementById('current-time-display');\\\\n            const durationDisplay \\\\u003d document.getElementById('duration-display');\\\\n            const galleryGrid \\\\u003d document.getElementById('gallery-grid');\\\\n            const galleryEmpty \\\\u003d document.getElementById('gallery-empty');\\\\n            const galleryCount \\\\u003d document.getElementById('gallery-count');\\\\n\\\\n            // Stats telemetry elements\\\\n            const statTimestamp \\\\u003d document.getElementById('stat-timestamp');\\\\n            const statSeconds \\\\u003d document.getElementById('stat-seconds');\\\\n            const statFrameNum \\\\u003d document.getElementById('stat-frame-num');\\\\n            const statFps \\\\u003d document.getElementById('stat-fps');\\\\n            const statMimeType \\\\u003d document.getElementById('stat-mimetype');\\\\n            const statEncoding \\\\u003d document.getElementById('stat-encoding');\\\\n            const statDuration \\\\u003d document.getElementById('stat-duration');\\\\n            const statResolution \\\\u003d document.getElementById('stat-resolution');\\\\n            const statHexdump \\\\u003d document.getElementById('stat-hexdump');\\\\n\\\\n            let currentFps \\\\u003d 30.0;\\\\n            let capturedCount \\\\u003d 0;\\\\n            let videoObjectUrl \\\\u003d null;\\\\n\\\\n            // Keyboard accessibility for file picker button in header\\\\n            fileLabelBtn.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Keyboard accessibility for dropzone\\\\n            dropZone.addEventListener('click', () \\\\u003d\\\\u003e {\\\\n                videoUploadInput.click();\\\\n            });\\\\n\\\\n            dropZone.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Drag and drop support\\\\n            dropZone.addEventListener('dragover', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.style.borderColor \\\\u003d 'var(--accent-blue)';\\\\n            });\\\\n\\\\n            dropZone.addEventListener('dragleave', () \\\\u003d\\\\u003e {\\\\n                dropZone.style.borderColor \\\\u003d 'var(--border-color)';\\\\n            });\\\\n\\\\n            dropZone.addEventListener('drop', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.style.borderColor \\\\u003d 'var(--border-color)';\\\\n                if (e.dataTransfer.files \\\\u0026\\\\u0026 e.dataTransfer.files.length \\\\u003e 0) {\\\\n                    processVideoFile(e.dataTransfer.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            videoUploadInput.addEventListener('change', (e) \\\\u003d\\\\u003e {\\\\n                if (e.target.files \\\\u0026\\\\u0026 e.target.files.length \\\\u003e 0) {\\\\n                    processVideoFile(e.target.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            function processVideoFile(file) {\\\\n                if (videoObjectUrl) {\\\\n                    URL.revokeObjectURL(videoObjectUrl);\\\\n                }\\\\n                videoObjectUrl \\\\u003d URL.createObjectURL(file);\\\\n                mainVideo.src \\\\u003d videoObjectUrl;\\\\n                mainVideo.load();\\\\n\\\\n                dropZone.style.display \\\\u003d 'none';\\\\n                videoContainer.style.display \\\\u003d 'flex';\\\\n\\\\n                statMimeType.textContent \\\\u003d file.type || 'video/quicktime (.mov)';\\\\n\\\\n                // Inspect header bytes (Vivitar AquaSnap / QuickTime container signature analysis)\\\\n                const reader \\\\u003d new FileReader();\\\\n                reader.onload \\\\u003d function(evt) {\\\\n                    const buffer \\\\u003d evt.target.result;\\\\n                    const uint8 \\\\u003d new Uint8Array(buffer);\\\\n                    let hex \\\\u003d '';\\\\n                    let ascii \\\\u003d '';\\\\n                    for (let i \\\\u003d 0; i \\\\u003c Math.min(uint8.length, 128); i++) {\\\\n                        const b \\\\u003d uint8[i];\\\\n                        hex +\\\\u003d b.toString(16).padStart(2, '0') + ' ';\\\\n                        ascii +\\\\u003d (b \\\\u003e\\\\u003d 32 \\\\u0026\\\\u0026 b \\\\u003c\\\\u003d 126) ? String.fromCharCode(b) : '.';\\\\n                    }\\\\n\\\\n                    statHexdump.textContent \\\\u003d `HEX: ${hex}\\\\\\\\nASCII: ${ascii}`;\\\\n\\\\n                    let encodingInfo \\\\u003d 'QuickTime Container (.mov)';\\\\n                    if (ascii.includes('ftypqt') || ascii.includes('qt')) {\\\\n                        encodingInfo +\\\\u003d ' • QuickTime Atom (ftypqt)';\\\\n                    }\\\\n                    if (hex.includes('ff d8 ff') || ascii.includes('JFIF') || ascii.includes('Exif')) {\\\\n                        encodingInfo +\\\\u003d ' • Motion-JPEG (MJPEG) Stream Detected';\\\\n                    } else {\\\\n                        encodingInfo +\\\\u003d ' • Standard AVC / H.264 Stream';\\\\n                    }\\\\n                    statEncoding.textContent \\\\u003d encodingInfo;\\\\n                };\\\\n                reader.readAsArrayBuffer(file.slice(0, 512));\\\\n            }\\\\n\\\\n            mainVideo.addEventListener('loadedmetadata', () \\\\u003d\\\\u003e {\\\\n                durationDisplay.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statDuration.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statResolution.textContent \\\\u003d `${mainVideo.videoWidth || 3840} × ${mainVideo.videoHeight || 2160}`;\\\\n                timelineSlider.max \\\\u003d mainVideo.duration;\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('timeupdate', () \\\\u003d\\\\u003e {\\\\n                const ct \\\\u003d mainVideo.currentTime;\\\\n                currentTimeDisplay.textContent \\\\u003d formatTime(ct);\\\\n                timelineSlider.value \\\\u003d ct;\\\\n\\\\n                statTimestamp.textContent \\\\u003d formatDetailedTime(ct);\\\\n                statSeconds.textContent \\\\u003d ct.toFixed(3) + ' seconds';\\\\n                statFrameNum.textContent \\\\u003d Math.floor(ct * currentFps).toLocaleString();\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('play', () \\\\u003d\\\\u003e {\\\\n                playPauseText.textContent \\\\u003d 'Pause';\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('pause', () \\\\u003d\\\\u003e {\\\\n                playPauseText.textContent \\\\u003d 'Play';\\\\n            });\\\\n\\\\n            playPauseBtn.addEventListener('click', togglePlay);\\\\n            skipBackBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5); });\\\\n            skipForwardBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5); });\\\\n\\\\n            function togglePlay() {\\\\n                if (mainVideo.paused) {\\\\n                    mainVideo.play().catch(err \\\\u003d\\\\u003e console.log(\\\\\\\"Play error:\\\\\\\", err));\\\\n                } else {\\\\n                    mainVideo.pause();\\\\n                }\\\\n            }\\\\n\\\\n            timelineSlider.addEventListener('input', (e) \\\\u003d\\\\u003e {\\\\n                mainVideo.currentTime \\\\u003d parseFloat(e.target.value);\\\\n            });\\\\n\\\\n            // Speed buttons setup\\\\n            const speedButtons \\\\u003d document.querySelectorAll('.speed-btn');\\\\n            speedButtons.forEach(btn \\\\u003d\\\\u003e {\\\\n                btn.addEventListener('click', (e) \\\\u003d\\\\u003e {\\\\n                    const speed \\\\u003d parseFloat(e.target.getAttribute('data-speed'));\\\\n                    mainVideo.playbackRate \\\\u003d speed;\\\\n\\\\n                    speedButtons.forEach(b \\\\u003d\\\\u003e b.classList.remove('active'));\\\\n                    e.target.classList.add('active');\\\\n                });\\\\n            });\\\\n\\\\n            captureBtn.addEventListener('click', captureFrame);\\\\n\\\\n            function captureFrame() {\\\\n                if (!mainVideo.videoWidth || !mainVideo.videoHeight) return;\\\\n\\\\n                const canvas \\\\u003d document.createElement('canvas');\\\\n                canvas.width \\\\u003d mainVideo.videoWidth;\\\\n                canvas.height \\\\u003d mainVideo.videoHeight;\\\\n                const ctx \\\\u003d canvas.getContext('2d');\\\\n                ctx.drawImage(mainVideo, 0, 0, canvas.width, canvas.height);\\\\n\\\\n                const dataUrl \\\\u003d canvas.toDataURL('image/png');\\\\n                const timeStr \\\\u003d formatTime(mainVideo.currentTime).replace(':', '-');\\\\n                const frameIdx \\\\u003d Math.floor(mainVideo.currentTime * currentFps);\\\\n\\\\n                capturedCount++;\\\\n                galleryCount.textContent \\\\u003d `${capturedCount} captured`;\\\\n                if (galleryEmpty) galleryEmpty.remove();\\\\n\\\\n                const thumb \\\\u003d document.createElement('div');\\\\n                thumb.className \\\\u003d 'thumb-card';\\\\n                thumb.innerHTML \\\\u003d `\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"thumb-img-wrapper\\\\\\\"\\\\u003e\\\\n                        \\\\u003cimg src\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" alt\\\\u003d\\\\\\\"Still frame at ${formatTime(mainVideo.currentTime)}\\\\\\\"\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"thumb-footer\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan\\\\u003e${formatTime(mainVideo.currentTime)}\\\\u003c/span\\\\u003e\\\\n                        \\\\u003ca href\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" download\\\\u003d\\\\\\\"mov_frame_${frameIdx}_${timeStr}.png\\\\\\\" class\\\\u003d\\\\\\\"thumb-download\\\\\\\"\\\\u003eDownload\\\\u003c/a\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                `;\\\\n                galleryGrid.prepend(thumb);\\\\n            }\\\\n\\\\n            // Keyboard navigation shortcuts\\\\n            document.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'INPUT' || document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'TEXTAREA') {\\\\n                    return;\\\\n                }\\\\n\\\\n                if (e.code \\\\u003d\\\\u003d\\\\u003d 'Space') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        togglePlay();\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowLeft') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5);\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowRight') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5);\\\\n                    }\\\\n                } else if (e.key \\\\u003d\\\\u003d\\\\u003d 'c' || e.key \\\\u003d\\\\u003d\\\\u003d 'C') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        captureFrame();\\\\n                    }\\\\n                }\\\\n            });\\\\n\\\\n            function formatTime(secs) {\\\\n                if (\\\\n```\\\",null,null,null,null,\\\"index.html\\\",2,null,false,null,[\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 8px 14px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 500;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n            transition: background-color 0.2s;\\\\n        }\\\\n\\\\n        .btn:hover {\\\\n            background-color: #374151;\\\\n        }\\\\n\\\\n        .btn-primary {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-primary:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n        }\\\\n\\\\n        aside {\\\\n            width: 360px;\\\\n            background-color: var(--bg-secondary);\\\\n            border-left: 1px solid var(--border-color);\\\\n            padding: 20px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            gap: 16px;\\\\n            overflow-y: auto;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            aside {\\\\n                width: 100%;\\\\n                border-left: none;\\\\n                border-top: 1px solid var(--border-color);\\\\n            }\\\\n        }\\\\n\\\\n        .sidebar-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            padding-bottom: 12px;\\\\n            border-bottom: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .sidebar-header h2 {\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 700;\\\\n            text-transform: uppercase;\\\\n            letter-spacing: 0.05em;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .live-badge {\\\\n            background-color: rgba(37, 99, 235, 0.1);\\\\n            color: #60a5fa;\\\\n            border: 1px solid rgba(37, 99, 235, 0.2);\\\\n            padding: 2px 8px;\\\\n            border-radius: 4px;\\\\n            font-size: 0.7rem;\\\\n            font-weight: 600;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n        }\\\\n\\\\n        .live-dot {\\\\n            width: 6px;\\\\n            height: 6px;\\\\n            background-color: #60a5fa;\\\\n            border-radius: 50%;\\\\n        }\\\\n\\\\n        .stat-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 10px;\\\\n        }\\\\n\\\\n        .stat-label {\\\\n            font-size: 0.7rem;\\\\n            font-weight: 500;\\\\n            color: var(--text-muted);\\\\n            margin-bottom: 4px;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .stat-value {\\\\n            font-family: monospace;\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            color: #60a5fa;\\\\n        }\\\\n\\\\n        .stat-value-sm {\\\\n            font-family: monospace;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n        }\\\\n\\\\n        .stat-grid-2 {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .hexdump-box {\\\\n            font-family: monospace;\\\\n            font-size: 0.65rem;\\\\n            color: var(--text-muted);\\\\n            background-color: black;\\\\n            padding: 8px;\\\\n            border-radius: 6px;\\\\n            overflow-x: auto;\\\\n            white-space: pre;\\\\n            line-height: 1.3;\\\\n            max-height: 100px;\\\\n            border: 1px solid #111;\\\\n        }\\\\n\\\\n        .shortcuts-box {\\\\n            margin-top: auto;\\\\n            padding-top: 12px;\\\\n            border-top: 1px solid var(--border-color);\\\\n            font-size: 0.7rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .shortcuts-box p {\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n            margin-bottom: 4px;\\\\n        }\\\\n\\\\n        .shortcut-grid {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        kbd {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 2px 4px;\\\\n            border-radius: 4px;\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n    \\\\u003c/style\\\\u003e\\\\n\\\\u003c/head\\\\u003e\\\\n\\\\u003cbody\\\\u003e\\\\n\\\\n    \\\\u003cheader role\\\\u003d\\\\\\\"banner\\\\\\\"\\\\u003e\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"header-title\\\\\\\"\\\\u003e\\\\n            \\\\u003ch1\\\\u003eQuickTime MOV Analyzer \\\\u0026 Extractor\\\\u003c/h1\\\\u003e\\\\n            \\\\u003cp\\\\u003eSan Carlos Library Station • Pure Browser Implementation\\\\u003c/p\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n        \\\\u003cdiv\\\\u003e\\\\n            \\\\u003clabel for\\\\u003d\\\\\\\"video-upload-input\\\\\\\" class\\\\u003d\\\\\\\"upload-btn-label\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" id\\\\u003d\\\\\\\"file-label-btn\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan\\\\u003eSelect .mov Video File\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/label\\\\u003e\\\\n            \\\\u003cinput type\\\\u003d\\\\\\\"file\\\\\\\" id\\\\u003d\\\\\\\"video-upload-input\\\\\\\" accept\\\\u003d\\\\\\\".mov,video/quicktime,video/*\\\\\\\" style\\\\u003d\\\\\\\"display: none;\\\\\\\"\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n    \\\\u003c/header\\\\u003e\\\\n\\\\n    \\\\u003cmain\\\\u003e\\\\n        \\\\u003c!-- Left Workspace: Video \\\\u0026 Controls --\\\\u003e\\\\n        \\\\u003csection class\\\\u003d\\\\\\\"workspace\\\\\\\" aria-label\\\\u003d\\\\\\\"Video Player Workspace\\\\\\\"\\\\u003e\\\\n            \\\\n            \\\\u003c!-- Dropzone / Empty State --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"drop-zone\\\\\\\" class\\\\u003d\\\\\\\"drop-zone\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" aria-label\\\\u003d\\\\\\\"Dropzone for video file. Press Enter to browse files.\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"margin-bottom: 16px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003csvg width\\\\u003d\\\\\\\"48\\\\\\\" height\\\\u003d\\\\\\\"48\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"#60a5fa\\\\\\\" stroke-width\\\\u003d\\\\\\\"1.5\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\"\\\\u003e\\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\" d\\\\u003d\\\\\\\"M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12\\\\\\\"/\\\\u003e\\\\u003c/svg\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003ch2\\\\u003eDrag \\\\u0026 Drop your QuickTime .mov Video\\\\u003c/h2\\\\u003e\\\\n                \\\\u003cp\\\\u003eSupports QuickTime container files including Vivitar AquaSnap MJPEG captures and standard MP4/MOV formats.\\\\u003c/p\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"drop-zone-badge\\\\\\\"\\\\u003ePress Enter or click here to browse files\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Active Video View (Hidden Initially) --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"video-container\\\\\\\" class\\\\u003d\\\\\\\"video-container\\\\\\\"\\\\u003e\\\\n                \\\\n                \\\\u003c!-- Video Display Frame --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"video-wrapper\\\\\\\"\\\\u003e\\\\n                    \\\\u003cvideo id\\\\u003d\\\\\\\"main-video\\\\\\\" preload\\\\u003d\\\\\\\"metadata\\\\\\\" playsinline\\\\u003e\\\\u003c/video\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Timeline Scrubber --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"scrubber-row\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan id\\\\u003d\\\\\\\"current-time-display\\\\\\\" class\\\\u003d\\\\\\\"time-label\\\\\\\"\\\\u003e00:00\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cinput type\\\\u003d\\\\\\\"range\\\\\\\" id\\\\u003d\\\\\\\"timeline-slider\\\\\\\" min\\\\u003d\\\\\\\"0\\\\\\\" max\\\\u003d\\\\\\\"100\\\\\\\" value\\\\u003d\\\\\\\"0\\\\\\\" step\\\\u003d\\\\\\\"0.001\\\\\\\" aria-label\\\\u003d\\\\\\\"Video timeline scrubber\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan id\\\\u003d\\\\\\\"duration-display\\\\\\\" class\\\\u003d\\\\\\\"time-label\\\\\\\"\\\\u003e00:00\\\\u003c/span\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Primary Playback Controls --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"control-toolbar\\\\\\\" role\\\\u003d\\\\\\\"toolbar\\\\\\\" aria-label\\\\u003d\\\\\\\"Playback controls\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"btn-group\\\\\\\"\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-skip-back\\\\\\\" class\\\\u003d\\\\\\\"btn\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Skip back 5 seconds\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003e-5s\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-play-pause\\\\\\\" class\\\\u003d\\\\\\\"btn btn-primary\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan id\\\\u003d\\\\\\\"play-pause-text\\\\\\\"\\\\u003ePlay\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-skip-forward\\\\\\\" class\\\\u003d\\\\\\\"btn\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Skip forward 5 seconds\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003e+5s\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n\\\\n                    \\\\u003cdiv\\\\u003e\\\\n                        \\\\u003cbutton id\\\\u003d\\\\\\\"btn-capture\\\\\\\" class\\\\u003d\\\\\\\"btn btn-capture\\\\\\\" type\\\\u003d\\\\\\\"button\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" title\\\\u003d\\\\\\\"Extract still image at current timestamp\\\\\\\"\\\\u003e\\\\n                            \\\\u003cspan\\\\u003eTake Still Image\\\\u003c/span\\\\u003e\\\\n                        \\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Speed Selector Toolbar --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"speed-toolbar\\\\\\\" role\\\\u003d\\\\\\\"toolbar\\\\\\\" aria-label\\\\u003d\\\\\\\"Playback speed selector\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan\\\\u003ePlayback Speed:\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"speed-buttons\\\\\\\"\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.25\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.25x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.5\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.5x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"0.75\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e0.75x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn active\\\\\\\" data-speed\\\\u003d\\\\\\\"1\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.25\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.25x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.5\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.5x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"1.75\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e1.75x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"2\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e2x\\\\u003c/button\\\\u003e\\\\n                        \\\\u003cbutton type\\\\u003d\\\\\\\"button\\\\\\\" class\\\\u003d\\\\\\\"speed-btn\\\\\\\" data-speed\\\\u003d\\\\\\\"3\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\"\\\\u003e3x\\\\u003c/button\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Extracted Frames Gallery --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"gallery-box\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"gallery-header\\\\\\\"\\\\u003e\\\\n                        \\\\u003ch3\\\\u003eExtracted Still Frames Gallery\\\\u003c/h3\\\\u003e\\\\n                        \\\\u003cspan id\\\\u003d\\\\\\\"gallery-count\\\\\\\" class\\\\u003d\\\\\\\"drop-zone-badge\\\\\\\"\\\\u003e0 captured\\\\u003c/span\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"gallery-grid\\\\\\\" class\\\\u003d\\\\\\\"gallery-grid\\\\\\\"\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"gallery-empty\\\\\\\" class\\\\u003d\\\\\\\"gallery-empty\\\\\\\"\\\\u003e\\\\n                            No frames captured yet. Click \\\\\\\"Take Still Image\\\\\\\" or press 'C' while playing.\\\\n                        \\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n        \\\\u003c/section\\\\u003e\\\\n\\\\n        \\\\u003c!-- Right Sidebar: Live Telemetry \\\\u0026 Metadata --\\\\u003e\\\\n        \\\\u003caside aria-label\\\\u003d\\\\\\\"Live Statistics Sidebar\\\\\\\"\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"sidebar-header\\\\\\\"\\\\u003e\\\\n                \\\\u003ch2\\\\u003eLive Telemetry\\\\u003c/h2\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"live-badge\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"live-dot\\\\\\\"\\\\u003e\\\\u003c/div\\\\u003e\\\\n                    Active\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Current Timestamp --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eCurrent Timestamp\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-timestamp\\\\\\\" class\\\\u003d\\\\\\\"stat-value\\\\\\\"\\\\u003e00:00.000\\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-seconds\\\\\\\" style\\\\u003d\\\\\\\"font-size: 0.7rem; color: var(--text-muted); font-family: monospace; margin-top: 2px;\\\\\\\"\\\\u003e0.000 seconds\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Frame Number \\\\u0026 FPS --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-grid-2\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eFrame #\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-frame-num\\\\\\\" class\\\\u003d\\\\\\\"stat-value\\\\\\\" style\\\\u003d\\\\\\\"color: #34d399;\\\\\\\"\\\\u003e0\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEst. FPS\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-fps\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e30.0 fps\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- MIME Type --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eVideo MIME Type\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-mimetype\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\" style\\\\u003d\\\\\\\"word-break: break-all;\\\\\\\"\\\\u003eNo video loaded\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Encoding \\\\u0026 Codec Inspection --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEncoding / Codec Inspection\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-encoding\\\\\\\" style\\\\u003d\\\\\\\"font-size: 0.75rem; color: #fbbf24; font-family: monospace; line-height: 1.4;\\\\\\\"\\\\u003eWaiting for file header analysis...\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Duration \\\\u0026 Resolution --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-grid-2\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eDuration\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-duration\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e00:00\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eResolution\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-resolution\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e0 × 0\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Header Hex Dump Inspector --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\" style\\\\u003d\\\\\\\"margin-bottom:0;\\\\\\\"\\\\u003eMOV Header \\\\u0026 Markers\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cspan style\\\\u003d\\\\\\\"font-size: 0.65rem; color: var(--text-muted); font-family: monospace;\\\\\\\"\\\\u003eFirst 128 bytes\\\\u003c/span\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-hexdump\\\\\\\" class\\\\u003d\\\\\\\"hexdump-box\\\\\\\"\\\\u003eNo header bytes read yet.\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Keyboard Guide --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"shortcuts-box\\\\\\\"\\\\u003e\\\\n                \\\\u003cp\\\\u003eKeyboard Shortcuts:\\\\u003c/p\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"shortcut-grid\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eSpace/Enter\\\\u003c/kbd\\\\u003e Play/Pause\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003e← / →\\\\u003c/kbd\\\\u003e Skip -/+ 5s\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eC\\\\u003c/kbd\\\\u003e Capture Frame\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eTab\\\\u003c/kbd\\\\u003e Navigate UI\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n        \\\\u003c/aside\\\\u003e\\\\n    \\\\u003c/main\\\\u003e\\\\n\\\\n    \\\\u003cscript\\\\u003e\\\\n        document.addEventListener('DOMContentLoaded', () \\\\u003d\\\\u003e {\\\\n            const videoUploadInput \\\\u003d document.getElementById('video-upload-input');\\\\n            const fileLabelBtn \\\\u003d document.getElementById('file-label-btn');\\\\n            const dropZone \\\\u003d document.getElementById('drop-zone');\\\\n            const videoContainer \\\\u003d document.getElementById('video-container');\\\\n            const mainVideo \\\\u003d document.getElementById('main-video');\\\\n            const playPauseBtn \\\\u003d document.getElementById('btn-play-pause');\\\\n            const playPauseText \\\\u003d document.getElementById('play-pause-text');\\\\n            const skipBackBtn \\\\u003d document.getElementById('btn-skip-back');\\\\n            const skipForwardBtn \\\\u003d document.getElementById('btn-skip-forward');\\\\n            const captureBtn \\\\u003d document.getElementById('btn-capture');\\\\n            const timelineSlider \\\\u003d document.getElementById('timeline-slider');\\\\n            const currentTimeDisplay \\\\u003d document.getElementById('current-time-display');\\\\n            const durationDisplay \\\\u003d document.getElementById('duration-display');\\\\n            const galleryGrid \\\\u003d document.getElementById('gallery-grid');\\\\n            const galleryEmpty \\\\u003d document.getElementById('gallery-empty');\\\\n            const galleryCount \\\\u003d document.getElementById('gallery-count');\\\\n\\\\n            // Stats telemetry elements\\\\n            const statTimestamp \\\\u003d document.getElementById('stat-timestamp');\\\\n            const statSeconds \\\\u003d document.getElementById('stat-seconds');\\\\n            const statFrameNum \\\\u003d document.getElementById('stat-frame-num');\\\\n            const statFps \\\\u003d document.getElementById('stat-fps');\\\\n            const statMimeType \\\\u003d document.getElementById('stat-mimetype');\\\\n            const statEncoding \\\\u003d document.getElementById('stat-encoding');\\\\n            const statDuration \\\\u003d document.getElementById('stat-duration');\\\\n            const statResolution \\\\u003d document.getElementById('stat-resolution');\\\\n            const statHexdump \\\\u003d document.getElementById('stat-hexdump');\\\\n\\\\n            let currentFps \\\\u003d 30.0;\\\\n            let capturedCount \\\\u003d 0;\\\\n            let videoObjectUrl \\\\u003d null;\\\\n\\\\n            // Keyboard accessibility for file picker button in header\\\\n            fileLabelBtn.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Keyboard accessibility for dropzone\\\\n            dropZone.addEventListener('click', () \\\\u003d\\\\u003e {\\\\n                videoUploadInput.click();\\\\n            });\\\\n\\\\n            dropZone.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Drag and drop support\\\\n            dropZone.addEventListener('dragover', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.style.borderColor \\\\u003d 'var(--accent-blue)';\\\\n            });\\\\n\\\\n            dropZone.addEventListener('dragleave', () \\\\u003d\\\\u003e {\\\\n                dropZone.style.borderColor \\\\u003d 'var(--border-color)';\\\\n            });\\\\n\\\\n            dropZone.addEventListener('drop', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.style.borderColor \\\\u003d 'var(--border-color)';\\\\n                if (e.dataTransfer.files \\\\u0026\\\\u0026 e.dataTransfer.files.length \\\\u003e 0) {\\\\n                    processVideoFile(e.dataTransfer.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            videoUploadInput.addEventListener('change', (e) \\\\u003d\\\\u003e {\\\\n                if (e.target.files \\\\u0026\\\\u0026 e.target.files.length \\\\u003e 0) {\\\\n                    processVideoFile(e.target.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            function processVideoFile(file) {\\\\n                if (videoObjectUrl) {\\\\n                    URL.revokeObjectURL(videoObjectUrl);\\\\n                }\\\\n                videoObjectUrl \\\\u003d URL.createObjectURL(file);\\\\n                mainVideo.src \\\\u003d videoObjectUrl;\\\\n                mainVideo.load();\\\\n\\\\n                dropZone.style.display \\\\u003d 'none';\\\\n                videoContainer.style.display \\\\u003d 'flex';\\\\n\\\\n                statMimeType.textContent \\\\u003d file.type || 'video/quicktime (.mov)';\\\\n\\\\n                // Inspect header bytes (Vivitar AquaSnap / QuickTime container signature analysis)\\\\n                const reader \\\\u003d new FileReader();\\\\n                reader.onload \\\\u003d function(evt) {\\\\n                    const buffer \\\\u003d evt.target.result;\\\\n                    const uint8 \\\\u003d new Uint8Array(buffer);\\\\n                    let hex \\\\u003d '';\\\\n                    let ascii \\\\u003d '';\\\\n                    for (let i \\\\u003d 0; i \\\\u003c Math.min(uint8.length, 128); i++) {\\\\n                        const b \\\\u003d uint8[i];\\\\n                        hex +\\\\u003d b.toString(16).padStart(2, '0') + ' ';\\\\n                        ascii +\\\\u003d (b \\\\u003e\\\\u003d 32 \\\\u0026\\\\u0026 b \\\\u003c\\\\u003d 126) ? String.fromCharCode(b) : '.';\\\\n                    }\\\\n\\\\n                    statHexdump.textContent \\\\u003d `HEX: ${hex}\\\\\\\\nASCII: ${ascii}`;\\\\n\\\\n                    let encodingInfo \\\\u003d 'QuickTime Container (.mov)';\\\\n                    if (ascii.includes('ftypqt') || ascii.includes('qt')) {\\\\n                        encodingInfo +\\\\u003d ' • QuickTime Atom (ftypqt)';\\\\n                    }\\\\n                    if (hex.includes('ff d8 ff') || ascii.includes('JFIF') || ascii.includes('Exif')) {\\\\n                        encodingInfo +\\\\u003d ' • Motion-JPEG (MJPEG) Stream Detected';\\\\n                    } else {\\\\n                        encodingInfo +\\\\u003d ' • Standard AVC / H.264 Stream';\\\\n                    }\\\\n                    statEncoding.textContent \\\\u003d encodingInfo;\\\\n                };\\\\n                reader.readAsArrayBuffer(file.slice(0, 512));\\\\n            }\\\\n\\\\n            mainVideo.addEventListener('loadedmetadata', () \\\\u003d\\\\u003e {\\\\n                durationDisplay.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statDuration.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statResolution.textContent \\\\u003d `${mainVideo.videoWidth || 3840} × ${mainVideo.videoHeight || 2160}`;\\\\n                timelineSlider.max \\\\u003d mainVideo.duration;\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('timeupdate', () \\\\u003d\\\\u003e {\\\\n                const ct \\\\u003d mainVideo.currentTime;\\\\n                currentTimeDisplay.textContent \\\\u003d formatTime(ct);\\\\n                timelineSlider.value \\\\u003d ct;\\\\n\\\\n                statTimestamp.textContent \\\\u003d formatDetailedTime(ct);\\\\n                statSeconds.textContent \\\\u003d ct.toFixed(3) + ' seconds';\\\\n                statFrameNum.textContent \\\\u003d Math.floor(ct * currentFps).toLocaleString();\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('play', () \\\\u003d\\\\u003e {\\\\n                playPauseText.textContent \\\\u003d 'Pause';\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('pause', () \\\\u003d\\\\u003e {\\\\n                playPauseText.textContent \\\\u003d 'Play';\\\\n            });\\\\n\\\\n            playPauseBtn.addEventListener('click', togglePlay);\\\\n            skipBackBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5); });\\\\n            skipForwardBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5); });\\\\n\\\\n            function togglePlay() {\\\\n                if (mainVideo.paused) {\\\\n                    mainVideo.play().catch(err \\\\u003d\\\\u003e console.log(\\\\\\\"Play error:\\\\\\\", err));\\\\n                } else {\\\\n                    mainVideo.pause();\\\\n                }\\\\n            }\\\\n\\\\n            timelineSlider.addEventListener('input', (e) \\\\u003d\\\\u003e {\\\\n                mainVideo.currentTime \\\\u003d parseFloat(e.target.value);\\\\n            });\\\\n\\\\n            // Speed buttons setup\\\\n            const speedButtons \\\\u003d document.querySelectorAll('.speed-btn');\\\\n            speedButtons.forEach(btn \\\\u003d\\\\u003e {\\\\n                btn.addEventListener('click', (e) \\\\u003d\\\\u003e {\\\\n                    const speed \\\\u003d parseFloat(e.target.getAttribute('data-speed'));\\\\n                    mainVideo.playbackRate \\\\u003d speed;\\\\n\\\\n                    speedButtons.forEach(b \\\\u003d\\\\u003e b.classList.remove('active'));\\\\n                    e.target.classList.add('active');\\\\n                });\\\\n            });\\\\n\\\\n            captureBtn.addEventListener('click', captureFrame);\\\\n\\\\n            function captureFrame() {\\\\n                if (!mainVideo.videoWidth || !mainVideo.videoHeight) return;\\\\n\\\\n                const canvas \\\\u003d document.createElement('canvas');\\\\n                canvas.width \\\\u003d mainVideo.videoWidth;\\\\n                canvas.height \\\\u003d mainVideo.videoHeight;\\\\n                const ctx \\\\u003d canvas.getContext('2d');\\\\n                ctx.drawImage(mainVideo, 0, 0, canvas.width, canvas.height);\\\\n\\\\n                const dataUrl \\\\u003d canvas.toDataURL('image/png');\\\\n                const timeStr \\\\u003d formatTime(mainVideo.currentTime).replace(':', '-');\\\\n                const frameIdx \\\\u003d Math.floor(mainVideo.currentTime * currentFps);\\\\n\\\\n                capturedCount++;\\\\n                galleryCount.textContent \\\\u003d `${capturedCount} captured`;\\\\n                if (galleryEmpty) galleryEmpty.remove();\\\\n\\\\n                const thumb \\\\u003d document.createElement('div');\\\\n                thumb.className \\\\u003d 'thumb-card';\\\\n                thumb.innerHTML \\\\u003d `\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"thumb-img-wrapper\\\\\\\"\\\\u003e\\\\n                        \\\\u003cimg src\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" alt\\\\u003d\\\\\\\"Still frame at ${formatTime(mainVideo.currentTime)}\\\\\\\"\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"thumb-footer\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan\\\\u003e${formatTime(mainVideo.currentTime)}\\\\u003c/span\\\\u003e\\\\n                        \\\\u003ca href\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" download\\\\u003d\\\\\\\"mov_frame_${frameIdx}_${timeStr}.png\\\\\\\" class\\\\u003d\\\\\\\"thumb-download\\\\\\\"\\\\u003eDownload\\\\u003c/a\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                `;\\\\n                galleryGrid.prepend(thumb);\\\\n            }\\\\n\\\\n            // Keyboard navigation shortcuts\\\\n            document.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'INPUT' || document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'TEXTAREA') {\\\\n                    return;\\\\n                }\\\\n\\\\n                if (e.code \\\\u003d\\\\u003d\\\\u003d 'Space') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        togglePlay();\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowLeft') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5);\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowRight') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5);\\\\n                    }\\\\n                } else if (e.key \\\\u003d\\\\u003d\\\\u003d 'c' || e.key \\\\u003d\\\\u003d\\\\u003d 'C') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.style.display \\\\u003d\\\\u003d\\\\u003d 'flex') {\\\\n                        captureFrame();\\\\n                    }\\\\n                }\\\\n            });\\\\n\\\\n            function formatTime(secs) {\\\\n                if (\\\\n```\\\",\\\"html\\\",null,false,true,null,null,[[\\\"Defining core CSS reset and dark theme variables\\\",[1790620217,359947815]],[\\\"Styling header and layout structure\\\",[1790620217,359951111]],[\\\"Styling main workspace and dropzone\\\",[1790620217,359953354]],[\\\"Styling timeline slider and controls toolbar\\\",[1790620217,359955748]],[\\\"Styling speed selector and frames gallery\\\",[1790620217,359957803]],[\\\"Styling live statistics sidebar\\\",[1790620217,359959683]],[\\\"Rendering header section\\\",[1790620217,359961906]],[\\\"Rendering main workspace and sidebar layout\\\",[1790620217,359964250]],[\\\"Implementing application logic and event listeners\\\",[1790620217,359967448]]]],null,true]],null,null,null,null,null,null,[]]],[\\\"San Carlos, CA, USA\\\",\\\"SWML_DESCRIPTION_FROM_YOUR_INTERNET_ADDRESS\\\",false,null,\\\"//www.google.com/maps/vt/data\\\\u003dDo7xJoV1sTNrlc1_E_QPRwKnqy2qTl5_IL4Fk6ijoI85IXk9nzjeyzhjCsxRS-wtbS_1W37nGPtpGT5KzELog_YVAAYfra3ZBgAQ4_wvNUk1p9SRWVxz4M7FKPlJa76R3ukF3aA0RnjfCLawJsEAqNu2Vrf4XZxS7bATsEe31g_fDaiy3nh_BhvEBeNRpg\\\"],null,null,\\\"US\\\",null,null,null,null,null,false,null,null,null,null,\\\"en\\\",null,null,null,true,[null,[false,false,false],[false,false,false,false,false,false],false],null,[[[[null,[null,0,\\\"I will now generate the complete, zero-dependency, pure vanilla HTML/CSS/JavaScript QuickTime .mov video player and frame extractor web application. It uses only standard system fonts and native CSS styling, ensuring it renders immediately without any external network dependencies or CDN links.\\\",[[94,98,[[null,null,null,null,3]]]]]],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[[[\\\"http://googleusercontent.com/immersive_entry_chip/0\\\"],\\\"c_a6ea4d6918c39910_index.html\\\",null,\\\"QuickTime Video Frame Extractor \\\\u0026 Player\\\",null,[1790620197,747368477],null,2]]]]]],null,null,null,null,null,null,null,null,null,null,null,null,\\\"cf41b0e0dd7d53e5\\\",null,null,\\\"3.5 Flash-Lite\\\",true,[[[[1004,\\\"Longer\\\",5,null,[\\\"expand\\\",\\\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/expand/default/24px.svg\\\",null,true]],[1005,\\\"Shorter\\\",6,null,[\\\"compress\\\",\\\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/compress/default/24px.svg\\\",null,true]],[1001,\\\"Try again\\\",1,null,[\\\"refresh\\\",\\\"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/refresh/default/24px.svg\\\",null,true]]]]],null,2,null,null,null,null,null,null,null,null,null,null,null,6,1]\"]]\n86945\n[[\"wrb.fr\",null,\"[null,[\\\"c_a6ea4d6918c39910\\\",\\\"r_d31878f5e32ec01b\\\"],null,null,[[\\\"rc_9c0cd9ea2b76ffd9\\\",[\\\"I will now generate the complete, zero-dependency, pure vanilla HTML/CSS/JavaScript QuickTime `.mov` video player and frame extractor web application. It uses only standard system fonts and native CSS styling, ensuring it renders immediately without any external network dependencies or CDN links.\\\\n\\\\nhttp://googleusercontent.com/immersive_entry_chip/0\\\"],null,null,null,null,null,null,[1],\\\"en\\\",null,null,[{\\\"8\\\":[],\\\"57\\\":[[[\\\"http://googleusercontent.com/immersive_entry_chip/0\\\"],\\\"c_a6ea4d6918c39910_index.html\\\",null,\\\"QuickTime Video Frame Extractor \\\\u0026 Player\\\",null,[1790620197,747368477],null,2]]}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[],null,[[\\\"c_a6ea4d6918c39910_index.html\\\",null,\\\"QuickTime Video Frame Extractor \\\\u0026 Player\\\",null,\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 8px 14px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 500;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n            transition: background-color 0.2s;\\\\n        }\\\\n\\\\n        .btn:hover {\\\\n            background-color: #374151;\\\\n        }\\\\n\\\\n        .btn-primary {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-primary:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n        }\\\\n\\\\n        aside {\\\\n            width: 360px;\\\\n            background-color: var(--bg-secondary);\\\\n            border-left: 1px solid var(--border-color);\\\\n            padding: 20px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            gap: 16px;\\\\n            overflow-y: auto;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            aside {\\\\n                width: 100%;\\\\n                border-left: none;\\\\n                border-top: 1px solid var(--border-color);\\\\n            }\\\\n        }\\\\n\\\\n        .sidebar-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            padding-bottom: 12px;\\\\n            border-bottom: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .sidebar-header h2 {\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 700;\\\\n            text-transform: uppercase;\\\\n            letter-spacing: 0.05em;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .live-badge {\\\\n            background-color: rgba(37, 99, 235, 0.1);\\\\n            color: #60a5fa;\\\\n            border: 1px solid rgba(37, 99, 235, 0.2);\\\\n            padding: 2px 8px;\\\\n            border-radius: 4px;\\\\n            font-size: 0.7rem;\\\\n            font-weight: 600;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n        }\\\\n\\\\n        .live-dot {\\\\n            width: 6px;\\\\n            height: 6px;\\\\n            background-color: #60a5fa;\\\\n            border-radius: 50%;\\\\n        }\\\\n\\\\n        .stat-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 10px;\\\\n        }\\\\n\\\\n        .stat-label {\\\\n            font-size: 0.7rem;\\\\n            font-weight: 500;\\\\n            color: var(--text-muted);\\\\n            margin-bottom: 4px;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .stat-value {\\\\n            font-family: monospace;\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            color: #60a5fa;\\\\n        }\\\\n\\\\n        .stat-value-sm {\\\\n            font-family: monospace;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n        }\\\\n\\\\n        .stat-grid-2 {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .hexdump-box {\\\\n            font-family: monospace;\\\\n            font-size: 0.65rem;\\\\n            color: var(--text-muted);\\\\n            background-color: black;\\\\n            padding: 8px;\\\\n            border-radius: 6px;\\\\n            overflow-x: auto;\\\\n            white-space: pre;\\\\n            line-height: 1.3;\\\\n            max-height: 100px;\\\\n            border: 1px solid #111;\\\\n        }\\\\n\\\\n        .shortcuts-box {\\\\n            margin-top: auto;\\\\n            padding-top: 12px;\\\\n            border-top: 1px solid var(--border-color);\\\\n            font-size: 0.7rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .shortcuts-box p {\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n            margin-bottom: 4px;\\\\n        }\\\\n\\\\n        .shortcut-grid {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        kbd {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 2px 4px;\\\\n            border-radius: 4px;\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n    \\\\u003c/style\\\\u003e\\\\n\\\\u003c/head\\\\u003e\\\\n\\\\u003cbody\\\