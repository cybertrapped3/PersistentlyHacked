\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n    