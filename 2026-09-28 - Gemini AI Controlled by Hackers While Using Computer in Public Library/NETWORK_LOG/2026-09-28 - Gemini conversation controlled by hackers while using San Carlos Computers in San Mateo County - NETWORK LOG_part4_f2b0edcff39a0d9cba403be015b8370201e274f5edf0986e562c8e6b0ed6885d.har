mb-1\\\\\\\"\\\\u003eEstimated Frame #\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"stat-frame-num\\\\\\\" class\\\\u003d\\\\\\\"text-lg font-bold text-emerald-400 code-font\\\\\\\"\\\\u003e0\\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"text-right\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400 block mb-1\\\\\\\"\\\\u003eFPS Estimate\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"stat-fps\\\\\\\" class\\\\u003d\\\\\\\"text-sm font-semibold text-slate-300 code-font\\\\\\\"\\\\u003e30.0 fps\\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Video Type \\\\u0026 MIME --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400 block mb-1\\\\\\\"\\\\u003eVideo MIME Type\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-mimetype\\\\\\\" class\\\\u003d\\\\\\\"text-sm font-medium text-slate-200 code-font break-all\\\\\\\"\\\\u003eNo video loaded\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Encoding \\\\u0026 Codec Info --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400 block mb-1\\\\\\\"\\\\u003eEncoding / Codec Inspection\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-encoding\\\\\\\" class\\\\u003d\\\\\\\"text-xs font-medium text-amber-400 code-font leading-relaxed\\\\\\\"\\\\u003eWaiting for file header analysis...\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Duration \\\\u0026 Resolution --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"grid grid-cols-2 gap-3\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400 block mb-1\\\\\\\"\\\\u003eDuration\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"stat-duration\\\\\\\" class\\\\u003d\\\\\\\"text-sm font-semibold text-slate-200 code-font\\\\\\\"\\\\u003e00:00\\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400 block mb-1\\\\\\\"\\\\u003eResolution\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cdiv id\\\\u003d\\\\\\\"stat-resolution\\\\\\\" class\\\\u003d\\\\\\\"text-sm font-semibold text-slate-200 code-font\\\\\\\"\\\\u003e0 × 0\\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- File Header Hex Dump Inspector (Vivitar AquaSnap / QuickTime Insight) --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"flex items-center justify-between mb-1.5\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-xs font-medium text-slate-400\\\\\\\"\\\\u003eMOV Header \\\\u0026 Stream Markers\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-[10px] text-slate-500 code-font\\\\\\\"\\\\u003eFirst 128 bytes\\\\u003c/span\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-hexdump\\\\\\\" class\\\\u003d\\\\\\\"text-[10px] font-mono text-slate-400 bg-black/50 p-2.5 rounded-lg overflow-x-auto whitespace-pre leading-tight max-h-28 border border-slate-900\\\\\\\"\\\\u003e\\\\nNo header bytes read yet.\\\\n                    \\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Accessibility \\\\u0026 Keyboard Guide Footer --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"mt-auto pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-1.5\\\\\\\"\\\\u003e\\\\n                \\\\u003cp class\\\\u003d\\\\\\\"font-semibold text-slate-300\\\\\\\"\\\\u003eKeyboard Shortcuts:\\\\u003c/p\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"grid grid-cols-2 gap-1 text-[11px]\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd class\\\\u003d\\\\\\\"px-1.5 py-0.5 bg-slate-800 rounded text-slate-300\\\\\\\"\\\\u003eSpace/Enter\\\\u003c/kbd\\\\u003e Play/Pause\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd class\\\\u003d\\\\\\\"px-1.5 py-0.5 bg-slate-800 rounded text-slate-300\\\\\\\"\\\\u003e← / →\\\\u003c/kbd\\\\u003e Skip -/+ 5s\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd class\\\\u003d\\\\\\\"px-1.5 py-0.5 bg-slate-800 rounded text-slate-300\\\\\\\"\\\\u003eC\\\\u003c/kbd\\\\u003e Capture Frame\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd class\\\\u003d\\\\\\\"px-1.5 py-0.5 bg-slate-800 rounded text-slate-300\\\\\\\"\\\\u003eTab\\\\u003c/kbd\\\\u003e Navigate UI\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n        \\\\u003c/aside\\\\u003e\\\\n    \\\\u003c/main\\\\u003e\\\\n\\\\n    \\\\u003cscript\\\\u003e\\\\n        document.addEventListener('DOMContentLoaded', () \\\\u003d\\\\u003e {\\\\n            const videoUploadBtn \\\\u003d document.getElementById('video-upload-btn');\\\\n            const customFileTrigger \\\\u003d document.getElementById('custom-file-trigger');\\\\n            const dropZone \\\\u003d document.getElementById('drop-zone');\\\\n            const videoContainer \\\\u003d document.getElementById('video-container');\\\\n            const mainVideo \\\\u003d document.getElementById('main-video');\\\\n            const playPauseBtn \\\\u003d document.getElementById('btn-play-pause');\\\\n            const playPauseIcon \\\\u003d document.getElementById('play-pause-icon');\\\\n            const playPauseText \\\\u003d document.getElementById('play-pause-text');\\\\n            const skipBackBtn \\\\u003d document.getElementById('btn-skip-back');\\\\n            const skipForwardBtn \\\\u003d document.getElementById('btn-skip-forward');\\\\n            const captureBtn \\\\u003d document.getElementById('btn-capture');\\\\n            const timelineSlider \\\\u003d document.getElementById('timeline-slider');\\\\n            const currentTimeDisplay \\\\u003d document.getElementById('current-time-display');\\\\n            const durationDisplay \\\\u003d document.getElementById('duration-display');\\\\n            const playIndicator \\\\u003d document.getElementById('play-indicator');\\\\n            const galleryGrid \\\\u003d document.getElementById('gallery-grid');\\\\n            const galleryEmpty \\\\u003d document.getElementById('gallery-empty');\\\\n            const galleryCount \\\\u003d document.getElementById('gallery-count');\\\\n\\\\n            // Stats Elements\\\\n            const statTimestamp \\\\u003d document.getElementById('stat-timestamp');\\\\n            const statSeconds \\\\u003d document.getElementById('stat-seconds');\\\\n            const statFrameNum \\\\u003d document.getElementById('stat-frame-num');\\\\n            const statFps \\\\u003d document.getElementById('stat-fps');\\\\n            const statMimeType \\\\u003d document.getElementById('stat-mimetype');\\\\n            const statEncoding \\\\u003d document.getElementById('stat-encoding');\\\\n            const statDuration \\\\u003d document.getElementById('stat-duration');\\\\n            const statResolution \\\\u003d document.getElementById('stat-resolution');\\\\n            const statHexdump \\\\u003d document.getElementById('stat-hexdump');\\\\n\\\\n            let currentFps \\\\u003d 30.0; // Default estimation for QuickTime / Vivitar AquaSnap\\\\n            let capturedFramesCount \\\\u003d 0;\\\\n            let objectUrl \\\\u003d null;\\\\n\\\\n            customFileTrigger.addEventListener('click', () \\\\u003d\\\\u003e {\\\\n                videoUploadBtn.click();\\\\n            });\\\\n\\\\n            customFileTrigger.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadBtn.click();\\\\n                }\\\\n            });\\\\n\\\\n            dropZone.addEventListener('click', () \\\\u003d\\\\u003e {\\\\n                videoUploadBtn.click();\\\\n            });\\\\n\\\\n            dropZone.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadBtn.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Drag and drop handlers\\\\n            dropZone.addEventListener('dragover', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.classList.add('border-blue-500', 'bg-blue-500/5');\\\\n            });\\\\n\\\\n            dropZone.addEventListener('dragleave', () \\\\u003d\\\\u003e {\\\\n                dropZone.classList.remove('border-blue-500', 'bg-blue-500/5');\\\\n            });\\\\n\\\\n            dropZone.addEventListener('drop', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.classList.remove('border-blue-500', 'bg-blue-500/5');\\\\n                if (e.dataTransfer.files \\\\u0026\\\\u0026 e.dataTransfer.files.length \\\\u003e 0) {\\\\n                    handleVideoFile(e.dataTransfer.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            videoUploadBtn.addEventListener('change', (e) \\\\u003d\\\\u003e {\\\\n                if (e.target.files \\\\u0026\\\\u0026 e.target.files.length \\\\u003e 0) {\\\\n                    handleVideoFile(e.target.files[0]);\\\\n                }\\\\n            });\\\\n\\\\n            function handleVideoFile(file) {\\\\n                if (objectUrl) {\\\\n                    URL.revokeObjectURL(objectUrl);\\\\n                }\\\\n                objectUrl \\\\u003d URL.createObjectURL(file);\\\\n                mainVideo.src \\\\u003d objectUrl;\\\\n                mainVideo.load();\\\\n\\\\n                dropZone.classList.add('hidden');\\\\n                videoContainer.classList.remove('hidden');\\\\n                videoContainer.classList.add('flex');\\\\n\\\\n                // Update basic stats\\\\n                statMimeType.textContent \\\\u003d file.type || 'video/quicktime (.mov)';\\\\n                \\\\n                // Read first 256 bytes for QuickTime / Motion-JPEG header inspection\\\\n                const reader \\\\u003d new FileReader();\\\\n                reader.onload \\\\u003d function(evt) {\\\\n                    const buffer \\\\u003d evt.target.result;\\\\n                    const uint8 \\\\u003d new Uint8Array(buffer);\\\\n                    let hexString \\\\u003d '';\\\\n                    let asciiPreview \\\\u003d '';\\\\n                    for (let i \\\\u003d 0; i \\\\u003c Math.min(uint8.length, 128); i++) {\\\\n                        const byte \\\\u003d uint8[i];\\\\n                        hexString +\\\\u003d byte.toString(16).padStart(2, '0') + ' ';\\\\n                        asciiPreview +\\\\u003d (byte \\\\u003e\\\\u003d 32 \\\\u0026\\\\u0026 byte \\\\u003c\\\\u003d 126) ? String.fromCharCode(byte) : '.';\\\\n                    }\\\\n\\\\n                    statHexdump.textContent \\\\u003d `HEX: ${hexString}\\\\\\\\nASCII: ${asciiPreview}`;\\\\n\\\\n                    // Inspect for QuickTime 'ftypqt' and JPEG/JFIF SOI (FF D8) or Motion JPEG headers (Vivitar AquaSnap signature hint)\\\\n                    let codecDesc \\\\u003d 'QuickTime Container (.mov)';\\\\n                    if (asciiPreview.includes('ftypqt') || asciiPreview.includes('qt')) {\\\\n                        codecDesc +\\\\u003d ' • QuickTime Atom Detected';\\\\n                    }\\\\n                    if (hexString.includes('ff d8 ff') || asciiPreview.includes('JFIF') || asciiPreview.includes('Exif')) {\\\\n                        codecDesc +\\\\u003d ' • Motion-JPEG (MJPEG) / JPEG Stream Found';\\\\n                    } else {\\\\n                        codecDesc +\\\\u003d ' • Standard H.264 / AVC / HEVC Stream';\\\\n                    }\\\\n                    statEncoding.textContent \\\\u003d codecDesc;\\\\n                };\\\\n                reader.readAsArrayBuffer(file.slice(0, 512));\\\\n            }\\\\n\\\\n            mainVideo.addEventListener('loadedmetadata', () \\\\u003d\\\\u003e {\\\\n                durationDisplay.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statDuration.textContent \\\\u003d formatTime(mainVideo.duration);\\\\n                statResolution.textContent \\\\u003d `${mainVideo.videoWidth || 3840} × ${mainVideo.videoHeight || 2160}`; // Default 4K fallback for Vivitar AquaSnap\\\\n                timelineSlider.max \\\\u003d mainVideo.duration;\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('timeupdate', () \\\\u003d\\\\u003e {\\\\n                const currentTime \\\\u003d mainVideo.currentTime;\\\\n                currentTimeDisplay.textContent \\\\u003d formatTime(currentTime);\\\\n                timelineSlider.value \\\\u003d currentTime;\\\\n                \\\\n                // Update live telemetry sidebar\\\\n                statTimestamp.textContent \\\\u003d formatDetailedTime(currentTime);\\\\n                statSeconds.textContent \\\\u003d currentTime.toFixed(3) + ' seconds';\\\\n                \\\\n                const frameNum \\\\u003d Math.floor(currentTime * currentFps);\\\\n                statFrameNum.textContent \\\\u003d frameNum.toLocaleString();\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('play', () \\\\u003d\\\\u003e {\\\\n                playPauseIcon.innerHTML \\\\u003d '\\\\u003cpath d\\\\u003d\\\\\\\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\\\\\\\"/\\\\u003e';\\\\n                playPauseText.textContent \\\\u003d 'Pause';\\\\n                showPlayIndicator(true);\\\\n            });\\\\n\\\\n            mainVideo.addEventListener('pause', () \\\\u003d\\\\u003e {\\\\n                playPauseIcon.innerHTML \\\\u003d '\\\\u003cpath d\\\\u003d\\\\\\\"M8 5v14l11-7z\\\\\\\"/\\\\u003e';\\\\n                playPauseText.textContent \\\\u003d 'Play';\\\\n                showPlayIndicator(false);\\\\n            });\\\\n\\\\n            function showPlayIndicator(isPlaying) {\\\\n                playIndicator.style.opacity \\\\u003d '1';\\\\n                const indicatorIcon \\\\u003d document.getElementById('indicator-icon');\\\\n                indicatorIcon.innerHTML \\\\u003d isPlaying ? '\\\\u003cpath d\\\\u003d\\\\\\\"M8 5v14l11-7z\\\\\\\"/\\\\u003e' : '\\\\u003cpath d\\\\u003d\\\\\\\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\\\\\\\"/\\\\u003e';\\\\n                setTimeout(() \\\\u003d\\\\u003e {\\\\n                    playIndicator.style.opacity \\\\u003d '0';\\\\n                }, 400);\\\\n            }\\\\n\\\\n            playPauseBtn.addEventListener('click', togglePlayPause);\\\\n            skipBackBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5); });\\\\n            skipForwardBtn.addEventListener('click', () \\\\u003d\\\\u003e { mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5); });\\\\n\\\\n            function togglePlayPause() {\\\\n                if (mainVideo.paused) {\\\\n                    mainVideo.play().catch(err \\\\u003d\\\\u003e console.log(\\\\\\\"Autoplay prevented:\\\\\\\", err));\\\\n                } else {\\\\n                    mainVideo.pause();\\\\n                }\\\\n            }\\\\n\\\\n            timelineSlider.addEventListener('input', (e) \\\\u003d\\\\u003e {\\\\n                mainVideo.currentTime \\\\u003d parseFloat(e.target.value);\\\\n            });\\\\n\\\\n            const speedButtons \\\\u003d document.querySelectorAll('.speed-btn');\\\\n            speedButtons.forEach(btn \\\\u003d\\\\u003e {\\\\n                btn.addEventListener('click', (e) \\\\u003d\\\\u003e {\\\\n                    const speed \\\\u003d parseFloat(e.target.getAttribute('data-speed'));\\\\n                    mainVideo.playbackRate \\\\u003d speed;\\\\n                    \\\\n                    speedButtons.forEach(b \\\\u003d\\\\u003e {\\\\n                        b.classList.remove('bg-blue-600', 'text-white', 'font-semibold', 'shadow');\\\\n                        b.classList.add('bg-slate-800', 'text-slate-300', 'font-medium');\\\\n                    });\\\\n                    e.target.classList.remove('bg-slate-800', 'text-slate-300', 'font-medium');\\\\n                    e.target.classList.add('bg-blue-600', 'text-white', 'font-semibold', 'shadow');\\\\n                });\\\\n            });\\\\n\\\\n            captureBtn.addEventListener('click', captureCurrentFrame);\\\\n\\\\n            function captureCurrentFrame() {\\\\n                if (!mainVideo.videoWidth || !mainVideo.videoHeight) return;\\\\n\\\\n                const canvas \\\\u003d document.createElement('canvas');\\\\n                canvas.width \\\\u003d mainVideo.videoWidth;\\\\n                canvas.height \\\\u003d mainVideo.videoHeight;\\\\n                const ctx \\\\u003d canvas.getContext('2d');\\\\n                ctx.drawImage(mainVideo, 0, 0, canvas.width, canvas.height);\\\\n\\\\n                const dataUrl \\\\u003d canvas.toDataURL('image/png');\\\\n                const timestampStr \\\\u003d formatTime(mainVideo.currentTime).replace(':', '-');\\\\n                const frameIndex \\\\u003d Math.floor(mainVideo.currentTime * currentFps);\\\\n\\\\n                capturedFramesCount++;\\\\n                galleryCount.textContent \\\\u003d `${capturedFramesCount} captured`;\\\\n                if (galleryEmpty) galleryEmpty.remove();\\\\n\\\\n                const thumbCard \\\\u003d document.createElement('div');\\\\n                thumbCard.className \\\\u003d 'group relative bg-slate-950 border border-slate-800 rounded-xl overflow-hidden shadow-md flex flex-col';\\\\n                thumbCard.innerHTML \\\\u003d `\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"relative aspect-video bg-black overflow-hidden flex items-center justify-center\\\\\\\"\\\\u003e\\\\n                        \\\\u003cimg src\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" alt\\\\u003d\\\\\\\"Extracted frame at ${formatTime(mainVideo.currentTime)}\\\\\\\" class\\\\u003d\\\\\\\"object-cover w-full h-full group-hover:scale-105 transition-transform duration-300\\\\\\\"\\\\u003e\\\\n                        \\\\u003cdiv class\\\\u003d\\\\\\\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center space-x-2\\\\\\\"\\\\u003e\\\\n                            \\\\u003ca href\\\\u003d\\\\\\\"${dataUrl}\\\\\\\" download\\\\u003d\\\\\\\"mov_frame_${frameIndex}_${timestampStr}.png\\\\\\\" class\\\\u003d\\\\\\\"p-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-medium shadow transition-all\\\\\\\" title\\\\u003d\\\\\\\"Download PNG\\\\\\\"\\\\u003e\\\\n                                \\\\u003csvg class\\\\u003d\\\\\\\"w-4 h-4\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"currentColor\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\"\\\\u003e\\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\" stroke-width\\\\u003d\\\\\\\"2\\\\\\\" d\\\\u003d\\\\\\\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\\\\\\\"/\\\\u003e\\\\u003c/svg\\\\u003e\\\\n                            \\\\u003c/a\\\\u003e\\\\n                        \\\\u003c/div\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv class\\\\u003d\\\\\\\"p-2 flex items-center justify-between text-[11px] bg-slate-900/90 text-slate-300\\\\\\\"\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"code-font font-medium\\\\\\\"\\\\u003e${formatTime(mainVideo.currentTime)}\\\\u003c/span\\\\u003e\\\\n                        \\\\u003cspan class\\\\u003d\\\\\\\"text-slate-500 code-font\\\\\\\"\\\\u003e#${frameIndex}\\\\u003c/span\\\\u003e\\\\n                    \\\\u003c/div\\\\u003e\\\\n                `;\\\\n                galleryGrid.prepend(thumbCard);\\\\n            }\\\\n\\\\n            document.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                // Ignore if typing inside input fields\\\\n                if (document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'INPUT' || document.activeElement.tagName \\\\u003d\\\\u003d\\\\u003d 'TEXTAREA') {\\\\n                    return;\\\\n                }\\\\n\\\\n                if (e.code \\\\u003d\\\\u003d\\\\u003d 'Space') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.classList.contains('hidden') \\\\u003d\\\\u003d false) {\\\\n                        togglePlayPause();\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowLeft') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.classList.contains('hidden') \\\\u003d\\\\u003d false) {\\\\n                        mainVideo.currentTime \\\\u003d Math.max(0, mainVideo.currentTime - 5);\\\\n                    }\\\\n                } else if (e.code \\\\u003d\\\\u003d\\\\u003d 'ArrowRight') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.classList.contains('hidden') \\\\u003d\\\\u003d false) {\\\\n                        mainVideo.currentTime \\\\u003d Math.min(mainVideo.duration, mainVideo.currentTime + 5);\\\\n                    }\\\\n                } else if (e.key \\\\u003d\\\\u003d\\\\u003d 'c' || e.key \\\\u003d\\\\u003d\\\\u003d 'C') {\\\\n                    e.preventDefault();\\\\n                    if (videoContainer.classList.contains('hidden') \\\\u003d\\\\u003d false) {\\\\n                        captureCurrentFrame();\\\\n                    }\\\\n                }\\\\n            });\\\\n\\\\n            function formatTime(seconds) {\\\\n                if (isNaN(seconds) || seconds \\\\u003d\\\\u003d\\\\u003d 0) return '00:00';\\\\n                const mins \\\\u003d Math.floor(seconds / 60);\\\\n                const secs \\\\u003d Math.floor(seconds % 60);\\\\n                return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;\\\\n            }\\\\n\\\\n            function formatDetailedTime(seconds) {\\\\n                if (isNaN(seconds)) return '00:00.000';\\\\n                const mins \\\\u003d Math.floor(seconds / 60);\\\\n                const secs \\\\u003d Math.floor(seconds % 60);\\\\n                const millis \\\\u003d Math.floor((seconds % 1) * 1000);\\\\n                return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${millis.toString().padStart(3, '0')}`;\\\\n            }\\\\n        });\\\\n    \\\\u003c/script\\\\u003e\\\\n\\\\u003c/body\\\\u003e\\\\n\\\\u003c/html\\\\u003e\\\\n```\\\",null,null,null,null,\\\"index.html\\\",2,null,false,null,[\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\" class\\\\u003d\\\\\\\"h-full\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cscript src\\\\u003d\\\\\\\"https://cdn.tailwindcss.com\\\\\\\"\\\\u003e\\\\u003c/script\\\\u003e\\\\n    \\\\u003clink rel\\\\u003d\\\\\\\"preconnect\\\\\\\" href\\\\u003d\\\\\\\"https://fonts.googleapis.com\\\\\\\"\\\\u003e\\\\n    \\\\u003clink rel\\\\u003d\\\\\\\"preconnect\\\\\\\" href\\\\u003d\\\\\\\"https://fonts.gstatic.com\\\\\\\" crossorigin\\\\u003e\\\\n    \\\\u003clink href\\\\u003d\\\\\\\"https://fonts.googleapis.com/css2?family\\\\u003dInter:wght@300;400;500;600;700\\\\u0026family\\\\u003dJetBrains+Mono:wght@400;500\\\\u0026display\\\\u003dswap\\\\\\\" rel\\\\u003d\\\\\\\"stylesheet\\\\\\\"\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        body {\\\\n            font-family: 'Inter', sans-serif;\\\\n        }\\\\n        .code-font {\\\\n            font-family: 'JetBrains Mono', monospace;\\\\n        }\\\\n        /* Custom focus ring for high accessibility */\\\\n        *:focus-visible {\\\\n            outline: 3px solid #3b82f6 !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n    \\\\u003c/style\\\\u003e\\\\n\\\\u003c/head\\\\u003e\\\\n\\\\u003cbody class\\\\u003d\\\\\\\"bg-slate-950 text-slate-100 h-full flex flex-col overflow-hidden selection:bg-blue-500 selection:text-white\\\\\\\"\\\\u003e\\\\n\\\\n    \\\\u003cheader role\\\\u003d\\\\\\\"banner\\\\\\\" class\\\\u003d\\\\\\\"bg-slate-900 border-b border-slate-800 px-6 py-3 flex items-center justify-between shrink-0\\\\\\\"\\\\u003e\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"flex items-center space-x-3\\\\\\\"\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/30\\\\\\\"\\\\u003e\\\\n                \\\\u003csvg class\\\\u003d\\\\\\\"w-5 h-5 text-white\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"currentColor\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\" aria-hidden\\\\u003d\\\\\\\"true\\\\\\\"\\\\u003e\\\\n                    \\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\" stroke-width\\\\u003d\\\\\\\"2\\\\\\\" d\\\\u003d\\\\\\\"M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z\\\\\\\"\\\\u003e\\\\u003c/path\\\\u003e\\\\n                \\\\u003c/svg\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n            \\\\u003cdiv\\\\u003e\\\\n                \\\\u003ch1 class\\\\u003d\\\\\\\"text-lg font-bold tracking-tight text-white\\\\\\\"\\\\u003eMOV Analyzer \\\\u0026 Frame Extractor\\\\u003c/h1\\\\u003e\\\\n                \\\\u003cp class\\\\u003d\\\\\\\"text-xs text-slate-400\\\\\\\"\\\\u003eSan Carlos Library Station • Accessible QuickTime Player\\\\u003c/p\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n        \\\\n        \\\\u003c!-- Quick File Upload Shortcut Button --\\\\u003e\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"flex items-center space-x-3\\\\\\\"\\\\u003e\\\\n            \\\\u003clabel for\\\\u003d\\\\\\\"video