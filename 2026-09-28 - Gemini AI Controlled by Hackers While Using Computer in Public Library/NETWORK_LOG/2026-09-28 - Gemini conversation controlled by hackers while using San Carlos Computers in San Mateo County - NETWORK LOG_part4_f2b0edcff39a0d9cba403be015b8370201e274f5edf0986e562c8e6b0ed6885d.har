gba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 8px 14px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 500;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n            transition: background-color 0.2s;\\\\n        }\\\\n\\\\n        .btn:hover {\\\\n            background-color: #374151;\\\\n        }\\\\n\\\\n        .btn-primary {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-primary:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        \\\\n```\\\",\\\"html\\\",null,false,true,null,null,[[\\\"Defining core CSS reset and dark theme variables\\\",[1790620204,282043845]],[\\\"Styling header and layout structure\\\",[1790620204,282047118]],[\\\"Styling main workspace and dropzone\\\",[1790620204,282049427]],[\\\"Styling timeline slider and controls toolbar\\\",[1790620204,282051888]],[\\\"Styling speed selector and frames gallery\\\",[1790620204,282054068]]]],null,true]],null,null,null,null,null,null,[]]],[\\\"San Carlos, CA, USA\\\",\\\"SWML_DESCRIPTION_FROM_YOUR_INTERNET_ADDRESS\\\",false,null,\\\"//www.google.com/maps/vt/data\\\\u003dDo7xJoV1sTNrlc1_E_QPRwKnqy2qTl5_IL4Fk6ijoI85IXk9nzjeyzhjCsxRS-wtbS_1W37nGPtpGT5KzELog_YVAAYfra3ZBgAQ4_wvNUk1p9SRWVxz4M7FKPlJa76R3ukF3aA0RnjfCLawJsEAqNu2Vrf4XZxS7bATsEe31g_fDaiy3nh_BhvEBeNRpg\\\"],null,null,\\\"US\\\",null,null,null,null,null,false,null,null,null,null,\\\"en\\\",null,null,null,true,[null,[false,false,false],[false,false,false,false,false,false],false],null,[[[[nu