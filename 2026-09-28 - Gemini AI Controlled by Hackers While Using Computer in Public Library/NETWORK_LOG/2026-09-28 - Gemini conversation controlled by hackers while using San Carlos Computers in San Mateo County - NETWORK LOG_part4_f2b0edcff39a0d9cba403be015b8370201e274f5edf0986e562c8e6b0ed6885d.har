s\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEst. FPS\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-fps\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e30.0 fps\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- MIME Type --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eVideo MIME Type\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-mimetype\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\" style\\\\u003d\\\\\\\"word-break: break-all;\\\\\\\"\\\\u003eNo video loaded\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Encoding \\\\u0026 Codec Inspection --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eEncoding / Codec Inspection\\\\u003c/span\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-encoding\\\\\\\" style\\\\u003d\\\\\\\"font-size: 0.75rem; color: #fbbf24; font-family: monospace; line-height: 1.4;\\\\\\\"\\\\u003eWaiting for file header analysis...\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Duration \\\\u0026 Resolution --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-grid-2\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eDuration\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-duration\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e00:00\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\"\\\\u003eResolution\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cdiv id\\\\u003d\\\\\\\"stat-resolution\\\\\\\" class\\\\u003d\\\\\\\"stat-value-sm\\\\\\\"\\\\u003e0 × 0\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Header Hex Dump Inspector --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"stat-card\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan class\\\\u003d\\\\\\\"stat-label\\\\\\\" style\\\\u003d\\\\\\\"margin-bottom:0;\\\\\\\"\\\\u003eMOV Header \\\\u0026 Markers\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cspan style\\\\u003d\\\\\\\"font-size: 0.65rem; color: var(--text-muted); font-family: monospace;\\\\\\\"\\\\u003eFirst 128 bytes\\\\u003c/span\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003cdiv id\\\\u003d\\\\\\\"stat-hexdump\\\\\\\" class\\\\u003d\\\\\\\"hexdump-box\\\\\\\"\\\\u003eNo header bytes read yet.\\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Keyboard Guide --\\\\u003e\\\\n            \\\\u003cdiv class\\\\u003d\\\\\\\"shortcuts-box\\\\\\\"\\\\u003e\\\\n                \\\\u003cp\\\\u003eKeyboard Shortcuts:\\\\u003c/p\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"shortcut-grid\\\\\\\"\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eSpace/Enter\\\\u003c/kbd\\\\u003e Play/Pause\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003e← / →\\\\u003c/kbd\\\\u003e Skip -/+ 5s\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eC\\\\u003c/kbd\\\\u003e Capture Frame\\\\u003c/div\\\\u003e\\\\n                    \\\\u003cdiv\\\\u003e\\\\u003ckbd\\\\u003eTab\\\\u003c/kbd\\\\u003e Navigate UI\\\\u003c/div\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n        \\\\u003c/aside\\\\u003e\\\\n    \\\\u003c/main\\\\u003e\\\\n\\\\n    \\\\u003cscript\\\\u003e\\\\n        document.addEventListener('DOMContentLoaded', () \\\\u003d\\\\u003e {\\\\n            const videoUploadInput \\\\u003d document.getElementById('video-upload-input');\\\\n            const fileLabelBtn \\\\u003d document.getElementById('file-label-btn');\\\\n            const dropZone \\\\u003d document.getElementById('drop-zone');\\\\n            const videoContainer \\\\u003d document.getElementById('video-container');\\\\n            const mainVideo \\\\u003d document.getElementById('main-video');\\\\n            const playPauseBtn \\\\u003d document.getElementById('btn-play-pause');\\\\n            const playPauseText \\\\u003d document.getElementById('play-pause-text');\\\\n            const skipBackBtn \\\\u003d document.getElementById('btn-skip-back');\\\\n            const skipForwardBtn \\\\u003d document.getElementById('btn-skip-forward');\\\\n            const captureBtn \\\\u003d document.getElementById('btn-capture');\\\\n            const timelineSlider \\\\u003d document.getElementById('timeline-slider');\\\\n            const currentTimeDisplay \\\\u003d document.getElementById('current-time-display');\\\\n            const durationDisplay \\\\u003d document.getElementById('duration-display');\\\\n            const galleryGrid \\\\u003d document.getElementById('gallery-grid');\\\\n            const galleryEmpty \\\\u003d document.getElementById('gallery-empty');\\\\n            const galleryCount \\\\u003d document.getElementById('gallery-count');\\\\n\\\\n            // Stats telemetry elements\\\\n            const statTimestamp \\\\u003d document.getElementById('stat-timestamp');\\\\n            const statSeconds \\\\u003d document.getElementById('stat-seconds');\\\\n            const statFrameNum \\\\u003d document.getElementById('stat-frame-num');\\\\n            const statFps \\\\u003d document.getElementById('stat-fps');\\\\n            const statMimeType \\\\u003d document.getElementById('stat-mimetype');\\\\n            const statEncoding \\\\u003d document.getElementById('stat-encoding');\\\\n            const statDuration \\\\u003d document.getElementById('stat-duration');\\\\n            const statResolution \\\\u003d document.getElementById('stat-resolution');\\\\n            const statHexdump \\\\u003d document.getElementById('stat-hexdump');\\\\n\\\\n            let currentFps \\\\u003d 30.0;\\\\n            let capturedCount \\\\u003d 0;\\\\n            let videoObjectUrl \\\\u003d null;\\\\n\\\\n            // Keyboard accessibility for file picker button in header\\\\n            fileLabelBtn.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Keyboard accessibility for dropzone\\\\n            dropZone.addEventListener('click', () \\\\u003d\\\\u003e {\\\\n                videoUploadInput.click();\\\\n            });\\\\n\\\\n            dropZone.addEventListener('keydown', (e) \\\\u003d\\\\u003e {\\\\n                if (e.key \\\\u003d\\\\u003d\\\\u003d 'Enter' || e.key \\\\u003d\\\\u003d\\\\u003d ' ') {\\\\n                    e.preventDefault();\\\\n                    videoUploadInput.click();\\\\n                }\\\\n            });\\\\n\\\\n            // Drag and drop support\\\\n            dropZone.addEventListener('dragover', (e) \\\\u003d\\\\u003e {\\\\n                e.preventDefault();\\\\n                dropZone.style.borderColor \\\\u003d 'var(--accent-blue)';\\\\n            });\\\\n\\\\n            dropZone.addEventListener('\\\\n```\\\",null,null,null,null,\\\"index.html\\\",2,null,false,null,[\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 8px 14px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 500;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n            transition: background-color 0.2s;\\\\n        }\\\\n\\\\n        .btn:hover {\\\\n            background-color: #374151;\\\\n        }\\\\n\\\\n        .btn-primary {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-primary:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        .btn-capture {\\\\n            background-color: var(--accent-emerald);\\\\n            border-color: var(--accent-emerald);\\\\n            color: white;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .btn-capture:hover {\\\\n            background-color: var(--accent-emerald-hover);\\\\n        }\\\\n\\\\n        .speed-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 10px 14px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .speed-toolbar span {\\\\n            font-size: 0.75rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-muted);\\\\n            text-transform: uppercase;\\\\n        }\\\\n\\\\n        .speed-buttons {\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        .speed-btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            border: 1px solid var(--border-color);\\\\n            color: var(--text-main);\\\\n            padding: 4px 8px;\\\\n            font-size: 0.75rem;\\\\n            border-radius: 6px;\\\\n            cursor: pointer;\\\\n            font-family: monospace;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .speed-btn.active {\\\\n            background-color: var(--accent-blue);\\\\n            border-color: var(--accent-blue);\\\\n            font-weight: bold;\\\\n        }\\\\n\\\\n        .gallery-box {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 16px;\\\\n            border-radius: 12px;\\\\n        }\\\\n\\\\n        .gallery-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            margin-bottom: 12px;\\\\n        }\\\\n\\\\n        .gallery-header h3 {\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n        }\\\\n\\\\n        .gallery-grid {\\\\n            display: grid;\\\\n            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\\\\n            gap: 10px;\\\\n            max-height: 180px;\\\\n            overflow-y: auto;\\\\n            padding: 4px;\\\\n        }\\\\n\\\\n        .gallery-empty {\\\\n            grid-column: 1 / -1;\\\\n            text-align: center;\\\\n            padding: 24px;\\\\n            color: var(--text-muted);\\\\n            font-size: 0.75rem;\\\\n        }\\\\n\\\\n        .thumb-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            border-radius: 8px;\\\\n            overflow: hidden;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper {\\\\n            position: relative;\\\\n            aspect-ratio: 16/9;\\\\n            background: black;\\\\n        }\\\\n\\\\n        .thumb-img-wrapper img {\\\\n            width: 100%;\\\\n            height: 100%;\\\\n            object-fit: cover;\\\\n        }\\\\n\\\\n        .thumb-footer {\\\\n            padding: 6px 8px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            font-size: 0.7rem;\\\\n            font-family: monospace;\\\\n            color: var(--text-muted);\\\\n            background-color: rgba(0,0,0,0.3);\\\\n        }\\\\n\\\\n        .thumb-download {\\\\n            color: #60a5fa;\\\\n            text-decoration: none;\\\\n        }\\\\n        .thumb-download:hover {\\\\n            text-decoration: underline;\\\\n        }\\\\n\\\\n        aside {\\\\n            width: 360px;\\\\n            background-color: var(--bg-secondary);\\\\n            border-left: 1px solid var(--border-color);\\\\n            padding: 20px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            gap: 16px;\\\\n            overflow-y: auto;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            aside {\\\\n                width: 100%;\\\\n                border-left: none;\\\\n                border-top: 1px solid var(--border-color);\\\\n            }\\\\n        }\\\\n\\\\n        .sidebar-header {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            padding-bottom: 12px;\\\\n            border-bottom: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .sidebar-header h2 {\\\\n            font-size: 0.8125rem;\\\\n            font-weight: 700;\\\\n            text-transform: uppercase;\\\\n            letter-spacing: 0.05em;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .live-badge {\\\\n            background-color: rgba(37, 99, 235, 0.1);\\\\n            color: #60a5fa;\\\\n            border: 1px solid rgba(37, 99, 235, 0.2);\\\\n            padding: 2px 8px;\\\\n            border-radius: 4px;\\\\n            font-size: 0.7rem;\\\\n            font-weight: 600;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 6px;\\\\n        }\\\\n\\\\n        .live-dot {\\\\n            width: 6px;\\\\n            height: 6px;\\\\n            background-color: #60a5fa;\\\\n            border-radius: 50%;\\\\n        }\\\\n\\\\n        .stat-card {\\\\n            background-color: var(--bg-primary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 10px;\\\\n        }\\\\n\\\\n        .stat-label {\\\\n            font-size: 0.7rem;\\\\n            font-weight: 500;\\\\n            color: var(--text-muted);\\\\n            margin-bottom: 4px;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .stat-value {\\\\n            font-family: monospace;\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            color: #60a5fa;\\\\n        }\\\\n\\\\n        .stat-value-sm {\\\\n            font-family: monospace;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n        }\\\\n\\\\n        .stat-grid-2 {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .hexdump-box {\\\\n            font-family: monospace;\\\\n            font-size: 0.65rem;\\\\n            color: var(--text-muted);\\\\n            background-color: black;\\\\n            padding: 8px;\\\\n            border-radius: 6px;\\\\n            overflow-x: auto;\\\\n            white-space: pre;\\\\n            line-height: 1.3;\\\\n            max-height: 100px;\\\\n            border: 1px solid #111;\\\\n        }\\\\n\\\\n        .shortcuts-box {\\\\n            margin-top: auto;\\\\n            padding-top: 12px;\\\\n            border-top: 1px solid var(--border-color);\\\\n            font-size: 0.7rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .shortcuts-box p {\\\\n            font-weight: 600;\\\\n            color: var(--text-main);\\\\n            margin-bottom: 4px;\\\\n        }\\\\n\\\\n        .shortcut-grid {\\\\n            display: grid;\\\\n            grid-template-columns: 1fr 1fr;\\\\n            gap: 4px;\\\\n        }\\\\n\\\\n        kbd {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 2px 4px;\\\\n            border-radius: 4px;\\\\n            color: var(--text-main);\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n    \\\\u003c/style\\\\u003e\\\\n\\\\u003c/head\\\\u003e\\\\n\\\\u003cbody\\\\u003e\\\\n\\\\n    \\\\u003cheader role\\\\u003d\\\\\\\"banner\\\\\\\"\\\\u003e\\\\n        \\\\u003cdiv class\\\\u003d\\\\\\\"header-title\\\\\\\"\\\\u003e\\\\n            \\\\u003ch1\\\\u003eQuickTime MOV Analyzer \\\\u0026 Extractor\\\\u003c/h1\\\\u003e\\\\n            \\\\u003cp\\\\u003eSan Carlos Library Station • Pure Browser Implementation\\\\u003c/p\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n        \\\\u003cdiv\\\\u003e\\\\n            \\\\u003clabel for\\\\u003d\\\\\\\"video-upload-input\\\\\\\" class\\\\u003d\\\\\\\"upload-btn-label\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" id\\\\u003d\\\\\\\"file-label-btn\\\\\\\"\\\\u003e\\\\n                \\\\u003cspan\\\\u003eSelect .mov Video File\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/label\\\\u003e\\\\n            \\\\u003cinput type\\\\u003d\\\\\\\"file\\\\\\\" id\\\\u003d\\\\\\\"video-upload-input\\\\\\\" accept\\\\u003d\\\\\\\".mov,video/quicktime,video/*\\\\\\\" style\\\\u003d\\\\\\\"display: none;\\\\\\\"\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n    \\\\u003c/header\\\\u003e\\\\n\\\\n    \\\\u003cmain\\\\u003e\\\\n        \\\\u003c!-- Left Workspace: Video \\\\u0026 Controls --\\\\u003e\\\\n        \\\\u003csection class\\\\u003d\\\\\\\"workspace\\\\\\\" aria-label\\\\u003d\\\\\\\"Video Player Workspace\\\\\\\"\\\\u003e\\\\n            \\\\n            \\\\u003c!-- Dropzone / Empty State --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"drop-zone\\\\\\\" class\\\\u003d\\\\\\\"drop-zone\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" aria-label\\\\u003d\\\\\\\"Dropzone for video file. Press Enter to browse files.\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"margin-bottom: 16px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003csvg width\\\\u003d\\\\\\\"48\\\\\\\" height\\\\u003d\\\\\\\"48\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"#60a5fa\\\\\\\" stroke-width\\\\u003d\\\\\\\"1.5\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\"\\\\u003e\\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\" d\\\\u003d\\\\\\\"M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12\\\\\\\"/\\\\u003e\\\\u003c/svg\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n                \\\\u003ch2\\\\u003eDrag \\\\u0026 Drop your QuickTime .mov Video\\\\u003c/h2\\\\u003e\\\\n                \\\\u003cp\\\\u003eSupports QuickTime container files including Vivitar AquaSnap MJPEG captures and standard MP4/MOV formats.\\\\u003c/p\\\\u003e\\\\n                \\\\u003cspan class\\\\u003d\\\\\\\"drop-zone-badge\\\\\\\"\\\\u003ePress Enter or click here to browse files\\\\u003c/span\\\\u003e\\\\n            \\\\u003c/div\\\\u003e\\\\n\\\\n            \\\\u003c!-- Active Video View (Hidden Initially) --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"video-container\\\\\\\" class\\\\u003d\\\\\\\"video-container\\\\\\\"\\\\u003e\\\\n                \\\\n                \\\\u003c!-- Video Display Frame --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"video-wrapper\\\\\\\"\\\\u003e\\\\n                    \\\\u003cvideo id\\\\u003d\\\\\\\"main-video\\\\\\\" preload\\\\u003d\\\\\\\"metadata\\\\\\\" playsinline\\\\u003e\\\\u003c/video\\\\u003e\\\\n                \\\\u003c/div\\\\u003e\\\\n\\\\n                \\\\u003c!-- Timeline Scrubber --\\\\u003e\\\\n                \\\\u003cdiv class\\\\u003d\\\\\\\"scrubber-row\\\\\\\"\\\\u003e\\\\n                    \\\\u003cspan id\\\\u003d\\\\\\\"current-time-display\\\\\\\" class\\\\u003d\\\\\\\"time-label\\\\\\\"\\\\u003e00:00\\\\u003c/span\\\\u003e\\\\n                    \\\\u003cinput type\\\\u003d\\\\\\\"range\\\\\\\" id\\\\u003d\\