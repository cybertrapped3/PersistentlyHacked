ime,video/*\\\\\\\" style\\\\u003d\\\\\\\"display: none;\\\\\\\"\\\\u003e\\\\n        \\\\u003c/div\\\\u003e\\\\n    \\\\u003c/header\\\\u003e\\\\n\\\\n    \\\\u003cmain\\\\u003e\\\\n        \\\\u003c!-- Left Workspace: Video \\\\u0026 Controls --\\\\u003e\\\\n        \\\\u003csection class\\\\u003d\\\\\\\"workspace\\\\\\\" aria-label\\\\u003d\\\\\\\"Video Player Workspace\\\\\\\"\\\\u003e\\\\n            \\\\n            \\\\u003c!-- Dropzone / Empty State --\\\\u003e\\\\n            \\\\u003cdiv id\\\\u003d\\\\\\\"drop-zone\\\\\\\" class\\\\u003d\\\\\\\"drop-zone\\\\\\\" tabindex\\\\u003d\\\\\\\"0\\\\\\\" role\\\\u003d\\\\\\\"button\\\\\\\" aria-label\\\\u003d\\\\\\\"Dropzone for video file. Press Enter to browse files.\\\\\\\"\\\\u003e\\\\n                \\\\u003cdiv style\\\\u003d\\\\\\\"margin-bottom: 16px;\\\\\\\"\\\\u003e\\\\n                    \\\\u003csvg width\\\\u003d\\\\\\\"48\\\\\\\" height\\\\u003d\\\\\\\"48\\\\\\\" fill\\\\u003d\\\\\\\"none\\\\\\\" stroke\\\\u003d\\\\\\\"#60a5fa\\\\\\\" stroke-width\\\\u003d\\\\\\\"1.5\\\\\\\" viewBox\\\\u003d\\\\\\\"0 0 24 24\\\\\\\"\\\\u003e\\\\u003cpath stroke-linecap\\\\u003d\\\\\\\"round\\\\\\\" stroke-linejoin\\\\u003d\\\\\\\"round\\\\\\\"\\\\n```\\\",\\\"html\\\",null,false,true,null,null,[[\\\"Defining core CSS reset and dark theme variables\\\",[1790620207,979235170]],[\\\"Styling header and layout structure\\\",[1790620207,979238247]],[\\\"Styling main workspace and dropzone\\\",[1790620207,979240614]],[\\\"Styling timeline slider and controls toolbar\\\",[1790620207,979243041]],[\\\"Styling speed selector and frames gallery\\\",[1790620207,979245222]],[\\\"Styling live statistics sidebar\\\",[1790620207,979247238]],[\\\"Rendering header section\\\",[1790620207,979249573]],[\\\"Rendering main workspace and sidebar layout\\\",[1790620207,979252009]]]],null,true]],null,null,null,null,null,null,[]]],[\\\"San Carlos, CA, USA\\\",\\\"SWML_DESCRIPTION_FROM_YOUR_INTERNET_ADDRESS\\\",false,null,\\\"//www.google.co