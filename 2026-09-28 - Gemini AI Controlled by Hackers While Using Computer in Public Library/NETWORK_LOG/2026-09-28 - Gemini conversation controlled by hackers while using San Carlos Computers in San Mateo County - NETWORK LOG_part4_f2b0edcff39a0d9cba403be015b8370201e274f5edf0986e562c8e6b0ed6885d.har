condary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16