l,null,[[\\\"rc_9c0cd9ea2b76ffd9\\\",[\\\"I will now generate the complete, zero-dependency, pure vanilla HTML/CSS/JavaScript QuickTime `.mov` video player and frame extractor web application. It uses only standard system fonts and native CSS styling, ensuring it renders immediately without any external network dependencies or CDN links.\\\\n\\\\nhttp://googleusercontent.com/immersive_entry_chip/0\\\"],null,null,null,null,null,null,[1],\\\"en\\\",null,null,[{\\\"8\\\":[],\\\"57\\\":[[[\\\"http://googleusercontent.com/immersive_entry_chip/0\\\"],\\\"c_a6ea4d6918c39910_index.html\\\",null,\\\"QuickTime Video Frame Extractor \\\\u0026 Player\\\",null,[1790620197,747368477],null,2]]}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[],null,[[\\\"c_a6ea4d6918c39910_index.html\\\",null,\\\"QuickTime Video Frame Extractor \\\\u0026 Player\\\",null,\\\"```html\\\\n\\\\u003c!DOCTYPE html\\\\u003e\\\\n\\\\u003chtml lang\\\\u003d\\\\\\\"en\\\\\\\"\\\\u003e\\\\n\\\\u003chead\\\\u003e\\\\n    \\\\u003cmeta charset\\\\u003d\\\\\\\"UTF-8\\\\\\\"\\\\u003e\\\\n    \\\\u003cmeta name\\\\u003d\\\\\\\"viewport\\\\\\\" content\\\\u003d\\\\\\\"width\\\\u003ddevice-width, initial-scale\\\\u003d1.0\\\\\\\"\\\\u003e\\\\n    \\\\u003ctitle\\\\u003eQuickTime .mov Player \\\\u0026 Frame Extractor\\\\u003c/title\\\\u003e\\\\n    \\\\u003cstyle\\\\u003e\\\\n        :root {\\\\n            --bg-primary: #090d16;\\\\n            --bg-secondary: #111827;\\\\n            --bg-tertiary: #1f2937;\\\\n            --accent-blue: #2563eb;\\\\n            --accent-blue-hover: #1d4ed8;\\\\n            --accent-emerald: #059669;\\\\n            --accent-emerald-hover: #047857;\\\\n            --text-main: #f3f4f6;\\\\n            --text-muted: #9ca3af;\\\\n            --border-color: #374151;\\\\n        }\\\\n\\\\n        * {\\\\n            box-sizing: border-box;\\\\n            margin: 0;\\\\n            padding: 0;\\\\n        }\\\\n\\\\n        body {\\\\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \\\\\\\"Segoe UI\\\\\\\", Roboto, Helvetica, Arial, sans-serif;\\\\n            background-color: var(--bg-primary);\\\\n            color: var(--text-main);\\\\n            height: 100vh;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        /* High accessibility focus rings */\\\\n        button:focus-visible, input:focus-visible, label:focus-visible {\\\\n            outline: 3px solid #60a5fa !important;\\\\n            outline-offset: 2px !important;\\\\n        }\\\\n\\\\n        header {\\\\n            background-color: var(--bg-secondary);\\\\n            border-bottom: 1px solid var(--border-color);\\\\n            padding: 12px 24px;\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            flex-shrink: 0;\\\\n        }\\\\n\\\\n        .header-title h1 {\\\\n            font-size: 1.1rem;\\\\n            font-weight: 700;\\\\n            letter-spacing: -0.025em;\\\\n        }\\\\n\\\\n        .header-title p {\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n        }\\\\n\\\\n        .upload-btn-label {\\\\n            background-color: var(--accent-blue);\\\\n            color: white;\\\\n            padding: 8px 16px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.875rem;\\\\n            font-weight: 600;\\\\n            cursor: pointer;\\\\n            display: inline-flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n            transition: background-color 0.2s;\\\\n            border: none;\\\\n        }\\\\n\\\\n        .upload-btn-label:hover {\\\\n            background-color: var(--accent-blue-hover);\\\\n        }\\\\n\\\\n        main {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: row;\\\\n            overflow: hidden;\\\\n        }\\\\n\\\\n        @media (max-width: 1024px) {\\\\n            main {\\\\n                flex-direction: column;\\\\n                overflow-y: auto;\\\\n            }\\\\n        }\\\\n\\\\n        .workspace {\\\\n            flex: 1;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            padding: 20px;\\\\n            overflow-y: auto;\\\\n            gap: 16px;\\\\n        }\\\\n\\\\n        .drop-zone {\\\\n            flex: 1;\\\\n            min-height: 360px;\\\\n            border: 2px dashed var(--border-color);\\\\n            border-radius: 16px;\\\\n            display: flex;\\\\n            flex-direction: column;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            padding: 32px;\\\\n            text-align: center;\\\\n            background-color: rgba(17, 24, 39, 0.4);\\\\n            cursor: pointer;\\\\n            transition: all 0.2s;\\\\n        }\\\\n\\\\n        .drop-zone:hover {\\\\n            border-color: var(--accent-blue);\\\\n            background-color: rgba(17, 24, 39, 0.7);\\\\n        }\\\\n\\\\n        .drop-zone h2 {\\\\n            font-size: 1.25rem;\\\\n            font-weight: 600;\\\\n            margin-bottom: 8px;\\\\n        }\\\\n\\\\n        .drop-zone p {\\\\n            font-size: 0.875rem;\\\\n            color: var(--text-muted);\\\\n            max-width: 400px;\\\\n            margin-bottom: 16px;\\\\n        }\\\\n\\\\n        .drop-zone-badge {\\\\n            background-color: var(--bg-tertiary);\\\\n            padding: 6px 12px;\\\\n            border-radius: 8px;\\\\n            font-size: 0.75rem;\\\\n            font-family: monospace;\\\\n            border: 1px solid var(--border-color);\\\\n        }\\\\n\\\\n        .video-container {\\\\n            display: none;\\\\n            flex-direction: column;\\\\n            gap: 12px;\\\\n            flex: 1;\\\\n        }\\\\n\\\\n        .video-wrapper {\\\\n            position: relative;\\\\n            width: 100%;\\\\n            background-color: black;\\\\n            border-radius: 12px;\\\\n            overflow: hidden;\\\\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);\\\\n            border: 1px solid var(--border-color);\\\\n            display: flex;\\\\n            align-items: center;\\\\n            justify-content: center;\\\\n            max-height: 55vh;\\\\n        }\\\\n\\\\n        video {\\\\n            max-height: 55vh;\\\\n            width: auto;\\\\n            max-width: 100%;\\\\n            display: block;\\\\n        }\\\\n\\\\n        .scrubber-row {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 12px;\\\\n            padding: 0 4px;\\\\n        }\\\\n\\\\n        .time-label {\\\\n            font-family: monospace;\\\\n            font-size: 0.75rem;\\\\n            color: var(--text-muted);\\\\n            width: 44px;\\\\n            text-align: center;\\\\n        }\\\\n\\\\n        input[type\\\\u003d\\\\\\\"range\\\\\\\"] {\\\\n            flex: 1;\\\\n            height: 6px;\\\\n            border-radius: 3px;\\\\n            background: var(--bg-tertiary);\\\\n            appearance: none;\\\\n            cursor: pointer;\\\\n            accent-color: var(--accent-blue);\\\\n        }\\\\n\\\\n        .control-toolbar {\\\\n            background-color: var(--bg-secondary);\\\\n            border: 1px solid var(--border-color);\\\\n            padding: 12px;\\\\n            border-radius: 12px;\\\\n            display: flex;\\\\n            flex-wrap: wrap;\\\\n            align-items: center;\\\\n            justify-content: space-between;\\\\n            gap: 12px;\\\\n        }\\\\n\\\\n        .btn-group {\\\\n            display: flex;\\\\n            align-items: center;\\\\n            gap: 8px;\\\\n        }\\\\n\\\\n        .btn {\\\\n            background-color: var(--bg-tertiary);\\\\n            color: var(--text-main);\