          "content": {
            "size": 121273,
            "mimeType": "application/json",
            "text": "{\"pageProps\":{\"marketingAsset\":{\"hideDismissButton\":false,\"marketingAssetContent\":[{\"backgroundImage\":{\"url\":\"https://www.datocms-assets.com/29926/1653335343-bg-svg-worldcat.png\"},\"buttonText\":\" \",\"image\":{\"alt\":null,\"url\":\"https://www.datocms-assets.com/29926/1676580923-217084-worldcatfind_ad_blue.png\"},\"imageCarousel\":[],\"imageDescription\":\"WorldCat Find app\",\"linkText\":\"Download now\",\"linkHref\":\"ANDROID=https://play.google.com/store/apps/details?id=org.oclc.wcmobile&referrer=utm_source%3Dwc-org%26utm_medium%3Dlaunch-banner-homepage, IOS=https://apps.apple.com/app/apple-store/id1638148949?pt=545842&ct=wc-org-launch-banner-homepage&mt=8\",\"subTitle\":\"\",\"title\":\"\"}]},\"infoPagesCollection\":{\"id\":\"55017470\",\"title\":\"For Librarians\",\"content\":{\"value\":{\"schema\":\"dast\",\"document\":{\"type\":\"root\",\"children\":[{\"type\":\"heading\",\"level\":2,\"children\":[{\"type\":\"span\",\"value\":\"Why become a WorldCat.org library?\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org makes your library’s resources visible to information seekers on a freely available website. It is the foundation of our \"},{\"url\":\"https://oc.lc/visibility\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"web visibility program\"}]},{\"type\":\"span\",\"value\":\", which connects people to libraries from search engines and nonlibrary websites where they usually begin their research. Information about library materials is spread across the web via strategic partnerships with search engines and key sites, such as Google Books and Goodreads. Searchers link from those sites to WorldCat.org and from there, to catalogs of libraries that own needed items. The result: Your local resources gain a more global presence, promoting libraries as a vital information source and allowing anyone to quickly and easily access resources in libraries around the world. \"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"As the world’s largest library catalog website, WorldCat.org helps users find items in libraries close to them. If your library is already on WorldCat.org, the best ways to maintain visibility on the site are to \"},{\"url\":\"https://help.oclc.org/Discovery_and_Reference/WorldCat-org/Get_started/Maximize_your_institutions_experience_and_visibility_on_WorldCat-org\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"keep your holdings up to date in WorldCat and ensure that information about your library, including links to your catalog, is accurate in the WorldCat registry\"}]},{\"type\":\"span\",\"value\":\".\"}]},{\"type\":\"thematicBreak\"},{\"type\":\"heading\",\"level\":2,\"children\":[{\"type\":\"span\",\"value\":\"Put your library in WorldCat.org\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org helps people know more about libraries and their collections, connecting people who may not otherwise visit in person or via a website. It expands the communities you serve while personalizing and localizing the experience for the people you care about most.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"We invite you to learn more about our \"},{\"url\":\"https://oc.lc/visibility\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"web visibility program\"}]},{\"type\":\"span\",\"value\":\" and how your library can participate.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"marks\":[\"strong\"],\"value\":\"Resources\"}]},{\"type\":\"list\",\"style\":\"bulleted\",\"children\":[{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://search.worldcat.org/about\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"About WorldCat.org\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"marks\":[\"strong\"],\"value\":\"WorldCat for librarians\"}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://search.worldcat.org/faq\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"Help and FAQ\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://search.worldcat.org/new-features\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"New Features\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://www.oclc.org/en/worldcat-org/news.html\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org news and events: News\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://www.oclc.org/en/worldcat-org/news.html\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org news and events: Recorded presentations\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://www.youtube.com/playlist?list=PLWXaAShGazu6iqighI8cT9p02FDkG2qO7\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"Videos: Navigating WorldCat.org\"}]}]}]}]}]}}},\"slug\":\"for-librarians\",\"relatedPages\":null},\"displayTemporaryWelcomePage\":\"OFF\",\"mobileBannerToggle\":\"ON\",\"mobileBannerUsToggle\":\"ON\",\"mobileBannerUserMaxRange\":\"1\",\"mobileBannerRandomNumberTesting\":\"1\",\"insightsToggle\":\"ON\",\"savedSearchToggle\":\"ON\",\"messages\":{\"components.authentication.EmailSigninForm.1094578291\":\"This is a required field\",\"components.authentication.EmailSigninForm.1152665477\":\"Sign in as an institutional user\",\"components.authentication.EmailSigninForm.1479782176\":\"Enter a valid email address\",\"components.authentication.EmailSigninForm.1766832403\":\"Email address\",\"components.authentication.EmailSigninForm.2094