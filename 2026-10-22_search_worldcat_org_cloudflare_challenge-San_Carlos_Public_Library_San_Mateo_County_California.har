            "text": "{\"pageProps\":{\"marketingAsset\":{\"hideDismissButton\":false,\"marketingAssetContent\":[{\"backgroundImage\":{\"url\":\"https://www.datocms-assets.com/29926/1653335343-bg-svg-worldcat.png\"},\"buttonText\":\" \",\"image\":{\"alt\":null,\"url\":\"https://www.datocms-assets.com/29926/1676580923-217084-worldcatfind_ad_blue.png\"},\"imageCarousel\":[],\"imageDescription\":\"WorldCat Find app\",\"linkText\":\"Download now\",\"linkHref\":\"ANDROID=https://play.google.com/store/apps/details?id=org.oclc.wcmobile&referrer=utm_source%3Dwc-org%26utm_medium%3Dlaunch-banner-homepage, IOS=https://apps.apple.com/app/apple-store/id1638148949?pt=545842&ct=wc-org-launch-banner-homepage&mt=8\",\"subTitle\":\"\",\"title\":\"\"}]},\"topicsLandingPage\":{\"id\":\"54384034\",\"introSection\":\"<p>It&rsquo;s amazing what&rsquo;s available in the world&rsquo;s libraries. To help you get started, we&rsquo;ve put together some scenarios to explore. They&rsquo;ll provide guidance for finding libraries near you and around the globe. Our hope is that you&rsquo;ll use what you find here to connect with a library.</p>\",\"pageTitle\":\"Topics\",\"featuredTopic\":[{\"title\":\"Women's history\",\"id\":\"84237632\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1647354955-thumbnail_womens_history.png\"},\"topicTitle\":\"Women’s history\",\"topicDescription\":\"Both historical and current resources.\",\"slug\":\"womens-history\"},{\"title\":\"Books for book lovers\",\"id\":\"120986449\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659490569-books-thumbnail.png\"},\"topicTitle\":\"Books for book lovers.\",\"topicDescription\":\"If you love books, there are books for that.\",\"slug\":\"book-lovers\"},{\"title\":\"Genealogy\",\"id\":\"84237911\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1647355056-thumbnail_genealogy.png\"},\"topicTitle\":\"Genealogy\",\"topicDescription\":\"If you’re interested in genealogy or family history, you’re in the right place.\",\"slug\":\"genealogy\"},{\"title\":\"Sustainability\",\"id\":\"147692559\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1680793665-216938-wc_sustainability_homepage-preview_622x349.png\"},\"topicTitle\":\"Sustainability\",\"topicDescription\":\"Explore resources related to sustainability, conservation, and environmentalism.\",\"slug\":\"sustainability\"},{\"title\":\"Cooking\",\"id\":\"84237654\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659489828-cooking-thumbnail.png\"},\"topicTitle\":\"Cooking\",\"topicDescription\":\"Much more than making meals.\",\"slug\":\"cooking\"},{\"title\":\"Martin Luther King, Jr.\",\"id\":\"144541263\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1673029760-mlk_topics-page-graphics_thumbnail.png\"},\"topicTitle\":\"Martin Luther King, Jr.\",\"topicDescription\":\"Historical and current resources pertaining to Civil Rights leader Martin Luther King, Jr.\",\"slug\":\"martin-luther-king-jr\"},{\"title\":\"Automobiles\",\"id\":\"122370241\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659489133-gettyimages-129270922-16x9.jpg\"},\"topicTitle\":\"Automobiles\",\"topicDescription\":\"Hit the road for unique automobile resources.\",\"slug\":\"automobiles\"},{\"title\":\"Cycling\",\"id\":\"149281774\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1689345750-216938-wc_cycling_homepage-preview_622x349.png\"},\"topicTitle\":\"Cycling\",\"topicDescription\":\"Explore cycling history, legendary riders, the art of the bike, movies inspired by bicycling, and more.\",\"slug\":\"cycling\"},{\"title\":\"Back to campus\",\"id\":\"122596521\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659490574-campus-thumbnail.png\"},\"topicTitle\":\"Back to campus\",\"topicDescription\":\"Resources for college success.\",\"slug\":\"back-to-campus\"},{\"title\":\"Use WorldCat.org for school research\",\"id\":\"84238410\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659459163-astronomyresearch_thumbnail.jpg\"},\"topicTitle\":\"Use WorldCat.org for school research\",\"topicDescription\":\"Learn additional basic and advanced search techniques in this simple tutorial.\",\"slug\":\"search\"},{\"title\":\"Open Content\",\"id\":\"122596482\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1659490579-open-thumbnail.png\"},\"topicTitle\":\"Open Content\",\"topicDescription\":\"Find open access materials for research and study.\",\"slug\":\"open-content\"},{\"title\":\"Welcome to WorldCat.org\",\"id\":\"84238287\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1660924679-welcome-doors-thumbnail.jpg\"},\"topicTitle\":\"Welcome to WorldCat.org.\",\"topicDescription\":\"Get started with WorldCat.org.\",\"slug\":\"welcome\"},{\"title\":\"Newsroom\",\"id\":\"122342470\",\"thumbnail\":{\"url\":\"https://www.datocms-assets.com/29926/1612826444-coverart-news.svg\"},\"topicTitle\":\"News\",\"topicDescription\":\"Check back here for news and updates related to WorldCat.org.\",\"slug\":\"news\"}]},\"displayTemporaryWelcomePage\":\"OFF\",\"mobileBannerToggle\":\"ON\",\"mobileBannerUsToggle\":\"ON\",\"mobileBannerUserMaxRange\":\"1\",\"mobileBannerRandomNumberTesting\":\"1\",\"insightsToggle\":\"ON\",\"savedSearchToggle\":\"ON\",\"datoCMSToken\":\"f30feae7a4f51b7bf64829b0a6fa20\",\"newRelicBrowserMonitoringToggle\":\"ON\",\"oclcEnv\":\"PROD\",\"newRelicLicenseKey\":\"NRJS-aaea7133c777fa72dfd\",\"messages\":{\"components.authentication.EmailSigninForm.1094578291\":\"This is a required field\",\"components.authentication.EmailSigninForm.1152665477\":\"Sign in as an institutional user\",\"components.authentication.EmailSigninForm.1479782176\":\"Enter a valid email address\",\"components.authentication.EmailSigninForm.1766832403\":\"Email address\",\"components.authentication.EmailSigninForm.2094698441\":\"Email address not found\",\"components.authentication.EmailSigninForm.236