            "size": 121046,
            "mimeType": "application/json",
            "text": "{\"pageProps\":{\"marketingAsset\":{\"hideDismissButton\":false,\"marketingAssetContent\":[{\"backgroundImage\":{\"url\":\"https://www.datocms-assets.com/29926/1653335343-bg-svg-worldcat.png\"},\"buttonText\":\" \",\"image\":{\"alt\":null,\"url\":\"https://www.datocms-assets.com/29926/1676580923-217084-worldcatfind_ad_blue.png\"},\"imageCarousel\":[],\"imageDescription\":\"WorldCat Find app\",\"linkText\":\"Download now\",\"linkHref\":\"ANDROID=https://play.google.com/store/apps/details?id=org.oclc.wcmobile&referrer=utm_source%3Dwc-org%26utm_medium%3Dlaunch-banner-homepage, IOS=https://apps.apple.com/app/apple-store/id1638148949?pt=545842&ct=wc-org-launch-banner-homepage&mt=8\",\"subTitle\":\"\",\"title\":\"\"}]},\"infoPagesCollection\":{\"id\":\"55008439\",\"title\":\"About WorldCat.org\",\"content\":{\"value\":{\"schema\":\"dast\",\"document\":{\"type\":\"root\",\"children\":[{\"type\":\"heading\",\"level\":2,\"children\":[{\"type\":\"span\",\"value\":\"What is WorldCat.org?\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org is a resource for locating unique, trustworthy materials that you often can’t find anywhere except in a library. By connecting thousands of libraries’ collections in one place, WorldCat.org makes it easy for you to browse the world’s libraries from one search box.\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"In the past fifty years, thousands of libraries have represented their collections in WorldCat. Today, you can search WorldCat in nearly 500 languages to find physical items like books, audiobooks, maps, musical scores, and recordings, along with electronic items like ebooks, e-journals, articles, and digital images you can access online. \"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"Search WorldCat.org for information on almost any topic: from science to cooking to history and genealogy. Here, you'll find out which libraries own bestsellers and one-of-a-kind items like family histories, photos, and other unique materials. A search on WorldCat.org delivers a single set of search results that integrates information about relevant library resources to support your information needs. \"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat.org is provided by OCLC, a nonprofit global library organization that provides shared technology services, original research, and community programs so libraries can better fuel learning, research, and innovation.\"}]},{\"type\":\"thematicBreak\"},{\"type\":\"heading\",\"level\":2,\"children\":[{\"type\":\"span\",\"value\":\"Where do I go from here?\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"Search, click on a result, and you’ll see a list of libraries that have indicated they have that resource. From there, you can either directly access online content or link to the catalog of a library near you for information about how to get the item. If what you want is available only from a library far away from you, don’t panic. Save the link to the item and ask your local library if they can get it for you through interlibrary loan.\"}]},{\"type\":\"thematicBreak\"},{\"type\":\"heading\",\"level\":2,\"children\":[{\"type\":\"span\",\"value\":\"Partnerships\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"We work with hundreds of library groups, publishers, technology providers, and other organizations to help get library resources in front of more people across the world every day. We invite you to learn more about how \"},{\"url\":\"https://www.oclc.org/en/partnerships.html\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"your organization could partner with us\"}]},{\"type\":\"span\",\"value\":\".\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"marks\":[\"strong\"],\"value\":\"Resources\"}]},{\"type\":\"list\",\"style\":\"bulleted\",\"children\":[{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"marks\":[\"strong\"],\"value\":\"About WorldCat.org\"}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://search.worldcat.org/for-librarians\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"WorldCat for librarians\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://search.worldcat.org/faq\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"Help and FAQ\"}]}]}]},{\"type\":\"listItem\",\"children\":[{\"type\":\"paragraph\",\"children\":[{\"url\":\"https://www.youtube.com/playlist?list=PLWXaAShGazu6iqighI8cT9p02FDkG2qO7\",\"type\":\"link\",\"children\":[{\"type\":\"span\",\"value\":\"Videos: Navigating WorldCat.org\"}]}]}]}]},{\"type\":\"paragraph\",\"children\":[{\"type\":\"span\",\"value\":\"\"}]}]}}},\"slug\":\"about\",\"relatedPages\":null},\"displayTemporaryWelcomePage\":\"OFF\",\"mobileBannerToggle\":\"ON\",\"mobileBannerUsToggle\":\"ON\",\"mobileBannerUserMaxRange\":\"1\",\"mobileBannerRandomNumberTesting\":\"1\",\"insightsToggle\":\"ON\",\"savedSearchToggle\":\"ON\",\"messages\":{\"components.authentication.EmailSigninForm.1094578291\":\"This is a required field\",\"components.authentication.EmailSigninForm.1152665477\":\"Sign in as an institutional user\",\"components.authentication.EmailSigninForm.1479782176\":\"Enter a valid email address\",\"components.authentication.EmailSigninForm.1766832403\":\"Email address\",\"components.authentication.EmailSigninForm.2094698441\":\"Email address not found\",\"components.authentication.EmailSigninForm.2369435044\":\"Required field\",\"components.authentication.EmailSigninForm.359529510\":\"Create a new account\",\"components.authentication.EmailSigninForm.3640052215\":\"Continue\",\"components.authentication.EmailSigninForm.919