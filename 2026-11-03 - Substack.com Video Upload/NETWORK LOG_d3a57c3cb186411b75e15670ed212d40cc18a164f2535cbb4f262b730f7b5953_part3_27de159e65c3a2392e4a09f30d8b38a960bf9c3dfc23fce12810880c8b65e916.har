            "text": "{\"cover_image\":null,\"podcast_art_url\":null,\"description\":null,\"search_engine_description\":null,\"search_engine_title\":null,\"slug\":null,\"social_title\":null,\"podcast_description\":null,\"free_unlock_required\":false,\"syndicate_voiceover_to_rss\":false,\"audience_before_archived\":null,\"exempt_from_archive_paywall\":false,\"teaser_post_eligible\":true,\"explicit\":null,\"type\":\"podcast\",\"audience\":\"everyone\",\"default_comment_sort\":null,\"draft_body\":\"{\\\"type\\\":\\\"doc\\\",\\\"content\\\":[{\\\"type\\\":\\\"paragraph\\\",\\\"attrs\\\":{\\\"textAlign\\\":null}}]}\",\"draft_podcast_duration\":null,\"draft_podcast_url\":null,\"draft_video_upload_id\":\"bf0b8e55-84e4-47bd-8918-cd38f47a20ba\",\"draft_podcast_upload_id\":\"0e1f88ed-2e04-4ed5-ae7f-6ae13e8a48c7\",\"draft_podcast_preview_upload_id\":null,\"draft_voiceover_upload_id\":null,\"draft_section_id\":null,\"draft_subtitle\":\"Second incident in this town in which I am delayed by a train’s stop light, and as I wait, the ghost train goes by. The silver lining? At least I am not targeted to be ran over by the train... yet.LOL\",\"draft_title\":\"2026-10-27_23-11-00 Targeted Harassment with the Ghost Train\",\"section_chosen\":true,\"should_send_free_preview\":false,\"should_send_email\":true,\"show_guest_bios\":true,\"write_comment_permissions\":\"everyone\",\"has_dismissed_tk_warning\":false,\"meter_type\":\"none\",\"account_based_meter_type\":\"metered\",\"is_draft_hidden\":false,\"email_from_name\":null,\"body\":null,\"draft_created_at\":\"2026-11-03T20:59:47.623Z\",\"draft_updated_at\":\"2026-11-03T21:09:32.751Z\",\"email_sent_at\":null,\"id\":223387699,\"is_published\":false,\"podcast_duration\":null,\"podcast_url\":null,\"imported_podcast_url\":null,\"video_upload_id\":null,\"podcast_upload_id\":null,\"podcast_preview_upload_id\":null,\"voiceover_upload_id\":null,\"post_date\":null,\"publication_id\":1683617,\"section_id\":null,\"subscriber_set_id\":null,\"subtitle\