f050aa4-201d-4f4b-8bf3-fcda7adc4611\",\"editor_v2\":false,\"postSchedules\":[],\"videoUpload\":null,\"postBylines\":[{\"user_id\":148159693,\"is_draft\":true,\"is_guest\":false,\"user\":{\"id\":148159693,\"name\":\"cybertrapped\",\"handle\":\"cybertrapped\",\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/4b574539-b7bf-4dd1-ae31-bf39764a586f_400x400.png\",\"bio\":\"I have experienced coordinated harassment (it may be community based harassment) for over seven years. I want this to stop. https://mastodon.social/@cybertrapped\",\"profile_set_up_at\":\"2023-05-24T21:06:53.168Z\",\"reader_installed_at\":\"2025-06-18T02:19:25.185Z\"}}],\"publishedBylines\":[],\"podcastUpload\":null,\"draftBylines\":[{\"id\":148159693,\"name\":\"cybertrapped\",\"handle\":\"cybertrapped\",\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/4b574539-b7bf-4dd1-ae31-bf39764a586f_400x400.png\",\"bio\":\"I have experienced coordinated harassment (it may be community based harassment) for over seven years. I want this to stop. https://mastodon.social/@cybertrapped\",\"profile_set_up_at\":\"2023-05-24T21:06:53.168Z\",\"reader_installed_at\":\"2025-06-18T02:19:25.185Z\"}],\"podcastPreviewUpload\":null,\"draftPodcastPreviewUpload\":null,\"voiceoverUpload\":null,\"draftVoiceoverUpload\":null,\"draftVideoUpload\":{\"id\":\"bf0b8e55-84e4-47bd-8918-cd38f47a20ba\",\"name\":\"2026-10-27_23-11-00 Targeted harassment - The Ghost Train - Second Incident Like This in This Town.mov\",\"created_at\":\"2026-11-03T21:00:04.237Z\",\"uploaded_at\":\"2026-11-03T21:00:34.402Z\",\"publication_id\":1683617,\"state\":\"uploaded\",\"post_id\":223387699,\"user_id\":148159693,\"duration\":600,\"height\":null,\"width\":null,\"thumbnail_id\":1,\"preview_start\":null,\"preview_duration\":null,\"media_type\":\"video\",\"primary_file_size\":1827889152,\"is_mux\":true,\"mux_asset_id\":\"dwijgHkPaIdjjOy1EerSPU3WDmAr8aie7d31T6TRlR00\",\"mux_playback_id\":null,\"mux_preview_asset_id