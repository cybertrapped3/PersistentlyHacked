            "text": "[{\"start\": 70.0, \"end\": 85.0, \"text\": \"[music]\", \"words\": [], \"non_speech\": \"music\", \"music_score\": 0.6975059509277344}, {\"text\": \" That's crazy.\", \"start\": 413.84, \"end\": 414.84, \"words\": [{\"word\": \" That's\", \"start\": 413.84, \"end\": 414.2, \"score\": 0.424957275390625, \"speaker\": \"SPEAKER_02\"}, {\"word\": \" crazy.\", \"start\": 414.2, \"end\": 414.38, \"score\": 0.5234375, \"speaker\": \"SPEAKER_02\"}], \"speaker\": \"SPEAKER_02\"}, {\"start\": 414.93300000000005, \"end\": 416.948, \"text\": \" Thank you\", \"words\": [{\"word\": \" Thank\", \"start\": 414.93300000000005, \"end\": 416.208, \"score\": 0.791, \"speaker\": \"SPEAKER_02\"}, {\"word\": \" you\", \"start\": 416.308, \"end\": 416.948, \"score\": 0.702, \"speaker\": \"SPEAKER_02\"}], \"avg_logprob\": -0.3680245578289032, \"speaker\": \"SPEAKER_02\"}, {\"start\": 421.27, \"end\": 422.79, \"text\": \" for all those updates.\", \"words\": [{\"word\": \" for\", \"start\": 421.27, \"end\": 421.63, \"score\": 0.693, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" all\", \"start\": 421.77, \"end\": 421.93, \"score\": 0.568, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" those\", \"start\": 421.97, \"end\": 422.19, \"score\": 0.49, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" updates.\", \"start\": 422.37, \"end\": 422.79, \"score\": 0.401, \"speaker\": \"SPEAKER_00\"}], \"avg_logprob\": -0.3680245578289032, \"speaker\": \"SPEAKER_00\"}, {\"start\": 422.85, \"end\": 425.58, \"text\": \"Hello and welcome to Newsday on the BBC World Service.\", \"words\": [{\"word\": \" Hello\", \"start\": 422.85, \"end\": 423.03, \"score\": 0.59716796875, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" and\", \"start\": 423.03, \"end\": 423.25, \"score\": 0.85498046875, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" welcome\", \"start\": 423.25, \"end\": 423.53, \"score\": 0.97412109375, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" to\", \"start\": 423.53, \"end\": 423.77, \"score\": 0.9970703125, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" Newsday\", \"start\": 423.77, \"end\": 424.11, \"score\": 0.885498046875, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" on\", \"start\": 424.11, \"end\": 424.27, \"score\": 0.69677734375, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" the\", \"start\": 424.27, \"end\": 424.31, \"score\": 0.96630859375, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" BBC\", \"start\": 424.31, \"end\": 424.67, \"score\": 0.99755859375, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" World\", \"start\": 424.67, \"end\": 425.03, \"score\": 0.92822265625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" Service.\", \"start\": 425.03, \"end\": 425.41, \"score\": 0.9580078125, \"speaker\": \"SPEAKER_00\"}], \"speaker\": \"SPEAKER_00\"}, {\"start\": 425.63, \"end\": 428.4633333333333, \"text\": \"We are live in London with Andrew Peach and here...\", \"words\": [{\"word\": \" We\", \"start\": 425.63, \"end\": 425.65, \"score\": 0.9931640625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" are\", \"start\": 425.65, \"end\": 425.75, \"score\": 0.87353515625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" live\", \"start\": 425.75, \"end\": 425.97, \"score\": 0.99658203125, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" in\", \"start\": 425.97, \"end\": 426.11, \"score\": 0.99853515625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" London\", \"start\": 426.11, \"end\": 426.35, \"score\": 0.99951171875, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" with\", \"start\": 426.35, \"end\": 426.59, \"score\": 0.9765625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" Andrew\", \"start\": 426.59, \"end\": 426.81, \"score\": 0.9541015625, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" Peach\", \"start\": 426.81, \"end\": 427.19, \"score\": 0.8486328125, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" and\", \"start\": 427.19, \"end\": 427.75, \"score\": 0.2259521484375, \"speaker\": \"SPEAKER_00\"}, {\"word\": \" here...\", \"start\": 427.75, \"end\": 428.27, \"score\": 0.7294921875}], \"spea