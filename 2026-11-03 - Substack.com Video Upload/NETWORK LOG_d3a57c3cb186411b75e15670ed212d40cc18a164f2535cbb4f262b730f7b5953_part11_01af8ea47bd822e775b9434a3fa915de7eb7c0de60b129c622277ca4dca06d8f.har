          "content": {
            "size": 532659,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n    <head>\n        <meta charset=\"utf-8\" />\n        <meta name=\"norton-safeweb-site-verification\" content=\"24usqpep0ejc5w6hod3dulxwciwp0djs6c6ufp96av3t4whuxovj72wfkdjxu82yacb7430qjm8adbd5ezlt4592dq4zrvadcn9j9n-0btgdzpiojfzno16-fnsnu7xd\" />\n        \n        <meta name=\"google\" content=\"notranslate\" />\n        \n        \n        <link rel=\"preconnect\" href=\"https://substackcdn.com\" />\n        \n\n        \n            <title data-rh=\"true\">Substack Home - cybertrapped’s Substack</title>\n            \n            <meta data-rh=\"true\" property=\"og:type\" content=\"article\"/>\n            \n            \n        \n\n        \n\n        <style>\n          @layer legacy, pencraftReset, pencraft;\n        </style>\n\n        \n        <link rel=\"preload\" as=\"style\" href=\"https://substackcdn.com/bundle/theme/publish.b3bdac4bb83dc97f6fbe.css\" />\n        \n        \n        \n\n        \n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/32347.bf8244f0.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/31443.530546da.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/26613.99d4e7f0.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/42640.b9718515.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/1099.08309fd9.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/56879.935cd047.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/77780.6cd7c175.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/22013.f0e47f1b.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/90020.572fa4fb.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/87782.637c6ddd.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/657.60112eae.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/22763.a47aeffd.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/72116.b1faa512.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/20308.63cb3230.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/32934.58559442.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/19812.73714403.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/74844.f1296849.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/87577.f1dcca16.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/reactPublish.abd84ece.css\" />\n            \n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://substackcdn.com/bundle/static/css/55297.af98b69f.css\" />\n            \n        \n\n        \n        \n        \n     