isEligibleForLiveStreamCreation\":true,\"webviewPlatform\":null,\"useDarkMode\":true,\"noIndex\":true,\"publication\":{\"id\":1683617,\"subdomain\":\"cybertrapped\",\"is_personal_mode\":false,\"name\":\"cybertrapped’s Substack\",\"custom_domain\":null,\"logo_url\":\"https://substackcdn.com/image/fetch/$s_!-N5Z!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F4b574539-b7bf-4dd1-ae31-bf39764a586f_400x400.png\",\"logo_url_wide\":null,\"cover_photo_url\":null,\"copyright\":\"cybertrapped\",\"email_from_name\":null,\"subscribe_content\":\"{\\\"type\\\":\\\"doc\\\",\\\"content\\\":[{\\\"type\\\":\\\"heading\\\",\\\"attrs\\\":{\\\"level\\\":1},\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Why subscribe?\\\"}]},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Subscribe to get full access to the newsletter and \\\"},{\\\"type\\\":\\\"text\\\",\\\"marks\\\":[{\\\"type\\\":\\\"link\\\",\\\"attrs\\\":{\\\"href\\\":\\\"%%archive_url%%\\\",\\\"target\\\":\\\"_blank\\\"}}],\\\"text\\\":\\\"website\\\"},{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\". Never miss an update.\\\"}]},{\\\"type\\\":\\\"button\\\",\\\"attrs\\\":{\\\"url\\\":\\\"%%checkout_url%%\\\",\\\"text\\\":\\\"Subscribe now\\\",\\\"action\\\":null,\\\"class\\\":null}},{\\\"type\\\":\\\"heading\\\",\\\"attrs\\\":{\\\"level\\\":3},\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Stay up-to-date\\\"}]},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"You won’t have to worry about missing anything. Every new edition of the newsletter goes directly to your inbox.\\\"}]},{\\\"type\\\":\\\"heading\\\",\\\"attrs\\\":{\\\"level\\\":3},\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Join the crew\\\"}]},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Be part of a community of people who share your interests.\\\"}]},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"To find out more about the company that provides the tech for this newsletter, visit \\\"},{\\\"type\\\":\\\"text\\\",\\\"marks\\\":[{\\\"type\\\":\\\"link\\\",\\\"attrs\\\":{\\\"href\\\":\\\"https://www.substack.com/\\\",\\\"target\\\":\\\"_blank\\\"}}],\\\"text\\\":\\\"Substack.com\\\"},{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\".\\\"}]}]}\",\"subscribe_footer\":\"Subscribe to get exclusive updates in your inbox\",\"welcome_email_content\":\"It’s good to have you here!\\n\\nYou will start receiving updates right here in your inbox. You can also log in to the website to read the full archives and other posts as they are published.\\n\\n---\\n\\n**Some housekeeping…**\\n\\nIf you can’t find the newsletter, check your spam folder. And please mark this address as ‘not spam.’ If the newsletter isn’t in your spam folder, either, you should look in the Promotions tab.\\n\\nYou can always see everything on the website.\\n\\nThanks again, and please tell a few friends if you feel like it.\\n\",\"welcome_email_subject\":\"Welcome to cybertrapped’s Substack\",\"unfinished_subscription_email_content\":\"{\\\"type\\\":\\\"doc\\\",\\\"content\\\":[{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"You're receiving free posts from cybertrapped’s Substack.\\\"}]},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"To get every post and other paid subscriber benefits, \\\"},{\\\"type\\\":\\\"text\\\",\\\"marks\\\":[{\\\"type\\\":\\\"strong\\\"}],\\\"text\\\":\\\"upgrade to a paid subscription\\\"}]},{\\\"type\\\":\\\"button\\\",\\\"attrs\\\":{\\\"url\\\":\\\"%%checkout_url%%\\\",\\\"text\\\":\\\"Upgrade subscription\\\",\\\"action\\\":null,\\\"class\\\":null}},{\\\"type\\\":\\\"paragraph\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"You can \\\"},{\\\"type\\\":\\\"text\