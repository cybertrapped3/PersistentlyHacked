            "text": "{\n  \"preferences\": {\n    \"colors\": {\n      \"base\": \"rgb(255, 105, 25)\",\n      \"light\": \"rgb(255, 105, 25)\",\n      \"dark\": \"rgb(22, 23, 24)\"\n    },\n    \"css\": \".team-theme-bg {\\n  background: rgb(255, 105, 25);\\n}\\n\\n.team-theme-bg-light {\\n  background: rgb(255, 105, 25);\\n  color: white !important;\\n}\\n\\n.team-theme-bg-dark {\\n  background: rgb(22, 23, 24);\\n}\"\n  },\n  \"companyName\": \"Substack\",\n  \"chatbotName\": {\n    \"base\": \"Substack Support\"\n  },\n  \"settings\": {\n    \"theme\": \"large\"\n  },\n  \"chatInputSettings\": {\n    \"enableFileUpload\": true,\n    \"allowedFileTypes\": [\n      \"pdf\",\n      \"png\",\n      \"jpg\",\n      \"jpeg\",\n      \"webp\",\n      \"gif\",\n      \"zip\"\n    ],\n    \"enableLiveChatClosingSurveyButton\": true\n  },\n  \"ratingSettings\": {\n    \"enableResolution\": true,\n    \"useDynamicCSATv2\": true,\n    \"enabled\": true,\n    \"isBinary\": false,\n    \"resolutionTriggersClosingSurvey\": false,\n    \"enableFeedback\": true\n  },\n  \"target\": \"base\",\n  \"closingSurveySettings\": {\n    \"disableClosingSurvey\": true,\n    \"closingSurveyIsBinaryOverride\": false,\n    \"skipAskToClose\": false,\n    \"isFeedbackEnabled\": false,\n    \"enableOnWidgetClose\": true,\n    \"enableOnEmbedWidgetClose\": false,\n    \"enableOnMobileWidgetClose\": false\n  },\n  \"chatMessageSettings\": {\n    \"disableMessageCsatRating\": false\n  },\n  \"defaultStoreSettings\": {\n    \"localizationData\": {}\n  },\n  \"welcomeMessageSettings\": {\n    \"layout\": \"bubble\"\n  }\n}"
