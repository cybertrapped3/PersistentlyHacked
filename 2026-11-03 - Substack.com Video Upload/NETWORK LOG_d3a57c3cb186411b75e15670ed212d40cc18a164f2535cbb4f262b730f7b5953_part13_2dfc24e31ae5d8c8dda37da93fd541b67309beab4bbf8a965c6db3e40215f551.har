correctly and is readable, with proper indentation where applicable.\n\n6. **Testing**: After processing, verify the integrity of the JSON structure by loading it into a JSON parser to check for errors. Also, manually inspect a few entries to ensure they contain the correct data and formatting.\n\nPlease do all these steps silently, and only return the final JSON file for download.`),o=async()=>{try{await navigator.clipboard.writeText(t),e(()=>(0,r.jsx)(Y.y,{text:\"Copied the prompt to the clipboard! Paste it into your task description or prompt field.\"}))}catch(e){alert(`Failed to copy text: ${String(e)}`)}};return(0,r.jsx)(\"a\",{onClick:o,children:\"Copy Prompt to Clipboard\"})}},810706:function(e,t,o){o.d(t,{T:()=>h});var r=o(886070),s=o(830758),i=o(511405),a=o.n(i),n=o(766002),l=o(568349),d=o(913915),p=o(757820),c=o(475746),u=o(490918);let h=e=>{let{section:t,audience:o,replace_existing:i,num_posts:h=1,pub:m,import_id:f,onComplete:y,onFail:_}=e,{iString:x,iPlural:g}=(0,n.G)();return(0,s.useEffect)(()=>{(async()=>{try{await a().post(`/api/v1/import/posts/${f}`).send({section:t,audience:o,replace_existing:i}),y()}catch(e){alert((0,l.uX)(e)),_()}})()},[]),(0,r.jsxs)(u.Nw,{children:[(0,r.jsx)(u.q_,{children:x(m?\"Importing posts\":\"Importing publication\")}),(0,r.jsxs)(u.KY,{children:[(0,r.jsx)(d.Ye,{justifyContent:\"center\",children:(0,r.jsx)(p.y$,{})}),(0,r.jsxs)(d.I1,{alignItems:\"center\",justifyContent:\"center\",children:[(0,r.jsx)(c.EY.B3,{color:\"primary\",children:g(\"Processing your post\",\"Processing your %1 posts\",h)}),(0,r.jsx)(c.EY.B5,{color:\"secondary\",children:x(\"This may take a few seconds\")})]})]})]})}},71092:function(e,t,o){o.d(t,{r:()=>b});var r=o(886070),s=o(830758),i=o(511405),a=o.n(i),n=o(766002),l=o(585478),d=o(668776),p=o(435369),c=o(913915),u=o(757820),h=o(475746),m=o(565842),f=o(490918),y=o(992636),_=o(441086),x=o(909036),g=o(757324);let b=e=>{let{pub:t,onImport:o,onSkip:i,onMoveToGenericImporter:b,isPodcastImport:j=!1}=e,{getCon