-b9f0bc7e117a\",\"publication_id\":1683617,\"name\":\"conspiracy to oppress\",\"slug\":\"conspiracy-to-oppress\",\"hidden\":false},{\"id\":\"2d4e238d-f2dd-40c9-b2f8-aab691322d45\",\"publication_id\":1683617,\"name\":\"covert oppression\",\"slug\":\"covert-oppression\",\"hidden\":false},{\"id\":\"923cfcb8-e067-41f5-a652-2a377f986c1c\",\"publication_id\":1683617,\"name\":\"Blocked & Disrupted\",\"slug\":\"blocked-and-disrupted\",\"hidden\":false},{\"id\":\"a910c16f-1cb5-4bc6-be4a-e974873c0508\",\"publication_id\":1683617,\"name\":\"cybertrapped\",\"slug\":\"cybertrapped\",\"hidden\":false},{\"id\":\"ca41e178-755c-4aa2-8432-aecada67c775\",\"publication_id\":1683617,\"name\":\"community organized harassment\",\"slug\":\"community-organized-harassment\",\"hidden\":false},{\"id\":\"d212dc6a-832b-4ae5-ae85-814f3bf4ed20\",\"publication_id\":1683617,\"name\":\"citywide mobbing\",\"slug\":\"citywide-mobbing\",\"hidden\":false}],\"postCountryBlocks\":[],\"disable_drop_cap\":false,\"cover_image_crop\":null,\"headlineTest\":null,\"coverImagePalette\":{\"Vibrant\":{\"rgb\":[60,126,198],\"population\":4},\"DarkVibrant\":{\"rgb\":[28,60,140],\"population\":1},\"LightVibrant\":{\"rgb\":[146,194,245],\"population\":99},\"Muted\":{\"rgb\":[75,109,174],\"population\":475},\"DarkMuted\":{\"rgb\":[55,54,86],\"population\":211},\"LightMuted\":{\"rgb\":[207,198,227],\"population\":32}},\"publishedBylines\":[{\"id\":148159693,\"name\":\"cybertrapped\",\"handle\":\"cybertrapped\",\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/4b574539-b7bf-4dd1-ae31-bf39764a586f_400x400.png\",\"bio\":\"I have experienced coordinated harassment (it may be community based harassment) for over seven years. I want this to stop. https://mastodon.social/@cybertrapped\",\"profile_set_up_at\":\"2023-05-24T21:06:53.168Z\",\"reader_installed_at\":\"2025-06-18T02:19:25.185Z\",\"publicationUsers\":[{\"id\":1660895,\"user_id\":148159693,\"publication_id\":1683617,\"role\":\"admin\",\"public\":