\"Subscriber\"},state:{name:\"State/Province\",explanation:\"The subscriber's state or province based on their most recent activity.\",group:\"Subscriber\"},time_zone:{name:\"Time zone\",explanation:\"The subscriber's time zone based on their most recent activity.\",group:\"Subscriber\"},is_subscribed:{name:\"Can see paid content\",group:\"Subscription\"},bestseller_tier:{name:\"Bestseller\",explanation:\"Shows a badge if this subscriber runs a Substack with 100+ subscribers.\",group:\"Subscription\"},num_emails_received:{name:\"Emails received (6mo)\",explanation:\"Number of times emails sent to this subscriber have been delivered in the last 6 months.\",group:\"Email engagement\"},num_emails_dropped:{name:\"Emails dropped (6mo)\",explanation:\"Emails to this subscriber that failed to deliver in the last 6 months.\",group:\"Email engagement\"},num_email_opens:{name:\"Emails opened (6mo)\",explanation:\"Number of times emails sent to this subscriber have been opened in the last 6 months. If the number is large, it may be because the subscriber is forwarding emails to other people.\",group:\"Email engagement\"},num_email_opens_last_7d:{name:\"Emails opened (7d)\",explanation:\"Number of times emails sent to this subscriber have been opened in the last 7 days. If the number is large, it may be because the subscriber is forwarding emails to other people.\",group:\"Email engagement\"},num_email_opens_last_30d:{name:\"Emails opened (30d)\",explanation:\"Number of times emails sent to this subscriber have been opened in the last 30 days. If the number is large, it may be because the subscriber is forwarding emails to other people.\",group:\"Email engagement\"},last_opened_at:{name:\"Last email open\",explanation:\"The date when this subscriber last opened an email from your publication.\",group:\"Email engagement\"},links_clicked:{name:\"Links clicked\",explanation:\"Links this subscriber clicked in your posts in the last 6 months.\",group:\"Email engagement\"},last_clicked_at:{name:\"Last clicked at\",explanation:\"When this subscriber last clicked a link in your posts, within the last 6 months.\",group:\"Email engagement\"},num_video_plays_last_30d:{name:\"Video plays (30d)\",explanation:\"Number of times this subscriber has played a video in the last 30 days, including rewatches of the same video.\",group:\"Content engagement\"},num_unique_videos_played_last_30d:{name:\"Unique videos played (30d)\",explanation:\"Number of unique videos that this subscriber has played in the last 30 days.\",group:\"Content engagement\"},last_video_played_at:{name:\"Last video played\",explanation:\"The date the subscriber most recently played a video.\",group:\"Content engagement\"},num_podcast_plays_last_30d:{name:\"Podcast plays (30d)\",explanation:\"Number of times this subscriber has listened to a podcast in the last 30 days, including replays of the same podcast. Off-Substack playback and downloads are not included.\",group:\"Content engagement\"},num_unique_podcast_plays_last_30d:{name:\"Unique podcasts played (30d)\",explanation:\"Number of unique podcasts that this subscriber has played in the last 30 days. Off-Substack playback and downloads are not included.\",group:\"Content engagement\"},last_podcast_played_at:{name:\"Last podcast played\",explanation:\"The date the subscriber most recently played a podcast.\",group:\"Content engagement\"},num_unique_email_posts_seen_last_7d:{name:\"Unique emails seen (7d)\",explanation:\"How many distinct emails sent to this subscriber in the last 7 days have been opened. Emails that are forwarded and then opened by someone else are not distinctly counted.\",group:\"Email engagement\"},num_unique_email_posts_seen_last_30d:{name:\"Unique emails seen (30d)\",explanation:\"How many distinct emails sent to a subscriber in the last 30 days have been opened. Emails that are forwarded and then opened by someone else are not distinctly counted.\",group:\"Email engagement\"},num_unique_email_posts_seen:{name:\"Unique emails seen (6mo)\",explanation:\"How many distinct emails sent to a subscriber have been opened in the last 6 months. Emails that are forwarded and then opened by someone else are not distinctly counted.\",group:\"Email engagement\"},num_web_post_views_last_7d:{name:\"Post views (7d)\",explanation:\"How many times this subscriber viewed any post in the last 7 days. If one person views the same post 10 times, this counts as 10 views.\",group:\"Content engagement\"},num_web_post_views_last_30d:{name:\"Post views (30d)\",explanation:\"How many times this subscriber viewed any post in the last 30 days. If one person views the same post 10 times, this counts as 10 views.\",group:\"Content engagement\"},num_web_post_views:{name:\"Post views\",explanation:\"How many times this subscriber viewed any post in the last 6 months. If one person views the same post 10 times, this counts as 10 views.\",group:\"Content engagement\"},num_unique_web_posts_seen_last_7d:{name:\"Unique posts seen (7d)\",explanation:\"How many distinct posts this subscriber has viewed in the last 7 days. If one person views the same post 10 times, this counts as 1 post seen.\",group:\"Content engagement\"},num_unique_web_posts_seen_last_30d:{name:\"Unique posts seen (30d)\",explanation:\"How many distinct posts this subscriber has viewed in the last 30 days. If one person views the same post 10 times, this counts as 1 post seen.\",group:\"Content engagement\"},num_unique_web_posts_seen:{name:\"Unique posts seen\",explanation:\"How many distinct posts this subscriber has viewed in the last 6 months. If one person views the same post 10 times, this counts as 1 post seen.\",group:\"Content engagement\"},num_comments_last_7d:{name:\"Comments (7d)\",explanation:\"How many times this subscriber has commented on any of your posts in the last 7 days.\",group:\"Content engagement\"},num_comments_last_30d:{name:\"Comments (30d)\",explanation:\"How many times this subscriber has commented on any of your posts in the last 30 days.\",group:\"Content engagement\"},num_comments:{name:\"Comments\",explanation:\"How many times this subscriber has commented on any of your posts.\",group:\"Content engagement\"},num_shares_last_7d:{name:\"Shares (7d)\",explanation:\"How many times a subscriber has clicked a button to share one of your posts in the last 7 days.\",group:\"Content engagement\"},num_shares_last_30d:{name:\"Shares (30d)\",explanation:\"How many times a subscriber has clicked a button to share one of your posts in the last 30 days.\",group:\"Content engagement\"},num_shares:{name:\"Shares\",explanation:\"How many times a subscriber has clicked a button to share one of your posts.\",group:\"Content engagement\"},num_subs_gifted:{name:\"Subscriptions gifted\",explanation:\"How many times a subscriber has gifted a subscription to another person.\",group:\"Subscription\"},subscription_expires_at:{name:\"Expiration date\",explanation:\"For paid subscribers, the date at which they will be charged to renew their subscription (if they have not cancelled), or when their paid subscription will end.\",group:\"Subscription\"},first_payment_at:{name:\"First paid date\",explanation:\"The date when a subscriber first paid for your newsletter.\",group:\"Subscription\"},subscription_interval:{name:\"Subscription interval\",explanation:\"The interval at which a subscriber is charged for their subscription.\",group:\"Subscription\"},total_revenue_generated:{name:\"Revenue\",explanation:\"How much money the subscriber has paid for your newsletter, not including any money refunded.\",group:\"Subscription\"},free_attribution:{name:\"Subscription source (free)\",explanation:\"A tag explaining how a subscriber arrived at your publication before becoming a free subscriber (e.g. from the Substack homepage or Google).\",group:\"Subscription\"},paid_attribution:{name:\"Subscription source (paid)\",explanation:\"A tag explaining how a subscriber arrived at your publication before becoming a paying subscriber (e.g. from the Substack homepage or Google).\",group:\"Subscription\"},days_active_last_30d:{name:\"Days active (30d)\",explanation:\"Days in the last 30 with a post view, email open, or note click, like or reply.\",group:\"Activity\"},activity_rating:{name:\"Activity\",explanation:\"Activity over the last 30 days, ranked against your other subscribers (1 to 5 stars).\",group:\"Activity\"},last_subscribed_at:{name:\"Paid upgrade date\",explanation:\"The most recent date on which a subscriber converted from free to paid.\",group:\"Subscription\"},unsubscribed_at:{name:\"Cancel date\",explanation:\"The date on which a subscriber chose to cancel their paid subscription.\",group:\"Subscription\"},unsubscribe_reason_bucket:{name:\"Cancel reason\",explanation:\"The reason a subscriber selected when they cancelled their paid subscription.\",group:\"Subscription\"},unsubscribe_feedback:{name:\"Cancel feedback\",explanation:\"The free-form explanation a subscriber wrote when they cancelled their paid subscription.\",filterable:!1,group:\"Subscription\"},emails_enabled:{name:\"Sections\",explanation:\"The sections or podcasts for which a subscriber has emails enabled, including your root publication.\",group:\"Email engagement\"},stripe_plan_name:{name:\"Stripe plan\",explanation:\"The nickname of the Stripe plan which the user is subscribed to.\",group:\"Subscription\"},bundle_id:{name:\"Bundle\",explanation:\"The bundle this subscription belongs to, if any.\",group:\"Subscription\"},is_bundle_parent:{name:\"Bundle origin\",explanation:\"Whether the bundle subscription originated on this publication or another publication in the bundle.\",group:\"Subscription\"},tag_ids:{name:\"Tags\",explanation:\"Publisher-defined tags assigned to this subscriber.\",group:\"Tags\"},group_membership:{name:\"Group membership\",explanation:\"Whether the subscriber is a group subscription admin, member, or not part of any group.\",group:\"Subscriber\"}},esK={price:(0,lq.yJ)(\"D