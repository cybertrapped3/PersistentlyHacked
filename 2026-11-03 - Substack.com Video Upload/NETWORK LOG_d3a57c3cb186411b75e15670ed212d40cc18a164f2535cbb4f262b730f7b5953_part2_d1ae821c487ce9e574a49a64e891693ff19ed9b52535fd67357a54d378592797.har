height:810,width:1080,resizeWidth:null,bytes:null,alt:\"colored pencil lined up on top of white surface\",title:null,type:\"image/jpg\",href:null,belowTheFold:!0,internalRedirect:null}},{type:\"caption\",content:[{type:\"text\",marks:[{type:\"em\"}],text:\"Replace this image with a photo or video. Articles with at least 1 visual get 55% more engagement.\"}]}]},nw(n_),nC(\"What brings you to Substack? This can be as formal or as casual as you want. Audiences love a backstory to help them get to know you.\"),nw(nv),nC(\"What is your Substack all about? Tell audiences what’s in store. If you already have paid subscriptions enabled, talk about those benefits, too.\"),nC(\"Try a personal sign off.\"),{type:\"horizontal_rule\"},nC(\"Short & sweet summary of who you are and what you do.\"),{type:\"button\",attrs:{url:\"%%checkout_url%%\",text:\"Subscribe now\",action:null,class:null}},{type:\"paragraph\"}]}),title:\"\",subtitle:\"\"}:{body:(o=this.props.pub.name,JSON.stringify({type:\"doc\",content:[{type:\"paragraph\"},{type:\"button\",attrs:{url:\"%%checkout_url%%\",text:\"Subscribe now\",action:null,class:null}},{type:\"heading\",attrs:{level:2},content:[{type:\"text\",text:\"[EDIT ME] Beginnings are hard. [EDIT ME]\"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"A blinking cursor on a fresh blank page can be intimidating for even seasoned writers. Here are some tips from our Partnerships team on how to go about your first Substack post:\"}]},{type:\"heading\",attrs:{level:3},content:[{type:\"text\",text:\"1. Why this, why now \"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"Tell your readers why you are launching this space. What brought you here and what inspired you to do it now. Think of it as a mini personal manifesto.\"}]},{type:\"heading\",attrs:{level:3},content:[{type:\"text\",text:\"2. What kind of community are you looking to build here\"}]},{type:\"paragraph\",content:[{type:\"text\",text:\" You are not just starting a newsletter when you start a Substack, you are starting a community. You are inviting people to subscribe to your thinking. What kind of space will this be? \"}]},{type:\"heading\",attrs:{level:3},content:[{type:\"text\",text:\"3. Be specific \"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"Readers love clarity. Be clear when you explain what they should expect: how often will you be posting? Can they expect certain posts on specific days? What will the free subscribers get? What does a paid subscription buy them? (You can list these benefits in bullets.) \"}]},{type:\"heading\",attrs:{level:3},content:[{type:\"text\",text:\"4. Use an image and “subscribe” buttons\"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"A picture will look nicer when you share the post on your social media (click the image icon in the editor to search for copyright-free photos), and it will give color to your archive as you build it.\"}]},{type:\"captionedImage\",content:[{type:\"image2\",attrs:{src:\"https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=MnwzMDAzMzh8MHwxfHNlYXJjaHwyfHxyYW5kb218ZW58MHx8fHwxNjY3MzQ5Njkx&ixlib=rb-4.0.3&q=80&w=1080\",fullscreen:null,imageSize:null,height:810,width:1080,resizeWidth:null,bytes:null,alt:\"colored pencil lined up on top of white surface\",title:null,type:\"image/jpg\",href:null,belowTheFold:!0,internalRedirect:null}},{type:\"caption\",content:[{type:\"text\",text:\"Photo by \"},{type:\"text\",marks:[{type:\"link\",attrs:{href:\"https://unsplash.com/@jessbaileydesigns\",target:\"_blank\"}}],text:\"Jess Bailey\"},{type:\"text\",text:\" on \"},{type:\"text\",marks:[{type:\"link\",attrs:{href:\"https://unsplash.com\",target:\"_blank\"}}],text:\"Unsplash\"}]}]},{type:\"paragraph\",content:[{type:\"text\",text:\"[EDIT ME]“Subscribe” buttons (found in your editor under “Buttons'“) will make it easy for new readers to subscribe to your newsletter with one click.[EDIT ME]\"}]},{type:\"heading\",attrs:{level:3},content:[{type:\"text\",text:\"5. Ignore our advice \"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"There is no one true way to go about building a Substack. This is your playground,  experiment with it. If you’re having fun, your readers will too. \"}]},{type:\"paragraph\",content:[{type:\"text\",text:\"(But trust us on the “subscribe” buttons!) \"}]},{type:\"horizontal_rule\"},{type:\"subscribeWidget\",attrs:{url:\"%%checkout_url%%\",text:\"Subscribe\"},content:[{type:\"ctaCaption\",content:[{type:\"text\",text:`Thanks for reading ${o}! Subscribe for free to receive new posts and support my work.`}]}]},{type:\"paragraph\"}]})),title:\"\",subtitle:\"\"};s=e,r=t,a=i}i&&this.setState({section_chosen:!0,section_id:\"pub\"===i?null:parseInt(i,10)});let l=this.props.launchPost?\"everyone\":this.props.audience||(0,ed.eZB)(this.props.pub,{type:this.getPostType(),coupon:null});if(\"adhoc_email\"===this.getPostType()&&!this.props.subscriber_set_id){let e={query:{subscription_type_in:void 0}};\"only_paid\"!==l||this.props.surveyId||(e.query.subscription_type_in=[\"paid\",\"founding\"]);let t=await H().post(\"/api/v1/subscriber_set\").send(e);this.setState({subscriber_set_id:t.body.id})}let d=this.props.launchPost?\"everyone\":(0,ed.LhZ)(l,this.props.type,this.props.pub,(0,ed.M$0)(this.props.pub)),c=(0,ed.oKw)(this.props.pub,this.props.type,l);this.setState({audienceToggle:l,commentLevel:d,commentSort:null,shouldSendEmail:c,dontSendEmail:!c}),e&&setTimeout(()=>{this.insertCoupon(e)},0);let u=this.props.user||{id:this.props.pub.author_id,name:this.props.pub.author_name,photo_url:this.props.pub.author_photo_url,bio:this.props.pub.author_bio},p=[];return\"page\"!==this.props.type&&p.push({user_id:u.id,is_guest:!1,is_draft:!0,user:u}),{title:s,subtitle:r,bylines:p,podcast_url:null,podcast_duration:null,video_upload_id:null,podcast_upload_id:null,podcast_preview_upload_id:null,voiceover_upload_id:null,body:a}};saveDocument=(()=>{var e=this;return async function(t){let i,n,{au