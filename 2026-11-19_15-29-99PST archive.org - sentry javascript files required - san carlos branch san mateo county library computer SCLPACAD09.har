            "text": "import{n as e}from\"./rolldown-runtime-QTnfLwEv.js\";import{A as t,C as n,E as r,N as i,O as a,P as o,T as s,x as c}from\"./vendor-lit-MQ4DzmMc.js\";import{s as l}from\"./vendor-shared-62wh2Xkx.js\";import{r as u,t as d}from\"./vendor-topnav-Dcg-INpV.js\";import{r as f}from\"./ia-status-indicator-Bd61y7bd.js\";import\"./ia-clearable-text-input-CaSQalrP.js\";import\"./ia-dropdown-DbuqBiPJ.js\";var p=e({IADropdownSearchBar:()=>h}),m={CategoryChanged:`categoryChanged`,SearchRequested:`searchRequested`},h=class extends s{constructor(){super(...arguments),this.categories=[],this.useMobileView=!1,this.hideDropdown=!1,this.loading=!1}get resolvedCategory(){return this.selectedCategory??this.categories?.[0]?.id??``}render(){return a`\n      <div id=\"container\" part=\"container\" role=\"search\">\n        <div\n          id=\"main-bar\"\n          part=\"main-bar\"\n          class=${this.hideDropdown?`no-dropdown`:r}\n        >\n          ${this.hideDropdown?r:this.dropdownTemplate}\n          ${this.textBoxTemplate} ${this.searchButtonTemplate}\n        </div>\n      </div>\n    `}willUpdate(e){if(e.has(`selectedCategory`)||e.has(`categories`)){let e=this.resolvedCategory;this.categoryDropdown&&this.categoryDropdown.selectedOption!==e&&(this.categoryDropdown.selectedOption=e)}}get dropdownTemplate(){return a`\n      <ia-dropdown\n        id=\"category-dropdown\"\n        part=\"category-dropdown\"\n        displayCaret\n        includeSelectedOption\n        closeOnSelect\n        closeOnEscape\n        closeOnBackdropClick\n        openViaButton\n        optionGroup=${o(`search category`)}\n        .selectedOption=${this.resolvedCategory}\n        .options=${this.categories}\n        @optionSelected=${this.handleCategorySelected}\n      >\n        <span slot=\"dropdown-label\" part=\"category-dropdown-label\"\n          >${this.selectedCategoryLabel}</span\n        >\n      </ia-dropdown>\n    `}get textBoxTemplate(){return a`\n      <ia-clearable-t