            "text": "<!DOCTYPE html>\n<html lang=\"en\" style=\"background-color:#ffffff\">\n    <head>\n        <title>You have been blocked</title>\n<!--[if !mso]>\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"></meta>\n<![endif]-->\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=5.0, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex\">\n\n<link rel=\"preconnect\" href=\"//static.captcha-delivery.com\">\n\n    <link rel=\"stylesheet\" href=\"//static.captcha-delivery.com/captcha/assets/tpl/6dc485c0c428c35b53577b146dc6f9179f55ef9ad41b327a2a179998839364bf/index.css\"/>\n        <link href=\"https://static.captcha-delivery.com/common/fonts/roboto/font-face.css\" rel=\"stylesheet\">\n\n<style>\n    /* General font handling */\n    *, *::before, *::after\n    {\n        font-family : Roboto, Verdana, Arial;\n        font-weight : 400;\n        color       : #000000;\n    }\n        .captcha__contact__submit\n        {\n            background-color : #A0CE4E !important;\n        }\n\n        .captcha__contact__submit\n        {\n            color : #FFFFFF !important;\n        }\n\n    \n</style>\n\n    </head>\n    <body class=\"dd-response-page--hard-block\" data-dd-response-page=\"hard-block\" >\n        <div id=\"captcha-container\" class=\"captcha\" data-dd-captcha-container>\n            <div class=\"captcha__header\" data-dd-captcha-header>\n    <div class=\"captcha__header__container\" data-dd-captcha-header-container>\n        <div class=\"captcha__header__logo-wrapper\" data-dd-captcha-header-logo-wrapper>\n                <img src=\"//static.captcha-delivery.com/captcha/assets/set/4818807655cc541430df555871066f3d0237831c/logo.png?update_cache=5856126111576137700\" class=\"captcha__header__logo\"\n                 data-dd-captcha-header-logo />\n        </div>\n    </div>\n</div>\n\n            <div class=\