\n      <li class=\"style-scope desktop-subnav\">\n        <a class=\"volunteer style-scope desktop-subnav\"\n          href=\"//archive.org/about/volunteer-positions\"><!--?lit$0049150236$-->Volunteer<!--?lit$0049150236$--><!--?--></a>\n      </li>\n      <!----><!---->\n    </ul>\n  </desktop-subnav>\n  <div id=\"close-layer\" class=\"style-scope ia-topnav\"></div>\n  </ia-topnav>\n                  </div>\n\n        <!-- Begin page content -->\n        <main id=\"maincontent\">\n          <div class=\"container container-ia\">\n\n              <input class=\"js-uploader-args\" type=\"hidden\" value='{\"s3user\":{\"s3accesskey\":\"ibsaKIXqcENsZigu\",\"s3secretkey\":\"aY0XwQR8nrivJYBE\"},\"screenname\":\"cybertrapped2\",\"can_upload\":true,\"override_browser_check\":false,\"collection_picker\":\"\\u003Cselect name=\\u0022mediatypecollection\\u0022 class=\\u0022mediatypecollection js-upload-mediatypecollection\\u0022 data-default-collections=\\u0027{\\u0022movies\\u0022:\\u0022opensource_movies\\u0022,\\u0022audio\\u0022:\\u0022opensource_audio\\u0022,\\u0022texts\\u0022:\\u0022opensource\\u0022,\\u0022software\\u0022:\\u0022open_source_software\\u0022,\\u0022image\\u0022:\\u0022opensource_image\\u0022,\\u0022data\\u0022:\\u0022opensource_media\\u0022}\\u0027\\u003E\\u003Coption value=\\u0022\\u0022 selected=\\u0022selected\\u0022\\u003E - - - Pick a collection - - - \\u003C/option\\u003E\\n\\u003Coption value=\\u0022movies:opensource_movies\\u0022\\u003ECommunity movies\\u003C/option\\u003E\\u003Coption value=\\u0022audio:opensource_audio\\u0022\\u003ECommunity audio\\u003C/option\\u003E\\u003Coption value=\\u0022texts:opensource\\u0022\\u003ECommunity texts\\u003C/option\\u003E\\u003Coption value=\\u0022software:open_source_software\\u0022\\u003ECommunity software\\u003C/option\\u003E\\u003Coption value=\\u0022image:opensource_image\\u0022\\u003ECommunity image\\u003C/option\\u003E\\u003Coption value=\\u0022data:opensource_media\\u0022\\u003ECommunity data\\u003C/option\\u003E\\u003C/select\\u003E\",\"meta\":[],\"title\":\"\",\"identifier\":\"\",\"suggested_identifier\":\"\",\"description\":\"\",\"subject\":\"\",\"creator\":\"\",\"date_parsed\":null,\"primary_collection\":\"\",\"test_item\":\"\",\"primary_language\":\"\",\"license_parsed\":null,\"is_mobile\":false,\"version\":\"1.7.0\",\"is_admin\":false,\"is_archive_user\":false,\"max_id_length\":0,\"etree\":false}'/>\n        <section id=\"uploader-delay-banner\" aria-label=\"Upload processing delays\">\n    <svg class=\"uploader-delay-banner-icon\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n    <p><strong>We are currently experiencing delays processing uploaded items.</strong> In some cases, it may take a few days. We apologize for any inconvenience and appreciate your patience while we restore normal functionality.</p>\n  </section>\n<section id=\"uploader-header-section\">\n  <h2>Upload files</h2>\n  <p>Please contribute books, audio, and video files that you have the right to share. <br>The Internet Archive, a non-profit library, will provide free storage and access to them.</p>\n  <p>We reserve the right to remove any submitted material.</p>\n  <p><b>Contributing to the Live Music Archive?</b> <a href=\"/create.php?lma=1\">Click here to use the LMA uploader instead.</a></p>\n</section>\n<div id=\"outer\">\n    <div id=\"file_drop\"\n      class=\"table drag_target\"\n      >\n        <div id=\"file_drop_contents\">\n            <div><b>Drag & Drop files here or</b></div>\n            <button class=\"btn btn-archive js-uploader-file-input-initial\">Choose files to upload</button>\n            <div class=\"hidden\"><input type=\"file\" multiple=\"multiple\" id=\"file_input_initial\"/></div>\n        </div>\n    </div>\n\n    <div id=\"file_info\" class=\"table\" style=\"display:none\">\n        <div id=\"metadata\">\n            <div id=\"upload-required-section\" class=\"grouped_metadata\">\n              <h3>Required Information</h3>\n              <div class=\"metadata_row\" id=\"page_title_row\">\n                  <span class=\"mdata_key\">Item Title <span class=\"required_star\">*</span></span><span id=\"page_title\" title=\"Title of the page\" class=\"mdata_value edit_text required x-archive-meta-title\"></span>\n                  <span class=\"checkmark check_gray\"></span>\n              </div>\n              <div class=\"metadata_row\" id=\"page_url_row\">\n                <span class=\"mdata_key\">\n                  Page URL <span class=\"required_star\">*</span>\n                </span>\n                <span class=\"mdata_value\">\n                  <span id=\"create_id_checking\"\n                                      >Finding an available URL for your item...</span>\n                  <span id=\"page_url\"\n                    style=\"display:none;\"                  >\n                    <span class=\"gray\">https://archive.org/details/</span>\n                    <span\n                    id=\"item_id\"\n                    title=\"Item Identifier\"\n                    class=\"edit_text\"></span>\n                  </span>\n                </span>\n                <span class=\"checkmark check_gray\" bust-attr=\"foo\"></span>\n              </div>\n              <div class=\"metadata_row\" id=\"description_row\">\n                <span class=\"checkmark check_gray\"></span>\n                <span class=\"mdata_key\">Description <span class=\"required_star\">*</span></span>\n                                <span id=\"description\" class=\"required placeholder mdata_value\" title=\"Add a description of the item page\">Add a description of the item page</span>\n                <div id=\"description_editor_div\">\n                    <br/>\n                    <textarea id=\"description_editor\" name=\"description_editor\" cols=\"50\" rows=\"6\"></textarea>\n                </div>\n              </div>\n              <div id=\"subject_row\" class=\"metadata_row\">\n                <span class=\"mdata_key\">Subject Tags <span class=\"required_star\">*</span></span>\n                                  <span id=\"subjects\" title=\"Add keywords, separated by commas\" class=\"mdata_value edit_text required placeholder\">Add keywords, separated by commas</span>\n                                <span class=\"checkmark check_gray\"></span>\n              </div>\n              <div class=\"metadata_row\" id=\"collection_row\">\n                <span class=\"mdata_key\">Collection <span class=\"required_star\">*</span></span>\n                <span class=\"mdata_value\">\n                    <span\n                      id=\"collection\"\n                      class=\"placeholder\"                      title='Collection for your item'>\n                        Collection for your item                    </span>\n                    <select name=\"mediatypecollection\" class=\"mediatypecollection js-upload-mediatypecollection\" data-default-collections='{\"movies\":\"opensource_movies\",\"audio\":\"opensource_audio\",\"texts\":\"opensource\",\"software\":\"open_source_software\",\"image\":\"opensource_image\",\"data\":\"opensource_media\"}'><option value=\"\" selected=\"selected\"> - - - Pick a collection - - - </option>\n<option value=\"movies:opensource_movies\">Community movies</option><option value=\"audio:opensource_audio\">Community audio</option><option value=\"texts:opensource\">Community texts</option><option value=\"software:open_source_software\">Community software</option><option value=\"image:opensource_image\">Community image</option><option value=\"data:opensource_media\">Community data</option></select>                </span>\n                <span class=\"checkmark check_gray\"></span>\n              </div>\n            </div>\n            <div id=\"upload-recommended-section\" class=\"grouped_metadata secondary\">\n              <h3>Recommended Information</h3>\n              <div class=\"metadata_row\" id=\"creator_row\">\n                  <span class=\"mdata_key\">Creator</span>\n                                      <span id=\"creator\" title=\"Creator of the content\" class=\"mdata_value edit_text x-archive-meta-creator placeholder\">Creator of the content</span>\n                                    <span class=\"checkmark check_gray\"></span>\n              </div>\n              <div class=\"metadata_row\" id=\"date_row\">\n                  <span class=\"mdata_key\">Date</span>\n                  <span class=\"checkmark check_gray\"></span>\n                  <span id=\"date\" class=\"mdata_value\">\n                                              <span id=\"date_text\" title=\"Date work was created/published\" class=\"x-archive-meta-date placeholder\">Date work was created/published</span>\n                                            <div id=\"date_picker\">\n                          <input id=\"date_year\" type=\"text\" placeholder=\"YYYY\" size=\"4\" maxlength=\"4\"> - <input id=\"date_month\" class=\"disabled\" type=\"text\" placeholder=\"MM\" size=\"2\" maxlength=\"2\" disabled> - <input id=\"date_day\" class=\"disabled\" type=\"text\" placeholder=\"DD\" size=\"2\" maxlength=\"2\" disabled>\n                      </div>\n                  </span>\n              </div>\n                          <div class=\"metadata_row\" id=\"language_row\">\n                <span class=\"mdata_key\">Language</span>\n                <span class=\"checkmark check_gray\"></span>\n                <span id='language' class=\"placeholder mdata_value\" title=\"Language of the work\">Language of the work</span>\n                <select id=\"language_select\" class=\"x-archive-meta-language\">\n                  <option value=\"\" class=\"gray\">Choose one...</option>\n                  <option value=\"eng\">English</option>\n                  <op