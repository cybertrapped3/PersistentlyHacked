            "text": "var e=class{async pageNavigationOccurred(e=!0){if(window.location.pathname.startsWith(`/donate`)||!e){await this.removeDonationBanner();return}await this.addDonationBanner()}constructor(e){this.ownerId=`donationBannerHandler`,this.baseUrl=e.baseUrl}async removeDonationBanner(){this.bannerContainer?.remove()}async addDonationBanner(){if(this.bannerContainer)return;let e=document.createElement(`div`);e.dataset.owner=this.ownerId;let t=document.createElement(`div`);t.id=`donato`;let n=document.createElement(`script`);n.type=`text/javascript`,n.src=`https://${this.baseUrl}/includes/donate.js`,e.appendChild(t),e.appendChild(n),document.body.prepend(e)}get bannerContainer(){return document.body.querySelector(`[data-owner=${this.ownerId}]`)}};export{e as DonationBannerHandler};"
