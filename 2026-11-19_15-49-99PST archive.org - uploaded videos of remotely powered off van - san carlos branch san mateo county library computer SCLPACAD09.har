          "content": {
            "size": 2617,
            "mimeType": "text/css",
            "text": "@charset \"UTF-8\";\n/* CSS Document */\n\nbody {\n    font-family: Helvetica, Arial, sans-serif;\n    background-color: #FFFFFF !important;\n    /*background-color: #F1FBFD !important;*/ /* Override background color */\n}\n\ntextarea.sans {\n\tfont-family: Helvetica,Arial,sans-serif;\n\tfont-size: 10pt;\n}\n\n/* Action links show underline only on hover */\n.createWidget a {\n\ttext-decoration: none;\n}\n.createWidget a:hover {\n\ttext-decoration: underline;\n}\n\n.createLabel {\n    font-weight: bold;\n}\n\n.createItemIdentifier { margin: 0; }\n\n.header { width: 95&; background-color: #000; padding: 5px; color: #fff; }\n.footer { text-align: center; }\n\n/* Beta! */\n.createBeta {\n\t-moz-box-shadow: 0px 1px 0px 0px #f29c93;\n\t-webkit-box-shadow: 0px 1px 0px 0px #f29c93;\n\tbox-shadow: 0px 1px 0px 0px #f29c93;\n\tbackground:-webkit-gradient( linear, left top, left bottom, color-stop(0.05, #ff4c38), color-stop(1, #cf3a3a) );\n\tbackground:-moz-linear-gradient( center top, #ff4c38 5%, #cf3a3a 100% );\n\tfilter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#ff4c38', endColorstr='#cf3a3a');\n\tbackground-color:#ff4c38;\n\t-moz-border-radius:9px;\n\t-webkit-border-radius:9px;\n\tborder-radius:9px;\n\tborder:1px solid #d83526;\n\tdisplay:inline-block;\n\tcolor:#ffffff;\n\tfont-family:arial;\n\tfont-size:50%;\n\tfont-weight:bold;\n\tpadding:3px 12px;\n\ttext-decoration:none;\n}\n\n/* Shown when validation fails */\nlabel.error {\n    color: red;\n    margin: 0.3em;\n}\n\n/* Template elements are cloned to create e.g. new item row elements */\n.template { display: none; }\n\n#progress_report, #progress_report_bar, #progress_report_status, #progress_report_bar_container { padding: 0px; }\n\n.js-spinner-placeholder {\n\tmargin-left: 1rem;\n}\n\n/* Scrolling autocomplete */\n.ui-autocomplete {\n\tmax-height: 18em; /* approx. 10 results */\n\toverflow-y: auto;\n\t/* prevent horizontal scrollbar */\n\toverflow-x: hidden;\n\t/* add padding to account for vertical scrollbar */\n\tpadding-right: 20px;\n}\n/* IE 6 doesn't support max-height\n * we use height instead, but this forces the menu to always be this tall\n */\n* html .ui-autocomplete {\n\theight: 18em; /* approx. 10 results */\n}\n\n.ui-button-icon-only .ui-button-text, .ui-button-icons-only .ui-button-text { padding: 0; text-indent: -9999999px; }\n\n@media all and (max-width: 320px) {\n    /* mobile devices such as iPhone/Android in portrait mode */\n    .createForm {\n        -webkit-text-size-adjust:150%;\n    }\n\n    input {\n        line-height: 1.2em;\n    }\n\n    select[name=mediatypecollection] {\n        width: 200px;\n    }\n\n    .createInstructions {\n        width: 320px;\n    }\n\n    .createLabel {\n        width: 320px;\n    }\n}\n"
          },
