ckground-color: #ab4517;\n        color: #fff;\n        border: 1px solid #67290e;\n        border-top: 0;\n      }\n\n      .urgent ::slotted(*) {\n        color: #fff;\n      }\n\n      .warn {\n        background-color: #fae366;\n        color: #2c2c2c;\n        border: 1px solid #96883d;\n        border-top: 0;\n      }\n\n      .warn ::slotted(*) {\n        color: #2c2c2c;\n      }\n\n      .info {\n        background-color: #428bca;\n        color: #fff;\n        border: 1px solid #285379;\n        border-top: 0;\n      }\n\n      .info ::slotted(*) {\n        color: #fff;\n      }\n\n      #close-button {\n        cursor: pointer;\n        color: inherit;\n        background: none;\n        border: none;\n        display: flex;\n        align-items: center;\n        padding-right: 0;\n        float: right;\n      }\n\n      #dismiss-text {\n        margin-left: 0.5rem;\n      }\n    `}};o([t({type:String})],l.prototype,`level`,void 0),o([t({type:Boolean})],l.prototype,`showCloseButton`,void 0),o([t({type:String})],l.prototype,`closeButtonText`,void 0),l=o([a(`alert-banner`)],l);export{l as AlertBanner};"
