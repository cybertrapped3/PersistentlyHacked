        "request": {
          "method": "PUT",
          "url": "https://s3.us.archive.org/2020-Ford-Transit-250-with-Unauthorized-Modifications-Purchased-New-Stanford-CT%2FLOCK0000.mov",
          "httpVersion": "",
          "headers": [
            {
              "custom": {},
              "name": "authorization",
              "value": "LOW ibsaKIXqcENsZigu:aY0XwQR8nrivJYBE"
            },
            {
